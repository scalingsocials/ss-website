---
/**
 * /guides/ — the long-form pillars index. Replaces the noindex lander.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Meta from '@/components/seo/Meta.astro';
import SchemaGraph from '@/components/seo/SchemaGraph.astro';
import Section from '@/components/primitives/Section.astro';
import AnswerBlock from '@/components/blocks/AnswerBlock.astro';
import CtaBand from '@/components/blocks/CtaBand.astro';
import Button from '@/components/primitives/Button.astro';
import { getCollection } from 'astro:content';
import { PARTNER_BY_SLUG } from '@/lib/team';
import { base, webPage, breadcrumbs } from '@/lib/schema';

const url = '/guides/';
const title = 'D2C Growth Guides: Economics, Creative and Site Speed';
const description =
  'Long-form guides from Scaling Socials on what decides D2C growth: unit economics and break-even ROAS, Meta creative testing, and Shopify store speed.';
const modified = '2026-09-06';

const guides = (await getCollection('guides'))
  .filter((g) => !g.data.draft)
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime());

const nodes = [
  ...base(),
  webPage({ url, name: title, description, hasBreadcrumb: true, dateModified: modified }),
  breadcrumbs(url, [{ name: 'Home', url: '/' }, { name: 'Guides', url }]),
];
---

<BaseLayout>
  <Meta slot="meta" title={title} description={description} type="website" modifiedTime={modified} />
  <SchemaGraph slot="schema" nodes={nodes} />

  <Section size="lg">
    <span class="ss-eyebrow">Guides</span>
    <h1 class="max-w-[20ch]">The long reads worth your time</h1>
    <AnswerBlock class="mt-[var(--space-4)]">
      Scaling Socials publishes long-form guides on the three things that decide whether a D2C brand
      grows profitably: the unit economics behind every ROAS figure, how to test Meta creative
      without wasting budget, and what store speed actually costs you in orders.
    </AnswerBlock>
    <div class="mt-[var(--space-6)] flex flex-wrap gap-[var(--space-2)]">
      <Button href="/tools/" variant="primary">Try the free calculators</Button>
      <Button href="/glossary/" variant="secondary">Read the glossary</Button>
    </div>
  </Section>

  <Section size="md">
    <ul class="grid gap-[var(--space-4)] md:grid-cols-2 lg:grid-cols-3">
      {guides.map((g) => {
        const author = PARTNER_BY_SLUG[g.data.author];
        return (
          <li>
            <a href={`/guides/${g.id}/`} class="ss-card group flex h-full flex-col gap-[var(--space-3)] rounded-[var(--radius-card)] border border-[var(--rule-c)] bg-[var(--ground)] p-[var(--space-5)] no-underline">
              <span class="text-label font-semibold text-[var(--accent-text)]">{g.data.tags[0]}</span>
              <span class="text-h4 font-semibold leading-snug text-[var(--fg)] group-hover:text-[var(--accent-text)]">{g.data.title}</span>
              <span class="text-small leading-relaxed text-[var(--fg-muted)]">{g.data.description}</span>
              <span class="mt-auto border-t border-[var(--rule-c)] pt-[var(--space-3)] text-label text-[var(--fg-muted)]" data-num>
                {author?.name} · <time datetime={g.data.published.toISOString().slice(0, 10)}>
                  {g.data.published.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' })}
                </time>
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </Section>

  <Section register="ink" size="md">
    <CtaBand
      heading="Want this applied to your account?"
      body="A written audit in three working days, whether or not you hire us."
      ctaLabel="Get a free growth plan"
      ctaHref="/audit/"
      secondaryLabel="Talk to us"
      secondaryHref="/contact/"
    />
  </Section>

  <style>
    .ss-eyebrow { display: inline-block; margin-bottom: var(--space-2); font-size: var(--text-label); font-weight: 600; color: var(--accent-text); }
    .ss-card { transition: transform var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out); }
    @media (prefers-reduced-motion: no-preference) {
      .ss-card:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--accent-fill) 55%, var(--rule-c)); }
    }
  </style>
</BaseLayout>
