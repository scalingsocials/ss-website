---
/**
 * /lp/performance-marketing/thanks/ — post-submit confirmation for the perf LP.
 * NOINDEX. Rendered by LandingThanksLayout (shared with the UAE LP).
 */
import LandingThanksLayout from '@/layouts/LandingThanksLayout.astro';
import { LANDING_BY_SLUG } from '@/lib/landings';

const c = LANDING_BY_SLUG['performance-marketing']!;

// One case study per spend band. Under ₹60 K sees the launch-from-zero account,
// the middle bands the turnaround, ₹5 L+ the mature account that broke its ceiling.
const MATCH = [
  { band: 'Under ₹40 K', slug: 'wellness-brand-zero-to-scale' },
  { band: '₹40–60 K', slug: 'wellness-brand-zero-to-scale' },
  { band: '₹60 K–2 L', slug: 'womens-fashion-account-turnaround' },
  { band: '₹2–5 L', slug: 'womens-fashion-account-turnaround' },
  { band: '₹5 L+', slug: 'womenswear-breaking-the-ceiling' },
];
---
<LandingThanksLayout content={c} match={MATCH} waText="Hi, I just booked a free account review, here's my latest Ads Manager screenshot" />
