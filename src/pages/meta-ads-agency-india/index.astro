---
/**
 * /meta-ads-agency-india/ — the flagship Meta Ads page. Bespoke (not the cluster
 * template) because the copy needs real lists, case-study pullouts, a stats block
 * and a ten-question FAQ — the enumerable structure answer engines extract (03 §3).
 * Owner-supplied copy, built to depth. Schema: Service + WebPage + BreadcrumbList
 * + FAQPage. No SS pricing figure (§18); the ₹10k–20k figure is an ad-spend floor
 * (the client's media budget, used to qualify), not a fee.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Meta from '@/components/seo/Meta.astro';
import SchemaGraph from '@/components/seo/SchemaGraph.astro';
import Section from '@/components/primitives/Section.astro';
import Prose from '@/components/primitives/Prose.astro';
import Button from '@/components/primitives/Button.astro';
import LeadForm from '@/components/blocks/LeadForm.astro';
import FaqAccordion from '@/components/blocks/FaqAccordion.astro';
import CtaBand from '@/components/blocks/CtaBand.astro';
import ComparisonTable from '@/components/blocks/ComparisonTable.astro';
import ProcessSteps from '@/components/blocks/ProcessSteps.astro';
import NotForYouBlock from '@/components/blocks/NotForYouBlock.astro';
import DotField from '@/components/graphics/DotField.astro';
import Glyph from '@/components/graphics/Glyph.astro';
import { SERVICE_BY_SLUG } from '@/lib/services';
import { base, service, webPage, breadcrumbs, faqPage, serviceId } from '@/lib/schema';
import { adSpendManaged, brandsServed, brandsPast10L, brandsPast1Cr } from '@/data/proofStats';
import type { FaqItem } from '@/components/blocks/FaqAccordion.astro';

const url = '/meta-ads-agency-india/';
const title = 'Meta Ads Agency in India for D2C Brands | Scaling Socials';
const description =
  'Scaling Socials is a Meta Ads agency for D2C brands in India and the UAE: full-funnel Facebook and Instagram ads, run to your margin with in-house creative.';
const published = '2026-09-01';
const modified = '2026-09-12';
const parent = SERVICE_BY_SLUG['performance-marketing'];

const answer =
  'Scaling Socials runs full-funnel Meta advertising, across Facebook and Instagram, for D2C and ecommerce brands in India and the UAE. That means prospecting, retargeting, and Advantage+ where it beats manual, all fed by an in-house creative pipeline and managed to your real margin rather than a platform-flattered ROAS.';

// Proof stats — single source of truth in src/data/proofStats.ts. The managed
// ad-spend figure has no channel qualifier and is gated by check:stats, so it
// can never drift from the other pages.
const stats = [brandsServed, brandsPast10L, brandsPast1Cr, adSpendManaged].map((s) => ({ v: s.value, l: s.label }));

// Budget shape, drawn as bars further down. Both splits are the ones the copy
// states in prose; `w` drives a flex ratio through a data attribute rather than
// an inline style, because the production CSP is strict hash-based and drops
// style="" silently (it already ate the per-card colours once).
const BUDGET_SPLITS = [
  {
    stage: 'Early-stage brand',
    note: 'No pixel data, no warm audience yet',
    parts: [
      { label: 'Prospecting', pct: '80%', w: '80' },
      { label: 'Retargeting', pct: '20%', w: '20' },
    ],
  },
  {
    stage: 'Scaling brand',
    note: 'Purchase data in the account to build on',
    parts: [
      { label: 'Prospecting', pct: '30%', w: '30' },
      { label: 'Retargeting', pct: '25%', w: '25' },
      { label: 'Lookalikes', pct: '45%', w: '45' },
    ],
  },
];

// The 90-day shape, lifted out of the prose it used to be buried in. Every
// phrase here comes from that copy — nothing new is claimed.
const NINETY_DAYS = [
  { title: 'Onboarding', body: 'A health check before a single campaign goes live: your whole path from homepage to purchase confirmation, your pixel, and an audit of everything the account has run before.' },
  { title: 'Month one — content', body: 'Campaigns go live and the month is spent finding which content angles work: statics, video, catalogue. A call every week on what happened and what is next.' },
  { title: 'Month two — targeting', body: 'With the content question answered, the month goes on audiences: which interests, which age bands, which locations, which structures.' },
  { title: 'Month three — consistency', body: 'All three answers in hand — the content, the targeting and the structure that work. This is where consistent sales and stable revenue become a fair expectation.' },
];

// Already an enumerated list in the copy; NotForYouBlock renders it as the
// disqualifier block the service pages use.
const NOT_FOR_YOU = [
  'Brands expecting 5X or 7X in month one. That is not how testing works and we will not pretend otherwise to win an account.',
  'Ad-spend budgets of ₹10,000–₹20,000 a month. There is no version of that budget that produces a meaningful result, and taking it would waste your money and our time.',
  'Brands that want a vendor rather than a partner — not open to changing pricing, improving the product, fixing the website or investing in content.',
  'Illegal products, and anything overpriced and sold on hype without delivering value.',
];

// The three differentiators, verbatim from the copy they replaced.
// "Official Meta Business Partner" is a bare fact with no sentence behind it,
// and §15 forbids writing one to fill the card. It renders as a badge above
// instead, so the two items that DO have substance keep equal-height cards.
const WHY_STAY = [
  { glyph: 'gauge', title: 'Social Analytix, our in-house AI tool', body: 'Monitors every live campaign in your ad account in real time and flags what to pause, what to scale, and where budget is leaking — so decisions happen on the day, not at the end of the month.' },
  { glyph: 'handshake', title: 'Experienced media buyers only', body: 'We keep the team small and qualified rather than filling it with volume hires and assigning your account to whoever is free.' },
];

// Priority order, with the reason the copy gives for each.
const TARGETING = [
  { name: 'Broad', why: 'Meta’s models in 2026 are considerably better at finding buyers than a hand-built interest stack.' },
  { name: 'Manual interests', why: 'The foundation of advertising, and it still works — particularly where a brand has a sharply defined customer.' },
  { name: 'Lookalikes', why: 'In proportion to the purchase data available. With enough purchasers in the account, these become one of the most reliable parts of the structure.' },
];

// Ordered by spend, exactly as the copy states it.
const CATEGORIES = {
  largest: ['Apparel', 'Home decor', 'Skincare', 'F&B'],
  rest: ['Services', 'Real estate', 'Study abroad', 'Pet', 'Electronics', 'Home appliances'],
};

const faqs: FaqItem[] = [
  { q: 'How long before I see results?', a: 'Positive traction usually shows in the first month. Consistent sales, stable ROAS and dependable revenue take at least three months, because that is how long a proper testing cycle takes.' },
  { q: 'Do I pay my ad spend to you?', a: 'No. Your ad budget goes directly into your own ad account and straight to Meta. We never mark it up and never route it through us. Everything stays visible to you.' },
  { q: 'Whose ad account do you run on?', a: 'Yours. Every rupee spent is visible in an account you own, which is the only arrangement that is genuinely transparent.' },
  { q: 'Whose pixel gets used?', a: 'Yours. The data we build belongs to you, and it stays with you whether you work with us next year or not.' },
  { q: 'What is the minimum contract period?', a: 'There is not one. We do not lock clients into contracts — you can stop whenever you choose. We suggest giving it three months so you are judging us on results rather than on the testing phase, but that is a recommendation, not a term.' },
  { q: 'Who will actually run my account — seniors or freshers?', a: 'Experienced buyers. We hire for capability rather than headcount, which is why the team is deliberately small.' },
  { q: 'Do you make the Meta ad creative?', a: 'Yes. Statics and video-led ads are produced in-house and tested in a structured pipeline. Creative is the single biggest lever on Meta right now, so it sits at the centre of the engagement rather than off to the side as an add-on.' },
  { q: 'Should I use Advantage+ or manual campaigns?', a: 'It depends on your catalogue and your funnel. We run Advantage+ where it beats manual and stay manual where the control pays off, and we test both against your break-even ROAS.' },
  {
    q: 'My Meta ads get traffic but no sales. Is it the ads?',
    a: [
      'Often it is not. The most common mistake we see in Indian D2C is ',
      { text: 'blaming Meta when the real problem sits after the click', href: '/blog/meta-ads-traffic-but-no-sales/' },
      '. When traffic is healthy and purchases are not, the cause is usually the product, the price, the website or the content — and no amount of campaign restructuring fixes any of those. We check the whole path from ad to checkout before rebuilding an account, and where the leak is on-site we fix it with ',
      { text: 'conversion rate optimisation', href: '/conversion-rate-optimisation-services/' },
      ', not more ad spend.',
    ],
  },
  { q: 'How does pricing work?', a: 'Every engagement is scoped to the brand rather than sold as a fixed package, and it reflects your ad spend and creative volume. Your Meta ad spend always stays separate and unmarked-up.' },
];

const nodes = [
  ...base(),
  service({ url, name: 'Meta Ads', serviceType: 'Meta advertising', description, areaServed: ['IN', 'AE'] }),
  webPage({ url, name: title, description, aboutId: serviceId(url), hasBreadcrumb: true, datePublished: published, dateModified: modified }),
  breadcrumbs(url, [{ name: 'Home', url: '/' }, { name: 'Performance marketing', url: '/performance-marketing-agency-bangalore/' }, { name: 'Meta Ads', url }]),
  faqPage(url, faqs),
];
---

<BaseLayout heroOver>
  <Meta slot="meta" title={title} description={description} type="website" modifiedTime={modified} />
  <SchemaGraph slot="schema" nodes={nodes} />

  <!-- HERO — the shared ink opener, --sub variant, same as every other
       sub-service page so the whole service tree reads as one system. -->
  <Section register="ink" size="lg" class="ss-inkhero ss-inkhero--sub ss-hero-over">
    <DotField origin="top-right" />
    <nav aria-label="Breadcrumb" class="ss-inkhero__crumb relative flex flex-wrap items-center gap-x-[0.15rem] text-label text-[var(--fg-muted)]">
      <a href="/" class="inline-flex items-center text-[var(--accent-text)] no-underline">Home</a><span> / </span>
      <a href="/performance-marketing-agency-bangalore/" class="inline-flex items-center text-[var(--accent-text)] no-underline">Performance marketing</a><span> / </span>
      <span>Meta Ads</span>
    </nav>
    <div class="ss-inkhero__grid relative grid gap-[var(--space-8)] lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <div class="ss-inkhero__copy">
        <span class="ss-eyebrow">Performance marketing</span>
        <h1 class="max-w-[20ch]">Meta Ads agency for D2C brands in India</h1>
        <p class="mt-[var(--space-4)] max-w-[56ch] text-h4 leading-[1.5] text-[var(--fg)]">{answer}</p>
        <p class="mt-[var(--space-4)] max-w-[56ch] text-body text-[var(--fg-muted)]">
          Five years in, we have run Meta ads for {brandsServed.value} brands, always inside their own ad accounts.
          The account stays yours. So does the pixel. And so does the data we build in it.
        </p>
        <div class="ss-inkhero__cta mt-[var(--space-6)] grid grid-cols-2 gap-[var(--space-2)]">
          <Button href="/audit/" variant="primary">Get a free growth plan</Button>
          <Button href="/performance-marketing-agency-bangalore/" variant="secondary">Performance marketing</Button>
        </div>
      </div>
      <div>
        <LeadForm source="meta-ads" heading="Get a free Meta ads review" questions={parent?.formQuestions ?? []} submitLabel="Get my free review" elevated />
      </div>
    </div>
  </Section>

  <Section size="md" class="!bg-[var(--surface-c)]">
    <div class="ma-two">
      <div>
    <Prose>
      <h2>How we structure a Meta account</h2>
      <p>There is no template. The structure follows the budget and the stage the brand is at, and both of those change.</p>
      <p><strong>Number of campaigns follows the budget.</strong> A brand spending ₹10,000 a day cannot support the same account architecture as a brand spending ₹1 lakh a day, and pretending otherwise is how testing budgets get spread so thin that nothing reaches significance. We have run both ends of that range and completed a clean testing phase in both, but the campaign count, the ad count and the daily allocation get worked out from your <a href="/tools/meta-ads-budget-planner/">monthly marketing budget</a> downward, not from a slide deck.</p>
      <p><strong>Prospecting versus retargeting follows the audience you already have.</strong> If you come to us with an existing customer base, a real Instagram following and warm audiences already sitting in your account, we start retargeting from week one because the money is already there to be collected. If you are starting cold with no pixel data and no audience, almost everything goes to prospecting first, because until we know which cold audiences add to cart and initiate checkout, there is nothing to retarget.</p>
    </Prose>

      </div>

      {/* The budget shape, drawn rather than listed, in a rail beside the copy
          it illustrates — it is the picture of the paragraph above it, so it
          belongs next to it rather than under it. Stacked here, because two
          bars side by side inside a narrow rail are unreadable. */}
      <aside class="ma-splits">
      {BUDGET_SPLITS.map((b) => (
        <figure class="ma-split">
          <figcaption class="ma-split__head">
            <span class="ma-split__stage">{b.stage}</span>
            <span class="ma-split__note">{b.note}</span>
          </figcaption>
          <div class="ma-split__bar" role="img" aria-label={`${b.stage}: ${b.parts.map((x) => `${x.label} ${x.pct}`).join(', ')}`}>
            {b.parts.map((x, i) => <span class="ma-split__seg" data-seg={i} data-w={x.w}></span>)}
          </div>
          <ul class="ma-split__key">
            {b.parts.map((x, i) => (
              <li><span class="ma-split__dot" data-seg={i}></span>{x.label} <strong>{x.pct}</strong></li>
            ))}
          </ul>
        </figure>
      ))}
      </aside>
    </div>

    {/* The funnel order, which the copy states as a single sentence. */}
    <ol class="ma-flow" aria-label="Funnel order">
      {['Cold', 'Warm', 'Retarget', 'Convert'].map((stepName) => <li><span>{stepName}</span></li>)}
    </ol>
    <p class="ma-flow__note">The funnel runs in that order every time.</p>

    <Prose class="mt-[var(--space-6)]">
      <h3>CBO or ABO is a testing decision, not a preference</h3>
      <p>Some accounts stay CBO-led, some ABO-led. It depends on the account, and on where that account is in its testing cycle.</p>
    </Prose>
    <ComparisonTable
      columns={['', 'High-budget CBO', 'ABO']}
      rows={[
        ['We reach for it when', 'The budget can move through testing quickly', 'A winner is already clear'],
        ['What it is doing', 'Multiple ad sets and creatives, one variable changed at a time — creative, or interest, or age, or gender, never all at once', 'Holding a proven creative or audience on a budget we control directly'],
        ['What it buys us', 'Speed to a verdict', 'Control, so the winner can be scaled'],
      ]}
      caption="How we choose between campaign budget optimisation and ad-set budgets."
      class="mt-[var(--space-4)]"
    />
    <figure class="ss-pullout">
      <span class="ss-pullout__tag">Inherited account · women’s fashion</span>
      <p class="ss-pullout__line"><span>Starting point:</span> 1.75x ROAS under a previous agency, spend spread across positions that never earned it.</p>
      <p class="ss-pullout__line"><span>Where it got to:</span> 3.94x in a single quarter, revenue up 204% on 35% more spend — our worst month still beat their previous best.</p>
      <a href="/case-studies/womens-fashion-account-turnaround/" class="ss-pullout__link">Read the women’s fashion turnaround</a>
    </figure>
  </Section>

  <Section size="md">
    <Prose>
      <h2>Creative is the lever, not the settings</h2>
      <p>Since the Andromeda update, the volume and quality of creative running through an account matters far more than how neatly the account is organised. We produce statics and video-led ads in-house and push them through a <a href="/guides/meta-ads-creative-testing/">structured testing pipeline</a>, so winners get found by spend rather than by the loudest opinion in the room.</p>
      <p>We do not commit to a fixed number of creatives per month, because that number is an output, not a target. If ten a week is producing results, ten a week is right. If it is not, we go to twenty, thirty, forty. The requirement sets the number.</p>
      <h3>How a test is judged</h3>
      <p>Every campaign is reviewed on a three to four day cycle against the objective it was launched for. A campaign producing strong <a href="/glossary/ctr/">CTR</a> and healthy add-to-carts gets more time even if the sales have not landed yet, because the signal is there. Anything not trending toward a winner gets switched off quickly.</p>
    </Prose>
    <ComparisonTable
      columns={['Campaign is for', 'Judged on', 'What counts as a winner', 'Killed when']}
      rows={[
        ['Sales', 'ROAS and order volume', 'Profitable ROAS and consistent orders', 'No sales inside the three-to-four-day window'],
        ['Lead generation', 'Cost per lead and lead quality', 'Leads your sales team can actually close', 'Leads are cheap but unclosable'],
        ['Brand building', 'CTR, CPC and CPM', 'Metrics trending toward a winner', 'No trend toward a winner'],
      ]}
      caption="Sales are not the fair measure in every phase, so the measure changes with the objective."
      class="mt-[var(--space-5)]"
    />
    <p class="ma-note">A killed campaign is replaced, not just switched off — new interest, new age band, new creative, new angle. Cheap leads your sales team cannot close are not a result.</p>
  </Section>

  <Section size="md" class="!bg-[var(--surface-c)]">
    <Prose>
      <h2>Advantage+ where it earns its place</h2>
      <p><a href="/glossary/advantage-plus-shopping/">Advantage+ Shopping</a> is a genuinely good update and we have seen it produce strong results, but it earns its place in two specific situations rather than by default.</p>
      <p>If you already have a proven product with sales behind it, Advantage+ with a serious budget is often the fastest way to scale that product. If you do not yet know what your winner is, Advantage+ is still useful, because it will test multiple products at once and tell you faster than a manual structure which of them the market actually wants.</p>
      <p>Where a manual structure gives us control worth paying for, we stay manual — the same call we weigh on <a href="/vs/advantage-plus-vs-manual/">Advantage+ versus a manual campaign structure</a>, and the one Google forces too with <a href="/glossary/performance-max/">Performance Max</a>. Either way, the campaign is held to your <a href="/glossary/roas/">break-even ROAS</a>, calculated from your margin with our <a href="/tools/break-even-roas-calculator/">break-even ROAS calculator</a>, not to a rule of thumb.</p>
    </Prose>
    <figure class="ss-pullout">
      <span class="ss-pullout__tag">Scaling a proven product · mid-luxury womenswear</span>
      <p class="ss-pullout__line"><span>Starting point:</span> capped at 3–5x for a year — a stable account that had quietly stopped growing.</p>
      <p class="ss-pullout__line"><span>Where it got to:</span> 7.09x across seven months while spending more than ever, worst month still 5.83x.</p>
      <a href="/case-studies/womenswear-breaking-the-ceiling/" class="ss-pullout__link">Read the womenswear scaling story</a>
    </figure>
  </Section>

  <Section size="md">
    <Prose>
      <h2>How we approach targeting</h2>
      <p>We have not dropped anything. Broad, manual interests and lookalikes all still get tested — in that order of priority.</p>
    </Prose>
    {/* A genuine ranking: the copy states these three in priority order and gives
        a reason for each, so the numbering carries information rather than
        decorating the list. */}
    <ol class="ma-rank">
      {TARGETING.map((t, i) => (
        <li class="ma-rank__item">
          <span class="ma-rank__n">{i + 1}</span>
          <div>
            <h3 class="ma-rank__t">{t.name}</h3>
            <p class="ma-rank__b">{t.why}</p>
          </div>
        </li>
      ))}
    </ol>
    <p class="ma-note">What works is decided per brand, by testing, not by a house rule.</p>
  </Section>

  <Section size="md" class="!bg-[var(--surface-c)]">
    <span class="ss-eyebrow">The engagement</span>
    <h2 class="max-w-[24ch] text-h2 font-semibold">What the first 90 days look like</h2>
    {/* The same four phases the prose described, on the step component the
        service pages already use — a timeline is what this content always was. */}
    <div class="mt-[var(--space-6)]"><ProcessSteps steps={NINETY_DAYS} /></div>
    <Prose class="mt-[var(--space-6)]">
      <h3>Inside onboarding</h3>
      <p>Before a single campaign goes live, we walk your entire path from homepage to purchase confirmation, looking for the breaks — add to cart, checkout initiation, billing details, payment. A slow or broken store is the most common thing quietly capping paid results, so this is also where we flag <a href="/web-development-company-bangalore/">website</a> and <a href="/shopify-speed-optimisation-services/">store-speed</a> problems that campaign changes can never fix. We then verify your pixel is firing correctly and connected properly to the ad account, and audit everything run on the account historically — money already spent is data already bought.</p>
      <p>That audit becomes your month-one plan. Whatever showed positive signal in the past gets priority; whatever failed gets avoided outright. Alongside it you get a creative brief, so you know exactly what images and videos we need from you and by when. When we produce the creative, our design team and our media buyers plan the campaigns and the creative together, in the same room. Most agencies get this wrong — designers make whatever they make and the buyer runs it. We do not work that way.</p>
    </Prose>
    <div class="ma-warn">
      <span class="ma-warn__tag">What not to expect in the first 30 to 60 days</span>
      <p>Strong, consistent ROAS. During testing, losing campaigns will outnumber winners — that is what testing is. Brands that hold their nerve through that window are the ones that see month-on-month growth afterwards. Patience in the testing phase is not optional.</p>
    </div>
    <figure class="ss-pullout">
      <span class="ss-pullout__tag">The testing window, with a real account behind it · wellness D2C</span>
      <p class="ss-pullout__line"><span>Starting point:</span> the first two months returned ₹0 — no proven product, no data, a genuinely hard call to keep going.</p>
      <p class="ss-pullout__line"><span>Where it got to:</span> ₹1.19 crore in year one at 6.23x average, with monthly budget grown 44x against proven performance.</p>
      <a href="/case-studies/wellness-brand-zero-to-scale/" class="ss-pullout__link">Read how the wellness brand scaled from zero</a>
    </figure>
  </Section>

  <Section size="md">
    <NotForYouBlock heading="Brands we do not work with" items={NOT_FOR_YOU} />
    <p class="ma-note mt-[var(--space-4)]">
      We will always tell you what is actually holding sales back, and that only works if you want to
      hear it. We work with brands that have a realistic view of where they want to be in a year and
      are willing to build toward it. If you are not sure that is you, our note on
      <a href="/blog/who-we-turn-down-and-why/">who we turn down and why</a> is an honest read.
    </p>

    <div class="mt-[var(--space-10)]">
      <span class="ss-eyebrow">Where the spend has gone</span>
      <h2 class="max-w-[24ch] text-h2 font-semibold">Categories we have spent in</h2>
      <p class="ma-note mt-[var(--space-3)] max-w-[62ch]">
        Five years across Indian and UAE ecommerce means most niches have come through the door.
        Ordered by spend:
      </p>
      {/* Two tiers because the copy draws that line itself — four largest by
          spend, then the rest. The emphasis is the information. */}
      <ul class="ma-cats mt-[var(--space-4)]">
        {CATEGORIES.largest.map((cat) => <li class="ma-cat ma-cat--lead">{cat}</li>)}
        {CATEGORIES.rest.map((cat) => <li class="ma-cat">{cat}</li>)}
      </ul>
    </div>
  </Section>

  <Section size="md" class="!bg-[var(--surface-c)]">
    <span class="ss-eyebrow">Why brands stay</span>
    <h2 class="max-w-[24ch] text-h2 font-semibold">Five years, inside your own account</h2>
    <ul class="mt-[var(--space-6)] grid gap-[var(--space-3)] sm:grid-cols-2 lg:grid-cols-4">
      {stats.map((s) => (
        <li class="flex flex-col gap-[var(--space-1)] rounded-[var(--radius-card)] border border-[var(--rule-c)] bg-[var(--ground)] p-[var(--space-4)]">
          <span class="display-type text-h2 font-bold leading-none text-[var(--fg)]">{s.v}</span>
          <span class="text-small leading-relaxed text-[var(--fg-muted)]">{s.l}</span>
        </li>
      ))}
    </ul>
    {/* Was an unmarked <ul> inside Prose that rendered as three run-on lines with
        no markers. These are the three differentiators, so they get the weight. */}
    <p class="ma-badge mt-[var(--space-5)]">
      <span class="ma-badge__ico"><Glyph name="shield" size={16} /></span>Official Meta Business Partner
    </p>
    <ul class="ma-why mt-[var(--space-3)]">
      {WHY_STAY.map((w) => (
        <li class="ma-why__item">
          <span class="ma-why__ico"><Glyph name={w.glyph} size={18} /></span>
          <div>
            <h3 class="ma-why__t">{w.title}</h3>
            {w.body && <p class="ma-why__b">{w.body}</p>}
          </div>
        </li>
      ))}
    </ul>
  </Section>

  <Section size="md">
    <span class="ss-eyebrow">Questions</span>
    <h2 class="max-w-[24ch] text-h2 font-semibold">Questions founders ask</h2>
    <div class="mt-[var(--space-5)] max-w-[820px]"><FaqAccordion items={faqs} openFirst /></div>
  </Section>

  <Section register="ink" size="md">
    <CtaBand heading="Not sure where to start?" body="Send us your accounts and you get a written audit in three working days, whether or not you go on to hire us." ctaLabel="Get a free growth plan" ctaHref="/audit/" secondaryLabel="Talk to us" secondaryHref="/contact/" />
  </Section>

  <style>
    .ss-eyebrow { display: inline-block; margin-bottom: var(--space-2); font-size: var(--text-label); font-weight: 600; color: var(--accent-text); }
    .ss-pullout { margin-top: var(--space-6); border-left: 3px solid var(--accent-graphic); background: var(--ground); border-radius: var(--radius-card); padding: var(--space-4) var(--space-5); display: flex; flex-direction: column; gap: var(--space-2); }
    .ss-pullout__tag { font-size: var(--text-label); font-weight: 600; color: var(--accent-text); }
    .ss-pullout__line { font-size: var(--text-small); line-height: 1.55; color: var(--fg); }
    .ss-pullout__line span { font-weight: 600; color: var(--fg-muted); }
    .ss-pullout__link { align-self: flex-start; margin-top: var(--space-1); font-size: var(--text-small); font-weight: 600; color: var(--accent-text); }

    /* --- budget split bars ------------------------------------------------ */
    /* Copy left, the bars that illustrate it in a rail on the right. Falls to
       one column below 960px, where a rail would be too narrow to read a bar in. */
    .ma-two { display: grid; gap: var(--space-6); align-items: start; }
    @media (min-width: 960px) { .ma-two { grid-template-columns: 1.12fr 0.88fr; } }
    /* Stacked, not side by side: inside the rail there is no width for two. */
    .ma-splits { display: grid; gap: var(--space-3); }
    @media (max-width: 959px) {
      .ma-splits { margin-top: var(--space-4); }
      /* Below the rail breakpoint there IS room for two across again. */
      @media (min-width: 780px) { .ma-splits { grid-template-columns: 1fr 1fr; } }
    }
    .ma-split {
      border: 1px solid var(--rule-c);
      border-radius: var(--radius-card);
      background: var(--ground);
      padding: var(--space-4);
    }
    .ma-split__head { display: flex; flex-direction: column; gap: 0.15rem; margin-bottom: var(--space-3); }
    .ma-split__stage { font-size: var(--text-h4); font-weight: 600; color: var(--fg); }
    .ma-split__note { font-size: var(--text-label); color: var(--fg-muted); }
    .ma-split__bar { display: flex; height: 14px; border-radius: 999px; overflow: hidden; gap: 2px; }
    /* Widths come from a data attribute, never an inline style: the production
       CSP is strict hash-based and drops style="" without an error anywhere.
       Only four ratios exist in the copy, so four rules cover it. */
    .ma-split__seg[data-w='80'] { flex: 80; }
    .ma-split__seg[data-w='45'] { flex: 45; }
    .ma-split__seg[data-w='30'] { flex: 30; }
    .ma-split__seg[data-w='25'] { flex: 25; }
    .ma-split__seg[data-w='20'] { flex: 20; }
    .ma-split__seg[data-seg='0'] { background: var(--accent-graphic); }
    .ma-split__seg[data-seg='1'] { background: color-mix(in srgb, var(--accent-graphic) 52%, var(--surface-c)); }
    .ma-split__seg[data-seg='2'] { background: var(--accent-graphic-2); }
    .ma-split__key { margin-top: var(--space-3); display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-3); font-size: var(--text-small); color: var(--fg-muted); }
    .ma-split__key li { display: flex; align-items: center; gap: 0.4rem; }
    .ma-split__key strong { color: var(--fg); font-variant-numeric: tabular-nums; }
    .ma-split__dot { width: 10px; height: 10px; border-radius: 3px; flex: none; }
    .ma-split__dot[data-seg='0'] { background: var(--accent-graphic); }
    .ma-split__dot[data-seg='1'] { background: color-mix(in srgb, var(--accent-graphic) 52%, var(--surface-c)); }
    .ma-split__dot[data-seg='2'] { background: var(--accent-graphic-2); }

    /* --- funnel order ----------------------------------------------------- */
    .ma-flow { margin-top: var(--space-5); display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-1); }
    /* The pill is the inner span, so the connector drawn on the li lands
       BETWEEN two pills instead of inside the left one. */
    .ma-flow li { display: flex; align-items: center; gap: var(--space-1); }
    .ma-flow li span {
      padding: 0.5rem var(--space-3);
      border: 1px solid var(--rule-c);
      border-radius: 999px;
      background: var(--ground);
      font-size: var(--text-small);
      font-weight: 600;
      color: var(--fg);
    }
    .ma-flow li:not(:last-child)::after { content: '→'; color: var(--accent-text); font-weight: 700; }
    .ma-flow__note { margin-top: var(--space-2); font-size: var(--text-small); color: var(--fg-muted); }

    /* --- ranked list ------------------------------------------------------ */
    .ma-rank { margin-top: var(--space-5); display: grid; gap: var(--space-3); }
    @media (min-width: 900px) { .ma-rank { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    .ma-rank__item {
      display: flex;
      gap: var(--space-3);
      padding: var(--space-4);
      border: 1px solid var(--rule-c);
      border-radius: var(--radius-card);
      background: var(--ground);
    }
    .ma-rank__n {
      flex: none;
      display: grid;
      place-items: center;
      width: 30px;
      height: 30px;
      border-radius: 999px;
      background: var(--accent-fill);
      color: var(--accent-on);
      font-size: var(--text-label);
      font-weight: 800;
    }
    .ma-rank__t { font-size: var(--text-h4); font-weight: 600; color: var(--fg); }
    .ma-rank__b { margin-top: var(--space-1); font-size: var(--text-small); line-height: 1.55; color: var(--fg-muted); }

    /* --- inline note + caution ------------------------------------------- */
    .ma-note { max-width: 68ch; font-size: var(--text-small); line-height: 1.6; color: var(--fg-muted); }
    .ma-note a { color: var(--accent-text); }
    .ma-warn {
      margin-top: var(--space-5);
      border: 1px solid color-mix(in srgb, var(--neg) 38%, var(--rule-c));
      border-radius: var(--radius-card);
      background: var(--ground);
      padding: var(--space-4) var(--space-5);
    }
    .ma-warn__tag { display: block; margin-bottom: var(--space-2); font-size: var(--text-label); font-weight: 700; color: var(--neg); }
    .ma-warn p { font-size: var(--text-small); line-height: 1.6; color: var(--fg); max-width: 68ch; }

    /* --- why brands stay --------------------------------------------------- */
    .ma-why { display: grid; gap: var(--space-3); }
    @media (min-width: 760px) { .ma-why { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    .ma-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.4rem var(--space-3);
      border: 1px solid color-mix(in srgb, var(--accent-graphic) 34%, transparent);
      border-radius: 999px;
      background: var(--accent-wash);
      font-size: var(--text-small);
      font-weight: 600;
      color: var(--accent-text);
    }
    .ma-badge__ico { display: grid; place-items: center; color: var(--accent-graphic); }
    .ma-why__item {
      display: flex;
      gap: var(--space-3);
      padding: var(--space-4);
      border: 1px solid var(--rule-c);
      border-radius: var(--radius-card);
      background: var(--ground);
    }
    .ma-why__ico {
      flex: none;
      display: grid;
      place-items: center;
      width: 36px;
      height: 36px;
      border-radius: var(--radius-input);
      background: var(--accent-wash);
      color: var(--accent-graphic);
    }
    .ma-why__t { font-size: var(--text-small); font-weight: 700; color: var(--fg); line-height: 1.3; }
    .ma-why__b { margin-top: var(--space-1); font-size: var(--text-small); line-height: 1.55; color: var(--fg-muted); }

    /* --- category chips --------------------------------------------------- */
    .ma-cats { display: flex; flex-wrap: wrap; gap: var(--space-1); }
    .ma-cat {
      padding: 0.45rem var(--space-3);
      border: 1px solid var(--rule-c);
      border-radius: 999px;
      background: var(--ground);
      font-size: var(--text-small);
      color: var(--fg-muted);
    }
    /* The four largest by spend carry the accent; the rest are quieter. The
       copy draws that line, so the styling repeats information rather than
       inventing a hierarchy. */
    .ma-cat--lead {
      border-color: color-mix(in srgb, var(--accent-graphic) 42%, transparent);
      background: var(--accent-wash);
      color: var(--accent-text);
      font-weight: 600;
    }
  </style>
</BaseLayout>
