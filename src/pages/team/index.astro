---
/**
 * /team/ — the four co-founders. See 02 §2, 03 §1.3 (Person per member).
 * The old /elementor-6312/ 301s here (02 §7). Photos pending → initials tile.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Meta from '@/components/seo/Meta.astro';
import SchemaGraph from '@/components/seo/SchemaGraph.astro';
import Section from '@/components/primitives/Section.astro';
import CtaBand from '@/components/blocks/CtaBand.astro';
import { PARTNERS } from '@/lib/team';
import { base, webPage, breadcrumbs, person } from '@/lib/schema';

const url = '/team/';
const title = 'Meet the Team Behind Scaling Socials | Co-founders';
const description =
  'Meet the four co-founders of Scaling Socials — paid media, ecommerce growth, web and brand — the team behind an omni-channel D2C growth agency in Bangalore.';
const modified = '2026-09-04';

const nodes = [
  ...base(),
  webPage({ url, name: title, description, hasBreadcrumb: true, dateModified: modified }),
  breadcrumbs(url, [{ name: 'Home', url: '/' }, { name: 'Team', url }]),
  ...PARTNERS.map((p) => person({ slug: p.slug, name: p.name, jobTitle: p.role, linkedin: p.linkedin, description: p.bio })),
];
---

<BaseLayout>
  <Meta slot="meta" title={title} description={description} type="website" modifiedTime={modified} />
  <SchemaGraph slot="schema" nodes={nodes} />

  <Section size="lg">
    <span class="ss-eyebrow">The team</span>
    <h1 class="max-w-[18ch]">Four founders, four disciplines, one team</h1>
    <p class="mt-[var(--space-4)] max-w-[56ch] text-h4 leading-[1.5] text-[var(--fg)]">
      Scaling Socials is run by its four co-founders, not by account managers you never meet. Between
      them they cover paid media, ecommerce growth, web and finance, and brand, so your account has
      the full range under one roof.
    </p>
  </Section>

  <Section size="md">
    <ul class="grid gap-[var(--space-4)] sm:grid-cols-2">
      {PARTNERS.map((p) => (
        <li id={p.slug} class="flex gap-[var(--space-4)] rounded-[var(--radius-card)] border border-[var(--rule-c)] bg-[var(--ground)] p-[var(--space-5)]">
          <div class="grid h-[72px] w-[72px] shrink-0 place-items-center rounded-[var(--radius-card)] bg-[var(--accent-wash)] text-h3 font-semibold text-[var(--accent-text)]" aria-hidden="true">
            {p.name.split(' ').map((w) => w[0]).join('').slice(0, 2)}
          </div>
          <div class="flex flex-col gap-[var(--space-1)]">
            <h2 class="text-h4 font-semibold text-[var(--fg)]">{p.name}</h2>
            <p class="text-small font-medium text-[var(--accent-text)]">{p.role} — {p.focus}</p>
            <p class="mt-[var(--space-1)] text-small leading-relaxed text-[var(--fg-muted)]">{p.bio}</p>
            <a href={p.linkedin} target="_blank" rel="noopener" class="mt-[var(--space-1)] w-fit text-small font-medium text-[var(--accent-text)]">LinkedIn</a>
          </div>
        </li>
      ))}
    </ul>
  </Section>

  <Section register="ink" size="md">
    <CtaBand heading="Work with the founders, not a middle layer" body="A written audit in three working days, whether or not you hire us." ctaLabel="Get a free growth plan" ctaHref="/audit/" secondaryLabel="Contact us" secondaryHref="/contact/" />
  </Section>

  <style>.ss-eyebrow { display: inline-block; margin-bottom: var(--space-2); font-size: var(--text-label); font-weight: 600; color: var(--accent-text); }</style>
</BaseLayout>
