---
/**
 * /case-studies/ — proof index as a plain grid of live-thumbnail cards, strongest
 * proof first (INDEX_ORDER). Each card previews its page's real hero visual via
 * CaseVisual variant="thumb", fed from the same data object, so a thumbnail can
 * never drift from its page. No client is named anywhere; the verifiability line
 * does the work the names used to do.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Meta from '@/components/seo/Meta.astro';
import SchemaGraph from '@/components/seo/SchemaGraph.astro';
import Section from '@/components/primitives/Section.astro';
import AnswerBlock from '@/components/blocks/AnswerBlock.astro';
import CtaBand from '@/components/blocks/CtaBand.astro';
import Button from '@/components/primitives/Button.astro';
import HeroMotif from '@/components/graphics/HeroMotif.astro';
import CaseVisual from '@/components/casestudy/CaseVisual.astro';
import { ARCHETYPES, CASE_STUDIES_ORDERED, CASE_STUDY_TOTALS } from '@/lib/caseStudies';
import { base, webPage, breadcrumbs } from '@/lib/schema';

const url = '/case-studies/';
const title = 'Case Studies: Real D2C Ad Account Results | Scaling Socials';
const description =
  "Seven real ad accounts Scaling Socials runs for Indian D2C brands: ₹2.77 crore tracked revenue on ₹42.1 lakh ad spend, and every account's worst month.";
const modified = '2026-09-05';

// Short, honest kicker per study — our voice, one line under the headline.
const KICKERS: Record<string, string> = {
  'wellness-brand-zero-to-scale': 'The two months most agencies edit out.',
  'womenswear-breaking-the-ceiling': 'Past a ceiling it sat under for a year.',
  'kids-accessories-seven-month-floor': 'A floor a brand can actually plan around.',
  'womens-fashion-account-turnaround': 'Same account. Three times the return.',
  'gifting-brand-new-concept-launch': 'Scaled up and got more efficient.',
  'indo-western-launch-90-days': 'Zero pixel data to a scalable winner.',
  'kidswear-campaign-longevity': 'One campaign, eight months, no rebuild.',
};

// Colours come from CSS classes (ss-cscard--c0..c6) below, NOT inline styles:
// the site's hash-based CSP has no 'unsafe-inline', so inline style attributes
// are stripped by the browser. `colorIndex` picks the class.
const cards = CASE_STUDIES_ORDERED.map((c, i) => ({
  study: c,
  arch: ARCHETYPES[c.archetype].label,
  bigStat: c.delta ? c.delta.after : c.held ? c.held.value : c.stats[0]!.value,
  colorIndex: i % 7,
  kicker: KICKERS[c.slug] ?? '',
}));

const totals = [
  { value: CASE_STUDY_TOTALS.revenue, label: 'Revenue tracked across these accounts' },
  { value: CASE_STUDY_TOTALS.spend, label: 'Ad spend managed' },
  { value: CASE_STUDY_TOTALS.roas, label: 'Blended return on ad spend' },
  { value: CASE_STUDY_TOTALS.accounts, label: 'Accounts documented in full' },
];

const nodes = [
  ...base(),
  webPage({ url, name: title, description, hasBreadcrumb: true, dateModified: modified }),
  breadcrumbs(url, [{ name: 'Home', url: '/' }, { name: 'Case studies', url }]),
];
---

<BaseLayout>
  <Meta slot="meta" title={title} description={description} type="website" modifiedTime={modified} />
  <SchemaGraph slot="schema" nodes={nodes} />

  <Section size="lg">
    <div class="grid gap-[var(--space-8)] lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div>
        <span class="ss-eyebrow">Proof</span>
        <h1 class="max-w-[20ch]">Seven accounts, and the worst month of each</h1>
        <AnswerBlock class="mt-[var(--space-4)]">
          Scaling Socials runs paid media for D2C and ecommerce brands across India and the UAE. The
          seven accounts here produced ₹2.77 crore in tracked revenue on ₹42.1 lakh of ad spend, a
          blended 6.58x return. Every figure comes from the client’s own ad account, and every case
          study names its softest month.
        </AnswerBlock>
        <div class="mt-[var(--space-6)] flex flex-wrap gap-[var(--space-2)]">
          <Button href="/audit/" variant="primary">Get a free growth plan</Button>
          <Button href="/contact/" variant="secondary">Talk to us</Button>
        </div>
      </div>
      <div class="hidden lg:block"><HeroMotif variant="growth" /></div>
    </div>
  </Section>

  <!-- ink · the verified aggregate -->
  <Section register="ink" size="md">
    <ul class="ss-totals grid grid-cols-2 gap-px lg:grid-cols-4">
      {totals.map((t) => (
        <li class="flex flex-col gap-[0.25rem] bg-[var(--ground)] p-[var(--space-5)]">
          <span class="display-type text-data-sm font-bold leading-none text-[var(--fg)]" data-num data-countup>{t.value}</span>
          <span class="text-label text-[var(--fg-muted)]">{t.label}</span>
        </li>
      ))}
    </ul>
    <p class="mt-[var(--space-4)] max-w-[62ch] text-small text-[var(--fg-muted)]">
      This is the sum of the seven accounts on this page and nothing else — not a lifetime agency
      figure. Every rupee traces back to a client ad account we can produce on request.
    </p>
  </Section>

  <!-- the grid of live-thumbnail cards -->
  <Section size="md">
    <span class="ss-eyebrow">The accounts</span>
    <h2 class="max-w-[24ch] text-h2 font-semibold">Real result tables, not thumbnails of nothing</h2>
    <ul class="ss-csgrid mt-[var(--space-6)] grid gap-[var(--space-4)] md:grid-cols-2 lg:grid-cols-3">
      {cards.map((c) => (
        <li>
          <a
            href={`/case-studies/${c.study.slug}/`}
            class:list={['ss-cscard group no-underline', `ss-cscard--c${c.colorIndex}`]}
          >
            <!-- chart recoloured to the card's own foreground: texture, not a chart box -->
            <div class="ss-cscard__thumb" aria-hidden="true"><CaseVisual visual={c.study.heroVisual} variant="thumb" /></div>
            <div class="ss-cscard__inner">
              <span class="ss-cscard__chip">{c.study.niche} · {c.arch}</span>
              <h3 class="ss-cscard__headline">{c.study.headline}</h3>
              {c.kicker && <span class="ss-cscard__kicker">{c.kicker}</span>}
              <span class="ss-cscard__stat display-type" data-num>{c.bigStat}</span>
              <span class="ss-cscard__foot" data-num>
                <span class="ss-cscard__meta">{c.study.channels} · {c.study.period}</span>
                <span class="ss-cscard__read">Read<svg class="ss-cscard__go" width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <!-- paper · why there are no names -->
  <Section size="sm" class="!bg-[var(--surface-c)]">
    <div class="rounded-[var(--radius-card)] border border-[var(--rule-c)] bg-[var(--ground)] p-[var(--space-5)]">
      <h2 class="text-h4 font-semibold text-[var(--fg)]">Why these brands aren’t named</h2>
      <p class="mt-[var(--space-2)] max-w-[68ch] text-small leading-relaxed text-[var(--fg-muted)]">
        These are high-performing accounts in competitive categories, and publishing the brand names
        would hand their competitors a target list. Each account is identified by its niche and its
        situation instead. The numbers, periods and channels are unchanged, and we will verify any
        account on this page under NDA on a call.
      </p>
    </div>
  </Section>

  <Section register="ink" size="md">
    <CtaBand
      heading="Want your account to read like one of these?"
      body="Send us your numbers and you get a written audit in three working days, whether or not you hire us."
      ctaLabel="Get a free growth plan"
      ctaHref="/audit/"
      secondaryLabel="Contact us"
      secondaryHref="/contact/"
    />
  </Section>

  <script>
    import '@/scripts/caseviz.ts';
  </script>

  <style>
    .ss-eyebrow { display: inline-block; margin-bottom: var(--space-2); font-size: var(--text-label); font-weight: 600; color: var(--accent-text); }
    .ss-totals { background: var(--rule-c); border: 1px solid var(--rule-c); }

    /* Editorial poster card: a solid colour, big headline, the big stat as hero,
       and the case-study chart recoloured to the card's foreground as texture. */
    .ss-cscard {
      position: relative;
      display: block;
      min-height: 420px;
      height: 100%;
      border-radius: 18px;               /* poster radius — intentional for this card */
      background: var(--card-bg, var(--surface-c));
      color: var(--card-fg, var(--fg));
      overflow: hidden;
      isolation: isolate;
      transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
    }
    /* Colour posters — set via classes (CSP blocks inline style attributes). */
    .ss-cscard--c0 { --card-bg: #14141A; --card-fg: #ECECEE; } /* ink */
    .ss-cscard--c1 { --card-bg: #4F52DB; --card-fg: #FFFFFF; } /* periwinkle */
    .ss-cscard--c2 { --card-bg: #ECE4D6; --card-fg: #23201A; } /* warm sand */
    .ss-cscard--c3 { --card-bg: #17544F; --card-fg: #EAF3F1; } /* deep teal */
    .ss-cscard--c4 { --card-bg: #F3D9DE; --card-fg: #4A2230; } /* blush */
    .ss-cscard--c5 { --card-bg: #3B2E63; --card-fg: #EDE9F7; } /* plum */
    .ss-cscard--c6 { --card-bg: #F2E3A8; --card-fg: #3A3212; } /* butter */
    /* the chart, bleeding along the bottom, recoloured to the card's own tone */
    .ss-cscard__thumb {
      position: absolute;
      inset: auto 0 0 0;
      height: 52%;
      opacity: 0.55;
      pointer-events: none;
      z-index: 0;
      -webkit-mask-image: linear-gradient(180deg, transparent, #000 42%);
              mask-image: linear-gradient(180deg, transparent, #000 42%);
      /* recolour every series token to the card foreground (variables inherit) */
      --accent-graphic: color-mix(in srgb, var(--card-fg) 90%, transparent);
      --accent-graphic-2: color-mix(in srgb, var(--card-fg) 52%, transparent);
      --accent-fill: var(--card-fg);
      --accent-wash: color-mix(in srgb, var(--card-fg) 10%, transparent);
      --pos: var(--card-fg);
      --neg: color-mix(in srgb, var(--card-fg) 66%, transparent);
      --rule-c: color-mix(in srgb, var(--card-fg) 22%, transparent);
      --ground: var(--card-bg);
      --surface-c: transparent;
      --fg: var(--card-fg);
      --fg-muted: color-mix(in srgb, var(--card-fg) 60%, transparent);
    }
    .ss-cscard__thumb :global(.cv) { border: 0; border-radius: 0; background: transparent; padding: 0 var(--space-4); }
    .ss-cscard__thumb :global(.cv__svg) { height: 100%; }

    .ss-cscard__inner {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      height: 100%;
      min-height: 420px;
      padding: var(--space-5);
    }
    .ss-cscard__chip {
      font-size: var(--text-label);
      font-weight: 600;
      letter-spacing: 0.02em;
      color: color-mix(in srgb, var(--card-fg) 72%, transparent);
    }
    .ss-cscard__headline {
      margin-top: var(--space-3);
      max-width: 18ch;
      font-family: var(--font-display);
      font-size: clamp(1.375rem, 1.5vw + 1rem, 1.75rem);
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.02em;
      color: var(--card-fg);
      text-wrap: balance;
    }
    .ss-cscard__kicker {
      margin-top: var(--space-2);
      font-size: var(--text-small);
      color: color-mix(in srgb, var(--card-fg) 78%, transparent);
    }
    .ss-cscard__stat {
      margin-top: var(--space-4);
      font-size: clamp(2.25rem, 3vw, 3rem);
      font-weight: 700;
      line-height: 1;
      letter-spacing: -0.03em;
      color: var(--card-fg);
      font-variant-numeric: tabular-nums;
    }
    .ss-cscard__foot {
      margin-top: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-2);
      padding-top: var(--space-4);
      font-size: var(--text-label);
      color: color-mix(in srgb, var(--card-fg) 64%, transparent);
    }
    .ss-cscard__read {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-weight: 600;
      color: var(--card-fg);
    }
    .ss-cscard__go { transition: transform var(--dur-fast) var(--ease-out); }
    @media (prefers-reduced-motion: no-preference) {
      .ss-cscard { will-change: transform; }
      .ss-cscard:hover { transform: translateY(-5px); box-shadow: 0 34px 60px -34px color-mix(in srgb, var(--card-bg) 80%, #000); }
      .ss-cscard:hover .ss-cscard__go { transform: translateX(4px); }
      .ss-cscard:hover .ss-cscard__thumb { opacity: 1; }
    }
  </style>
</BaseLayout>
