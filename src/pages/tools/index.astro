---
/**
 * /tools/ — index of the free calculators. See 02 §1 (TOOLS).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Meta from '@/components/seo/Meta.astro';
import SchemaGraph from '@/components/seo/SchemaGraph.astro';
import Section from '@/components/primitives/Section.astro';
import CtaBand from '@/components/blocks/CtaBand.astro';
import Glyph from '@/components/graphics/Glyph.astro';
import PanelMotif from '@/components/graphics/PanelMotif.astro';
import { base, webPage, breadcrumbs } from '@/lib/schema';

const url = '/tools/';
const title = 'Free D2C Marketing Tools and Calculators | Scaling Socials';
const description =
  'Free calculators for D2C and ecommerce founders from Scaling Socials — work out your break-even ROAS, CAC payback and ad budget, with the maths explained.';
const modified = '2026-09-04';

const tools = [
  { name: 'Break-even ROAS calculator', desc: 'The return on ad spend you need before an order makes money, from your AOV and margin.', href: '/tools/break-even-roas-calculator/', live: true, icon: 'gauge' },
  { name: 'D2C CAC payback calculator', desc: 'How long it takes to earn back the cost of acquiring a customer, from CAC, AOV, margin and repeat rate.', href: '/tools/d2c-cac-payback-calculator/', live: true, icon: 'handshake' },
  { name: 'Meta ads budget planner', desc: 'Split a monthly budget into testing and scaling, and see fundable test cells and estimated orders.', href: '/tools/meta-ads-budget-planner/', live: true, icon: 'target' },
  { name: 'Shopify speed grader', desc: 'Grade your LCP against Core Web Vitals and model the revenue of reaching the 2.5s target.', href: '/tools/shopify-speed-grader/', live: true, icon: 'speed' },
];

const nodes = [...base(), webPage({ url, name: title, description, hasBreadcrumb: true, dateModified: modified }), breadcrumbs(url, [{ name: 'Home', url: '/' }, { name: 'Tools', url }])];
---

<BaseLayout>
  <Meta slot="meta" title={title} description={description} type="website" modifiedTime={modified} />
  <SchemaGraph slot="schema" nodes={nodes} />

  <Section size="lg">
    <div class="grid gap-[var(--space-8)] lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div>
        <span class="ss-eyebrow">Free tools</span>
        <h1 class="max-w-[18ch]">Free calculators for D2C founders</h1>
        <p class="mt-[var(--space-4)] max-w-[54ch] text-h4 leading-[1.5] text-[var(--fg)]">
          Simple, honest calculators with the maths shown and no email wall. Built by Scaling Socials
          for the numbers a D2C operator actually needs to know.
        </p>
      </div>
      <div class="hidden lg:block"><PanelMotif label="tools.scalingsocials" tag="Break-even" /></div>
    </div>
    <ul class="mt-[var(--space-8)] grid gap-[var(--space-3)] sm:grid-cols-2">
      {tools.map((t) => (
        <li>
          <a href={t.live ? t.href : '#'} class:list={['group flex h-full flex-col gap-[var(--space-2)] rounded-[var(--radius-card)] border border-[var(--rule-c)] bg-[var(--ground)] p-[var(--space-5)] no-underline', !t.live && 'pointer-events-none opacity-60']}>
            <div class="flex items-center justify-between gap-[var(--space-2)]">
              <span class="ss-tool-glyph"><Glyph name={t.icon} size={22} /></span>
              {!t.live && <span class="rounded-full border border-[var(--rule-c)] px-[0.6rem] py-[0.1rem] text-label text-[var(--fg-muted)]">Soon</span>}
            </div>
            <h2 class="text-h4 font-semibold text-[var(--fg)] group-hover:text-[var(--accent-text)]">{t.name}</h2>
            <p class="text-small leading-relaxed text-[var(--fg-muted)]">{t.desc}</p>
            {t.live && <span class="mt-auto text-small font-medium text-[var(--accent-text)]">Open the calculator</span>}
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Section register="ink" size="md">
    <CtaBand heading="Want the numbers run for your brand?" body="A written audit in three working days, whether or not you hire us." ctaLabel="Get a free growth plan" ctaHref="/audit/" />
  </Section>

  <style>
    .ss-eyebrow { display: inline-block; margin-bottom: var(--space-2); font-size: var(--text-label); font-weight: 600; color: var(--accent-text); }
    .ss-tool-glyph {
      display: grid; place-items: center; width: 44px; height: 44px;
      border-radius: var(--radius-input); color: var(--accent-graphic);
      background: var(--accent-wash);
      border: 1px solid color-mix(in srgb, var(--accent-graphic) 22%, transparent);
    }
  </style>
</BaseLayout>
