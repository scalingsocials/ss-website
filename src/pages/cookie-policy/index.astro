---
import LegalLayout from '@/layouts/LegalLayout.astro';
import { ORG } from '@/lib/schema/entity';
const url = '/cookie-policy/';
const title = 'Cookie Policy | Scaling Socials Media LLP Bangalore';
const description =
  'How Scaling Socials uses cookies and similar technologies on our website — essential and analytics cookies, the tools we use, and how you can control them.';
---
<LegalLayout url={url} title={title} description={description} heading="Cookie Policy" updated="4 September 2026">
  <p>This policy explains how {ORG.legalName} (“Scaling Socials”) uses cookies and similar technologies on {ORG.url}. It should be read with our <a href="/privacy/">privacy policy</a>.</p>

  <h2>What cookies are</h2>
  <p>Cookies are small text files a website stores on your device. They let the site work properly, remember your preferences, and help us understand how the site is used.</p>

  <h2>The cookies we use</h2>
  <p><strong>Essential.</strong> Needed for the site to function — for example, remembering a form draft you started or your cookie choices. These cannot be switched off.</p>
  <p><strong>Analytics.</strong> Help us see which pages are useful and where visitors drop off, through tools such as Google Analytics and Microsoft Clarity. This data is aggregated and used to improve the site.</p>
  <p><strong>Advertising and measurement.</strong> Where enabled, tools from Meta and Google help us measure the performance of our own campaigns. We prefer server-side measurement and keep client-side tracking to a minimum.</p>

  <h2>Controlling cookies</h2>
  <p>You can accept or decline non-essential cookies through the consent banner where shown, and you can clear or block cookies in your browser settings at any time. Blocking some cookies may affect how the site works.</p>

  <h2>Contact</h2>
  <p>Questions about cookies? Email <a href={`mailto:${ORG.email}`}>{ORG.email}</a>.</p>
</LegalLayout>
