---
/**
 * Home — brand + entity hub. See 08 §7 and 02 §4.
 *
 * Real, permissioned content throughout (owner confirmed): the three published
 * results, real client logos, real creatives, real testimonials. Colour comes
 * from alternating white/surface bands, periwinkle eyebrows and the ink chapter
 * breaks — so it reads as a designed page, not a document. Mobile-first: every
 * dense block (logos, creatives, testimonials) is a swipeable rail.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Meta from '@/components/seo/Meta.astro';
import SchemaGraph from '@/components/seo/SchemaGraph.astro';
import Section from '@/components/primitives/Section.astro';
import Hero from '@/components/Hero.astro';
import LogoWall from '@/components/blocks/LogoWall.astro';
import CreativeWall from '@/components/blocks/CreativeWall.astro';
import Teardowns from '@/components/blocks/Teardowns.astro';
import FounderNote from '@/components/blocks/FounderNote.astro';
import Testimonials from '@/components/blocks/Testimonials.astro';
import ClientVoice from '@/components/blocks/ClientVoice.astro';
import ProcessSteps from '@/components/blocks/ProcessSteps.astro';
import PricingBlock from '@/components/blocks/PricingBlock.astro';
import ComparisonTable from '@/components/blocks/ComparisonTable.astro';
import NotForYouBlock from '@/components/blocks/NotForYouBlock.astro';
import FaqAccordion from '@/components/blocks/FaqAccordion.astro';
import CtaBand from '@/components/blocks/CtaBand.astro';
import { SERVICE_PILLARS } from '@/lib/nav';
import { FEATURED_STUDIES, INDEX_ORDER, CASE_STUDY_KICKERS } from '@/lib/caseStudies';
import CaseStudyPoster from '@/components/blocks/CaseStudyPoster.astro';
import { professionalService, website, webPage, breadcrumbs, faqPage, ORG_ID } from '@/lib/schema';

// Homepage proof row uses the same editorial poster cards as /case-studies/.
// Each featured study keeps the colour it has on the index (by INDEX_ORDER
// position), so a card looks the same wherever it appears.
const featuredPosters = FEATURED_STUDIES.map((cs) => ({
  study: cs,
  colorIndex: (INDEX_ORDER as readonly string[]).indexOf(cs.slug) % 7,
  kicker: CASE_STUDY_KICKERS[cs.slug] ?? '',
}));

const title = 'Ecommerce Growth & Ads Agency Bangalore | Scaling Socials';
const description =
  'Scaling Socials is an omni-channel ecommerce growth agency in Bangalore: Meta and Google Ads, Shopify, SEO and CRO for D2C brands in India and the UAE.';
const published = '2026-09-01';
const modified = '2026-09-04';

// Simple line icons per service pillar.
const ICONS: Record<string, string> = {
  'Performance marketing': 'M4 19V5M4 19h16M7 15l3-3 3 2 4-6',
  'SEO': 'M10.5 4a6.5 6.5 0 1 0 4.9 10.8M20 20l-4.6-4.6',
  'Shopify development': 'M6 8h12l-1 11H7L6 8Zm3 0a3 3 0 0 1 6 0',
  'Web development': 'M8.5 9 5 12l3.5 3M15.5 9 19 12l-3.5 3M13 7l-2 10',
  'Social media marketing': 'M5 6h14v9h-8l-4 3.5V6Z',
  'Conversion rate optimisation': 'M4 5h16l-6 7v5l-4 2v-7L4 5Z',
};

const problems = [
  'I can’t tell which campaigns are actually making money.',
  'My agency reports a ROAS that never shows up in my bank account.',
  'We keep boosting spend, but the CAC climbs faster than revenue.',
  'Nobody has looked at my store’s checkout in months.',
];

const steps = [
  { title: 'Audit', body: 'We read your ad accounts and your store, and find where spend leaks and where it can scale.' },
  { title: 'Plan', body: 'A 30-60-90 plan: the first things we would change, in order, with the reasoning.' },
  { title: 'Build', body: 'Campaign structure, creative angles and landing pages, built so they can be tested against real margins.' },
  { title: 'Test', body: 'We test creative and audiences against your break-even ROAS, not a generic benchmark.' },
  { title: 'Scale', body: 'What works gets budget, what doesn’t gets cut, and then we run the loop again. Every month.' },
];

const comparisonCols = ['', 'In-house hire', 'Freelancer', 'Scaling Socials'];
const comparisonRows = [
  ['What you get', 'One skill set', 'One skill set', 'Media, creative, CRO and dev in one team'],
  ['Ramp time', 'A month or more', 'Days', 'About a week'],
  ['Accountability', 'Yours to manage', 'Varies', 'One team, one number'],
  ['Creative', 'Depends on the hire', 'Rarely', 'Produced in-house, tested weekly'],
  ['Best when', 'Spend is large and steady', 'Scope is small and defined', 'You need to build, test and scale'],
  ['Not for you if', 'You need breadth fast', 'You need accountability', 'You only want the cheapest option'],
];

const value = {
  lede: 'A full growth department across ads, SEO, Shopify, creative and CRO, under one team instead of five separate hires.',
  included: [
    'A senior team across media, creative, SEO, store and CRO',
    'Ad creative and content edited and produced in-house from your footage, tested weekly',
    'Everything run against your real margins, not vanity metrics',
    'One team accountable to one number, and never a markup on your ad spend',
  ],
  note: 'Every service is scoped to your brand and stage, tell us what you need and we will map the engagement out with you.',
};

const notForYou = [
  'Pre-launch brands with no data to audit. We can’t audit an empty account.',
  'Anyone wanting a free strategy they’ll hand to a cheaper agency. We’d rather say no.',
  'Anyone after a guaranteed ROAS number. We work to your margins and won’t promise a figure we can’t control.',
];

const faqItems = [
  { q: 'How does performance marketing pricing work in India?', a: 'We scope every engagement to the brand rather than a fixed package, it depends on your monthly ad spend, how many platforms you run, and how much creative you need produced. Whatever the scope, your ad spend is separate and paid directly to the platforms; we never mark it up.' },
  { q: 'Do you work with brands outside India?', a: 'Scaling Socials works with D2C and ecommerce brands across India and the UAE. UAE engagements account for the local platform mix, VAT on ad spend, and seasonality like Ramadan and DSF, rather than being a copy of the India playbook.' },
  { q: 'What do you need from me to get started?', a: 'Read-only access to your Meta Ads, Google Ads, and Shopify or GA4, plus a 20-minute call on what you sell and what your margins are. From there the first audit takes three working days.' },
  { q: 'What makes you different from other agencies?', a: 'Scaling Socials works to your P&L, not to platform-reported ROAS. We tell you when not to hire us, hand you an audit you could take to another agency, and keep media, creative, store and CRO on one team. We also publish honest public teardowns of real D2C brands.' },
];

const schemaNodes = [
  professionalService(),
  website(),
  webPage({ url: '/', name: title, description, aboutId: ORG_ID, hasBreadcrumb: true, datePublished: published, dateModified: modified }),
  breadcrumbs('/', [{ name: 'Home', url: '/' }]),
  faqPage('/', faqItems),
];

const eyebrow = 'ss-eyebrow';
const surface = '!bg-[var(--surface-c)]';
---

<BaseLayout heroOver>
  <Meta slot="meta" title={title} description={description} type="website" modifiedTime={modified} />
  <SchemaGraph slot="schema" nodes={schemaNodes} />

  <!-- HERO (ink) -->
  <Hero />

  <!-- TRUST: client logo marquee (paper). Official partners now live in the hero. -->
  <Section size="sm" data-reveal>
    <LogoWall heading="Brands we work with" />
  </Section>

  <!-- SERVICES (surface) -->
  <Section id="services" size="md" class={surface} data-reveal>
    <div class="grid gap-[var(--space-4)] md:grid-cols-[1fr_1fr] md:items-end">
      <div>
        <span class={eyebrow}>What we do</span>
        <h2 class="max-w-[16ch] text-h2 font-semibold">Everything a brand needs to grow</h2>
      </div>
      <p class="max-w-[52ch] text-body text-[var(--fg-muted)] md:justify-self-end">
        Six services, one team: paid media, SEO, Shopify and web, social and CRO. We grow D2C and
        ecommerce brands, and run lead generation for B2B and service businesses too.
      </p>
    </div>
    <ul class="mt-[var(--space-6)] grid gap-[var(--space-3)] sm:grid-cols-2 lg:grid-cols-3">
      {SERVICE_PILLARS.map((s) => (
        <li>
          <a href={s.href} class="ss-svc-card group relative flex h-full flex-col gap-[var(--space-2)] overflow-hidden rounded-[var(--radius-card)] border border-[var(--rule-c)] bg-[var(--ground)] p-[var(--space-4)] no-underline">
            <span class="ss-svc-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d={ICONS[s.label]} stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
            <h3 class="text-h4 font-semibold text-[var(--fg)] group-hover:text-[var(--accent-text)]">{s.label}</h3>
            <p class="text-small leading-relaxed text-[var(--fg-muted)]">{s.descriptor}</p>
            <span class="mt-auto inline-flex items-center gap-[0.35rem] pt-[var(--space-2)] text-small font-medium text-[var(--accent-text)]">
              Explore
              <svg class="ss-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <!-- CREATIVE WALL (ink) -->
  <Section register="ink" size="md" data-reveal>
    <span class={eyebrow}>Creative</span>
    <div class="flex flex-wrap items-end justify-between gap-[var(--space-3)]">
      <h2 class="max-w-[22ch] text-h2 font-semibold">Creative built to be tested</h2>
      <a href="/work/" class="ss-link-arrow inline-flex items-center gap-[0.35rem] text-small font-medium text-[var(--accent-text)] no-underline">
        See the full wall
        <svg class="ss-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
    <p class="mt-[var(--space-2)] mb-[var(--space-6)] max-w-[58ch] text-body text-[var(--fg-muted)]">
      We edit and produce ad creative in-house, both statics and video, from footage brands send us.
      Real client work, the kind nobody else in the industry shows at volume.
    </p>
    <CreativeWall variant="marquee" limit={12} />
  </Section>

  <!-- CASE STUDIES (paper) — real, permissioned results -->
  <Section size="md" data-reveal>
    <span class={eyebrow}>Proof</span>
    <div class="flex flex-wrap items-end justify-between gap-[var(--space-3)]">
      <h2 class="max-w-[20ch] text-h2 font-semibold">Real revenue, on the board</h2>
      <a href="/case-studies/" class="ss-link-arrow inline-flex items-center gap-[0.35rem] text-small font-medium text-[var(--accent-text)] no-underline">
        All case studies
        <svg class="ss-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
    <ul class="mt-[var(--space-6)] grid gap-[var(--space-4)] sm:grid-cols-3">
      {featuredPosters.map((c) => (
        <li>
          <CaseStudyPoster study={c.study} colorIndex={c.colorIndex} kicker={c.kicker} />
        </li>
      ))}
    </ul>
  </Section>

  <!-- TESTIMONIALS (soft pastel band — periwinkle→teal) -->
  <Section size="md" class="home-tst" data-reveal>
    <span class={eyebrow}>In their words</span>
    <h2 class="max-w-[22ch] text-h2 font-semibold">What our clients say</h2>
    <p class="mt-[var(--space-2)] mb-[var(--space-6)] max-w-[56ch] text-body text-[var(--fg-muted)]">
      Real brands, across ads, Shopify and web. Swipe through.
    </p>
    <Testimonials />
  </Section>

  <!-- CLIENT VOICE (paper) — compact -->
  <Section size="sm" data-reveal>
    <span class={eyebrow}>Sound familiar?</span>
    <h2 class="max-w-[24ch] text-h2 font-semibold">You have probably said one of these</h2>
    <div class="mt-[var(--space-5)]">
      <ClientVoice problems={problems} />
    </div>
  </Section>

  <!-- PROCESS (surface) -->
  <Section size="md" class={surface} data-reveal>
    <span class={eyebrow}>How it works</span>
    <h2 class="max-w-[20ch] text-h2 font-semibold">How an engagement runs</h2>
    <div class="mt-[var(--space-5)]">
      <ProcessSteps steps={steps} />
    </div>
  </Section>

  <!-- VALUE (paper) -->
  <Section size="md" data-reveal>
    <span class={eyebrow}>The value</span>
    <h2 class="max-w-[24ch] text-h2 font-semibold">What you get for your money</h2>
    <div class="mt-[var(--space-5)]">
      <PricingBlock lede={value.lede} included={value.included} note={value.note} />
    </div>
    <p class="mt-[var(--space-4)] text-body text-[var(--fg-muted)]">
      Want to see the maths on what a customer is worth to you?
      <a href="/tools/break-even-roas-calculator/" class="font-medium text-[var(--accent-text)]">Work out your break-even ROAS</a>.
    </p>
  </Section>

  <!-- COMPARISON (surface) -->
  <Section size="md" class={surface} data-reveal>
    <span class={eyebrow}>Honest comparison</span>
    <h2 class="max-w-[26ch] text-h2 font-semibold">In-house, freelancer, or agency?</h2>
    <p class="mt-[var(--space-2)] max-w-[60ch] text-body text-[var(--fg-muted)]">
      Sometimes the honest answer is not us. Here is when each option wins.
    </p>
    <div class="mt-[var(--space-5)]">
      <ComparisonTable columns={comparisonCols} rows={comparisonRows} highlightCol={3} />
    </div>
  </Section>

  <!-- TEARDOWNS (ink) -->
  <Section register="ink" size="md" data-reveal>
    <Teardowns />
  </Section>

  <!-- FAQ (paper) -->
  <Section size="md" data-reveal>
    <span class={eyebrow}>Questions</span>
    <h2 class="max-w-[20ch] text-h2 font-semibold">Questions founders ask</h2>
    <div class="mt-[var(--space-5)] max-w-[760px]">
      <FaqAccordion items={faqItems} openFirst />
    </div>
  </Section>

  <!-- FOUNDER + NOT FOR YOU (surface) -->
  <Section size="md" class={surface} data-reveal>
    <FounderNote />
    <div class="mt-[var(--space-8)] max-w-[640px] border-t border-[var(--rule-c)] pt-[var(--space-6)]">
      <NotForYouBlock items={notForYou} />
    </div>
  </Section>

  <!-- CTA BAND (ink) -->
  <Section register="ink" size="md" data-reveal>
    <CtaBand
      heading="Find out what is leaking money in your ads"
      body="Send us access and, within three working days, you get a written audit of what is working, what is not, and what we would change first, whether or not you hire us."
      ctaLabel="Get a free growth plan"
      ctaHref="/audit/"
      secondaryLabel="Talk to us"
      secondaryHref="/contact/"
    />
  </Section>

  <style>
    .ss-eyebrow {
      display: inline-block;
      margin-bottom: var(--space-2);
      font-size: var(--text-label);
      font-weight: 600;
      letter-spacing: 0.01em;
      color: var(--accent-text);
    }
    .ss-svc-icon {
      display: grid;
      place-items: center;
      width: 40px;
      height: 40px;
      border-radius: var(--radius-card);
      background: var(--accent-wash);
      color: var(--accent-text);
      margin-bottom: var(--space-1);
    }
    /* Cards lift on a crisp border + shadow. No fade-in overlay and no filter,
       so the text and background stay sharp through the transition. */
    .ss-svc-card {
      transform: translateZ(0);
      backface-visibility: hidden;
      transition: transform var(--dur-base) var(--ease-out),
                  border-color var(--dur-base) var(--ease-out),
                  box-shadow var(--dur-base) var(--ease-out);
    }
    @media (prefers-reduced-motion: no-preference) {
      .ss-svc-card:hover {
        transform: translateY(-4px);
        border-color: color-mix(in srgb, var(--accent-fill) 55%, var(--rule-c));
        box-shadow: 0 24px 50px -30px color-mix(in srgb, var(--accent-fill) 45%, transparent);
      }
    }
    .ss-arrow { transition: transform var(--dur-fast) var(--ease-out); }
    .ss-svc-card:hover .ss-arrow { transform: translateX(3px); }
    /* Inline text links (e.g. "All case studies") that carry a trailing arrow. */
    .ss-link-arrow { min-height: 44px; transition: gap var(--dur-fast) var(--ease-out); }
    .ss-link-arrow .ss-arrow { transition: transform var(--dur-fast) var(--ease-out); }
    .ss-link-arrow:hover .ss-arrow { transform: translateX(3px); }

    /* Sticky mini-CTA — shown by motion.ts once the hero scrolls out. */
    .ss-sticky-cta {
      position: fixed; left: 50%; bottom: calc(var(--space-3) + env(safe-area-inset-bottom, 0px)); transform: translate(-50%, 160%);
      z-index: 40; display: flex; align-items: center; gap: var(--space-3);
      border: 1px solid var(--rule-c); border-radius: 999px;
      background: color-mix(in srgb, var(--ground) 92%, transparent);
      -webkit-backdrop-filter: blur(12px) saturate(1.3);
      backdrop-filter: blur(12px) saturate(1.3);
      box-shadow: 0 16px 40px -20px color-mix(in srgb, var(--color-black) 55%, transparent);
      padding: 0.45rem 0.45rem 0.45rem var(--space-4);
      max-width: calc(100vw - 2 * var(--space-3));
      opacity: 0; visibility: hidden;
      transition: transform var(--dur-base) var(--ease-out), opacity var(--dur-base) var(--ease-out), visibility var(--dur-base);
    }
    .ss-sticky-cta.is-visible { transform: translate(-50%, 0); opacity: 1; visibility: visible; }
    .ss-sticky-cta__text { font-size: var(--text-small); color: var(--fg); white-space: nowrap; }
    @media (max-width: 640px) { .ss-sticky-cta__text { display: none; } }
    .ss-sticky-cta__btn {
      border-radius: 999px; background: var(--accent-fill); color: var(--accent-on);
      font-size: var(--text-small); font-weight: 600; text-decoration: none;
      padding: 0.55rem var(--space-3); white-space: nowrap;
    }

    /* Testimonials: a soft pastel periwinkle→teal band so the section reads warmer
       than the plain surface, while staying light (08 §5c: keep colour gentle). */
    .home-tst {
      background:
        radial-gradient(115% 90% at 100% 0%, color-mix(in srgb, var(--color-teal) 14%, transparent), transparent 62%),
        linear-gradient(180deg, color-mix(in srgb, var(--accent-fill) 10%, var(--ground)), color-mix(in srgb, var(--accent-fill) 5%, var(--ground)));
    }

    /* Mobile: the floating sticky CTA becomes a clean full-width button, not a
       button sitting inside a bordered pill (which read as a box on phones). */
    @media (max-width: 640px) {
      .ss-sticky-cta {
        left: var(--space-3); right: var(--space-3); max-width: none;
        transform: translateY(180%);
        padding: 0; border: none; background: transparent; box-shadow: none;
        -webkit-backdrop-filter: none; backdrop-filter: none;
      }
      .ss-sticky-cta.is-visible { transform: translateY(0); }
      .ss-sticky-cta__btn {
        width: 100%; text-align: center;
        border-radius: var(--radius-button);
        padding: 0.9rem var(--space-4); font-size: 0.95rem;
        box-shadow: 0 14px 34px -14px color-mix(in srgb, var(--accent-fill) 65%, transparent);
      }
    }
  </style>

  <div data-sticky-cta class="ss-sticky-cta">
    <span class="ss-sticky-cta__text">Free growth plan: a written audit in three working days.</span>
    <a href="/audit/" class="ss-sticky-cta__btn">Get a free growth plan</a>
  </div>
</BaseLayout>
