---
/**
 * Home — brand + entity hub. See 08-DESIGN-BRIEF.md §7 and 02 §4.
 *
 * Paper/ink rhythm with two ink chapter breaks (client wall, CTA). Everything
 * here is real or plainly derivable copy — no invented client names, metrics or
 * case studies (CLAUDE.md §15). The three headline stats, client logos and hero
 * deltas are still outstanding (11 §6), so those slots are left out rather than
 * faked; they drop in when the data lands.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Meta from '@/components/seo/Meta.astro';
import SchemaGraph from '@/components/seo/SchemaGraph.astro';
import Section from '@/components/primitives/Section.astro';
import Hero from '@/components/Hero.astro';
import PlatformStrip from '@/components/blocks/PlatformStrip.astro';
import CreativeWall from '@/components/blocks/CreativeWall.astro';
import CaseStudyTeaser from '@/components/blocks/CaseStudyTeaser.astro';
import BenchmarkTeaser from '@/components/blocks/BenchmarkTeaser.astro';
import FounderNote from '@/components/blocks/FounderNote.astro';
import ClientVoice from '@/components/blocks/ClientVoice.astro';
import ProcessSteps from '@/components/blocks/ProcessSteps.astro';
import PricingBlock from '@/components/blocks/PricingBlock.astro';
import ComparisonTable from '@/components/blocks/ComparisonTable.astro';
import NotForYouBlock from '@/components/blocks/NotForYouBlock.astro';
import FaqAccordion from '@/components/blocks/FaqAccordion.astro';
import CtaBand from '@/components/blocks/CtaBand.astro';
import { SERVICE_PILLARS } from '@/lib/nav';
import { professionalService, website, webPage, breadcrumbs, faqPage, ORG_ID } from '@/lib/schema';

const title = 'Performance Marketing Agency in Bangalore | Scaling Socials';
const description =
  'Scaling Socials manages Meta and Google Ads and builds Shopify stores for D2C brands in India and the UAE. Performance marketing from ₹25,000 a month.';

const published = '2026-09-01';
const modified = '2026-09-03';

const problems = [
  'I can’t tell which campaigns are actually making money.',
  'My agency reports a ROAS that never shows up in my bank account.',
  'We keep boosting spend, but the CAC climbs faster than revenue.',
  'Nobody has looked at my store’s checkout in months.',
];

const steps = [
  { title: 'Audit', body: 'Scaling Socials reads your ad accounts and your store, and finds where spend leaks and where it can scale.' },
  { title: 'Plan', body: 'A 30-60-90 plan: the first things we would change, in order, with the reasoning behind each one.' },
  { title: 'Build', body: 'Campaign structure, creative angles and landing pages, all built so they can be tested against real margins.' },
  { title: 'Test', body: 'We test creative and audiences against your break-even ROAS, not a generic benchmark that loses money.' },
  { title: 'Scale', body: 'What works gets budget, what doesn’t gets cut, and then we run the loop again. Every month.' },
];

const comparisonCols = ['', 'In-house hire', 'Freelancer', 'Scaling Socials'];
const comparisonRows = [
  ['Monthly cost', '₹80k–1.5L salary', '₹20k–60k', 'From ₹25k'],
  ['Ramp time', '1–3 months', 'Days', 'About a week'],
  ['Breadth', 'One skill set', 'One skill set', 'Media, creative, CRO, dev'],
  ['Accountability', 'Yours to manage', 'Varies', 'One team, one number'],
  ['Best when', 'Spend is large and steady', 'Scope is small and defined', 'You need to build, test and scale'],
  ['Not for you if', 'You need breadth fast', 'You need accountability', 'You want the cheapest option — a freelancer is cheaper'],
];

const pricing = {
  price: '₹25,000/month',
  lede: 'Where you land depends on your monthly ad spend. Managing ₹1L a month and managing ₹20L a month are different jobs — more campaigns, more creative, more testing.',
  factors: [
    'Monthly ad spend',
    'How many platforms you run',
    'How much creative you need produced each month',
    'Whether landing page and CRO work is in scope',
  ],
  note: 'Ad spend is separate and paid directly to the platforms. We never mark it up.',
};

const notForYou = [
  'Pre-launch brands with no data to audit. We can’t audit an empty account.',
  'Anyone wanting a free strategy they’ll hand to a cheaper agency. We’d rather say no.',
  'Service businesses and B2B lead gen. Not our specialism — we’ll refer you to someone better.',
];

const faqItems = [
  {
    q: 'How much does performance marketing cost in India?',
    a: 'Scaling Socials starts performance marketing at ₹25,000 a month. Where you land depends on your monthly ad spend, how many platforms you run, and how much creative you need produced. Ad spend is separate and paid directly to the platforms — we never mark it up.',
  },
  {
    q: 'Do you work with brands outside India?',
    a: 'Scaling Socials works with D2C and ecommerce brands across India and the UAE. UAE engagements account for the local platform mix, VAT on ad spend, and seasonality like Ramadan and DSF, rather than being a copy of the India playbook.',
  },
  {
    q: 'What do you need from me to get started?',
    a: 'Read-only access to your Meta Ads, Google Ads, and Shopify or GA4, plus a 20-minute call on what you sell and what your margins are. From there the first audit takes three working days.',
  },
  {
    q: 'What makes you different from other agencies?',
    a: 'Scaling Socials works to your P&L, not to platform-reported ROAS. We publish our pricing, tell you when not to hire us, and hand you an audit you could take to another agency. The India D2C Ad Benchmark Index is ours.',
  },
];

const schemaNodes = [
  professionalService(),
  website(),
  webPage({ url: '/', name: title, description, aboutId: ORG_ID, hasBreadcrumb: true, datePublished: published, dateModified: modified }),
  breadcrumbs('/', [{ name: 'Home', url: '/' }]),
  faqPage('/', faqItems),
];
---

<BaseLayout>
  <Meta slot="meta" title={title} description={description} type="website" modifiedTime={modified} />
  <SchemaGraph slot="schema" nodes={schemaNodes} />

  <!-- 1. HERO (ink, cinematic) -->
  <Hero />

  <!-- 2. PLATFORM STRIP (paper) -->
  <Section size="sm" data-reveal>
    <PlatformStrip />
  </Section>

  <!-- 3. SERVICES (paper) -->
  <Section id="services" size="md" data-reveal>
    <h2 class="max-w-[20ch] text-h2 font-semibold">What Scaling Socials runs for you</h2>
    <p class="mt-[var(--space-2)] max-w-[52ch] text-body text-[var(--fg-muted)]">
      Six services, one team. Media, creative, store build and CRO, run against your margins.
    </p>
    <ul class="mt-[var(--space-6)] grid gap-[var(--space-3)] sm:grid-cols-2 lg:grid-cols-3">
      {SERVICE_PILLARS.map((s, i) => (
        <li>
          <a
            href={s.href}
            class="ss-svc-card group relative flex h-full flex-col gap-[var(--space-2)] overflow-hidden rounded-[var(--radius-card)] border border-[var(--rule-c)] bg-[var(--ground)] p-[var(--space-4)] no-underline"
          >
            <span class="display-type text-small font-semibold text-[var(--accent-text)]" data-num>{String(i + 1).padStart(2, '0')}</span>
            <h3 class="text-h4 font-semibold text-[var(--fg)] group-hover:text-[var(--accent-text)]">{s.label}</h3>
            <p class="text-small leading-relaxed text-[var(--fg-muted)]">{s.descriptor}</p>
            <span class="mt-auto inline-flex items-center gap-[0.35rem] pt-[var(--space-2)] text-small font-medium text-[var(--accent-text)]">
              Explore
              <svg class="ss-svc-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <!-- 4. CREATIVE WALL (ink) -->
  <Section register="ink" size="md" data-reveal>
    <div class="mb-[var(--space-6)] flex flex-col gap-[var(--space-2)]">
      <h2 class="max-w-[22ch] text-h2 font-semibold">Creative that stops the scroll</h2>
      <p class="max-w-[56ch] text-body text-[var(--fg-muted)]">
        Video-led ads we produce in-house, built to be tested. Most agencies describe their
        creative work — this is ours, running.
      </p>
    </div>
    <CreativeWall />
  </Section>

  <!-- 5. CLIENT VOICE (paper) -->
  <Section size="md" data-reveal>
    <h2 class="max-w-[22ch] text-h2 font-semibold">You have probably said one of these</h2>
    <div class="mt-[var(--space-5)] max-w-[44ch]">
      <ClientVoice problems={problems} />
    </div>
  </Section>

  <!-- 6. CASE STUDIES (paper) -->
  <Section size="md" data-reveal>
    <div class="mb-[var(--space-6)] flex flex-wrap items-end justify-between gap-[var(--space-3)]">
      <h2 class="max-w-[20ch] text-h2 font-semibold">Results we can show you</h2>
      <a href="/case-studies/" class="text-small font-medium text-[var(--accent-text)] no-underline">All case studies</a>
    </div>
    <CaseStudyTeaser />
  </Section>

  <!-- 7. BENCHMARK INDEX (ink) -->
  <Section register="ink" size="lg" data-reveal>
    <BenchmarkTeaser />
  </Section>

  <!-- 5. PROCESS (paper) -->
  <Section size="md" data-reveal>
    <h2 class="max-w-[20ch] text-h2 font-semibold">How an engagement runs</h2>
    <div class="mt-[var(--space-5)]">
      <ProcessSteps steps={steps} />
    </div>
  </Section>

  <!-- 6. PRICING (paper) -->
  <Section size="md" data-reveal>
    <h2 class="max-w-[24ch] text-h2 font-semibold">What performance marketing costs</h2>
    <div class="mt-[var(--space-5)] max-w-[640px]">
      <PricingBlock {...pricing} />
    </div>
  </Section>

  <!-- 7. COMPARISON (paper) -->
  <Section size="md" data-reveal>
    <h2 class="max-w-[26ch] text-h2 font-semibold">In-house, freelancer, or agency?</h2>
    <p class="mt-[var(--space-2)] max-w-[60ch] text-body text-[var(--fg-muted)]">
      Sometimes the honest answer is not us. Here is when each option wins.
    </p>
    <div class="mt-[var(--space-5)]">
      <ComparisonTable columns={comparisonCols} rows={comparisonRows} highlightCol={3} />
    </div>
  </Section>

  <!-- FOUNDER (paper) -->
  <Section size="md" data-reveal>
    <FounderNote />
  </Section>

  <!-- FAQ (paper) -->
  <Section size="md" data-reveal>
    <h2 class="max-w-[20ch] text-h2 font-semibold">Questions founders ask</h2>
    <div class="mt-[var(--space-5)] max-w-[760px]">
      <FaqAccordion items={faqItems} openFirst />
    </div>
  </Section>

  <!-- 9. NOT FOR YOU (paper) -->
  <Section size="md" data-reveal>
    <div class="max-w-[640px]">
      <NotForYouBlock items={notForYou} />
    </div>
  </Section>

  <!-- 10. CTA BAND (ink) -->
  <Section register="ink" size="md" data-reveal>
    <CtaBand
      heading="Find out what is leaking money in your ads"
      body="Send us access and, within three working days, you get a written audit of what is working, what is not, and what we would change first — whether or not you hire us."
      ctaLabel="Get a free growth plan"
      ctaHref="/audit/"
      secondaryLabel="Talk to us"
      secondaryHref="/contact/"
    />
  </Section>

  <style>
    .ss-svc-card {
      transition: transform var(--dur-base) var(--ease-out),
                  border-color var(--dur-base) var(--ease-out),
                  box-shadow var(--dur-base) var(--ease-out);
    }
    .ss-svc-card::before {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(180deg, transparent, var(--accent-wash));
      opacity: 0;
      transition: opacity var(--dur-base) var(--ease-out);
      pointer-events: none;
    }
    @media (prefers-reduced-motion: no-preference) {
      .ss-svc-card:hover {
        transform: translateY(-4px);
        border-color: color-mix(in srgb, var(--accent-fill) 55%, var(--rule-c));
        box-shadow: 0 24px 50px -30px color-mix(in srgb, var(--accent-fill) 55%, transparent);
      }
    }
    .ss-svc-card:hover::before { opacity: 1; }
    .ss-svc-arrow { transition: transform var(--dur-fast) var(--ease-out); }
    .ss-svc-card:hover .ss-svc-arrow { transform: translateX(3px); }
  </style>

  <script>
    import '@/scripts/motion.ts';
  </script>
</BaseLayout>
