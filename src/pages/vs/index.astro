---
/**
 * /vs/ — the comparisons hub. Links every comparison page (so none are orphaned)
 * and is itself linked from the footer.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Meta from '@/components/seo/Meta.astro';
import SchemaGraph from '@/components/seo/SchemaGraph.astro';
import Section from '@/components/primitives/Section.astro';
import Button from '@/components/primitives/Button.astro';
import CtaBand from '@/components/blocks/CtaBand.astro';
import { COMPARISONS } from '@/lib/comparisons';
import { base, webPage, breadcrumbs } from '@/lib/schema';

const url = '/vs/';
const title = 'Marketing & Ecommerce Comparisons | Scaling Socials';
const description =
  'Honest comparisons for D2C founders: agency vs freelancer, in-house vs agency, Shopify vs WooCommerce, Advantage+ vs manual, SEO vs performance marketing.';
const modified = '2026-09-11';

const nodes = [
  ...base(),
  webPage({ url, name: title, description, hasBreadcrumb: true, dateModified: modified }),
  breadcrumbs(url, [{ name: 'Home', url: '/' }, { name: 'Comparisons', url }]),
];
---

<BaseLayout>
  <Meta slot="meta" title={title} description={description} type="website" modifiedTime={modified} />
  <SchemaGraph slot="schema" nodes={nodes} />

  <Section size="lg">
    <span class="ss-eyebrow">Comparisons</span>
    <h1 class="max-w-[20ch]">Straight answers to the "which should I choose?" questions</h1>
    <p class="mt-[var(--space-4)] max-w-[58ch] text-h4 leading-[1.5] text-[var(--fg)]">
      No vendor spin. Each of these says plainly when the other option wins, then where Scaling Socials
      actually fits — the same honesty you get in our free audit.
    </p>
    <div class="mt-[var(--space-5)]"><Button href="/audit/" variant="primary">Get a free growth plan</Button></div>
  </Section>

  <Section size="md">
    <ul class="grid gap-[var(--space-4)] sm:grid-cols-2">
      {COMPARISONS.map((c) => (
        <li>
          <a href={c.url} class="ss-vcard flex h-full flex-col gap-[var(--space-2)] rounded-[var(--radius-card)] border border-[var(--rule-c)] bg-[var(--ground)] p-[var(--space-5)] no-underline">
            <h2 class="text-h4 font-semibold text-[var(--fg)]">{c.name}</h2>
            <p class="text-small leading-relaxed text-[var(--fg-muted)]">{c.blurb}</p>
            <span class="ss-learn mt-auto inline-flex items-center gap-[0.35rem] pt-[var(--space-2)] text-small font-medium text-[var(--accent-text)]">
              Read the comparison
              <svg class="ss-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Section register="ink" size="md">
    <CtaBand heading="Still weighing it up?" body="Send us your situation and get a written audit in three working days, with a straight recommendation — whether or not you hire us." ctaLabel="Get a free growth plan" ctaHref="/audit/" secondaryLabel="Talk to us" secondaryHref="/contact/" />
  </Section>

  <style>
    .ss-eyebrow { display:inline-block; margin-bottom: var(--space-2); font-size: var(--text-label); font-weight:600; color: var(--accent-text); }
    .ss-vcard, .ss-arrow { transition: transform var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out); }
    .ss-vcard:hover { transform: translateY(-2px); border-color: color-mix(in srgb, var(--accent-fill) 45%, var(--rule-c)); }
    .ss-vcard:hover .ss-arrow { transform: translateX(3px); }
  </style>
</BaseLayout>
