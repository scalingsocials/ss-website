---
/**
 * /about/ — company story + founders. See 02 §2 (Company), 03 §1.3.
 * The 2022 LLP incorporation appears only here in prose; structured fields use
 * the 2021 founding date (entity.ts / CLAUDE.md entity rules).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Meta from '@/components/seo/Meta.astro';
import SchemaGraph from '@/components/seo/SchemaGraph.astro';
import Section from '@/components/primitives/Section.astro';
import { Image } from 'astro:assets';
import Prose from '@/components/primitives/Prose.astro';
import CtaBand from '@/components/blocks/CtaBand.astro';
import NotForYouBlock from '@/components/blocks/NotForYouBlock.astro';
import { PARTNERS } from '@/lib/team';
import { base, webPage, breadcrumbs, person } from '@/lib/schema';

const url = '/about/';
const title = 'About Scaling Socials | D2C Growth Agency Bangalore';
const description =
  'Scaling Socials is an omni-channel ecommerce growth agency in Bangalore, founded in 2021 by four operators, serving D2C brands across India and the UAE.';
const modified = '2026-09-04';

const values = [
  { t: 'We work to your P&L', b: 'Not to platform-reported ROAS. If the maths doesn’t work for your brand, we’ll tell you.' },
  { t: 'We publish our pricing', b: 'Nobody else in this SERP does. Transparency filters the right clients in and the wrong ones out.' },
  { t: 'We say when not to hire us', b: 'Every service page has a real disqualifier list. Saying no is a trust signal, and it saves everyone time.' },
  { t: 'One team, one number', b: 'Media, creative, store and CRO under one roof, so nobody points fingers when a number moves.' },
];

// How the agency actually operates — each one is a direct answer to a failure
// the founders hit when they were the client hiring an agency (owner-supplied).
const standards = [
  {
    t: 'Realistic growth, month on month',
    b: 'We plan to a number the account can actually hit, and say what it will take to get there. Nobody here will promise you 5x in thirty days — that pitch is how brands end up overspent and disappointed.',
  },
  {
    t: 'Experienced managers, not juniors',
    b: 'Every account is run by an ad manager with at least a year handling large budgets. The person who understands your account is the person actually working on it.',
  },
  {
    t: 'Everything stays in-house',
    b: 'Media, creative, store and CRO all sit under one roof. We do not outsource the work and put our name on it, because quality control ends the moment it leaves the building.',
  },
  {
    t: 'Pricing matched to the work',
    b: 'What we charge flexes with the real workload and the stage you are at, rather than a fixed retainer that ignores whether you are launching or scaling.',
  },
];

// Real disqualifiers, in the founders' own terms. Saying no is a trust signal.
const notForYou = [
  'Brands without a working marketing budget. Below a real spend level we cannot get you the result you are expecting, and we would rather tell you now.',
  'Brands treating marketing as a get-rich-quick scheme — expecting viral content or a high return inside the first month.',
  'Brands with no long-term view. Growth compounds over quarters; it does not arrive in week three.',
  'Brands unwilling to act on what we find. If the product, the pricing or the website is what is holding sales back, we will say so, and this only works if that gets fixed.',
  'Anyone who wants budget deployed without a plan — a big launch spend or an expensive lifestyle shoot before there is any evidence it will return.',
  'Anyone who treats our team badly. We have ended retainers over it and would do it again.',
];

const nodes = [
  ...base(),
  webPage({ url, name: title, description, hasBreadcrumb: true, dateModified: modified }),
  breadcrumbs(url, [{ name: 'Home', url: '/' }, { name: 'About', url }]),
  ...PARTNERS.map((p) => person({ slug: p.slug, name: p.name, jobTitle: p.role, linkedin: p.linkedin, description: p.bio })),
];
---

<BaseLayout>
  <Meta slot="meta" title={title} description={description} type="website" modifiedTime={modified} />
  <SchemaGraph slot="schema" nodes={nodes} />

  <Section size="lg">
    <span class="ss-eyebrow">About us</span>
    <h1 class="max-w-[20ch]">The agency that answers to your P&amp;L</h1>
    <p class="mt-[var(--space-4)] max-w-[58ch] text-h4 leading-[1.5] text-[var(--fg)]">
      Scaling Socials is an omni-channel ecommerce growth agency in Bangalore. We run Meta and Google
      Ads, build and optimise Shopify stores, and handle SEO, social and CRO for D2C brands across
      India and the UAE, measured by the revenue we drive rather than the impressions we buy.
    </p>
  </Section>

  <Section size="md" class="!bg-[var(--surface-c)]">
    <Prose>
      <h2>How we started</h2>
      <p>
        Scaling Socials began as a partnership in 2021 and was incorporated as Scaling Socials Media
        LLP in 2022. It started because the four of us — an engineer, two MBAs and an operator who’d
        built his own online businesses — went looking for an agency to run marketing for a brand of
        our own, and kept running into the same things.
      </p>
      <p>
        Agencies promised 5x to 10x returns in timeframes nobody could deliver them in. The person
        who sold us the retainer was never the person who ran the account, and the work went to
        juniors who couldn’t answer a straight question about why a campaign was losing money.
        Services we were paying for got quietly outsourced, so nobody could stand behind the quality.
        And the pricing was vague — a number picked out of the air rather than one a startup could
        plan around.
      </p>
      <p>
        So we built the opposite, and the four standards below are each a direct answer to one of
        those problems. We start from your margins, we publish what we charge, and we hand brands an
        audit they could take to a competitor. It’s a slower way to grow an agency and a far more
        durable one, because the clients who choose us that way tend to stay.
      </p>
      <p>
        Today we work with D2C brands across fashion, beauty, home, wellness and jewellery, in India
        and the UAE, running the whole funnel from the first ad impression to the checkout.
      </p>
    </Prose>
  </Section>

  <Section size="md">
    <span class="ss-eyebrow">How we run accounts</span>
    <h2 class="max-w-[24ch] text-h2 font-semibold">Four standards we set after being the client</h2>
    <ul class="mt-[var(--space-6)] grid gap-[var(--space-3)] sm:grid-cols-2">
      {standards.map((v) => (
        <li class="flex flex-col gap-[var(--space-2)] rounded-[var(--radius-card)] border border-[var(--rule-c)] bg-[var(--ground)] p-[var(--space-4)]">
          <h3 class="text-h4 font-semibold text-[var(--fg)]">{v.t}</h3>
          <p class="text-small leading-relaxed text-[var(--fg-muted)]">{v.b}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section register="ink" size="md">
    <div class="grid gap-[var(--space-8)] lg:grid-cols-[1fr_1.2fr] lg:items-start">
      <div>
        <span class="ss-eyebrow">Being honest about fit</span>
        <p class="max-w-[46ch] text-h4 leading-[1.5] text-[var(--fg)]">
          We turn down work, and we say why. It saves both sides a quarter of finding out the
          expensive way.
        </p>
      </div>
      <NotForYouBlock heading="Who we’re not for" items={notForYou} />
    </div>
  </Section>

  <Section size="md">
    <span class="ss-eyebrow">What we believe</span>
    <h2 class="max-w-[22ch] text-h2 font-semibold">Four things we won’t compromise on</h2>
    <ul class="mt-[var(--space-6)] grid gap-[var(--space-3)] sm:grid-cols-2">
      {values.map((v) => (
        <li class="flex flex-col gap-[var(--space-2)] rounded-[var(--radius-card)] border border-[var(--rule-c)] bg-[var(--ground)] p-[var(--space-4)]">
          <h3 class="text-h4 font-semibold text-[var(--fg)]">{v.t}</h3>
          <p class="text-small leading-relaxed text-[var(--fg-muted)]">{v.b}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section size="md" class="!bg-[var(--surface-c)]">
    <span class="ss-eyebrow">The team</span>
    <div class="flex flex-wrap items-end justify-between gap-[var(--space-3)]">
      <h2 class="max-w-[20ch] text-h2 font-semibold">Four founders, four disciplines</h2>
      <a href="/team/" class="text-small font-medium text-[var(--accent-text)] no-underline">Meet the team</a>
    </div>
    <ul class="mt-[var(--space-6)] grid gap-[var(--space-3)] sm:grid-cols-2 lg:grid-cols-4">
      {PARTNERS.map((p) => (
        <li class="flex flex-col items-start gap-[var(--space-2)] rounded-[var(--radius-card)] border border-[var(--rule-c)] bg-[var(--ground)] p-[var(--space-4)]">
          <Image
            src={p.photo}
            alt={`${p.name}, ${p.role} at Scaling Socials`}
            width={80}
            height={100}
            widths={[80, 160]}
            sizes="80px"
            loading="lazy"
            class="h-[100px] w-[80px] rounded-[var(--radius-card)] bg-[var(--surface-c)] object-cover object-top"
          />
          <div>
            <div class="font-semibold text-[var(--fg)]">{p.name}</div>
            <div class="text-small text-[var(--fg-muted)]">{p.focus}</div>
          </div>
        </li>
      ))}
    </ul>
  </Section>

  <Section register="ink" size="md">
    <CtaBand heading="Want to see how we’d grow your brand?" body="A written audit in three working days, whether or not you hire us." ctaLabel="Get a free growth plan" ctaHref="/audit/" secondaryLabel="Contact us" secondaryHref="/contact/" />
  </Section>

  <style>.ss-eyebrow { display: inline-block; margin-bottom: var(--space-2); font-size: var(--text-label); font-weight: 600; color: var(--accent-text); }</style>
</BaseLayout>
