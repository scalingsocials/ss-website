---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Meta from '@/components/seo/Meta.astro';
import Section from '@/components/primitives/Section.astro';
import Button from '@/components/primitives/Button.astro';

// The 25 planned terms (03 §6). Definitions publish as DefinedTerm pages.
const terms = ['ROAS', 'CAC', 'AOV', 'LTV', 'CPM', 'CPC', 'CTR', 'CVR', 'MER', 'Blended ROAS', 'Contribution margin', 'Advantage+ Shopping', 'Performance Max', 'Attribution window', 'Incrementality', 'Creative fatigue', 'Hook rate', 'Thumb-stop ratio', 'Retention cohort', 'Payback period', 'CLV:CAC ratio', 'Checkout abandonment'];
---
<BaseLayout noindex>
  <Meta slot="meta" title="D2C Marketing Glossary | Scaling Socials Bangalore" description="Plain-English definitions of D2C and ecommerce marketing metrics, each with a worked rupee example, from Scaling Socials." noindex />
  <Section size="lg">
    <span class="ss-eyebrow">Glossary</span>
    <h1 class="max-w-[20ch]">Every D2C metric, defined with a rupee example</h1>
    <p class="mt-[var(--space-4)] max-w-[54ch] text-h4 leading-[1.5] text-[var(--fg)]">
      The metrics a founder actually needs, from ROAS and CAC to AOV and MER, each defined plainly,
      with how it’s calculated and a worked example in rupees. Term pages publish shortly.
    </p>
    <ul class="mt-[var(--space-8)] flex flex-wrap gap-[var(--space-2)]">
      {terms.map((t) => (
        <li class="rounded-full border border-[var(--rule-c)] bg-[var(--surface-c)] px-[var(--space-3)] py-[0.4rem] text-small text-[var(--fg)]">{t}</li>
      ))}
    </ul>
    <div class="mt-[var(--space-8)]"><Button href="/tools/break-even-roas-calculator/" variant="primary">Try the break-even ROAS calculator</Button></div>
  </Section>
  <style>.ss-eyebrow { display: inline-block; margin-bottom: var(--space-2); font-size: var(--text-label); font-weight: 600; color: var(--accent-text); }</style>
</BaseLayout>
