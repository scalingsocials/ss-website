---
/**
 * /thank-you/ — post-submit confirmation. noindex, excluded from sitemap.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Meta from '@/components/seo/Meta.astro';
import Section from '@/components/primitives/Section.astro';
import Button from '@/components/primitives/Button.astro';
---

<BaseLayout noindex>
  {/* Use <Meta> rather than hand-rolled tags so this page gets the canonical
      and Open Graph tags too. noindex skips the title/description length gate. */}
  <Meta
    slot="meta"
    noindex
    title="Thank you — Scaling Socials"
    description="Thanks, we have your details and will reply within one working day."
    type="website"
  />

  <Section size="lg">
    <div class="mx-auto max-w-[52ch] text-center">
      <div class="mx-auto mb-[var(--space-4)] grid h-[64px] w-[64px] place-items-center rounded-full bg-[var(--accent-wash)]">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12.5 10 17l9-10" stroke="var(--accent-text)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <h1 class="text-h2 font-semibold">Thanks, we’ve got it.</h1>
      {/* Two different journeys land here: an enquiry from a lead form, and a
          teardown-list signup (a native form post, so the server picks the
          redirect and cannot vary the page). The copy has to be true for both. */}
      <p class="mt-[var(--space-3)] text-body text-[var(--fg-muted)]">
        If you sent us your brand, a real person at Scaling Socials reads it and replies within one
        working day. If you joined the teardown list, the first one reaches you the day it
        publishes. Either way, WhatsApp us on +91 96067 13608 if it’s urgent.
      </p>
      <div class="mt-[var(--space-6)] flex flex-wrap justify-center gap-[var(--space-2)]">
        <Button href="/" variant="primary">Back to home</Button>
        <Button href="/case-studies/" variant="secondary">See case studies</Button>
      </div>
    </div>
  </Section>
</BaseLayout>
