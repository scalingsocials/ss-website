---
/**
 * SiteShowcase — a scrolling wall of real client store/site screenshots, desktop
 * and mobile, so the Shopify and Web/App pages show the look, not just describe
 * it. Screenshots live in src/assets/sites/<name>-desktop.webp and -mobile.webp
 * (captured from live client sites) and are optimised by astro:assets.
 *
 * Each card frames the desktop shot in a minimal browser chrome with the phone
 * shot inset in the corner. Two rows. Phones and touch get a swipe rail; a
 * desktop with a mouse gets a CSS-only loop that pauses on hover. No JS either way.
 *
 * RECAPTURING ONE OF THESE: do not screenshot on `load`. eazywagon-desktop.webp
 * was taken that way and caught the hero carousel mid-flight — 56% of the frame
 * came out as flat rgb(232,232,232) placeholder grey with only the carousel dots
 * showing, and it shipped like that (fixed 2026-09-14 by recapturing at 1440x900
 * after polling every above-the-fold <img> for naturalWidth > 0).
 *
 * Two traps when writing that capture script: a Shopify storefront polls
 * analytics forever so `networkidle` never fires, and `img.decode()` returns a
 * promise that never settles for an image that never loads, so awaiting them all
 * hangs rather than failing. Poll `complete && naturalWidth` instead.
 *
 * All twelve were audited for this by finding large connected regions of
 * near-exact uniform colour; the remaining flat areas are real photography,
 * brand colour and white page background.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  heading?: string;
  class?: string;
}
const { heading = 'The look, on real stores', class: className = '' } = Astro.props;

const desktops = import.meta.glob<{ default: ImageMetadata }>('/src/assets/sites/*-desktop.webp', { eager: true });
const mobiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/sites/*-mobile.webp', { eager: true });

// Nice brand labels for the known client sites; falls back to a title-cased slug.
const LABELS: Record<string, string> = {
  koshkulture: 'Kosh Kulture',
  chinmaya: 'Chinmaya Mission',
  eazywagon: 'Eazy Wagon',
  joliindia: 'Joli India',
  younglings: 'Younglings',
  sanyamalik: 'Sanya Malik',
};
const title = (slug: string) => LABELS[slug] ?? slug.replace(/(^|[-_])(\w)/g, (_, __, c) => ' ' + c.toUpperCase()).trim();

const byName = (rec: Record<string, { default: ImageMetadata }>) =>
  Object.fromEntries(Object.entries(rec).map(([p, m]) => [p.split('/').pop()!.replace(/-(desktop|mobile)\.webp$/, ''), m.default]));
const d = byName(desktops);
const m = byName(mobiles);

const sites = Object.keys(d)
  .sort()
  .map((name) => ({ name, label: title(name), desktop: d[name]!, mobile: m[name] }));

// Rendered twice for the desktop marquee: the second copy is what scrolls into
// view as the first leaves, so the loop has no visible jump. It is aria-hidden
// and display:none everywhere except the desktop marquee, so screen readers and
// the phone swipe rail only ever see each site once.
const loop = [...sites.map((s) => ({ ...s, dup: false })), ...sites.map((s) => ({ ...s, dup: true }))];
---

{sites.length > 0 && (
  <div class:list={['ss-shots', className]}>
    {/* Callers that already print their own section heading above this block
        (LandingLayout does) pass heading="" to suppress it. Rendering the tag
        regardless shipped an empty <h2> straight under a real one. */}
    {heading && <h2 class="mb-[var(--space-5)] max-w-[24ch] text-h2 font-semibold">{heading}</h2>}
    <div class="ss-shots__rail">
      <ul class="ss-shots__track">
        {loop.map((s) => (
          <li class:list={['ss-shots__item', s.dup && 'ss-shots__item--dup']} aria-hidden={s.dup ? 'true' : undefined}>
            <figure class="ss-frame">
              <div class="ss-frame__bar" aria-hidden="true">
                <span class="ss-frame__dot"></span><span class="ss-frame__dot"></span><span class="ss-frame__dot"></span>
              </div>
              <Image
                src={s.desktop}
                alt={`${s.label} — a store designed and built by Scaling Socials, desktop view`}
                width={s.desktop.width}
                height={s.desktop.height}
                widths={[520, 900]}
                sizes="(max-width: 640px) 84vw, 460px"
                loading="lazy"
                decoding="async"
                class="ss-frame__desktop"
              />
              {s.mobile && (
                <Image
                  src={s.mobile}
                  alt={`${s.label} on mobile`}
                  width={s.mobile.width}
                  height={s.mobile.height}
                  widths={[140, 280]}
                  sizes="120px"
                  loading="lazy"
                  decoding="async"
                  class="ss-frame__mobile"
                />
              )}
              <figcaption class="ss-frame__cap">{s.label}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </div>
)}

<style>
  .ss-shots__rail {
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    margin-inline: calc(-1 * var(--space-3));
    padding-inline: var(--space-3);
    padding-bottom: var(--space-2);
  }
  .ss-shots__rail::-webkit-scrollbar { display: none; }
  /* TWO rows that scroll sideways together (owner-directed, 2026-09-14). Grid
     with column auto-flow, not flex: the browser fills row 1 then row 2 of each
     column for us, so the pairing needs no markup change and no JS. With six
     sites that is three columns of two. An odd count simply leaves the last
     column's lower cell empty rather than breaking the rhythm. */
  .ss-shots__track {
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(2, auto);
    grid-auto-columns: min(460px, 84vw);
    gap: var(--space-4);
    width: max-content;
    align-items: start;
  }
  .ss-shots__item { scroll-snap-align: start; }
  .ss-shots__item--dup { display: none; }

  /* DESKTOP: an auto-scrolling loop that pauses under the pointer (owner-directed,
     2026-09-15). A mouse wheel scrolls vertically and the rail hides its
     scrollbar, so on a PC the sideways rail simply could not be moved — the
     second half of the showcase was unreachable.

     Gated on a real hovering pointer, not just width: a touch laptop or tablet at
     1280px still gets the swipe rail, because "pause on hover" means nothing
     without a hover. Under reduced motion the loop is off and the rail stays a
     manual scroller with a visible scrollbar instead. */
  @media (hover: hover) and (pointer: fine) and (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .ss-shots__rail {
      overflow: hidden;
      scroll-snap-type: none;
      margin-inline: 0;
      padding-inline: 0;
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
      mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
    }
    .ss-shots__item--dup { display: block; }
    .ss-shots__track {
      --shots-gap: var(--space-4);
      animation: ssShotsLoop 64s linear infinite;
    }
    /* Pause while the pointer is over the rail, or while anything inside it has
       keyboard focus; resume the moment it leaves. */
    .ss-shots__rail:hover .ss-shots__track,
    .ss-shots__rail:focus-within .ss-shots__track { animation-play-state: paused; }
  }
  /* The copy doubles the column count, so -50% lands HALF A GAP short of the
     first duplicate: 2N columns have 2N-1 gaps, and the seam gap belongs to
     neither half. Subtracting that half-gap is what makes the wrap invisible —
     without it every loop visibly jumps by 16px. */
  @keyframes ssShotsLoop {
    from { transform: translateX(0); }
    to   { transform: translateX(calc(-50% - var(--shots-gap) / 2)); }
  }
  @media (hover: hover) and (pointer: fine) and (min-width: 1024px) and (prefers-reduced-motion: reduce) {
    .ss-shots__rail { scrollbar-width: thin; }
    .ss-shots__rail::-webkit-scrollbar { display: block; height: 8px; }
  }

  .ss-frame {
    position: relative;
    margin: 0;
    border: 1px solid var(--rule-c);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--surface-c);
    box-shadow: 0 30px 60px -40px color-mix(in srgb, var(--accent-fill) 40%, transparent);
  }
  .ss-frame__bar {
    display: flex; align-items: center; gap: 6px;
    padding: 8px var(--space-3);
    background: var(--ground);
    border-bottom: 1px solid var(--rule-c);
  }
  .ss-frame__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--rule-c); }
  .ss-frame__desktop { display: block; width: 100%; height: auto; aspect-ratio: 1440 / 900; object-fit: cover; object-position: top; }
  .ss-frame__mobile {
    position: absolute;
    right: var(--space-3);
    bottom: calc(var(--space-3) + 1.4rem);
    width: 22%;
    height: auto;
    border-radius: 10px;
    border: 2px solid var(--ground);
    box-shadow: 0 12px 24px -12px color-mix(in srgb, var(--color-black) 60%, transparent);
    background: var(--ground);
  }
  .ss-frame__cap {
    padding: 0.55rem var(--space-3);
    background: var(--ground);
    border-top: 1px solid var(--rule-c);
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--fg);
  }
</style>
