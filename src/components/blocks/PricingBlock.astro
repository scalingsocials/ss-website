---
/**
 * PricingBlock — value-framed. See 11 §2. Leads with the worth of what's included,
 * not the "cost". The published floor stays (transparency is the differentiator,
 * 11 §2) but as a quiet "from" line, so the reader feels the value before the price.
 * The number renders as real text in the HTML (CLAUDE.md §10). Register-agnostic.
 */
export interface Props {
  lede: string; // the value statement (headline)
  included: string[]; // what you actually get
  price?: string; // e.g. "₹25,000/month" — shown as a quiet "from" line
  note?: string;
  class?: string;
}
const { lede, included, price, note, class: className = '' } = Astro.props;
---

<div
  data-value-block
  class:list={[
    'grid gap-[var(--space-6)] rounded-[var(--radius-card)] border border-[var(--rule-c)] bg-[var(--ground)] p-[var(--space-6)] md:grid-cols-[1fr_1fr] md:items-start',
    className,
  ]}
>
  <div class="flex flex-col gap-[var(--space-3)]">
    <p class="text-h3 font-semibold leading-snug text-[var(--fg)]">{lede}</p>
    {price && (
      <p class="text-small text-[var(--fg-muted)]">
        Plans start from <span class="font-semibold text-[var(--fg)]" data-num>{price}</span>.
        We publish this because nobody else in this SERP does.
      </p>
    )}
    {note && <p class="text-small text-[var(--fg-muted)]">{note}</p>}
  </div>

  <ul class="flex flex-col gap-[var(--space-2)]">
    {included.map((item) => (
      <li class="flex gap-[var(--space-2)] text-body text-[var(--fg)]">
        <span class="mt-[0.15em] grid h-[20px] w-[20px] shrink-0 place-items-center rounded-full bg-[var(--accent-wash)]" aria-hidden="true">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2.5 6.2 5 8.6l4.5-5" stroke="var(--accent-text)" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <span>{item}</span>
      </li>
    ))}
  </ul>
</div>
