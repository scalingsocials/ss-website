---
/**
 * Testimonials — real client quotes in a compact scroll rail (shorter than a
 * stacked grid). Migrated from scalingsocials.com; named, public, spanning
 * services (Shopify / web / brand / performance). Genuine, not invented (§15).
 *
 * The rail is swipeable/scrollable on its own; prev/next arrows are progressive
 * enhancement (a small bundled script scrolls by one card). Register-agnostic.
 */
export interface Props {
  class?: string;
  /** Keep only testimonials whose tag is in this list (e.g. the ad LP shows only
   *  performance-marketing quotes). Omit to show all (homepage default). */
  filter?: string[];
  /** 'rail' = the arrow scroll rail. 'slider' = an auto-scrolling ad-testimonials
   *  slider for the landing pages. 'marquee' = the homepage's auto-scrolling
   *  two-row wall of ALL reviews, dark glowing cards in the accent. */
  variant?: 'rail' | 'slider' | 'marquee';
}
const { class: className = '', filter, variant = 'rail' } = Astro.props;

interface Testimonial {
  quote: string;
  name: string;
  tag: string;
  /** Client brand (named-client quotes migrated from the old site). */
  brand?: string;
  /** Provenance for public-platform reviews, e.g. 'Google'. */
  source?: string;
  /** Star rating (real, from the source). Renders a ★ row when present. */
  rating?: number;
}

// Named-client quotes (migrated from scalingsocials.com) + real, verbatim
// Google Business Profile reviews (5-star, lightly punctuation-cleaned to house
// style — no wording invented; §15). Spread across services on purpose.
const testimonials: Testimonial[] = [
  { quote: 'They revamped our cosmetic brand Timri’s ecommerce Shopify website. On-time delivery, a good sense of our business, and available whenever we need assistance. Highly recommended for ecommerce Shopify development.', name: 'Nikunj Vavadiya', brand: 'Timri', tag: 'Shopify development' },
  { quote: 'I really appreciate how proactive they are with ad management. When the ads perform well, they scale them up wisely, and when something isn’t working, they immediately reduce the spend, keeping our budget in mind as if it were their own. Their commitment and transparency make working with them a great experience.', name: 'Sharmili Pasha', source: 'Google', rating: 5, tag: 'Performance marketing' },
  { quote: 'Amazing work on website development, coordinating regularly with the brand. We set deadlines together and they commit to them. Over the months the quality of work kept improving, which is rare and commendable.', name: 'Param Sadh', brand: 'Younglings', tag: 'Web development' },
  { quote: 'They have maintained the highest level of professionalism and transparency of any digital marketing agency I have ever dealt with. I had two websites affected by Google algorithm updates and had lost a lot of ranking, but after hiring their link building and SEO services it helped me a lot to restore all those rankings.', name: 'Abhay Singh', source: 'Google', rating: 5, tag: 'SEO' },
  { quote: 'A team of very hard-working people who strive to understand what the brand actually requires. They understood exactly what our vision was and delivered their best to achieve it.', name: 'Juhi Dhanki', brand: 'Lille Barn', tag: 'Brand & growth' },
  { quote: 'Just after 4 months of their work on our performance marketing strategy, traffic has been voluminous and we are increasing our sales. Their unfailing ways to communicate and take care of any arising problems have worked as the right solace at each step.', name: 'Shyam Sundar Saw', source: 'Google', rating: 5, tag: 'Performance marketing' },
  { quote: 'Scaling Socials did a fantastic job developing my website. Their team was professional, efficient, and attentive to my needs. The new website is attractive, easy to use, and has boosted my business visibility.', name: 'Marri Vamshi', source: 'Google', rating: 5, tag: 'Web development' },
  { quote: 'Clear ideas and smooth coordination have really paid off, boosting our sales. The straightforward approach to getting things done is making a big impact.', name: 'Pooja', brand: 'Rangloom Indie Crafts', tag: 'Performance marketing' },
  { quote: 'Their proficiency in performance and social media marketing enables them to craft tailored campaigns that effectively engage target audiences, resulting in increased visibility, traffic, and conversions. Known for their transparency and data-driven strategies, they consistently deliver strong ROI.', name: 'Vishal M', source: 'Google', rating: 5, tag: 'Social media marketing' },
  { quote: 'They really take the time to understand what you need and build a strategy around it, whether it’s SEO, social media, or paid ads. What I appreciate most is how easy they are to work with. They’re always quick to respond, clear in their communication, and genuinely care about getting results.', name: 'Aarnav N', source: 'Google', rating: 5, tag: 'Digital marketing' },
];

// The ad landing pages pass a filter so only performance-marketing quotes show
// (Sharmili Pasha, Shyam Sundar Saw, Pooja all carry the "Performance marketing"
// tag). Homepage passes nothing → all testimonials.
const shown = filter ? testimonials.filter((t) => filter.includes(t.tag)) : testimonials;

// Slider variant: only REAL testimonials that mention ads/campaigns/ROAS/spend/
// scaling/growth/performance (verbatim; §15 — nothing invented). If fewer than 4
// exist we pad with clearly-labelled "coming soon" placeholders.
const AD_RE = /\b(ads?|campaign|roas|spend|scal(?:e|ing)|growth|performance)\b/i;
// Match the QUOTE TEXT only (§15 — the prompt says "whose text mentions…"), so a
// generic quote is never pulled in just because its service tag says "growth".
const adPicked = testimonials.filter((t) => AD_RE.test(t.quote));
const slug = (n: string) => n.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

// The homepage 'marquee' shows EVERY review (filter-aware), across services;
// the LP 'slider' shows only the ad/growth quotes. Both auto-scroll in two
// opposing rows. Placeholders only pad the LP slider, never the full marquee.
const isMarquee = variant === 'marquee';
const source = isMarquee ? shown : adPicked;
const placeholders = isMarquee ? 0 : Math.max(0, 4 - source.length);
const twoRows = source.length >= 6;
const rowA = twoRows ? source.filter((_, i) => i % 2 === 0) : source;
const rowB = twoRows ? source.filter((_, i) => i % 2 === 1) : [];
// Second line under the name — like the reference's role: the client's brand
// when we have it, else the service. The review source (e.g. Google) is carried
// by the star row, so it isn't repeated here.
const roleLine = (t: Testimonial) => t.brand ?? t.tag;
---

{variant === 'slider' || variant === 'marquee' ? (
  <div class:list={['ss-tstsl', isMarquee && 'ss-tstsl--glow', className]}>
    {[rowA, ...(twoRows ? [rowB] : [])].map((row, ri) => (
      <div class="ss-tstsl__row" data-slider>
        <div class:list={['ss-tstsl__track', ri === 1 && 'ss-tstsl__track--rev']}>
          {[...row, ...row].map((t, i) => (
            <figure class="ss-tstcard" aria-hidden={i >= row.length ? 'true' : undefined}>
              <div class="ss-tstcard__head">
                <span class="ss-tstcard__avatar">
                  {!isMarquee && <img src={`/lp/testimonials/${slug(t.name)}.jpg`} alt="" width="44" height="44" loading="lazy" decoding="async" class="ss-tstcard__img" />}
                  <span class="ss-tstcard__initial" aria-hidden="true">{t.name.charAt(0)}</span>
                </span>
                <div>
                  <div class="ss-tstcard__name">{t.name}</div>
                  {isMarquee
                    ? <div class="ss-tstcard__brand">{roleLine(t)}</div>
                    : (t.brand && <div class="ss-tstcard__brand">{t.brand}</div>)}
                </div>
              </div>
              <blockquote class="ss-tstcard__q" data-clamp>{t.quote}</blockquote>
              {!isMarquee && <button type="button" class="ss-tstcard__more" data-more hidden>more</button>}
              {t.rating && (
                <div class="ss-tstcard__stars" role="img" aria-label={`Rated ${t.rating} out of 5`}>
                  {'★'.repeat(t.rating)}<span class="ss-tstcard__src" aria-hidden="true"> Review on {t.source}</span>
                </div>
              )}
            </figure>
          ))}
          {ri === 0 && Array.from({ length: placeholders }).map(() => (
            <figure class="ss-tstcard ss-tstcard--ph">
              <div class="ss-tstcard__head"><span class="ss-tstcard__avatar ss-tstcard__avatar--ph" aria-hidden="true"></span><div class="ss-tstcard__name">Testimonial — coming soon</div></div>
            </figure>
          ))}
        </div>
      </div>
    ))}
  </div>
) : (
<div class:list={['ss-tst', className]}>
  <div class="ss-tst__head flex items-center justify-end gap-[var(--space-2)]">
    <button type="button" data-tprev aria-label="Previous testimonial" class="ss-tst__nav">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <button type="button" data-tnext aria-label="Next testimonial" class="ss-tst__nav">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>
  <div data-testimonials class="ss-trail">
    <ul class="ss-trail__track">
      {shown.map((t) => (
        <li class="ss-trail__item ss-trail__card flex flex-col gap-[var(--space-3)] rounded-[var(--radius-card)] border border-[var(--rule-c)] bg-[var(--ground)] p-[var(--space-4)]">
          <span class="w-fit rounded-full bg-[var(--accent-wash)] px-[0.7rem] py-[0.2rem] text-label font-semibold text-[var(--accent-text)]">{t.tag}</span>
          <blockquote class="ss-trail__q text-small leading-relaxed text-[var(--fg)] md:text-body">“{t.quote}”</blockquote>
          <figcaption class="mt-auto flex flex-col gap-[0.2rem] text-small">
            <span class="flex flex-wrap items-baseline gap-x-[var(--space-2)]">
              <span class="font-semibold text-[var(--fg)]">{t.name}</span>
              {t.brand && <span class="text-[var(--fg-muted)]">{t.brand}</span>}
            </span>
            {t.source && (
              <span class="flex items-center gap-[0.4rem] text-label text-[var(--fg-muted)]">
                <span class="ss-tst__stars" role="img" aria-label={`Rated ${t.rating} out of 5`}>{'★'.repeat(t.rating ?? 5)}</span>
                <span aria-hidden="true">Review on {t.source}</span>
              </span>
            )}
          </figcaption>
        </li>
      ))}
    </ul>
  </div>
</div>
)}

<script>
  // Progressive enhancement: wire the prev/next arrows to scroll the rail one
  // card at a time. The rail is already usable (swipe/scroll) without this.
  //
  // We scroll to an actual card edge computed from live positions (not a fixed
  // scrollBy delta), so a click always lands on a card even mid-animation or
  // after a resize — the old delta approach could under-scroll when clicked
  // rapidly, which read as "the button sometimes does nothing".
  document.querySelectorAll<HTMLElement>('.ss-tst').forEach((root) => {
    const rail = root.querySelector<HTMLElement>('[data-testimonials]');
    if (!rail) return;
    const prev = root.querySelector<HTMLButtonElement>('[data-tprev]');
    const next = root.querySelector<HTMLButtonElement>('[data-tnext]');
    const items = () => Array.from(rail.querySelectorAll<HTMLElement>('.ss-trail__item'));

    const move = (dir: 1 | -1) => {
      const padL = parseFloat(getComputedStyle(rail).paddingLeft) || 0;
      const anchor = rail.getBoundingClientRect().left + padL; // the left-aligned card edge
      const list = items();
      if (!list.length) return;
      // The card currently sitting nearest the left edge is "the page we're on";
      // step one index from it, so prev and next are exact mirrors and neither
      // over- nor under-shoots from a partially-scrolled position.
      let idx = 0;
      let best = Infinity;
      list.forEach((el, i) => {
        const d = Math.abs(el.getBoundingClientRect().left - anchor);
        if (d < best) { best = d; idx = i; }
      });
      const nextIdx = Math.max(0, Math.min(list.length - 1, idx + dir));
      // Snap the two ends to the true scroll extents so the rail actually reaches
      // 0 / max and the arrows disable — otherwise the leading padding gutter
      // leaves a few px that prev can never clear.
      let left: number;
      if (nextIdx === 0) left = 0;
      else if (nextIdx === list.length - 1) left = rail.scrollWidth - rail.clientWidth;
      else left = rail.scrollLeft + (list[nextIdx].getBoundingClientRect().left - anchor);
      rail.scrollTo({ left, behavior: 'smooth' });
    };

    const sync = () => {
      const max = rail.scrollWidth - rail.clientWidth;
      if (prev) prev.disabled = rail.scrollLeft <= 1;
      if (next) next.disabled = rail.scrollLeft >= max - 1;
    };

    prev?.addEventListener('click', () => move(-1));
    next?.addEventListener('click', () => move(1));
    rail.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync, { passive: true });
    sync();
  });

  // Slider variant: avatar photos that 404 fall back to the initial; the "more"
  // button appears only when the 5-line-clamped quote is actually truncated.
  document.querySelectorAll<HTMLImageElement>('.ss-tstcard__img').forEach((img) => {
    const hide = () => img.closest('.ss-tstcard__avatar')?.classList.add('is-missing');
    if (img.complete && img.naturalWidth === 0) hide();
    img.addEventListener('error', hide);
  });
  document.querySelectorAll<HTMLElement>('.ss-tstcard').forEach((card) => {
    const q = card.querySelector<HTMLElement>('[data-clamp]');
    const more = card.querySelector<HTMLButtonElement>('[data-more]');
    if (!q || !more) return;
    if (q.scrollHeight - q.clientHeight > 4) {
      more.hidden = false;
      more.addEventListener('click', () => {
        const open = q.classList.toggle('is-open');
        more.textContent = open ? 'less' : 'more';
      });
    }
  });
</script>

<style>
  .ss-tst__head { margin-bottom: var(--space-3); }
  .ss-tst__nav {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--rule-c);
    background: var(--ground);
    color: var(--fg);
    transition: border-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .ss-tst__nav:hover { color: var(--accent-text); border-color: color-mix(in srgb, var(--accent-fill) 55%, var(--rule-c)); }
  .ss-tst__nav:active { transform: scale(0.94); }
  .ss-tst__nav:focus-visible { outline: 2px solid var(--accent-text); outline-offset: 2px; }
  /* At a rail end the arrow greys out, so it's clear why it won't move. */
  .ss-tst__nav:disabled { opacity: 0.35; cursor: default; }
  .ss-tst__nav:disabled:hover { color: var(--fg); border-color: var(--rule-c); }

  .ss-trail {
    overflow-x: auto;
    /* proximity, NOT mandatory: mandatory snap fights a programmatic smooth
       scroll and can cancel it mid-animation, which is why the arrows "worked
       sometimes". proximity keeps the snap-on-swipe feel but lets the buttons
       land reliably. */
    scroll-snap-type: x proximity;
    scroll-behavior: smooth;
    scrollbar-width: none;
    margin-inline: calc(-1 * var(--space-3));
    padding-inline: var(--space-3);
    /* Match the snap start to the padding gutter so the first card snaps to
       scrollLeft 0 (not to the 24px gutter), letting the rail reach the true
       start and the prev arrow disable there. */
    scroll-padding-inline: var(--space-3);
  }
  .ss-trail::-webkit-scrollbar { display: none; }
  /* align-items:stretch (flex default) makes every card match the tallest, so the
     clamped quotes give a clean, uniform card grid instead of ragged heights. */
  .ss-trail__track { display: flex; gap: var(--space-3); width: max-content; }
  .ss-trail__item { flex: none; width: min(340px, 80vw); scroll-snap-align: start; }

  /* A soft lift so the cards read as objects on the pastel band, not flat panels. */
  .ss-trail__card {
    box-shadow: 0 1px 2px color-mix(in srgb, var(--color-black) 5%, transparent),
                0 12px 30px -22px color-mix(in srgb, var(--color-black) 40%, transparent);
  }
  /* Clamp quotes so cards stay a consistent, compact height and the whole
     section fits the viewport — the full text stays in the DOM for crawlers. */
  .ss-trail__q {
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (min-width: 768px) { .ss-trail__q { -webkit-line-clamp: 6; } }

  /* Real review stars — kept quiet (the brand accent stays rare, 08 §5c). The
     glyphs carry the rating; screen readers get the aria-label instead. */
  .ss-tst__stars { color: var(--fg); letter-spacing: 0.08em; }

  /* ── Slider variant (auto-scroll, pause on hover, static grid if reduced) ── */
  .ss-tstsl { display: flex; flex-direction: column; gap: var(--space-3); }
  .ss-tstsl__row { overflow: hidden; }
  .ss-tstsl__track { display: flex; gap: var(--space-3); width: max-content; animation: ssTstScroll 46s linear infinite; will-change: transform; }
  .ss-tstsl__track--rev { animation-direction: reverse; }
  /* Pause on hover only with a real pointer — on touch, :hover sticks after a tap
     and would freeze the slider. Focus always pauses (keyboard). */
  @media (hover: hover) { .ss-tstsl__row:hover .ss-tstsl__track { animation-play-state: paused; } }
  .ss-tstsl__row:focus-within .ss-tstsl__track { animation-play-state: paused; }
  @keyframes ssTstScroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  .ss-tstcard { flex: none; width: 280px; display: flex; flex-direction: column; gap: var(--space-2); border: 1px solid var(--rule-c); border-radius: var(--radius-card); background: var(--ground); padding: var(--space-4); }
  .ss-tstcard__head { display: flex; align-items: center; gap: var(--space-2); }
  .ss-tstcard__avatar { position: relative; display: grid; place-items: center; width: 44px; height: 44px; flex: none; border-radius: 50%; overflow: hidden; background: var(--accent-wash); color: var(--accent-text); font-weight: 700; }
  .ss-tstcard__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; }
  .ss-tstcard__avatar.is-missing .ss-tstcard__img { display: none; }
  .ss-tstcard__avatar--ph { background: var(--surface-c); }
  .ss-tstcard__name { font-weight: 600; font-size: var(--text-small); color: var(--fg); }
  .ss-tstcard__brand { font-size: var(--text-label); color: var(--fg-muted); }
  .ss-tstcard__q { font-size: var(--text-small); line-height: 1.5; color: var(--fg); display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; }
  .ss-tstcard__q.is-open { -webkit-line-clamp: unset; overflow: visible; }
  .ss-tstcard__more { align-self: flex-start; font-size: var(--text-label); font-weight: 600; color: var(--accent-text); }
  .ss-tstcard__stars { margin-top: auto; font-size: var(--text-label); color: var(--fg); letter-spacing: 0.06em; }
  .ss-tstcard__src { color: var(--fg-muted); letter-spacing: normal; }
  .ss-tstcard--ph { justify-content: center; color: var(--fg-muted); }

  /* ── Marquee glow variant (homepage, ink register) ──────────────────────────
     The reference's look — a wall of dark cards with a periwinkle rim and a soft
     halo, drifting past — rebuilt in our accent via semantic tokens. On the ink
     register --accent-fill is the lifted periwinkle, so the glow reads on black. */
  .ss-tstsl--glow .ss-tstcard {
    width: min(360px, 82vw);
    gap: var(--space-3);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--accent-fill) 10%, var(--surface-c)), var(--surface-c));
    border-color: color-mix(in srgb, var(--accent-fill) 34%, var(--rule-c));
    box-shadow:
      0 18px 45px -26px color-mix(in srgb, var(--accent-fill) 70%, transparent),
      inset 0 1px 0 color-mix(in srgb, var(--accent-fill) 16%, transparent);
  }
  .ss-tstsl--glow .ss-tstcard__avatar {
    background: color-mix(in srgb, var(--accent-fill) 24%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent-fill) 42%, transparent);
  }
  .ss-tstsl--glow .ss-tstcard__q { -webkit-line-clamp: 4; }
  /* Fade both edges so cards emerge and dissolve instead of hard-cutting. */
  .ss-tstsl--glow .ss-tstsl__row {
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .ss-tstsl__track { animation: none; flex-wrap: wrap; width: auto; }
    .ss-tstsl__track > [aria-hidden="true"] { display: none; }
  }
</style>
