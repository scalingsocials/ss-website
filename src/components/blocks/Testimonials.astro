---
/**
 * Testimonials — real client quotes in a compact scroll rail (shorter than a
 * stacked grid). Migrated from scalingsocials.com; named, public, spanning
 * services (Shopify / web / brand / performance). Genuine, not invented (§15).
 * Register-agnostic.
 */
export interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const testimonials = [
  { quote: 'They revamped our cosmetic brand Timri’s ecommerce Shopify website. On-time delivery, a good sense of our business, and available whenever we need assistance. Highly recommended for ecommerce Shopify development.', name: 'Nikunj Vavadiya', brand: 'Timri', tag: 'Shopify development' },
  { quote: 'Amazing work on website development, coordinating regularly with the brand. We set deadlines together and they commit to them. Over the months the quality of work kept improving, which is rare and commendable.', name: 'Param Sadh', brand: 'Younglings', tag: 'Web development' },
  { quote: 'A team of very hard-working people who strive to understand what the brand actually requires. They understood exactly what our vision was and delivered their best to achieve it.', name: 'Juhi Dhanki', brand: 'Lille Barn', tag: 'Brand & growth' },
  { quote: 'Clear ideas and smooth coordination have really paid off, boosting our sales. The straightforward approach to getting things done is making a big impact.', name: 'Pooja', brand: 'Rangloom Indie Crafts', tag: 'Performance marketing' },
];
---

<div data-testimonials class:list={['ss-trail', className]}>
  <ul class="ss-trail__track">
    {testimonials.map((t) => (
      <li class="ss-trail__item flex flex-col gap-[var(--space-3)] rounded-[var(--radius-card)] border border-[var(--rule-c)] bg-[var(--ground)] p-[var(--space-4)]">
        <span class="w-fit rounded-full bg-[var(--accent-wash)] px-[0.7rem] py-[0.2rem] text-label font-semibold text-[var(--accent-text)]">{t.tag}</span>
        <blockquote class="text-body leading-relaxed text-[var(--fg)]">“{t.quote}”</blockquote>
        <figcaption class="mt-auto flex items-baseline gap-[var(--space-2)] text-small">
          <span class="font-semibold text-[var(--fg)]">{t.name}</span>
          <span class="text-[var(--fg-muted)]">{t.brand}</span>
        </figcaption>
      </li>
    ))}
  </ul>
</div>

<style>
  .ss-trail {
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    margin-inline: calc(-1 * var(--space-3));
    padding-inline: var(--space-3);
  }
  .ss-trail::-webkit-scrollbar { display: none; }
  .ss-trail__track { display: flex; gap: var(--space-3); width: max-content; }
  .ss-trail__item { flex: none; width: min(360px, 82vw); scroll-snap-align: start; }
</style>
