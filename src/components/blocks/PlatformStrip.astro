---
/**
 * PlatformStrip — the platforms Scaling Socials runs on. See 08 §7 (partner marks).
 *
 * Factual: these are the ad and commerce platforms the agency operates on, not a
 * certification claim. Rendered as clean wordmarks (real vector logos slot in
 * later). Register-agnostic.
 */
export interface Props {
  label?: string;
  class?: string;
}
const { label = 'Where we run', class: className = '' } = Astro.props;
const platforms = ['Meta', 'Google Ads', 'Shopify', 'Amazon', 'Google Analytics'];
---

<div data-platform-strip class:list={['flex flex-col items-center gap-[var(--space-4)]', className]}>
  <span class="text-small font-medium text-[var(--fg-muted)]">{label}</span>
  <ul class="flex flex-wrap items-center justify-center gap-x-[var(--space-8)] gap-y-[var(--space-4)]">
    {platforms.map((p) => (
      <li class="text-h4 font-semibold tracking-[-0.01em] text-[var(--fg)] opacity-70 transition-opacity duration-[var(--dur-base)] hover:opacity-100">
        {p}
      </li>
    ))}
  </ul>
</div>
