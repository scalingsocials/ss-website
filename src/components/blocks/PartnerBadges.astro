---
/**
 * PartnerBadges — official partner marks. See 08 §7 item 3.
 *
 * Owner confirmed (2026-09-04) Scaling Socials is an official Google, Meta and
 * Shopify partner, so these render as verified. Replace the text marks with the
 * official badge SVGs + a link to each public partner-directory listing when
 * available. Register-agnostic.
 */
import BrandIcon from '@/components/graphics/BrandIcon.astro';

export interface Props {
  label?: string;
  class?: string;
}
const { label = 'Official partners', class: className = '' } = Astro.props;

const partners = [
  { name: 'Google Partner', icon: 'google' as const },
  { name: 'Meta Business Partner', icon: 'meta' as const },
  { name: 'Shopify Partner', icon: 'shopify' as const },
];
---

<div data-partner-badges class:list={['flex flex-col items-center gap-[var(--space-4)]', className]}>
  <span class="text-small font-medium text-[var(--fg-muted)]">{label}</span>
  <ul class="flex flex-wrap items-center justify-center gap-[var(--space-3)]">
    {partners.map((p) => (
      <li class="ss-partner flex items-center gap-[0.6rem] rounded-full border border-[var(--rule-c)] bg-[var(--ground)] px-[var(--space-3)] py-[0.5rem]">
        <span class="grid h-[22px] w-[22px] shrink-0 place-items-center">
          <BrandIcon name={p.icon} size={20} />
        </span>
        <span class="text-small font-semibold text-[var(--fg)]">{p.name}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  /* Partner marks read in full brand colour (they are proof, not decoration),
     with a quiet lift on hover to match the card language. */
  .ss-partner { transition: border-color var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out); }
  @media (prefers-reduced-motion: no-preference) {
    .ss-partner:hover { transform: translateY(-2px); border-color: color-mix(in srgb, var(--accent-fill) 45%, var(--rule-c)); }
  }
</style>
