---
/**
 * PartnerBadges — official partner marks. See 08 §7 item 3.
 *
 * Owner confirmed (2026-09-04) Scaling Socials is an official Google, Meta and
 * Shopify partner, so these render as verified. Replace the text marks with the
 * official badge SVGs + a link to each public partner-directory listing when
 * available. Register-agnostic.
 */
export interface Props {
  label?: string;
  class?: string;
}
const { label = 'Official partners', class: className = '' } = Astro.props;

const partners = ['Google Partner', 'Meta Business Partner', 'Shopify Partner'];
---

<div data-partner-badges class:list={['flex flex-col items-center gap-[var(--space-4)]', className]}>
  <span class="text-small font-medium text-[var(--fg-muted)]">{label}</span>
  <ul class="flex flex-wrap items-center justify-center gap-[var(--space-3)]">
    {partners.map((p) => (
      <li class="flex items-center gap-[0.5rem] rounded-full border border-[var(--rule-c)] bg-[var(--ground)] px-[var(--space-3)] py-[0.55rem]">
        <span class="grid h-[18px] w-[18px] place-items-center rounded-full bg-[var(--accent-fill)]">
          <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 6.2 5 8.6l4.5-5" stroke="var(--accent-on)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <span class="text-small font-semibold text-[var(--fg)]">{p}</span>
      </li>
    ))}
  </ul>
</div>
