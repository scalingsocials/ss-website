---
/**
 * VideoTestimonials — short founder videos, portrait, click-to-play.
 *
 * These are NOT ambient videos, so the 08 §media autoplay rules (muted, 8s,
 * 1.5MB) don't apply: nothing plays until the visitor taps, sound stays on,
 * `preload="none"` means the page downloads only the poster until then. Each
 * item ships .webm + .mp4 with an explicit poster and dimensions (no CLS).
 *
 * Native controls are OFF until playback starts, so the poster shows as a clean
 * portrait card with one play button (iOS otherwise paints its own transport
 * controls over the poster). On play the native controls come back so the
 * visitor can scrub, mute and go fullscreen.
 *
 * The media sources are attached by script after the window `load` event, not
 * in the HTML. Playwright's WebKit (the check:browsers gate, no media backend on
 * Windows) never finishes resource selection for a <video> with <source>
 * children, so the page's load event never fires and the gate times out.
 * Without JS the poster still renders (rule 1: content visible); videos on this
 * site load via script by design (CLAUDE.md rule 2).
 * Assets live in /public/lp/testimonials/ (encoded by ffmpeg, 540px wide, each
 * under the perf gate's 1.5 MB per-video budget).
 */
import type { VideoItem } from '@/lib/videoTestimonials';
export type { VideoItem };

export interface Props {
  items: VideoItem[];
  class?: string;
}
const { items, class: className = '' } = Astro.props;
---

<ul class:list={['ss-vt', className]} data-vt-list>
  {items.map((v, i) => (
    <li class="ss-vt__item">
      <div class="ss-vt__frame" data-vt>
        <video
          class="ss-vt__video"
          preload="none"
          playsinline
          poster={v.poster}
          width={v.width}
          height={v.height}
          aria-label={`${v.label}, ${v.duration}`}
          data-mp4={v.mp4}
          data-webm={v.webm}
        ></video>
        <button type="button" class="ss-vt__play" data-vt-play aria-label={`Play ${v.label.toLowerCase()} ${i + 1}`}>
          <span class="ss-vt__play-ico" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z" /></svg>
          </span>
        </button>
        <div class="ss-vt__meta" aria-hidden="true">
          <span class="ss-vt__label">{v.label}</span>
          <span class="ss-vt__dur">{v.duration}</span>
        </div>
      </div>
    </li>
  ))}
</ul>

<script>
  const init = () => {
    const frames = Array.from(document.querySelectorAll<HTMLElement>('[data-vt]'));
    const videos = frames.map((f) => f.querySelector<HTMLVideoElement>('video')).filter((v): v is HTMLVideoElement => !!v);
    for (const f of frames) {
      if (f.dataset.ready) continue;
      f.dataset.ready = '1';
      const vid = f.querySelector<HTMLVideoElement>('video');
      const btn = f.querySelector<HTMLButtonElement>('[data-vt-play]');
      if (!vid || !btn) continue;
      // Attach sources only AFTER the window load event (see header note) —
      // doing it at script time still blocks `load` in WebKit's media-less build.
      const attach = () => {
        if (vid.dataset.attached) return;
        vid.dataset.attached = '1';
        for (const [key, type] of [['webm', 'video/webm'], ['mp4', 'video/mp4']] as const) {
          const src = vid.dataset[key];
          if (!src) continue;
          const el = document.createElement('source');
          el.src = src;
          el.type = type;
          vid.appendChild(el);
        }
      };
      if (document.readyState === 'complete') attach();
      else window.addEventListener('load', attach, { once: true });
      btn.addEventListener('click', () => {
        attach();
        for (const other of videos) if (other !== vid && !other.paused) other.pause();
        vid.controls = true;
        vid.play().catch(() => {});
      });
      vid.addEventListener('play', () => {
        f.classList.add('is-playing');
        vid.controls = true;
        for (const other of videos) if (other !== vid && !other.paused) other.pause();
      });
      vid.addEventListener('ended', () => { f.classList.remove('is-playing'); vid.controls = false; vid.currentTime = 0; });
    }
  };
  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  /* A snap-scrolling rail on phones (cards peek), a centred row from tablet up.
     Portrait video never stretches to fill a wide row. */
  .ss-vt { display:flex; gap: var(--space-3); overflow-x:auto; scroll-snap-type:x mandatory; padding: 0 0 var(--space-2); margin: 0 calc(-1 * var(--space-3)); padding-inline: var(--space-3); scrollbar-width:none; }
  .ss-vt::-webkit-scrollbar { display:none; }
  .ss-vt__item { flex: 0 0 min(78vw, 300px); scroll-snap-align:center; }
  @media (min-width: 720px) { .ss-vt { justify-content:center; overflow:visible; margin:0; padding:0; } .ss-vt__item { flex: 0 0 300px; } }
  .ss-vt__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    border-radius: 22px;
    overflow: hidden;
    background: var(--surface-c);
    border: 1px solid color-mix(in srgb, var(--fg) 12%, transparent);
    box-shadow: 0 30px 60px -30px rgba(0,0,0,.6);
    transition: transform var(--dur-base) var(--ease-out);
  }
  @media (hover:hover) { .ss-vt__frame:hover { transform: translateY(-4px); } }
  .ss-vt__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; background: #000; }
  .ss-vt__play { position: absolute; inset: 0; display: grid; place-items: center; background: linear-gradient(180deg, transparent 40%, color-mix(in srgb, #000 70%, transparent)); color: #fff; border: 0; cursor: pointer; padding: 0; }
  .ss-vt__play-ico { display: grid; place-items: center; width: 72px; height: 72px; border-radius: 50%; background: color-mix(in srgb, #fff 94%, transparent); color: #000; box-shadow: 0 16px 40px -12px rgba(0,0,0,.7); transition: transform var(--dur-fast) var(--ease-out); padding-left: 4px; }
  .ss-vt__play:hover .ss-vt__play-ico { transform: scale(1.06); }
  .ss-vt__play:focus-visible { outline: 3px solid var(--accent-text); outline-offset: -3px; }
  .ss-vt__meta { position:absolute; left: var(--space-3); right: var(--space-3); bottom: var(--space-3); display:flex; align-items:flex-end; justify-content:space-between; gap: var(--space-2); color:#fff; pointer-events:none; }
  .ss-vt__label { font-size: var(--text-small); font-weight:600; line-height:1.3; text-shadow: 0 1px 6px rgba(0,0,0,.7); }
  .ss-vt__dur { flex:none; font-size: var(--text-label); font-weight:700; padding: 0.2rem 0.5rem; border-radius:999px; background: color-mix(in srgb, #000 55%, transparent); border:1px solid color-mix(in srgb, #fff 25%, transparent); }
  .is-playing .ss-vt__play, .is-playing .ss-vt__meta { display: none; }
  @media (prefers-reduced-motion: reduce) { .ss-vt__play-ico, .ss-vt__frame { transition: none; } }
</style>
