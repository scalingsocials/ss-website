---
/**
 * CreativeWall — a horizontal slider of real ad creatives. See 08 §7, 02 §1.2.
 *
 * Creatives are different aspect ratios, so a cropped grid loses the artwork.
 * This shows each one WHOLE at a fixed height (natural width) in a scroll-snap
 * rail — drag/scroll/swipe, no JS, fast, and good on mobile. Images optimised by
 * astro:assets. Videos are held until compressed to the 1.5MB clip budget (08 §8).
 *
 * Ink register. Client permission required before any client creative appears.
 */
import { Image } from 'astro:assets';
import { CREATIVES } from '@/lib/creatives';

export interface Props {
  limit?: number;
  class?: string;
}
const { limit, class: className = '' } = Astro.props;
const items = typeof limit === 'number' ? CREATIVES.slice(0, limit) : CREATIVES;
---

{items.length > 0 ? (
  <div data-creative-wall class:list={['ss-rail', className]}>
    <ul class="ss-rail__track">
      {items.map((c) => (
        <li class="ss-rail__item">
          <Image
            src={c.src}
            alt={c.alt}
            width={c.src.width}
            height={c.src.height}
            widths={[300, 600]}
            sizes="(max-width: 640px) 60vw, 320px"
            loading="lazy"
            decoding="async"
            class="ss-rail__img"
          />
        </li>
      ))}
    </ul>
  </div>
) : (
  <div class:list={['rounded-[var(--radius-card)] border border-dashed border-[var(--rule-c)] p-[var(--space-6)] text-center', className]}>
    <p class="text-small text-[var(--fg-muted)]">
      TODO: [creatives] — drop stills into <code>src/assets/Creatives/</code>.
    </p>
  </div>
)}

<style>
  .ss-rail {
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    /* full-bleed to the section edge for a nicer rail on the dark band */
    margin-inline: calc(-1 * var(--space-3));
    padding-inline: var(--space-3);
  }
  .ss-rail::-webkit-scrollbar { display: none; }
  .ss-rail__track {
    display: flex;
    gap: var(--space-3);
    width: max-content;
    padding-block: 2px;
  }
  .ss-rail__item {
    flex: none;
    scroll-snap-align: start;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid var(--rule-c);
    background: var(--surface-c);
    transition: transform var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);
  }
  .ss-rail__img {
    height: clamp(280px, 46vh, 420px);
    width: auto;
    display: block;
    object-fit: contain;
    background: var(--surface-c);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ss-rail__item:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--accent-fill) 55%, var(--rule-c)); }
  }
</style>
