---
/**
 * CreativeWall — real ad creatives. See 08 §7, 02 §1.2, 08 §8.
 *
 * Renders the real client creative stills from src/assets/Creatives/, optimised
 * by astro:assets (webp/avif, srcset, lazy, explicit dimensions → no CLS). The
 * supplied videos are held until compressed to the 1.5MB clip budget; when a
 * cleared, compressed clip lands, a card can carry it with the poster→play→
 * click-to-unmute mechanism in motion.ts.
 *
 * Ink register. Client permission required before any client creative appears.
 */
import { Image } from 'astro:assets';
import { CREATIVES } from '@/lib/creatives';

export interface Props {
  /** Cap how many to show on the homepage; the full set lives on /work/. */
  limit?: number;
  class?: string;
}
const { limit, class: className = '' } = Astro.props;
const items = typeof limit === 'number' ? CREATIVES.slice(0, limit) : CREATIVES;
---

{items.length > 0 ? (
  <ul data-creative-wall class:list={['grid grid-cols-2 gap-[var(--space-3)] sm:grid-cols-3 lg:grid-cols-4', className]}>
    {items.map((c) => (
      <li class="ss-clip group relative overflow-hidden rounded-[var(--radius-card)] border border-[var(--rule-c)] bg-[var(--surface-c)]">
        <Image
          src={c.src}
          alt={c.alt}
          width={c.src.width}
          height={c.src.height}
          widths={[360, 720]}
          sizes="(max-width: 640px) 45vw, (max-width: 1024px) 30vw, 22vw"
          loading="lazy"
          decoding="async"
          class="ss-clip__img aspect-[4/5] w-full object-cover"
        />
      </li>
    ))}
  </ul>
) : (
  <div class:list={['rounded-[var(--radius-card)] border border-dashed border-[var(--rule-c)] p-[var(--space-6)] text-center', className]}>
    <p class="text-small text-[var(--fg-muted)]">
      TODO: [creatives] — drop stills into <code>src/assets/Creatives/</code> and they appear here.
    </p>
  </div>
)}

<style>
  .ss-clip { transition: transform var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out); }
  .ss-clip__img { transition: transform 0.6s var(--ease-out); background: var(--surface-c); }
  @media (prefers-reduced-motion: no-preference) {
    .ss-clip:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--accent-fill) 50%, var(--rule-c)); }
    .ss-clip:hover .ss-clip__img { transform: scale(1.05); }
  }
</style>
