---
/**
 * FounderNote — a named human. See 08 §7.
 *
 * Uses a real co-founder, their real photo and real LinkedIn (11 §1). The
 * portrait is the founder's own photo, recovered from the previous team page
 * (src/assets/founders/README.md) — never a stock face on a named person; if the
 * photo is ever missing, the initials tile falls back in.
 *
 * TODO: confirm the pull-quote with the founder. The line below reflects the
 * documented positioning (work to the P&L, show the maths, disqualify honestly)
 * but has not been approved as a verbatim quote.
 */
import { Image } from 'astro:assets';
import jamalPhoto from '@/assets/founders/jamal-khan.jpg';

export interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const founder = {
  name: 'Jamal Khan',
  role: 'Co-founder, Scaling Socials',
  linkedin: 'https://www.linkedin.com/in/jamal-mohammed-khan-4555001b2/',
  photo: jamalPhoto,
  quote:
    'We would rather show you the number that moved and the one that did not, than a dashboard that flatters us. If we cannot make the maths work for your brand, we will tell you.',
};
---

<figure data-founder class:list={['grid gap-[var(--space-5)] md:grid-cols-[auto_1fr] md:items-center md:gap-[var(--space-6)]', className]}>
  <div class="flex items-center gap-[var(--space-4)]">
    <Image
      src={founder.photo}
      alt={`${founder.name}, ${founder.role}`}
      width={124}
      height={155}
      widths={[124, 248]}
      sizes="124px"
      loading="lazy"
      class="h-[132px] w-[108px] shrink-0 rounded-[var(--radius-card)] border border-[var(--rule-c)] object-cover object-top md:h-[155px] md:w-[124px]"
    />
    <div class="md:hidden">
      <div class="font-semibold text-[var(--fg)]">{founder.name}</div>
      <div class="text-small text-[var(--fg-muted)]">{founder.role}</div>
    </div>
  </div>

  <div class="flex flex-col gap-[var(--space-4)]">
    <blockquote class="max-w-[52ch] text-h3 font-medium leading-snug text-[var(--fg)]">
      “{founder.quote}”
    </blockquote>
    <figcaption class="hidden flex-wrap items-baseline gap-x-[var(--space-2)] text-small md:flex">
      <span class="font-semibold text-[var(--fg)]">{founder.name}</span>
      <span class="text-[var(--fg-muted)]">{founder.role}</span>
      <a href={founder.linkedin} target="_blank" rel="noopener" class="font-medium text-[var(--accent-text)]">LinkedIn</a>
    </figcaption>
  </div>
</figure>
