---
/**
 * ServiceCard — one service pillar as a large, premium, illustrated card.
 *
 * Anatomy (reference-inspired, not copied): a full pastel-tinted card, a bold
 * title, a short descriptor, and a custom service SVG illustration anchored to
 * the bottom that auto-themes to the card's hue. A corner arrow badge signals
 * the link and fills on hover.
 *
 * Used on the homepage services grid (and anywhere the pillars are cross-linked)
 * so every service card on the site matches.
 *
 * COLOUR / SHAPE NOTE (owner-directed, 2026-09-12): the services grid uses soft
 * per-service PASTEL cards and a softer corner radius — a deliberate, contained
 * exception to "the accent is rare" (§5c) and the 4px card radius (§5). The hue
 * is decorative (card wash + illustration); title/descriptor read the semantic
 * tokens, so §5a contrast rules hold. The cards sit inside <main data-register
 * ="paper">, so those tokens resolve here.
 */
import type { NavLeaf } from '@/lib/nav';

interface Props {
  service: NavLeaf;
  /** 0-based position — drives the pastel hue and the illustration. */
  index: number;
}
const { service, index } = Astro.props;

// The six pastel hues live in the scoped <style> below, selected by data-hue.
// They are NOT set via an inline `style` attribute: the production CSP is strict
// hash-based and blocks inline style attributes (you cannot hash one), which
// silently dropped the per-card colours on the live site. A data attribute +
// hashed CSS is CSP-safe. See docs/spec/01 CSP notes.
const hue = index % 6;
---

<a
  href={service.href}
  class="svc group"
  data-hue={hue}
>
  <span class="svc__arrow" aria-hidden="true">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
      <path d="M5 11 11 5M6 5h5v5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>

  <div class="svc__body">
    <h3 class="svc__title">{service.label}</h3>
    <p class="svc__desc">{service.descriptor}</p>
  </div>

  <div class="svc__art" aria-hidden="true">
    {/* Paints come from CSS classes (.ai/.am/.si/.sm) not `fill="var(...)"`:
        var() in SVG presentation attributes isn't reliable cross-browser
        (renders black on WebKit/iOS). In the CSS `fill`/`stroke` property it is. */}
    <svg viewBox="0 0 240 160" fill="none" xmlns="http://www.w3.org/2000/svg">
      <ellipse cx="120" cy="150" rx="86" ry="8" class="ai" opacity="0.10" />

      {index === 0 && (
        <g>
          {/* Performance marketing — rising bars + trend arrow */}
          <rect x="66" y="104" width="22" height="42" rx="6" class="ai" opacity="0.78" />
          <rect x="96" y="86" width="22" height="60" rx="6" class="ai" opacity="0.88" />
          <rect x="126" y="66" width="22" height="80" rx="6" class="ai" />
          <rect x="156" y="48" width="22" height="98" rx="6" class="ai" />
          <rect x="156" y="48" width="22" height="12" rx="6" fill="#fff" opacity="0.28" />
          <path d="M60 98 96 82 126 62 156 46 186 30" class="sm" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M172 28h16v16" class="sm" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
          <circle cx="186" cy="30" r="6" class="ai" />
        </g>
      )}

      {index === 1 && (
        <g>
          {/* SEO — magnifier over a rising line */}
          <rect x="150" y="98" width="13" height="30" rx="4" class="ai" opacity="0.3" />
          <rect x="168" y="84" width="13" height="44" rx="4" class="ai" opacity="0.3" />
          <circle cx="108" cy="78" r="42" fill="#fff" opacity="0.55" />
          <circle cx="108" cy="78" r="42" class="si" stroke-width="9" />
          <path d="M86 92 102 76 114 84 134 60" class="si" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
          <line x1="140" y1="112" x2="166" y2="138" class="si" stroke-width="13" stroke-linecap="round" />
        </g>
      )}

      {index === 2 && (
        <g>
          {/* Shopify development — shopping bag + coin */}
          <path d="M74 74h92l9 62a8 8 0 0 1-8 9H73a8 8 0 0 1-8-9z" class="ai" />
          <path d="M92 74h56l6 62H86z" fill="#fff" opacity="0.14" />
          <path d="M96 78v-8a24 24 0 0 1 48 0v8" class="si" stroke-width="8" stroke-linecap="round" />
          <circle cx="120" cy="112" r="18" class="am" />
          <path d="M120 103v18M114 108h9a4 4 0 0 1 0 8h-9m0 0h10" class="si" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      )}

      {index === 3 && (
        <g>
          {/* Web development — browser window + code */}
          <rect x="78" y="56" width="112" height="74" rx="12" class="ai" opacity="0.2" />
          <rect x="56" y="62" width="118" height="76" rx="13" fill="#fff" opacity="0.6" />
          <rect x="56" y="62" width="118" height="76" rx="13" class="si" stroke-width="3" opacity="0.4" />
          <circle cx="72" cy="76" r="4.5" class="ai" />
          <circle cx="86" cy="76" r="4.5" class="ai" opacity="0.55" />
          <circle cx="100" cy="76" r="4.5" class="ai" opacity="0.4" />
          <path d="M96 98 84 110l12 12M138 98l12 12-12 12" class="si" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M126 94 108 126" class="sm" stroke-width="6" stroke-linecap="round" />
        </g>
      )}

      {index === 4 && (
        <g>
          {/* Social media marketing — chat bubbles */}
          <path d="M62 62h74a15 15 0 0 1 15 15v28a15 15 0 0 1-15 15h-38l-20 17v-17h-1a15 15 0 0 1-15-15V77a15 15 0 0 1 15-15z" class="ai" />
          <path d="M99 82c-7-9-20-3-20 7 0 9 11 13 20 20 9-7 20-11 20-20 0-10-13-16-20-7z" fill="#fff" opacity="0.9" />
          <circle cx="170" cy="118" r="22" class="am" />
          <path d="M164 108v20l17-10z" fill="#fff" />
        </g>
      )}

      {index === 5 && (
        <g>
          {/* CRO — conversion funnel */}
          <circle cx="92" cy="50" r="6" class="am" />
          <circle cx="118" cy="46" r="6" class="am" />
          <circle cx="144" cy="50" r="6" class="am" />
          <path d="M70 64h100l-38 44v26l-24 12v-38z" class="ai" />
          <path d="M70 64h100l-14 16H84z" fill="#fff" opacity="0.16" />
          <circle cx="120" cy="140" r="17" class="am" />
          <path d="M112 140 118 146l10-12" class="si" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      )}
    </svg>
  </div>
</a>

<style>
  /* Per-service pastel hues. Kept here (a hashed style block) rather than an
     inline style attribute, which the production CSP blocks. a = lightest card
     wash, b = mid highlight, ink = the saturated hue for the illustration. */
  .svc[data-hue='0'] { --c-a: #eef0ff; --c-b: #c6c9ff; --c-ink: #4b4ed6; } /* periwinkle */
  .svc[data-hue='1'] { --c-a: #e1f5f0; --c-b: #a9e2d7; --c-ink: #1c857a; } /* teal */
  .svc[data-hue='2'] { --c-a: #e6f1fb; --c-b: #b7ddf4; --c-ink: #2181b4; } /* sky */
  .svc[data-hue='3'] { --c-a: #f2ebfe; --c-b: #d6c2fb; --c-ink: #6c43c8; } /* violet */
  .svc[data-hue='4'] { --c-a: #fdeaf1; --c-b: #f6c6d9; --c-ink: #c0446f; } /* blush */
  .svc[data-hue='5'] { --c-a: #feefe1; --c-b: #fbd2ac; --c-ink: #b67328; } /* amber */

  /* Illustration paints — CSS fill/stroke resolve var() reliably everywhere. */
  .svc__art .ai { fill: var(--c-ink); }
  .svc__art .am { fill: var(--c-b); }
  .svc__art .si { stroke: var(--c-ink); }
  .svc__art .sm { stroke: var(--c-b); }

  .svc {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    min-height: 340px;
    padding: var(--space-4);
    border-radius: 20px; /* softer than the 4px card radius — owner-directed, see NOTE */
    background: linear-gradient(158deg, var(--c-a), color-mix(in srgb, var(--c-b) 55%, var(--c-a)));
    border: 1px solid color-mix(in srgb, var(--c-ink) 14%, transparent);
    text-decoration: none;
    overflow: hidden;
    isolation: isolate;
    transition:
      transform var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }

  .svc__body {
    position: relative;
    z-index: 2;
    max-width: 22ch;
  }
  .svc__title {
    font-size: clamp(1.375rem, 1.1rem + 1vw, 1.75rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: var(--tracking-heading);
    color: var(--fg);
    padding-right: 2.5rem; /* clear the corner arrow badge */
  }
  .svc__desc {
    margin-top: var(--space-2);
    font-size: var(--text-small);
    line-height: 1.5;
    color: color-mix(in srgb, var(--fg) 82%, var(--c-ink));
  }

  /* Corner link affordance. */
  .svc__arrow {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    z-index: 3;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--c-ink) 30%, transparent);
    color: var(--c-ink);
    background: color-mix(in srgb, #fff 45%, transparent);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  /* Illustration anchored to the bottom, bleeding to the card edges. */
  .svc__art {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    pointer-events: none;
  }
  .svc__art svg {
    width: 82%;
    max-width: 250px;
    height: auto;
    transform-origin: bottom center;
    transition: transform var(--dur-base) var(--ease-out);
  }

  @media (prefers-reduced-motion: no-preference) {
    .svc:hover {
      transform: translateY(-6px);
      border-color: color-mix(in srgb, var(--c-ink) 32%, transparent);
      box-shadow: 0 30px 60px -32px color-mix(in srgb, var(--c-ink) 70%, transparent);
    }
    .svc:hover .svc__art svg { transform: scale(1.05); }
    .svc:hover .svc__arrow {
      background: var(--c-ink);
      border-color: var(--c-ink);
      color: #fff;
      transform: translate(2px, -2px);
    }
  }
  .svc:focus-visible {
    outline: 2px solid var(--c-ink);
    outline-offset: 3px;
  }
  .svc:focus-visible .svc__arrow {
    background: var(--c-ink);
    border-color: var(--c-ink);
    color: #fff;
  }
</style>
