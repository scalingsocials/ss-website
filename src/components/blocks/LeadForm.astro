---
/**
 * LeadForm — the 2-step lead capture form. See 04-LEAD-CAPTURE-AND-TRACKING.md,
 * 01 §2.1 (intentionally VANILLA JS, not React — a 2-step form doesn't justify a
 * ~60KB runtime on a content page, and this must stay under the 60KB budget).
 *
 * Progressive enhancement: with JS off it is one honest form that posts to
 * /api/lead. With JS on (src/scripts/leadform.ts) it becomes two steps, validates
 * inline, and captures the lead as soon as step 1 is done — sending a `partial`
 * record then, and an `abandoned` beacon if the visitor leaves without submitting
 * (Shopify-style abandoned capture). Step 2 questions are service-specific.
 */
import type { Field } from '@/lib/formFields';
import FieldControl from '@/components/blocks/FieldControl.astro';
export type { Field };

export interface Props {
  source: string; // e.g. 'performance-marketing', 'audit'
  heading?: string;
  subheading?: string;
  submitLabel?: string;
  /** Service-specific step-2 questions. Their names are prefixed q_ on submit. */
  questions?: Field[];
  /** Pre-selected "service you're interested in" dropdown (service pages). */
  service?: { options: string[]; value: string };
  /** Override the default step-1 fields (name/email/phone). */
  step1Fields?: Field[];
  /** Override the default step-2 lead fields (company/website). */
  step2Lead?: Field[];
  /** Show the free-text message textarea at the end of step 2 (default true). */
  showMessage?: boolean;
  messageLabel?: string;
  /** Prominent, elevated card treatment (service-page heroes). */
  elevated?: boolean;
  class?: string;
}

const {
  source,
  heading = 'Get a free growth plan',
  subheading = 'A written audit in three working days, whether or not you hire us.',
  submitLabel = 'Get my free growth plan',
  questions = [],
  service,
  step1Fields,
  step2Lead: step2LeadProp,
  showMessage = true,
  messageLabel = 'Anything else? (optional)',
  elevated = false,
  class: className = '',
} = Astro.props;

// Step 1 asks only for who they are — kept short so the form fits one screen and
// the `partial` record captures a reachable lead immediately.
const step1: Field[] = step1Fields ?? [
  { name: 'name', label: 'Full name', type: 'text', required: true, autocomplete: 'name' },
  { name: 'email', label: 'Work email', type: 'email', required: true, autocomplete: 'email' },
  { name: 'phone', label: 'Phone or WhatsApp', type: 'tel', required: true, autocomplete: 'tel' },
];

// Brand + website move to step 2 as standard lead fields (not q_ answers), so
// step 1 stays short but we still capture them on a completed submission.
const step2Lead: Field[] = step2LeadProp ?? [
  { name: 'company', label: 'Brand or company', type: 'text', required: true, autocomplete: 'organization' },
  { name: 'website', label: 'Website or Instagram', type: 'text', required: false, autocomplete: 'url', placeholder: 'yourbrand.com' },
];

// Pre-selected service dropdown (service pages tag the lead with the page's own
// service, still changeable). Rendered at the top of step 1.
const serviceField: Field | null = service
  ? { name: 'service', label: 'Service you’re interested in', type: 'select', required: false, options: service.options, defaultValue: service.value }
  : null;

const field = (f: Field, prefix = '') => ({ ...f, key: `${prefix}${f.name}` });
const s1 = step1.map((f) => field(f));
const s2lead = step2Lead.map((f) => field(f));
const s2 = questions.map((f) => field(f, 'q_'));
---

<form
  data-lead-form
  data-source={source}
  action="/api/lead/"
  method="post"
  class:list={['ss-leadform flex flex-col gap-[var(--space-4)] rounded-[var(--radius-card)] border border-[var(--rule-c)] bg-[var(--ground)] p-[var(--space-5)]', elevated && 'ss-leadform--elevated', className]}
  novalidate
>
  <input type="hidden" name="lead_id" value="" />
  <input type="hidden" name="source" value={source} />
  <input type="hidden" name="page" value="" />
  <!-- honeypot -->
  <div class="ss-hp" aria-hidden="true">
    <label>Company website<input type="text" name="company_website" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="flex flex-col gap-[0.35rem]">
    <div class="flex items-center justify-between">
      <h3 class="text-h4 font-semibold text-[var(--fg)]">{heading}</h3>
      <span class="text-label text-[var(--fg-muted)]" data-lf-progress hidden>
        Step <span data-lf-step>1</span> of 2
      </span>
    </div>
    {subheading && <p class="text-small text-[var(--fg-muted)]">{subheading}</p>}
  </div>

  <fieldset data-step="1" class="ss-lf-step flex flex-col gap-[var(--space-3)]">
    <legend class="sr-only">Your details</legend>
    {serviceField && <FieldControl field={serviceField} name={serviceField.name} />}
    {s1.map((f) => <FieldControl field={f} name={f.key} />)}
    <div class="ss-lf-nav flex justify-end">
      <button type="button" data-next class="ss-btn-primary">Next</button>
    </div>
  </fieldset>

  <fieldset data-step="2" class="ss-lf-step flex flex-col gap-[var(--space-3)]">
    <legend class="sr-only">About your brand</legend>
    {s2lead.map((f) => <FieldControl field={f} name={f.key} />)}
    {s2.map((f) => <FieldControl field={f} name={f.key} />)}
    {showMessage && (
      <label class="flex flex-col gap-[0.3rem]">
        <span class="text-small font-medium text-[var(--fg)]">{messageLabel}</span>
        <textarea name="message" rows="2" class="ss-input" placeholder="Context, links, targets…"></textarea>
      </label>
    )}
    <!-- Cloudflare Turnstile (spam). Public site key; rendered by leadform.ts so
         it survives View Transitions. No-JS submits fall back to the honeypot. -->
    <div class="ss-turnstile" data-sitekey="0x4AAAAAAEnPLoBC02N8dQMm"></div>
    <div class="ss-lf-nav flex items-center justify-between gap-[var(--space-2)]">
      <button type="button" data-back class="ss-btn-ghost" hidden>Back</button>
      <button type="submit" class="ss-btn-primary ml-auto">{submitLabel}</button>
    </div>
  </fieldset>

  <p class="ss-lf-status text-small" role="status" aria-live="polite" data-lf-status hidden></p>
  <p class="text-label text-[var(--fg-muted)]">No spam. We reply within one working day.</p>
</form>

<script>
  import '@/scripts/leadform.ts';
</script>

<style>
  .ss-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  /* Elevated treatment for service-page heroes: a prominent, lifted card. */
  .ss-leadform--elevated {
    box-shadow: 0 40px 80px -48px color-mix(in srgb, var(--accent-fill) 55%, transparent),
                0 2px 8px -4px color-mix(in srgb, var(--color-black) 30%, transparent);
    padding: var(--space-6);
  }
  .ss-leadform--elevated :global(.ss-input) { padding: 0.72rem var(--space-3); }
  .ss-input {
    width: 100%;
    border: 1px solid color-mix(in srgb, var(--fg-muted) 65%, transparent);
    border-radius: var(--radius-input);
    background: var(--ground);
    color: var(--fg);
    padding: 0.62rem var(--space-3);
    font-size: var(--text-body);
    font-family: inherit;
    transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }
  .ss-input::placeholder { color: var(--fg-muted); }
  .ss-input:hover { border-color: var(--fg-muted); }
  .ss-input:focus-visible { outline: none; border-color: var(--accent-text); box-shadow: 0 0 0 3px var(--accent-wash); }
  .ss-input[aria-invalid='true'] { border-color: var(--neg); }
  .ss-btn-primary {
    border-radius: var(--radius-button);
    background: var(--accent-fill);
    color: var(--accent-on);
    font-weight: 600;
    padding: 0.65rem var(--space-4);
    transition: transform var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
  }
  .ss-btn-primary:hover { transform: translateY(-1px); background: var(--accent-hover); }
  .ss-btn-ghost {
    border-radius: var(--radius-button);
    color: var(--fg-muted);
    padding: 0.65rem var(--space-3);
    font-weight: 500;
  }
  .ss-btn-ghost:hover { color: var(--fg); }
</style>
