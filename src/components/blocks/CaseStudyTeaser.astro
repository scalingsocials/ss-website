---
/**
 * CaseStudyTeaser — image cards for the homepage proof section.
 *
 * Uses generic vertical labels and dummy imagery (11 §6) — no invented client
 * names or metrics (CLAUDE.md §15). Real case-study cards with result tables
 * (CaseStudyCard) replace these once written and permissioned.
 */
import { CASE_TEASERS } from '@/lib/media';

export interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<ul data-case-teaser class:list={['grid gap-[var(--space-4)] sm:grid-cols-2 lg:grid-cols-3', className]}>
  {CASE_TEASERS.map((c) => (
    <li>
      <a href={c.href} class="ss-case group block h-full overflow-hidden rounded-[var(--radius-card)] border border-[var(--rule-c)] bg-[var(--ground)] no-underline">
        <div class="ss-case__imgwrap relative overflow-hidden">
          <img
            src={c.image}
            alt={`${c.category} case study`}
            width="800"
            height="600"
            loading="lazy"
            decoding="async"
            class="ss-case__img aspect-[4/3] w-full object-cover"
          />
          <span class="absolute left-[var(--space-3)] top-[var(--space-3)] rounded-full border border-[var(--rule-c)] bg-[var(--ground)] px-[0.7rem] py-[0.2rem] text-label font-semibold text-[var(--fg)]">
            {c.category}
          </span>
        </div>
        <div class="flex flex-col gap-[var(--space-2)] p-[var(--space-4)]">
          <p class="text-body leading-snug text-[var(--fg)] group-hover:text-[var(--accent-text)]">{c.summary}</p>
          <span class="inline-flex items-center gap-[0.35rem] text-small font-medium text-[var(--accent-text)]">
            Read the case study
            <svg class="ss-case__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </div>
      </a>
    </li>
  ))}
</ul>

<style>
  .ss-case { transition: transform var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out); }
  .ss-case__img { transition: transform 0.6s var(--ease-out); }
  .ss-case__arrow { transition: transform var(--dur-fast) var(--ease-out); }
  @media (prefers-reduced-motion: no-preference) {
    .ss-case:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--accent-fill) 45%, var(--rule-c)); box-shadow: 0 24px 50px -30px color-mix(in srgb, var(--color-black) 45%, transparent); }
    .ss-case:hover .ss-case__img { transform: scale(1.05); }
    .ss-case:hover .ss-case__arrow { transform: translateX(3px); }
  }
</style>
