---
/**
 * CaseStudyCard — a proof card with a real result table, not a thumbnail.
 * See 08-DESIGN-BRIEF.md §7.8 and 02 §5.2.
 *
 * The card is a STATE CHANGE with attribution, like Delta: it requires a client
 * and a period, and shows before→after as real values in the HTML. It must never
 * degrade into a big number with a small label (08 §1) — that treatment says
 * nothing and every agency site uses it.
 *
 * Structure, top to bottom: the annotation marker (08 §3 — a thin vertical rule
 * with a tag, the site's motif) carrying the archetype; the headline, which is
 * the story; the delta itself, which is the proof; then attribution and the
 * read link. Elevation is a 1px rule, never a shadow (08 §9). Register-agnostic.
 */
export interface Metric {
  label: string; // "Account ROAS"
  before: string; // "1.75x"
  after: string; // "3.94x"
  direction?: 'up' | 'down';
}

export interface Props {
  client: string;
  period: string;
  headline: string;
  /** The annotation tag — what we did, e.g. "Turned around an inherited account". */
  archetype?: string;
  category?: string; // "Meta Ads"
  metrics?: Metric[];
  /**
   * For mature accounts with no honest before→after: a held value (a floor, a
   * run length). Rendered in the same slot as the delta, without a direction,
   * because inventing a Delta for a stability story would be a lie.
   */
  stat?: { label: string; value: string };
  href: string;
  class?: string;
}

const {
  client,
  period,
  headline,
  archetype,
  category,
  metrics = [],
  stat,
  href,
  class: className = '',
} = Astro.props;

const [lead, ...rest] = metrics;
---

<a
  href={href}
  data-case-study-card
  class:list={[
    'ss-cs group relative flex h-full flex-col gap-[var(--space-4)] rounded-[var(--radius-card)] border border-[var(--rule-c)] p-[var(--space-5)] no-underline',
    className,
  ]}
>
  <!-- annotation marker: thin rule + tag (08 §3) -->
  <div class="flex items-start gap-[var(--space-3)]">
    <span class="ss-cs__rule mt-[0.3rem] w-px shrink-0 self-stretch bg-[var(--accent-graphic)]" aria-hidden="true"></span>
    <span class="flex flex-col gap-[0.1rem]">
      {archetype && (
        <span class="text-label font-semibold leading-snug text-[var(--accent-text)]">{archetype}</span>
      )}
      <span class="text-label text-[var(--fg-muted)]">{client}</span>
    </span>
  </div>

  <p class="text-h4 font-semibold leading-snug text-[var(--fg)] group-hover:text-[var(--accent-text)]">
    {headline}
  </p>

  {lead && (
    <div class="mt-auto flex flex-col gap-[0.35rem]">
      <span class="text-label text-[var(--fg-muted)]">{lead.label}</span>
      <span class="flex flex-wrap items-baseline gap-[0.5rem] display-type" data-num>
        <span class="text-h4 text-[var(--fg-muted)]">{lead.before}</span>
        <svg class="ss-cs__arrow shrink-0 text-[var(--rule-c)]" width="18" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true">
          <path d="M1 6h14M12 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span
          class:list={[
            'text-data-sm font-bold leading-none tracking-[-0.025em]',
            lead.direction === 'down' ? 'text-[var(--neg)]' : 'text-[var(--pos)]',
          ]}
        >{lead.after}</span>
      </span>
      <span class="sr-only">
        {lead.label} changed from {lead.before} to {lead.after} for {client} over {period}.
      </span>
    </div>
  )}

  {!lead && stat && (
    <div class="mt-auto flex flex-col gap-[0.35rem]">
      <span class="text-label text-[var(--fg-muted)]">{stat.label}</span>
      <span class="display-type text-data-sm font-bold leading-none tracking-[-0.025em] text-[var(--pos)]" data-num>
        {stat.value}
      </span>
    </div>
  )}

  {rest.length > 0 && (
    <dl class="flex flex-col gap-[var(--space-1)]">
      {rest.map((m) => (
        <div class="flex items-baseline justify-between gap-[var(--space-3)]">
          <dt class="text-small text-[var(--fg-muted)]">{m.label}</dt>
          <dd class="flex items-baseline gap-[0.4rem] display-type text-small" data-num>
            <span class="text-[var(--fg-muted)]">{m.before}</span>
            <span aria-hidden="true" class="text-[var(--rule-c)]">&rarr;</span>
            <span
              class:list={[
                'font-semibold',
                m.direction === 'down' ? 'text-[var(--neg)]' : 'text-[var(--pos)]',
              ]}
            >{m.after}</span>
          </dd>
        </div>
      ))}
    </dl>
  )}

  <div
    class="flex items-center justify-between gap-[var(--space-3)] border-t border-[var(--rule-c)] pt-[var(--space-3)] text-label text-[var(--fg-muted)]"
    data-num
  >
    <span>{[category, period].filter(Boolean).join(' · ')}</span>
    <span class="inline-flex items-center gap-[0.35rem] font-medium text-[var(--accent-text)]">
      Read it
      <svg class="ss-cs__go" width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </span>
  </div>
</a>

<style>
  .ss-cs {
    transition:
      border-color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .ss-cs__rule {
    transition: background-color var(--dur-base) var(--ease-out);
  }
  .ss-cs__go,
  .ss-cs__arrow {
    transition: transform var(--dur-base) var(--ease-out);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ss-cs:hover {
      transform: translateY(-3px);
      border-color: color-mix(in srgb, var(--accent-fill) 55%, var(--rule-c));
    }
    .ss-cs:hover .ss-cs__go {
      transform: translateX(3px);
    }
    .ss-cs:hover .ss-cs__arrow {
      transform: translateX(2px);
    }
  }
  .ss-cs:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 3px;
  }
</style>
