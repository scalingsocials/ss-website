---
/**
 * FieldControl — one labelled form control for LeadForm. Renders an input, a
 * (optionally grouped, optionally pre-selected) select, or a textarea from a
 * Field, plus the inline error slot leadform.ts writes into.
 *
 * `compact` renders a placeholder-driven field (label goes into the placeholder,
 * kept in an sr-only label for accessibility) — the tight, form-forward look for
 * service-page hero forms. Otherwise labels sit above the control.
 */
import type { Field } from '@/lib/formFields';
import { PRIMARY, REST } from '@/lib/countries';
import { DEFAULT_ISO } from '@/lib/phone';
// The country shown before any JS runs. Server-rendered so the closed control
// is never blank and never disagrees with the <select>'s own selected option.
const DEF = PRIMARY.find((c) => c.iso === DEFAULT_ISO) ?? PRIMARY[0]!;

export interface Props {
  field: Field;
  /** The submitted name (e.g. prefixed q_ for service-specific questions). */
  name: string;
  compact?: boolean;
}
const { field: f, name, compact = false } = Astro.props;
const inputType: 'text' | 'email' | 'tel' | 'url' =
  f.type && f.type !== 'select' && f.type !== 'textarea' ? f.type : 'text';
const isSel = (o: string) => f.defaultValue !== undefined && o === f.defaultValue;
const ph = f.placeholder ?? f.label;

// Every `tel` field becomes a dial-code select + local number, so the rule is
// the same on all five forms without touching each one. The select submits as
// `<name>_cc`; /api/lead composes the two into E.164 and validates per country.
// Rendered server-side so it works with JavaScript off — leadform.ts only
// upgrades the default to match the visitor's timezone.
const isPhone = inputType === 'tel';
const ccName = `${name}_cc`;
const defaultExample = '96067 13608';
---
<label class="ss-fc flex flex-col gap-[0.3rem]">
  {/* Compact fields carry `aria-label` on the control itself (below), so an
      sr-only <span> here made a screen reader announce the same label twice —
      three times on a select, where the empty option's text is the label too.
      The control's aria-label is the accessible name; the span was redundant. */}
  {!compact && (
    <span class="text-small font-medium text-[var(--fg)]">
      {f.label}{f.required && <span class="text-[var(--neg)]"> *</span>}
    </span>
  )}
  {f.type === 'select' ? (
    <select name={name} required={f.required} aria-label={f.label} class="ss-input">
      <option value="" selected={f.defaultValue === undefined}>{compact ? f.label : 'Select…'}</option>
      {f.optgroups
        ? f.optgroups.map((g) => (
            <optgroup label={g.label}>
              {g.options.map((o) => <option value={o} selected={isSel(o)}>{o}</option>)}
            </optgroup>
          ))
        : (f.options ?? []).map((o) => <option value={o} selected={isSel(o)}>{o}</option>)}
    </select>
  ) : isPhone ? (
    <span class="ss-input ss-phone" data-phone-field>
      <span class="ss-phone__slot">
        {/* What the visitor sees while the picker is closed: flag, dial code,
            chevron. Nothing else — a half-clipped "+91 In…" is what made this
            field look broken on a phone. aria-hidden because the <select>
            underneath is the real, labelled control. */}
        <span class="ss-phone__view" aria-hidden="true">
          <span class="ss-phone__flag" data-phone-flag>{DEF.flag}</span>
          <span class="ss-phone__dial" data-phone-dial>{DEF.dial}</span>
          <svg class="ss-phone__chev" width="12" height="12" viewBox="0 0 14 14" fill="none">
            <path d="M3 5.25 7 9.25l4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
        <select
          name={ccName}
          data-phone-cc
          class="ss-phone__cc"
          aria-label="Country dialling code"
        >
          {/* Options keep the FULL name. A native select paints its closed state
              from the selected option's own text and cannot show something
              different in the two states — so the list stays searchable (typing
              "United" still jumps to United Arab Emirates, and 209 rows of bare
              dial codes would be unusable) while the transparent layer above
              lets the closed state show just the flag and the code.

              The two pinned entries carry no group heading: labelling them would
              tell a visitor which markets we sell into, which a phone field has
              no business announcing. A disabled rule separates them instead. */}
          {PRIMARY.map((c) => (
            <option value={c.iso} data-dial={c.dial} data-flag={c.flag} selected={c.iso === DEFAULT_ISO}>
              {c.flag} {c.dial} {c.name}
            </option>
          ))}
          <option disabled>──────────</option>
          {REST.map((c) => (
            <option value={c.iso} data-dial={c.dial} data-flag={c.flag}>{c.flag} {c.dial} {c.name}</option>
          ))}
        </select>
      </span>
      <input
        type="tel"
        name={name}
        data-phone-num
        required={f.required}
        aria-label={f.label}
        placeholder={f.placeholder ?? defaultExample}
        autocomplete={f.autocomplete}
        inputmode="tel"
        class="ss-phone__num"
      />
    </span>
  ) : f.type === 'textarea' ? (
    <textarea name={name} required={f.required} rows="3" aria-label={f.label} placeholder={compact ? ph : f.placeholder} class="ss-input"></textarea>
  ) : (
    <input
      type={inputType}
      name={name}
      required={f.required}
      aria-label={f.label}
      placeholder={compact ? ph : f.placeholder}
      autocomplete={f.autocomplete}
      class="ss-input"
    />
  )}
  <span class="ss-err text-label text-[var(--neg)]" data-err hidden></span>
</label>

<style is:global>
  /* ONE control, not two boxes side by side (owner feedback, 2026-09-13: the
     old pair "looks clumsy"). The bordered box is the WRAPPER; the dial-code
     picker and the number sit inside it divided by a hairline, which is the
     shape every mainstream phone field uses. The wrapper carries .ss-input, so
     it inherits the border, radius, background and every contextual override
     (compact, elevated, the ink hero) for free, and only the padding is undone. */
  /* min-width:0 on the label as well: it is a flex item of the step column with
     min-width:auto, so a wide child's min-content size propagates up through
     the form to the hero grid track and widens the column past the viewport. */
  .ss-fc { min-width: 0; }

  /* 0,3,0 on purpose. `.ss-leadform--compact .ss-input` is 0,2,0 and sets the
     padding this element must not have; a single-class rule here would win or
     lose by bundle order. */
  .ss-leadform .ss-phone.ss-input { padding: 0; }
  .ss-phone {
    display: flex;
    align-items: stretch;
    overflow: hidden; /* keeps the children square inside the rounded border */
    min-width: 0;
  }
  /* The wrapper owns focus and error now, because neither child draws a border. */
  .ss-phone:focus-within {
    outline: none;
    border-color: var(--accent-text);
    box-shadow: 0 0 0 3px var(--accent-wash);
  }
  .ss-phone:has(.ss-phone__num[aria-invalid='true']) { border-color: var(--neg); }

  .ss-phone__slot {
    position: relative;
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    min-width: 0;
    border-right: 1px solid color-mix(in srgb, var(--fg-muted) 40%, transparent);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  /* Keyboard users need to see WHICH half has focus — the wrapper ring alone
     cannot say that. */
  .ss-phone__slot:focus-within { background: var(--accent-wash); }
  .ss-phone__view {
    display: flex;
    align-items: center;
    gap: 0.34rem;
    padding: 0 0.6rem 0 0.8rem;
    font: inherit;
    line-height: 1;
    color: var(--fg);
    white-space: nowrap;
    pointer-events: none; /* the transparent <select> beneath takes the tap */
  }
  .ss-phone__flag { font-size: 1.12em; line-height: 1; }
  .ss-phone__dial { font-variant-numeric: tabular-nums; }
  .ss-phone__chev { flex: none; opacity: 0.65; }

  /* The REAL control: full size, on top, invisible. opacity (not visibility or
     display) so it keeps its place in the accessibility tree and still opens
     the platform's own picker on tap. */
  .ss-phone__cc {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    opacity: 0;
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }

  .ss-phone__num {
    flex: 1 1 auto;
    width: auto;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--fg);
    font: inherit;
    padding: 0.62rem var(--space-3);
  }
  .ss-phone__num::placeholder { color: var(--fg-muted); }
  .ss-phone__num:focus-visible { outline: none; }
</style>
