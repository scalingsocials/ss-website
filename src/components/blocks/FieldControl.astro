---
/**
 * FieldControl — one labelled form control for LeadForm. Renders an input, a
 * (optionally grouped, optionally pre-selected) select, or a textarea from a
 * Field, plus the inline error slot leadform.ts writes into.
 *
 * `compact` renders a placeholder-driven field (label goes into the placeholder,
 * kept in an sr-only label for accessibility) — the tight, form-forward look for
 * service-page hero forms. Otherwise labels sit above the control.
 */
import type { Field } from '@/lib/formFields';
import { PRIMARY, REST } from '@/lib/countries';
import { DEFAULT_ISO } from '@/lib/phone';

export interface Props {
  field: Field;
  /** The submitted name (e.g. prefixed q_ for service-specific questions). */
  name: string;
  compact?: boolean;
}
const { field: f, name, compact = false } = Astro.props;
const inputType: 'text' | 'email' | 'tel' | 'url' =
  f.type && f.type !== 'select' && f.type !== 'textarea' ? f.type : 'text';
const isSel = (o: string) => f.defaultValue !== undefined && o === f.defaultValue;
const ph = f.placeholder ?? f.label;

// Every `tel` field becomes a dial-code select + local number, so the rule is
// the same on all five forms without touching each one. The select submits as
// `<name>_cc`; /api/lead composes the two into E.164 and validates per country.
// Rendered server-side so it works with JavaScript off — leadform.ts only
// upgrades the default to match the visitor's timezone.
const isPhone = inputType === 'tel';
const ccName = `${name}_cc`;
const defaultExample = '96067 13608';
---
<label class="ss-fc flex flex-col gap-[0.3rem]">
  {/* Compact fields carry `aria-label` on the control itself (below), so an
      sr-only <span> here made a screen reader announce the same label twice —
      three times on a select, where the empty option's text is the label too.
      The control's aria-label is the accessible name; the span was redundant. */}
  {!compact && (
    <span class="text-small font-medium text-[var(--fg)]">
      {f.label}{f.required && <span class="text-[var(--neg)]"> *</span>}
    </span>
  )}
  {f.type === 'select' ? (
    <select name={name} required={f.required} aria-label={f.label} class="ss-input">
      <option value="" selected={f.defaultValue === undefined}>{compact ? f.label : 'Select…'}</option>
      {f.optgroups
        ? f.optgroups.map((g) => (
            <optgroup label={g.label}>
              {g.options.map((o) => <option value={o} selected={isSel(o)}>{o}</option>)}
            </optgroup>
          ))
        : (f.options ?? []).map((o) => <option value={o} selected={isSel(o)}>{o}</option>)}
    </select>
  ) : isPhone ? (
    <span class="ss-phone" data-phone-field>
      <select
        name={ccName}
        data-phone-cc
        class="ss-input ss-phone__cc"
        aria-label="Country dialling code"
      >
        {/* Dial code FIRST, name second, and the select is width-capped in CSS.
            A native select shows the selected option's own text when closed, so
            it cannot be short closed and long open — capping the width means a
            long name like "United Arab Emirates" clips, but the dial code is
            always the part that survives, which is the part that matters. */}
        <optgroup label="Where we work">
          {PRIMARY.map((c) => (
            <option value={c.iso} data-dial={c.dial} title={c.name} selected={c.iso === DEFAULT_ISO}>
              {c.dial} {c.name}
            </option>
          ))}
        </optgroup>
        <optgroup label="All countries">
          {REST.map((c) => (
            <option value={c.iso} data-dial={c.dial} title={c.name}>{c.dial} {c.name}</option>
          ))}
        </optgroup>
      </select>
      <input
        type="tel"
        name={name}
        data-phone-num
        required={f.required}
        aria-label={f.label}
        placeholder={f.placeholder ?? defaultExample}
        autocomplete={f.autocomplete}
        inputmode="tel"
        class="ss-input ss-phone__num"
      />
    </span>
  ) : f.type === 'textarea' ? (
    <textarea name={name} required={f.required} rows="3" aria-label={f.label} placeholder={compact ? ph : f.placeholder} class="ss-input"></textarea>
  ) : (
    <input
      type={inputType}
      name={name}
      required={f.required}
      aria-label={f.label}
      placeholder={compact ? ph : f.placeholder}
      autocomplete={f.autocomplete}
      class="ss-input"
    />
  )}
  <span class="ss-err text-label text-[var(--neg)]" data-err hidden></span>
</label>

<style is:global>
  /* The dial code sits flush against the number as one control. Auto width on
     the select so "+971 UAE" is never clipped, and the number field takes the
     rest. Both inherit .ss-input, so focus and error states already match. */
  /* Two-class selectors on purpose: .ss-input sets `width: 100%`, which made
     the select fill the whole row and squeeze the number field to 50px on a
     360px phone. A single-class rule here would lose or win by source order. */
  .ss-phone { display: flex; gap: var(--space-2); align-items: stretch; }
  .ss-phone > .ss-phone__cc {
    flex: 0 0 auto;
    /* Wide enough for "+971 UAE"-length names; longer ones clip after the dial
       code. max-width keeps it from eating the number field on a small phone. */
    width: 8.25rem;
    max-width: 42%;
    /* padding-RIGHT only. `padding-inline` here overwrote the right padding
       that select.ss-input reserves for its chevron, so the arrow rendered on
       top of the dial code. */
    padding-left: var(--space-2);
    text-overflow: ellipsis;
  }
  .ss-phone > .ss-phone__num { flex: 1 1 auto; width: auto; min-width: 0; }
</style>
