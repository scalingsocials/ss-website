---
/**
 * FaqAccordion — <details>/<summary>, ZERO JavaScript. See CLAUDE.md §12, 01 §2.1.
 *
 * The answers live in the DOM whether the accordion is open or closed. That is
 * the whole point: an accordion that renders answers only on click gives Google
 * AI Overviews and LLM retrieval nothing to extract (03 §3.7). Never replace this
 * with a React island — <details> already does the job with no JS.
 *
 * FAQPage schema is emitted separately from the same data (seo/SchemaGraph +
 * schema/faqPage), never marking up an answer that is not visible here.
 *
 * Register-agnostic. Reads semantic vars only.
 */
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  items: FaqItem[];
  /** Open the first item by default. */
  openFirst?: boolean;
  class?: string;
}

const { items, openFirst = false, class: className = '' } = Astro.props;
---

<div data-faq class:list={['flex flex-col', className]}>
  {items.map((item, i) => (
    <details
      class="group border-t border-[var(--rule-c)] last:border-b"
      open={openFirst && i === 0}
    >
      <summary class="flex cursor-pointer list-none items-center justify-between gap-[var(--space-3)] py-[var(--space-3)] text-h4 font-semibold text-[var(--fg)]">
        {item.q}
        <svg
          class="ss-faq-caret shrink-0 text-[var(--fg-muted)]"
          width="16"
          height="16"
          viewBox="0 0 10 10"
          aria-hidden="true"
          fill="none"
        >
          <path d="M2 3.5 5 6.5 8 3.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </summary>
      <p class="max-w-[64ch] pb-[var(--space-4)] text-body leading-relaxed text-[var(--fg-muted)]">
        {item.a}
      </p>
    </details>
  ))}
</div>

<style>
  .ss-faq-caret {
    transition: transform var(--dur-fast) var(--ease-out);
  }
  details[open] > summary .ss-faq-caret {
    transform: rotate(180deg);
  }
  summary::-webkit-details-marker {
    display: none;
  }
</style>
