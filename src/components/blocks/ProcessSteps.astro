---
/**
 * ProcessSteps — the five numbered engagement phases. See 02 §3 and §5.1.
 *
 * This is the ONLY place numbered markers appear on the site (08 §7), because
 * the engagement genuinely is a sequence. Do not reuse numbered markers for
 * decoration — if it is not a real ordered sequence, it does not get numbers.
 *
 * Numerals are Anek Latin, tabular. Register-agnostic.
 */
export interface Step {
  title: string;
  body: string;
}

export interface Props {
  steps: Step[];
  class?: string;
}

const { steps, class: className = '' } = Astro.props;
---

<ol data-process-steps class:list={['flex flex-col', className]}>
  {steps.map((step, i) => (
    <li
      class:list={[
        'ss-step relative grid grid-cols-[auto_1fr] gap-x-[var(--space-4)] gap-y-[var(--space-1)] py-[var(--space-4)] pl-[var(--space-4)]',
        i > 0 && 'border-t border-[var(--rule-c)]',
      ]}
    >
      <span class="ss-step__fill" aria-hidden="true"></span>
      <span
        class="row-span-2 display-type text-data-sm font-semibold leading-none text-[var(--accent-text)]"
        data-num
        aria-hidden="true"
      >
        {String(i + 1).padStart(2, '0')}
      </span>
      <h3 class="self-center text-h4 font-semibold text-[var(--fg)]">{step.title}</h3>
      <p class="max-w-[54ch] text-small leading-relaxed text-[var(--fg-muted)]">{step.body}</p>
    </li>
  ))}
</ol>

<style>
  /* Left spine "fills" as each step scrolls into view. CSS scroll-driven, zero
     JS, progressive enhancement (unsupported browsers show a static spine). */
  .ss-step__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--accent-graphic);
    transform: scaleY(1);
    transform-origin: top;
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .ss-step__fill {
        transform: scaleY(0);
        animation: ssStepFill linear both;
        animation-timeline: view();
        animation-range: entry 12% cover 42%;
      }
      @keyframes ssStepFill {
        from { transform: scaleY(0); }
        to { transform: scaleY(1); }
      }
    }
  }
</style>
