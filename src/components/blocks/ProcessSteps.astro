---
/**
 * ProcessSteps — the numbered engagement phases. See 02 §3 and 08 §7. The one
 * place numbered markers appear (08 §7), because it is a real sequence.
 *
 * Mobile: compact cards, a 28px number chip beside the title, a short description
 * below. No connecting rail (it used to run through the body text). Desktop: a
 * horizontal row, chip above title, a thin connector between the chips only —
 * never through the text — with equal-height columns. Register-agnostic, renders
 * fully without JS, and adds no on-load opacity animation.
 */
export interface Step {
  title: string;
  body: string;
}
export interface Props {
  steps: Step[];
  class?: string;
}
const { steps, class: className = '' } = Astro.props;
---

<ol data-process-steps class:list={['ss-process', className]}>
  {steps.map((step, i) => (
    <li class="ss-process__step">
      <div class="ss-process__head">
        <span class="ss-process__chip display-type" data-num aria-hidden="true">{i + 1}</span>
        <h3 class="ss-process__title">{step.title}</h3>
      </div>
      <p class="ss-process__body">{step.body}</p>
    </li>
  ))}
</ol>

<style>
  /* Mobile: a stack of compact cards. */
  .ss-process {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .ss-process__step {
    border: 1px solid var(--rule-c);
    border-radius: var(--radius-card);
    background: var(--ground);
    padding: var(--space-4);
  }
  .ss-process__head { display: flex; align-items: center; gap: var(--space-3); }
  .ss-process__chip {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    flex: none;
    border-radius: 50%;
    background: var(--accent-fill);
    color: var(--accent-on);
    font-size: var(--text-label);
    font-weight: 700;
    line-height: 1;
  }
  .ss-process__title { font-size: var(--text-body); font-weight: 600; color: var(--fg); }
  .ss-process__body {
    margin-top: var(--space-2);
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--fg-muted);
    /* keep it to ~two lines on the phone card */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Desktop: a horizontal row; chip above title; connector between chips only. */
  @media (min-width: 768px) {
    .ss-process {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      gap: var(--space-5);
      align-items: start;
    }
    .ss-process__step { border: none; background: transparent; padding: 0; position: relative; }
    .ss-process__head { flex-direction: column; align-items: flex-start; gap: var(--space-2); }
    .ss-process__chip { position: relative; z-index: 1; }
    .ss-process__title { font-size: var(--text-h4); }
    .ss-process__body { margin-top: var(--space-1); -webkit-line-clamp: unset; overflow: visible; display: block; max-width: 32ch; }
    /* thin rail behind the chips only (chips sit on top and cover it) */
    .ss-process::before {
      content: '';
      position: absolute;
      top: 14px;
      left: 8%;
      right: 8%;
      height: 2px;
      background: var(--rule-c);
      z-index: 0;
    }
  }
</style>
