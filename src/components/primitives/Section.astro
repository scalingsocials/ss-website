---
/**
 * Section — the only component that switches register.
 *
 * Every page section is a <Section>. Register controls colour only; the type
 * scale, spacing rhythm and component shapes are identical in both. That is
 * what stops the two registers reading as two different websites.
 *
 * Rule from 08-DESIGN-BRIEF.md §9: cap ink bands at five per page. A site that
 * alternates every section stops having rhythm and starts having stripes.
 */
export interface Props {
  register?: 'paper' | 'ink';
  bleed?: boolean;          // full-bleed background, contained inner content
  size?: 'sm' | 'md' | 'lg';
  as?: 'section' | 'div' | 'header' | 'footer' | 'article';
  id?: string;
  class?: string;
  // Allow data-* passthrough (e.g. data-reveal for scroll motion).
  [attr: `data-${string}`]: string | boolean | undefined;
}

const {
  register = 'paper',
  bleed = false,
  size = 'md',
  as: Tag = 'section',
  id,
  class: className = '',
  ...rest
} = Astro.props;

const padBySize: Record<string, string> = {
  sm: 'py-[var(--space-8)]',
  md: 'py-[var(--space-12)]',
  lg: 'py-[var(--space-16)]',
};
const pad = padBySize[size];
---

<Tag
  data-register={register}
  id={id}
  class={`${pad} ${bleed ? 'w-full' : ''} ${className}`}
  {...rest}
>
  <div class="mx-auto w-full max-w-[var(--container)] px-[var(--space-3)] md:px-[var(--space-4)]">
    <slot />
  </div>
</Tag>
