---
/**
 * Table — the data-table shell. Rules, not shadows; tabular figures throughout.
 *
 * LLMs and AI Overviews parse tables with far higher fidelity than prose
 * (03 §3.5), so tables are load-bearing content, not decoration. Elevation is a
 * 1px rule (08 §9) — no shadows, no zebra fills beyond the surface token.
 *
 * Pass `columns` + `rows` for the common case, or omit both and provide your own
 * <thead>/<tbody> via the slot. Wraps in an overflow-x container so a wide table
 * scrolls inside itself instead of pushing the page sideways.
 *
 * theme.css already applies tabular-nums to every td/th, so numbers align.
 */
export interface Props {
  columns?: string[];
  rows?: (string | number)[][];
  caption?: string;
  /** Column indexes (0-based) to right-align, e.g. numeric columns. */
  numericCols?: number[];
  /** 0-based column index to softly emphasise with the surface fill. */
  highlightCol?: number;
  class?: string;
}

const { columns, rows, caption, numericCols = [], highlightCol, class: className = '' } = Astro.props;
const align = (i: number) => (numericCols.includes(i) ? 'text-right' : 'text-left');
// Static class string so Tailwind's scanner keeps it; toggled per-column.
// ss-hl-col carries a distinct accent-tinted fill (defined in <style>) so the
// emphasised column reads on BOTH a white and a surface section, plus the
// scroll-driven fill-in where supported. ss-hl-col--head marks the top cell.
const hl = (i: number, head = false) =>
  i === highlightCol ? (head ? 'ss-hl-col ss-hl-col--head' : 'ss-hl-col') : '';
---

<div class:list={['w-full overflow-x-auto', className]}>
  <table class="w-full border-collapse text-small">
    {caption && (
      <caption class="text-left text-label text-[var(--fg-muted)] mb-[var(--space-2)]">
        {caption}
      </caption>
    )}
    {columns && rows ? (
      <>
        <thead>
          <tr class="border-b border-[var(--fg)]">
            {columns.map((c, i) => (
              <th
                scope="col"
                class:list={[
                  'py-[var(--space-2)] px-[var(--space-3)] font-semibold text-[var(--fg)]',
                  align(i),
                  hl(i, true),
                ]}
              >
                {c}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="border-b border-[var(--rule-c)]">
              {row.map((cell, i) => (
                <td
                  class:list={[
                    'py-[var(--space-2)] px-[var(--space-3)] text-[var(--fg)]',
                    align(i),
                    hl(i),
                  ]}
                  data-num={numericCols.includes(i) ? '' : undefined}
                >
                  {cell}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </>
    ) : (
      <slot />
    )}
  </table>
</div>

<style>
  /* The emphasised column (usually "Scaling Socials") gets a distinct, faintly
     accent-tinted fill so it stands apart from the section behind it — on a white
     section AND on a surface section, where a plain surface fill would vanish. */
  .ss-hl-col { background-color: var(--hl-fill); }
  table :where(.ss-hl-col) {
    --hl-fill: color-mix(in srgb, var(--accent-wash) 62%, var(--ground));
  }
  /* A slim accent cap on the header cell reads as "this is the one". */
  .ss-hl-col--head { box-shadow: inset 0 3px 0 0 var(--accent-graphic); }

  /* Fills in as the table scrolls into view where supported (progressive
     enhancement; the static fill above is the fallback). */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .ss-hl-col {
        animation: ssHlIn linear both;
        animation-timeline: view();
        animation-range: entry 5% cover 35%;
      }
      @keyframes ssHlIn {
        from { background-color: transparent; }
        to { background-color: var(--hl-fill); }
      }
    }
  }
</style>
