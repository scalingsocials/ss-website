---
/**
 * Hero — the cinematic opener. Ink register, one orchestrated load sequence
 * (08 §6). Sized to sit in one viewport on desktop: smaller headline, tighter
 * rhythm, the results panel centred alongside.
 *
 * The proof row shows REAL, permissioned client results (owner confirmed) — the
 * figures Scaling Socials publishes, in Indian units. Every number renders as a
 * real value in the HTML (CLAUDE.md §10). Renders fully with JS disabled.
 */
import Section from '@/components/primitives/Section.astro';
import Button from '@/components/primitives/Button.astro';
import { CASE_STUDIES } from '@/lib/caseStudies';

const chips = ['Paid media', 'SEO', 'Shopify', 'Web', 'Social', 'CRO'];
const stats = CASE_STUDIES;
---

<Section register="ink" size="md" class="hero" as="section">
  <div class="hero__grid">
    <div class="hero__copy">
      <h1 class="hero__title">
        <span class="hero__line hero__line--1">Ecommerce growth for D2C brands,</span>
        <span class="hero__line hero__line--2">run on your <span class="hero__accent">P&amp;L.</span></span>
      </h1>

      <p class="hero__answer hero__line hero__line--3" data-answer-block>
        Scaling Socials is an omni-channel ecommerce growth agency in Bangalore — Meta and Google
        Ads, Shopify and web, SEO, social and CRO for D2C brands in India and the UAE. From ₹25,000
        a month.
      </p>

      <ul class="hero__stats hero__line" style="animation-delay:0.36s" aria-label="Recent client results">
        {stats.map((s) => (
          <li class="hero__stat">
            <span class="hero__stat-value" data-num>{s.result}</span>
            <span class="hero__stat-label">{s.metric} {s.period}</span>
          </li>
        ))}
      </ul>

      <div class="hero__cta hero__line" style="animation-delay:0.48s">
        <Button href="/audit/" variant="primary">Get a free growth plan</Button>
        <Button href="/case-studies/" variant="secondary">See case studies</Button>
      </div>
    </div>

    <!-- Results panel: an animated dashboard motif, not a data claim. -->
    <div class="hero__panel hero__line hero__line--5" aria-hidden="true">
      <div class="hero__panelhead">
        <span class="hero__dot"></span><span class="hero__dot"></span><span class="hero__dot"></span>
        <span class="hero__panellabel">performance.live</span>
      </div>

      <svg class="hero__chart" viewBox="0 0 420 240" fill="none" preserveAspectRatio="none" role="img" aria-label="Illustrative upward performance trend">
        <g class="hero__grid-lines">
          <line x1="0" y1="60" x2="420" y2="60" /><line x1="0" y1="120" x2="420" y2="120" /><line x1="0" y1="180" x2="420" y2="180" />
        </g>
        <path class="hero__area" d="M0 200 C 70 190, 110 170, 160 150 C 220 126, 270 120, 320 78 C 355 50, 390 40, 420 30 L 420 240 L 0 240 Z" />
        <path class="hero__line-path" d="M0 200 C 70 190, 110 170, 160 150 C 220 126, 270 120, 320 78 C 355 50, 390 40, 420 30" />
        <line class="hero__annot" x1="320" y1="10" x2="320" y2="230" />
        <circle class="hero__point" cx="320" cy="78" r="5" />
      </svg>
      <div class="hero__annotlabel">Creative refresh</div>

      {chips.map((c, i) => (
        <span class={`hero__chip hero__chip--${i + 1}`}>{c}</span>
      ))}
    </div>
  </div>
</Section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: min(94svh, 860px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 55% at 82% 18%, color-mix(in srgb, var(--accent-fill) 26%, transparent), transparent 70%),
      radial-gradient(55% 55% at 3% 100%, color-mix(in srgb, var(--color-teal) 18%, transparent), transparent 70%);
    pointer-events: none;
  }
  .hero > :global(*) { position: relative; }

  .hero__grid { display: grid; gap: var(--space-6); align-items: center; }
  @media (min-width: 960px) {
    .hero__grid { grid-template-columns: 1.05fr 0.9fr; gap: var(--space-8); }
  }

  .hero__title {
    font-size: clamp(2.25rem, 4.8vw, 3.6rem);
    line-height: 1.06;
    letter-spacing: var(--tracking-display);
    margin: 0;
  }
  .hero__line { display: block; }
  .hero__line--1 { font-weight: 500; color: var(--fg); }
  .hero__line--2 { font-weight: 700; color: var(--fg); }
  .hero__accent { color: var(--accent-text); }

  .hero__answer {
    margin-top: var(--space-3);
    max-width: 52ch;
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--fg-muted);
  }

  .hero__stats {
    margin-top: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }
  .hero__stat { display: flex; flex-direction: column; gap: 2px; }
  .hero__stat-value {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 700;
    line-height: 1;
    color: var(--fg);
    letter-spacing: -0.02em;
  }
  .hero__stat-label { font-size: var(--text-label); color: var(--fg-muted); }

  .hero__cta { margin-top: var(--space-5); display: flex; flex-wrap: wrap; gap: var(--space-2); }

  /* ---- results panel ---------------------------------------------------- */
  .hero__panel {
    position: relative;
    border: 1px solid var(--rule-c);
    border-radius: var(--radius-card);
    background: linear-gradient(180deg, color-mix(in srgb, var(--surface-c) 92%, transparent), var(--surface-c));
    padding: var(--space-3);
    box-shadow: 0 30px 80px -40px color-mix(in srgb, var(--accent-fill) 45%, transparent);
    aspect-ratio: 4 / 3;
  }
  @media (max-width: 640px) { .hero__panel { aspect-ratio: 16 / 11; } }
  .hero__panelhead { display: flex; align-items: center; gap: 6px; padding-bottom: var(--space-2); }
  .hero__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--rule-c); }
  .hero__panellabel { margin-left: auto; font-size: var(--text-label); color: var(--fg-muted); letter-spacing: 0.02em; }
  .hero__chart { width: 100%; height: calc(100% - 2.2rem); display: block; }
  .hero__grid-lines line { stroke: var(--rule-c); stroke-width: 1; }
  .hero__area { fill: color-mix(in srgb, var(--accent-fill) 16%, transparent); opacity: 0; }
  .hero__line-path { stroke: var(--accent-graphic); stroke-width: 2.5; stroke-linecap: round; fill: none; stroke-dasharray: 620; stroke-dashoffset: 620; }
  .hero__annot { stroke: var(--accent-graphic); stroke-width: 1; stroke-dasharray: 3 4; opacity: 0; }
  .hero__point { fill: var(--accent-graphic); opacity: 0; }
  .hero__annotlabel { position: absolute; top: 12%; right: 12%; font-size: var(--text-label); color: var(--fg); background: var(--ground); border: 1px solid var(--rule-c); border-radius: 999px; padding: 2px 10px; opacity: 0; }

  .hero__chip {
    position: absolute; font-size: var(--text-label); font-weight: 600; color: var(--accent-text);
    background: color-mix(in srgb, var(--accent-fill) 16%, var(--ground));
    border: 1px solid color-mix(in srgb, var(--accent-fill) 40%, transparent);
    border-radius: 999px; padding: 4px 12px; white-space: nowrap; opacity: 0;
  }
  .hero__chip--1 { top: 5%; left: -6%; } .hero__chip--2 { top: 26%; right: -8%; }
  .hero__chip--3 { top: 52%; left: -8%; } .hero__chip--4 { bottom: 20%; right: -6%; }
  .hero__chip--5 { bottom: 4%; left: 8%; } .hero__chip--6 { top: 1%; right: 12%; }
  @media (max-width: 640px) { .hero__chip--3, .hero__chip--5, .hero__chip--6 { display: none; } }

  @media (prefers-reduced-motion: no-preference) {
    .hero__line { opacity: 0; transform: translateY(14px); animation: heroIn 0.7s var(--ease-out) forwards; }
    .hero__line--1 { animation-delay: 0.05s; }
    .hero__line--2 { animation-delay: 0.16s; }
    .hero__line--3 { animation-delay: 0.30s; }
    .hero__line--5 { animation-delay: 0.28s; transform: translateY(24px) scale(0.98); }
    .hero__line-path { animation: draw 1.2s var(--ease-out) 0.55s forwards; }
    .hero__area { animation: fadeIn 0.8s ease 1.15s forwards; }
    .hero__annot, .hero__point { animation: fadeIn 0.5s ease 1.45s forwards; }
    .hero__annotlabel { animation: chipIn 0.5s var(--ease-out) 1.55s forwards; }
    .hero__chip { animation: chipIn 0.5s var(--ease-out) forwards; }
    .hero__chip--1 { animation-delay: 0.95s; } .hero__chip--2 { animation-delay: 1.07s; }
    .hero__chip--3 { animation-delay: 1.19s; } .hero__chip--4 { animation-delay: 1.31s; }
    .hero__chip--5 { animation-delay: 1.43s; } .hero__chip--6 { animation-delay: 1.55s; }
    @keyframes heroIn { to { opacity: 1; transform: none; } }
    @keyframes draw { to { stroke-dashoffset: 0; } }
    @keyframes fadeIn { to { opacity: 1; } }
    @keyframes chipIn { from { opacity: 0; transform: translateY(8px) scale(0.96); } to { opacity: 1; transform: none; } }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__area, .hero__annot, .hero__point, .hero__annotlabel, .hero__chip { opacity: 1; }
    .hero__line-path { stroke-dashoffset: 0; }
  }
</style>
