---
/**
 * Hero — the cinematic opener. Ink register, one orchestrated load sequence
 * (08 §6). Sized to sit in one viewport on desktop.
 *
 * The right-hand graphic is a DECORATIVE (aria-hidden) "live performance"
 * dashboard: a glass card with a glowing gradient trend line, a pulsing live
 * point, and an interactive crosshair — it tilts toward the cursor on desktop and
 * auto-sweeps on touch (motion.ts, progressive enhancement). It renders fully and
 * statically with JS disabled, and animation is dropped under prefers-reduced-motion.
 * It states no figures, so it never makes a data claim (CLAUDE.md §10).
 *
 * The proof row shows REAL, permissioned client results (owner confirmed), in
 * Indian units, as real values in the HTML.
 */
import Section from '@/components/primitives/Section.astro';
import Button from '@/components/primitives/Button.astro';
import BrandIcon from '@/components/graphics/BrandIcon.astro';
import { HERO_STATS } from '@/lib/caseStudies';

const partners = [
  { name: 'Google', icon: 'google' as const },
  { name: 'Meta', icon: 'meta' as const },
  { name: 'Shopify', icon: 'shopify' as const },
];

const chips = ['Paid media', 'SEO', 'Shopify', 'Web', 'Social', 'CRO'];
const stats = HERO_STATS;
// 3 stats → single row; 4 → 2x2 grid. Layout follows the data, not a fixed count.
const statsLayout = stats.length === 4 ? 'hero__stats--4' : 'hero__stats--3';
---

<Section register="ink" size="md" class="hero" as="section">
  <div class="hero__grid">
    <div class="hero__copy">
      <h1 class="hero__title">
        <span class="hero__line hero__line--1">Ecommerce growth for D2C brands,</span>
        <span class="hero__line hero__line--2">run on your <span class="hero__accent">P&amp;L.</span></span>
      </h1>

      <p class="hero__answer hero__line hero__line--3" data-answer-block>
        Scaling Socials is an omni-channel ecommerce growth agency in Bangalore. We run Meta and
        Google Ads, Shopify and web, SEO, social and CRO for D2C brands across India and the UAE,
        measured by the revenue we drive rather than the impressions we buy.
      </p>

      <ul class:list={['hero__stats hero__line hero__line--4', statsLayout]} aria-label="Recent client results">
        {stats.map((s) => (
          <li class="hero__stat">
            <span class="hero__stat-value" data-num>{s.value}</span>
            <span class="hero__stat-label">{s.label}, {s.niche.toLowerCase()}</span>
          </li>
        ))}
      </ul>

      <div class="hero__cta hero__line hero__line--6">
        <Button href="/audit/" variant="primary">Get a free growth plan</Button>
        <Button href="/case-studies/" variant="secondary">See case studies</Button>
      </div>
    </div>

    <div class="hero__right">
      <div class="hero__partners hero__line hero__line--5">
        <span class="hero__partners-label">Official partner</span>
        <ul class="hero__partners-list">
          {partners.map((p) => (
            <li class="hero__partner"><BrandIcon name={p.icon} size={18} /><span>{p.name}</span></li>
          ))}
        </ul>
      </div>

      <!-- Live performance dashboard — decorative, interactive (see motion.ts). -->
      <div class="hero__panel hero__line hero__line--5" aria-hidden="true">
        <div class="hero__card" data-hero-panel>
          <span class="hero__cardglow" aria-hidden="true"></span>

          <div class="hero__panelhead">
            <span class="hero__dot"></span><span class="hero__dot"></span><span class="hero__dot"></span>
            <span class="hero__badge"><span class="hero__badge-dot"></span>Live</span>
            <span class="hero__panellabel">performance.live</span>
          </div>

          <div class="hero__chartwrap" data-hero-chart>
            <svg class="hero__chart" viewBox="0 0 440 220" fill="none" preserveAspectRatio="none" role="img" aria-label="Illustrative upward performance trend">
              <defs>
                <linearGradient id="hpLine" x1="0" y1="0" x2="1" y2="0.4">
                  <stop class="hp-s-a" offset="0" />
                  <stop class="hp-s-b" offset="1" />
                </linearGradient>
                <linearGradient id="hpArea" x1="0" y1="0" x2="0" y2="1">
                  <stop class="hp-a-a" offset="0" />
                  <stop class="hp-a-b" offset="1" />
                </linearGradient>
                <filter id="hpGlow" x="-10%" y="-45%" width="120%" height="200%">
                  <feGaussianBlur stdDeviation="3.4" result="b" />
                  <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
                </filter>
              </defs>
              <g class="hero__grid-lines">
                <line x1="0" y1="55" x2="440" y2="55" /><line x1="0" y1="110" x2="440" y2="110" /><line x1="0" y1="165" x2="440" y2="165" />
              </g>
              <path class="hero__area" d="M0 190 C 60 180 110 162 160 150 C 220 135 250 118 300 96 C 350 74 395 44 440 26 L 440 220 L 0 220 Z" fill="url(#hpArea)" />
              <path class="hero__line-path" d="M0 190 C 60 180 110 162 160 150 C 220 135 250 118 300 96 C 350 74 395 44 440 26" stroke="url(#hpLine)" filter="url(#hpGlow)" />
              <g class="hero__cross" data-cross>
                <line class="hero__cross-v" x1="300" y1="4" x2="300" y2="216" />
                <circle class="hero__cross-halo" cx="300" cy="96" r="10" />
                <circle class="hero__cross-dot" cx="300" cy="96" r="4.5" />
              </g>
              <circle class="hero__live-pt" cx="440" cy="26" r="4.5" />
            </svg>
            <div class="hero__annotlabel" data-annot>Creative refresh</div>
          </div>

          <ul class="hero__legend">
            {chips.map((c) => <li class="hero__chip-m">{c}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </div>
</Section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    /* The header is fixed and floats over the page; pull the dark hero full-bleed
       up behind it so the header shrink reveals more of the hero. Fills one screen. */
    margin-top: calc(-1 * var(--hh, 68px));
    min-height: 100vh; /* fallback for iOS < 15.4 (no svh unit) */
    min-height: 100svh;
    padding-top: calc(var(--hh, 68px) + var(--space-4));
    padding-bottom: var(--space-5);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 55% at 82% 18%, color-mix(in srgb, var(--accent-fill) 26%, transparent), transparent 70%),
      radial-gradient(55% 55% at 3% 100%, color-mix(in srgb, var(--color-teal) 18%, transparent), transparent 70%);
    pointer-events: none;
  }
  .hero > :global(*) { position: relative; }

  .hero__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-6); align-items: center; }
  .hero__grid > * { min-width: 0; }
  @media (min-width: 960px) {
    .hero__grid { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.9fr); gap: var(--space-8); }
  }

  .hero__title {
    font-size: clamp(2.25rem, 4.8vw, 3.6rem);
    line-height: 1.06;
    letter-spacing: var(--tracking-display);
    margin: 0;
  }
  .hero__line { display: block; }
  .hero__line--1 { font-weight: 500; color: var(--fg); }
  .hero__line--2 { font-weight: 700; color: var(--fg); }
  .hero__accent { color: var(--accent-text); }

  .hero__answer {
    margin-top: var(--space-3);
    max-width: min(52ch, 100%);
    font-size: var(--text-body);
    line-height: 1.55;
    color: var(--fg-muted);
  }

  .hero__stats {
    margin-top: var(--space-5);
    display: grid;
    gap: var(--space-4) var(--space-6);
    width: fit-content;
    max-width: 100%;
  }
  .hero__stats--3 { grid-template-columns: repeat(3, auto); }
  .hero__stats--4 { grid-template-columns: repeat(2, auto); }
  /* Phones: keep the three headline results on ONE row. */
  @media (max-width: 560px) {
    .hero__stats { width: 100%; gap: var(--space-3) var(--space-2); }
    .hero__stats--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .hero__stats--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hero__stat-value { font-size: 1.15rem; letter-spacing: -0.03em; }
    .hero__stat-label { font-size: 0.66rem; line-height: 1.25; }
  }
  .hero__stat { display: flex; flex-direction: column; gap: 2px; }
  .hero__stat-value {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 700;
    line-height: 1;
    color: var(--fg);
    letter-spacing: -0.02em;
  }
  .hero__stat-label { font-size: var(--text-label); color: var(--fg-muted); }

  .hero__cta { margin-top: var(--space-5); display: flex; flex-wrap: wrap; gap: var(--space-2); }
  @media (max-width: 560px) {
    .hero__cta { flex-wrap: nowrap; }
    .hero__cta :global(a) { flex: 1 1 0; min-width: 0; padding-left: 0.5rem; padding-right: 0.5rem; font-size: 0.82rem; }
  }

  /* Right column: partner strip stacked above the dashboard panel. */
  .hero__right { display: flex; flex-direction: column; gap: var(--space-3); min-width: 0; }

  .hero__partners { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-2) var(--space-3); }
  .hero__partners-label { font-size: var(--text-label); font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--fg-muted); }
  .hero__partners-list { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .hero__partner {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--fg) 16%, transparent);
    background: color-mix(in srgb, var(--ground) 60%, transparent);
    font-size: var(--text-label); font-weight: 600; color: var(--fg);
  }
  .hero__partner :global(.ss-brandicon) { display: block; }

  /* ---- live dashboard panel -------------------------------------------------
     Outer .hero__panel carries the intro reveal + the 3D perspective; the inner
     .hero__card carries the glass look and the cursor tilt, so the two transforms
     never fight (the reveal animation would otherwise reset the tilt). */
  .hero__panel { perspective: 1200px; }
  .hero__card {
    position: relative;
    isolation: isolate;
    border: 1px solid color-mix(in srgb, var(--fg) 14%, transparent);
    border-radius: var(--radius-card);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--surface-c) 94%, transparent), color-mix(in srgb, var(--ground) 82%, transparent));
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    padding: var(--space-3);
    box-shadow:
      0 30px 80px -40px color-mix(in srgb, var(--accent-fill) 50%, transparent),
      inset 0 1px 0 color-mix(in srgb, var(--fg) 10%, transparent);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-height: clamp(280px, 33vw, 360px);
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transform-style: preserve-3d;
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
    will-change: transform;
  }
  /* Ambient glow that drifts behind the card content — the futuristic backlight. */
  .hero__cardglow {
    position: absolute; inset: -1px; z-index: -1; border-radius: inherit; overflow: hidden;
    background:
      radial-gradient(50% 60% at 85% 8%, color-mix(in srgb, var(--accent-graphic) 30%, transparent), transparent 70%),
      radial-gradient(45% 55% at 5% 100%, color-mix(in srgb, var(--color-teal) 24%, transparent), transparent 70%);
    opacity: 0.7;
  }

  .hero__panelhead { display: flex; align-items: center; gap: 6px; }
  .hero__dot { width: 8px; height: 8px; border-radius: 50%; background: color-mix(in srgb, var(--fg) 22%, transparent); }
  .hero__badge {
    display: inline-flex; align-items: center; gap: 5px; margin-left: 6px;
    font-size: 0.62rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--accent-text);
    background: color-mix(in srgb, var(--accent-graphic) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent-graphic) 35%, transparent);
    border-radius: 999px; padding: 2px 8px;
  }
  .hero__badge-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent-graphic); }
  .hero__panellabel { margin-left: auto; font-size: var(--text-label); color: var(--fg-muted); letter-spacing: 0.02em; white-space: nowrap; }
  @media (max-width: 400px) { .hero__panellabel { display: none; } }

  .hero__chartwrap { position: relative; flex: 1; min-height: 150px; }
  .hero__chart { width: 100%; height: 100%; display: block; overflow: visible; }
  .hp-s-a { stop-color: var(--accent-graphic); }
  .hp-s-b { stop-color: var(--accent-graphic-2, var(--color-teal)); }
  .hp-a-a { stop-color: var(--accent-graphic); stop-opacity: 0.28; }
  .hp-a-b { stop-color: var(--accent-graphic); stop-opacity: 0; }
  .hero__grid-lines line { stroke: color-mix(in srgb, var(--fg) 10%, transparent); stroke-width: 1; }
  .hero__area { opacity: 0; }
  .hero__line-path { stroke-width: 2.6; stroke-linecap: round; fill: none; stroke-dasharray: 720; stroke-dashoffset: 720; }

  /* Interactive crosshair — moved by motion.ts (hover on desktop, auto-sweep on
     touch). Hidden until active. */
  .hero__cross { opacity: 0; transition: opacity 0.2s var(--ease-out); }
  .hero__cross-v { stroke: color-mix(in srgb, var(--accent-graphic) 55%, transparent); stroke-width: 1; stroke-dasharray: 3 4; }
  .hero__cross-dot { fill: var(--accent-graphic); }
  .hero__cross-halo { fill: color-mix(in srgb, var(--accent-graphic) 30%, transparent); }
  /* Pulsing "live" point riding the leading edge of the line. */
  .hero__live-pt { fill: var(--accent-graphic); }

  .hero__annotlabel {
    position: absolute; top: 8%; right: 8%;
    font-size: var(--text-label); color: var(--fg);
    background: color-mix(in srgb, var(--ground) 78%, transparent);
    -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px);
    border: 1px solid color-mix(in srgb, var(--fg) 14%, transparent);
    border-radius: 999px; padding: 2px 10px; opacity: 0; white-space: nowrap;
  }

  /* Contained legend — replaces the old floating chips (which clipped at the card
     edges). One tidy row on both desktop and mobile. */
  .hero__legend { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0; padding: 0; }
  .hero__chip-m {
    font-size: var(--text-label); font-weight: 600; color: var(--accent-text);
    background: color-mix(in srgb, var(--accent-fill) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent-fill) 38%, transparent);
    border-radius: 999px; padding: 4px 11px; white-space: nowrap;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__line { opacity: 0; transform: translateY(14px); animation: heroIn 0.7s var(--ease-out) forwards; }
    .hero__line--1 { animation-delay: 0.05s; }
    .hero__line--2 { animation-delay: 0.16s; }
    .hero__line--3 { animation-delay: 0.30s; }
    .hero__line--4 { animation-delay: 0.36s; }
    .hero__line--6 { animation-delay: 0.48s; }
    .hero__line--5 { animation-delay: 0.28s; transform: translateY(24px) scale(0.98); }
    .hero__line-path { animation: draw 1.3s var(--ease-out) 0.5s forwards; }
    .hero__area { animation: fadeIn 0.8s ease 1.2s forwards; }
    .hero__annotlabel { animation: chipIn 0.5s var(--ease-out) 1.4s forwards; }
    .hero__live-pt { transform-box: fill-box; transform-origin: center; animation: fadeIn 0.4s ease 1.5s forwards, pulse 2.4s var(--ease-out) 1.5s infinite; }
    .hero__cardglow { animation: glowDrift 9s ease-in-out infinite alternate; }
    @keyframes heroIn { to { opacity: 1; transform: none; } }
    @keyframes draw { to { stroke-dashoffset: 0; } }
    @keyframes fadeIn { to { opacity: 1; } }
    @keyframes chipIn { from { opacity: 0; transform: translateY(8px) scale(0.96); } to { opacity: 1; transform: none; } }
    @keyframes pulse {
      0%, 100% { r: 4.5; opacity: 1; }
      50% { r: 6.5; opacity: 0.55; }
    }
    @keyframes glowDrift {
      from { transform: translate3d(-3%, -2%, 0) scale(1); opacity: 0.6; }
      to { transform: translate3d(3%, 2%, 0) scale(1.08); opacity: 0.85; }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__area, .hero__annotlabel, .hero__live-pt { opacity: 1; }
    .hero__line-path { stroke-dashoffset: 0; }
  }
</style>
