---
/**
 * Header — the 5-item primary nav. See 02-SITEMAP-AND-PAGE-SPECS.md §6.
 *
 * Rendered once, paper register. Desktop shows a mega menu (Services) and two
 * dropdowns (Work, Resources, Company) plus a direct Benchmarks link and the
 * primary CTA. Mobile collapses to a <dialog> opened by a hamburger — vanilla
 * JS, NOT a React island (01 §2.1).
 *
 * Accessibility: the menu panels are revealed by CSS :hover and :focus-within,
 * so with JavaScript disabled a keyboard user still tabs to a trigger, sees the
 * panel, and tabs into its links. src/scripts/nav.ts only layers on aria-expanded,
 * tap-to-toggle, and Escape/outside-click closing.
 */
import { Image } from 'astro:assets';
import lockup from '@/assets/brand/lockup-black.png';
import lockupWhite from '@/assets/brand/lockup-white.png';
import Button from '@/components/primitives/Button.astro';
import { NAV, NAV_CTA } from '@/lib/nav';

export interface Props {
  /** True on pages whose hero is dark: the header starts transparent with the
   *  white logo (ink register), then reverts to the solid paper header on scroll.
   *  motion.ts re-evaluates this per page from the first section's register. */
  heroOver?: boolean;
}
const { heroOver = false } = Astro.props;

const panelId = (label: string) => `nav-panel-${label.toLowerCase().replace(/\s+/g, '-')}`;
---

<header data-register={heroOver ? 'ink' : 'paper'} transition:persist="site-header" class:list={['ss-header fixed inset-x-0 top-0 z-50 border-b border-[var(--rule-c)]', heroOver && 'is-over']}>
  <!-- Frosted-glass backdrop on its OWN layer. The dropdown panels overflow the
       header box; if they are descendants of a backdrop-filter element, Chrome
       composites them into the backdrop buffer and leaves a hairline repaint
       ghost over the hero when a panel fades out on close. Isolating the blur
       to this element (which does NOT contain the panels) keeps the frosted
       look with none of that coupling. -->
  <div class="ss-header__backdrop" aria-hidden="true"></div>
  <!-- Scroll-progress rule under the header. CSS scroll-driven, zero JS. -->
  <div class="ss-header__progress" aria-hidden="true"></div>
  <div class="ss-header__bar mx-auto flex w-full max-w-[var(--container)] items-center gap-[var(--space-4)] px-[var(--space-3)] md:px-[var(--space-4)]">
    <a href="/" class="ss-header__logo shrink-0 no-underline" aria-label="Scaling Socials — home">
      <Image src={lockup} alt="Scaling Socials" height={28} width={Math.round(28 * (lockup.width / lockup.height))} densities={[1, 2]} loading="eager" class="ss-logo ss-logo--dark" />
      <Image src={lockupWhite} alt="Scaling Socials" height={28} width={Math.round(28 * (lockupWhite.width / lockupWhite.height))} densities={[1, 2]} loading="eager" class="ss-logo ss-logo--light" />
    </a>

    <!-- Desktop nav -->
    <nav aria-label="Primary" class="ss-nav-desktop ml-auto hidden items-center gap-[var(--space-1)] lg:flex">
      {NAV.map((item) =>
        item.kind === 'link' ? (
          <a
            href={item.href}
            class="rounded-[var(--radius-button)] px-[var(--space-2)] py-[var(--space-2)] text-small font-medium text-[var(--fg)] no-underline"
          >
            {item.label}
          </a>
        ) : (
          <div class="ss-nav-group relative" data-nav-group>
            <button
              type="button"
              data-nav-trigger
              aria-expanded="false"
              aria-controls={panelId(item.label)}
              class="ss-nav-trigger flex items-center gap-[0.3rem] rounded-[var(--radius-button)] px-[var(--space-2)] py-[var(--space-2)] text-small font-medium text-[var(--fg)]"
            >
              {item.label}
              <svg class="ss-caret" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" fill="none">
                <path d="M2 3.5 5 6.5 8 3.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>

            <div
              id={panelId(item.label)}
              data-register="paper"
              class:list={[
                'ss-nav-panel absolute left-0 top-full mt-px border border-[var(--rule-c)] bg-[var(--ground)]',
                item.kind === 'mega' ? 'ss-nav-panel--mega' : 'ss-nav-panel--list',
              ]}
            >
              {item.kind === 'mega' ? (
                <div class="grid grid-cols-[1fr_1fr_minmax(200px,240px)] gap-[var(--space-5)] p-[var(--space-4)]">
                  <div class="col-span-2 grid grid-cols-2 gap-x-[var(--space-5)] gap-y-[var(--space-3)]">
                    {item.items!.map((leaf) => (
                      <a href={leaf.href} class="group block no-underline">
                        <span class="block text-small font-semibold text-[var(--fg)] group-hover:text-[var(--accent-text)]">
                          {leaf.label}
                        </span>
                        {leaf.descriptor && (
                          <span class="mt-[0.15rem] block text-label leading-snug text-[var(--fg-muted)]">
                            {leaf.descriptor}
                          </span>
                        )}
                      </a>
                    ))}
                  </div>
                  <!-- Right rail: evergreen case-study promo. Swap for a named
                       featured study once owner confirms a client + permission. -->
                  <div class="border-l border-[var(--rule-c)] pl-[var(--space-4)]">
                    <span class="block text-label font-semibold text-[var(--fg-muted)]">
                      Case studies
                    </span>
                    <p class="mt-[var(--space-2)] text-label leading-snug text-[var(--fg-muted)]">
                      Real ₹-revenue results from the D2C brands we run paid growth for.
                    </p>
                    <a href="/case-studies/" class="mt-[var(--space-2)] inline-block text-small font-medium text-[var(--accent-text)]">
                      See all case studies
                    </a>
                  </div>
                </div>
              ) : (
                <ul class="flex min-w-[240px] flex-col gap-[0.15rem] p-[var(--space-2)]">
                  {item.items!.map((leaf) => (
                    <li>
                      <a
                        href={leaf.href}
                        target={leaf.external ? '_blank' : undefined}
                        rel={leaf.external ? 'noopener' : undefined}
                        class="group block rounded-[var(--radius-button)] px-[var(--space-2)] py-[var(--space-1)] no-underline hover:bg-[var(--surface-c)]"
                      >
                        <span class="block text-small font-semibold text-[var(--fg)] group-hover:text-[var(--accent-text)]">
                          {leaf.label}
                        </span>
                        {leaf.descriptor && (
                          <span class="block text-label leading-snug text-[var(--fg-muted)]">
                            {leaf.descriptor}
                          </span>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        )
      )}

      <Button href={NAV_CTA.href} variant="primary" size="sm" class="ml-[var(--space-2)]">
        {NAV_CTA.label}
      </Button>
    </nav>

    <!-- Mobile: CTA (≥sm only) + hamburger. The CTA sits in a wrapper span that
         controls its visibility — a Button's own `hidden` loses to its base
         `inline-flex`, so on phones the CTA would otherwise crowd the hamburger. -->
    <div class="ml-auto flex items-center gap-[var(--space-2)] lg:hidden">
      <span class="hidden sm:inline-flex">
        <Button href={NAV_CTA.href} variant="primary" size="sm">
          {NAV_CTA.label}
        </Button>
      </span>
      <button
        type="button"
        data-mobile-open
        aria-label="Open menu"
        aria-haspopup="dialog"
        class="flex min-h-[44px] min-w-[44px] items-center justify-center rounded-[var(--radius-button)] p-[0.4rem] text-[var(--fg)] hover:bg-[var(--surface-c)]"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" fill="none">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile nav dialog. Native <dialog>; answers/links present in DOM. -->
  <dialog data-mobile-nav data-register="paper" class="ss-mobile-nav" aria-label="Primary">
    <div class="ss-mobile-nav__inner flex h-full flex-col bg-[var(--ground)]">
      <div class="flex items-center justify-between border-b border-[var(--rule-c)] px-[var(--space-3)] py-[var(--space-2)]">
        <span class="text-small font-semibold text-[var(--fg)]">Menu</span>
        <button
          type="button"
          data-mobile-close
          aria-label="Close menu"
          class="flex min-h-[44px] min-w-[44px] items-center justify-center rounded-[var(--radius-button)] p-[0.4rem] text-[var(--fg)] hover:bg-[var(--surface-c)]"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" fill="none">
            <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </button>
      </div>

      <nav aria-label="Mobile" class="flex-1 overflow-y-auto px-[var(--space-3)] py-[var(--space-3)]">
        {NAV.map((item) =>
          item.kind === 'link' ? (
            <a
              href={item.href}
              class="block border-b border-[var(--rule-c)] py-[var(--space-2)] text-h4 font-semibold text-[var(--fg)] no-underline"
            >
              {item.label}
            </a>
          ) : (
            <details class="border-b border-[var(--rule-c)]">
              <summary class="flex cursor-pointer list-none items-center justify-between py-[var(--space-2)] text-h4 font-semibold text-[var(--fg)]">
                {item.label}
                <svg class="ss-caret" width="14" height="14" viewBox="0 0 10 10" aria-hidden="true" fill="none">
                  <path d="M2 3.5 5 6.5 8 3.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </summary>
              <ul class="flex flex-col gap-[0.15rem] pb-[var(--space-2)]">
                {item.items!.map((leaf) => (
                  <li>
                    <a
                      href={leaf.href}
                      target={leaf.external ? '_blank' : undefined}
                      rel={leaf.external ? 'noopener' : undefined}
                      class="block py-[0.5rem] pl-[var(--space-2)] text-body text-[var(--fg)] no-underline"
                    >
                      {leaf.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          )
        )}
        <Button href={NAV_CTA.href} variant="primary" class="mt-[var(--space-3)] w-full">
          {NAV_CTA.label}
        </Button>
      </nav>
    </div>
  </dialog>
</header>

<script>
  import '@/scripts/nav.ts';
</script>

<style>
  .ss-header {
    /* Clear the notch on fixed header (notched devices). */
    padding-top: env(safe-area-inset-top, 0px);
    transition: border-color var(--dur-base) var(--ease-out);
  }
  /* The frosted glass lives here, on its own layer behind the bar — never an
     ancestor of the dropdown panels (see the markup note above). inset:0 covers
     the whole header box including the safe-area padding, so the notch blurs too. */
  .ss-header__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: color-mix(in srgb, var(--ground) 82%, transparent);
    /* -webkit- first: iOS Safari needs the prefix or the blur silently no-ops. */
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    backdrop-filter: saturate(1.4) blur(12px);
    /* Own compositor layer so its buffer is invalidated cleanly. */
    transform: translateZ(0);
    transition: background var(--dur-base) var(--ease-out),
                box-shadow var(--dur-base) var(--ease-out);
  }
  /* Bar content (and the dropdown panels within it) sit above the backdrop. */
  .ss-header__bar { position: relative; z-index: 1; }
  /* Scroll state (class toggled by motion.ts): lifts off the page. */
  .ss-header.is-scrolled .ss-header__backdrop {
    background: color-mix(in srgb, var(--ground) 92%, transparent);
    box-shadow: 0 10px 30px -18px color-mix(in srgb, var(--color-black) 55%, transparent);
  }
  .ss-header.is-scrolled {
    border-color: color-mix(in srgb, var(--rule-c) 70%, transparent);
  }

  /* Over a dark hero (ink register at the top of the page): the header is
     transparent with the white logo. motion.ts adds .is-over (and flips the
     header's register to ink) only while at the top; on scroll it removes
     .is-over and restores the solid paper header below. */
  .ss-logo { display: inline-flex; align-items: center; }
  .ss-logo--light { display: none; }
  .ss-header.is-over .ss-logo--dark { display: none; }
  .ss-header.is-over .ss-logo--light { display: inline-flex; }
  /* The register rule ([data-register]{background:var(--ground)}) paints the
     header dark in ink mode — override it so the hero shows through. Higher
     specificity than [data-register], so no !important needed. */
  .ss-header.is-over { background-color: transparent; border-color: transparent; }
  .ss-header.is-over .ss-header__backdrop {
    background: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    box-shadow: none;
  }

  /* On scroll the WHOLE header compacts: less vertical padding, a smaller logo,
     tighter nav and a smaller CTA — so the bar itself gets shorter, not just the
     logo. Everything eases together for a single, cohesive shrink. */
  /* Base vertical padding lives here (not a Tailwind utility) so the is-scrolled
     override always wins the cascade. */
  .ss-header__bar {
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    transition: padding var(--dur-base) var(--ease-out);
  }
  .ss-header__logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px; /* ≥44px touch target (home link) */
    transform-origin: left center;
    transition: transform var(--dur-base) var(--ease-out);
    will-change: transform;
  }
  .ss-nav-desktop > a,
  .ss-nav-trigger,
  .ss-header :global(.ss-btn),
  .ss-header :global(a[class*='inline-flex']) {
    transition: font-size var(--dur-base) var(--ease-out), padding var(--dur-base) var(--ease-out);
  }
  .ss-header.is-scrolled .ss-header__bar {
    padding-top: calc(var(--space-2) * 0.42);
    padding-bottom: calc(var(--space-2) * 0.42);
  }
  .ss-header.is-scrolled .ss-header__logo { transform: scale(0.82); }
  .ss-header.is-scrolled .ss-nav-desktop > a,
  .ss-header.is-scrolled .ss-nav-trigger {
    font-size: 0.9rem;
    padding-top: calc(var(--space-2) * 0.6);
    padding-bottom: calc(var(--space-2) * 0.6);
  }
  /* the primary CTA (an <a> Button) compacts too */
  .ss-header.is-scrolled :global(a[class*='inline-flex']) {
    font-size: 0.85rem;
    padding-top: 0.3rem;
    padding-bottom: 0.3rem;
  }

  /* Animated underline on the top-level nav items — premium, quiet. */
  .ss-nav-desktop > a,
  .ss-nav-trigger { position: relative; }
  .ss-nav-desktop > a::after,
  .ss-nav-trigger::after {
    content: '';
    position: absolute;
    left: var(--space-2);
    right: var(--space-2);
    bottom: 2px;
    height: 2px;
    border-radius: 2px;
    background: var(--accent-graphic);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .ss-nav-desktop > a:hover::after,
  .ss-nav-trigger:hover::after,
  .ss-nav-group:focus-within .ss-nav-trigger::after,
  .ss-nav-group[data-open='true'] .ss-nav-trigger::after {
    transform: scaleX(1);
  }

  /* Menu panels: hidden by default, revealed on hover / keyboard focus / JS
     open. focus-within is what makes them keyboard-usable with JS disabled. */
  .ss-nav-panel {
    z-index: 60;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    /* translate3d (not translateY) keeps the panel on its own compositor layer.
       The fixed header has backdrop-filter and a fractional height, so the panel
       lands on a sub-pixel row; without a stable layer Chrome leaves a 1px
       hairline ghost over the hero when the panel fades out on close. */
    transform: translate3d(0, -4px, 0);
    will-change: opacity, transform;
    backface-visibility: hidden;
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out),
      visibility var(--dur-fast);
  }
  .ss-nav-panel--mega {
    width: min(720px, calc(100vw - 2 * var(--space-4)));
  }
  .ss-nav-group:hover > .ss-nav-panel,
  .ss-nav-group:focus-within > .ss-nav-panel,
  .ss-nav-group[data-open='true'] > .ss-nav-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate3d(0, 0, 0);
  }
  /* After a link is chosen, JS adds .is-dismissed so a lingering hover/focus does
     not re-open the panel on the page just navigated to. Cleared on pointer-leave
     (nav.ts) so the next genuine hover works. Also neutralises the caret/underline
     so the trigger doesn't read as active while its panel is suppressed. */
  .ss-nav-group.is-dismissed:hover > .ss-nav-panel,
  .ss-nav-group.is-dismissed:focus-within > .ss-nav-panel {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate3d(0, -4px, 0);
  }
  .ss-nav-group.is-dismissed:hover .ss-nav-trigger::after,
  .ss-nav-group.is-dismissed:focus-within .ss-nav-trigger::after { transform: scaleX(0); }
  .ss-nav-group.is-dismissed:hover .ss-caret,
  .ss-nav-group.is-dismissed:focus-within .ss-caret { transform: none; }

  /* Scroll-progress rule: grows left→right as the page scrolls. Zero JS,
     progressive enhancement (unsupported browsers just see a static hairline). */
  .ss-header__progress {
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 2px;
    width: 100%;
    transform-origin: left;
    transform: scaleX(0);
    background: var(--accent-graphic);
    z-index: 61;
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .ss-header__progress {
        animation: ssProgress linear both;
        animation-timeline: scroll(root block);
      }
      @keyframes ssProgress {
        from { transform: scaleX(0); }
        to { transform: scaleX(1); }
      }
    }
  }

  .ss-caret {
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .ss-nav-group:hover .ss-caret,
  .ss-nav-group:focus-within .ss-caret,
  .ss-nav-group[data-open='true'] .ss-caret {
    transform: rotate(180deg);
  }
  details[open] > summary .ss-caret {
    transform: rotate(180deg);
  }

  /* Native dialog as a full-height sheet from the right. */
  .ss-mobile-nav {
    margin: 0 0 0 auto;
    height: 100dvh;
    max-height: 100dvh;
    width: min(360px, 92vw);
    max-width: 92vw;
    padding: 0;
    border: none;
    border-left: 1px solid var(--rule-c);
    color: var(--fg);
  }
  .ss-mobile-nav::backdrop {
    background: color-mix(in srgb, var(--color-black) 45%, transparent);
  }
  .ss-mobile-nav__inner {
    height: 100%;
  }
  summary::-webkit-details-marker {
    display: none;
  }
</style>
