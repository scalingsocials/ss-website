---
/**
 * StatGrid — four headline figures, big numeral + label, hairline accent on top.
 * Each value carries its EXACT real string and a data-countup hook; caseviz.ts
 * interpolates the display on scroll, then restores the exact text. Staggered
 * reveal via the site's [data-reveal] observer.
 */
export interface Props {
  stats: { value: string; label: string }[];
  class?: string;
}
const { stats, class: className = '' } = Astro.props;
---
<ul class:list={['ss-sg grid grid-cols-2 gap-[var(--space-3)] sm:grid-cols-4', className]}>
  {stats.map((s, i) => (
    <li class="ss-sg__card" data-reveal style={`--i:${i}`}>
      <span class="ss-sg__val display-type text-data-sm font-bold leading-none text-[var(--fg)]" data-num data-countup>{s.value}</span>
      <span class="ss-sg__label text-label leading-snug text-[var(--fg-muted)]">{s.label}</span>
    </li>
  ))}
</ul>
<style>
  .ss-sg__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: var(--space-4);
    padding-top: calc(var(--space-4) + 2px);
    border: 1px solid var(--rule-c);
    border-radius: var(--radius-card);
    background: var(--ground);
    overflow: hidden;
  }
  .ss-sg__card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: var(--accent-graphic);
  }
  .ss-sg__val { font-variant-numeric: tabular-nums; }
  /* Stagger the reveal by card index (works with the global [data-reveal] fade). */
  .js-reveal .ss-sg__card[data-reveal] { transition-delay: calc(var(--i, 0) * 70ms); }
</style>
