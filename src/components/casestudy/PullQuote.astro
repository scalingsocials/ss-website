---
/**
 * PullQuote — the honesty beat ("the soft month"). Large display type in a tinted
 * band with a vertical accent rule. A deliberate pause; this is the differentiator.
 */
export interface Props {
  text: string;
  context?: string;
  class?: string;
}
const { text, context, class: className = '' } = Astro.props;
---
<figure class:list={['ss-pq', className]} data-reveal>
  {context && <figcaption class="ss-pq__context">{context}</figcaption>}
  <blockquote class="ss-pq__text">{text}</blockquote>
</figure>
<style>
  .ss-pq {
    margin: 0;
    border-left: 3px solid var(--accent-fill);
    border-radius: 0 var(--radius-card) var(--radius-card) 0;
    background: color-mix(in srgb, var(--accent-wash) 70%, var(--ground));
    padding: var(--space-6) var(--space-6) var(--space-6) var(--space-5);
  }
  .ss-pq__context {
    display: inline-block;
    margin-bottom: var(--space-3);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .ss-pq__text {
    max-width: 46ch;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--fg);
    text-wrap: balance;
  }
</style>
