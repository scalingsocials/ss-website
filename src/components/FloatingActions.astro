---
/**
 * FloatingActions — the bottom-right floating cluster, rendered site-wide via
 * BaseLayout (skipped on `bare` ad landing pages, like the header/footer).
 *
 * Two stacked controls:
 *  1. WhatsApp — always visible on every page, so anyone can reach us in one tap.
 *     It's an <a href="https://wa.me/…"> (plain navigation → no CSP concern). The
 *     number is derived from the single source of truth (entity.ts), never typed.
 *  2. Growth-plan CTA — carries `data-sticky-cta`; motion.ts reveals it once the
 *     hero scrolls out of view. Only the homepage has a `.hero`, so elsewhere it
 *     stays hidden. It floats ABOVE WhatsApp and reserves no space when hidden,
 *     so it never leaves a gap. This replaces the old full-width mobile bar, which
 *     read as distracting on phones.
 *
 * COLOUR NOTE: the WhatsApp button uses WhatsApp's own brand green (#25D366) — a
 * deliberate, contained exception to the token rule (CLAUDE.md §5), the same way a
 * third-party logo keeps its own colour so it stays recognisable.
 */
import { ORG } from '@/lib/schema/entity';

const waNumber = ORG.telephone.replace(/\D/g, '');
const waText = encodeURIComponent(
  "Hi Scaling Socials — I'd like to talk about growing my brand."
);
const waHref = `https://wa.me/${waNumber}?text=${waText}`;
---

<div class="ss-fab">
  <!-- Growth-plan CTA — revealed by motion.ts once the hero scrolls out (home). -->
  <a href="/audit/" data-sticky-cta class="ss-fab__cta">
    <svg class="ss-fab__cta-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M13 3 5 13h5l-1 8 8-10h-5l1-8Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
    </svg>
    <span>Get a free growth plan</span>
  </a>

  <!-- WhatsApp — always available, every page. -->
  <a
    href={waHref}
    target="_blank"
    rel="noopener noreferrer"
    class="ss-fab__wa"
    aria-label="Chat with Scaling Socials on WhatsApp"
  >
    <span class="ss-fab__wa-label">Chat with us</span>
    <span class="ss-fab__wa-badge">
      <svg width="26" height="26" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
        <path d="M16 3C9.38 3 4 8.38 4 15c0 2.1.55 4.15 1.6 5.96L4 29l8.25-2.16A11.9 11.9 0 0 0 16 27c6.62 0 12-5.38 12-12S22.62 3 16 3zm0 21.9c-1.7 0-3.37-.44-4.84-1.28l-.35-.2-4.9 1.28 1.3-4.78-.23-.37A9.86 9.86 0 0 1 6.1 15C6.1 9.54 10.54 5.1 16 5.1S25.9 9.54 25.9 15 21.46 24.9 16 24.9z"/>
        <path d="M21.6 17.9c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35z"/>
      </svg>
    </span>
  </a>
</div>

<style>
  .ss-fab {
    position: fixed;
    right: max(var(--space-3), env(safe-area-inset-right, 0px));
    bottom: calc(var(--space-3) + env(safe-area-inset-bottom, 0px));
    z-index: 45;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  /* --- WhatsApp -------------------------------------------------------------
     A pill that shows just the round badge by default and expands to reveal the
     label on hover/focus (pointer devices). On touch it stays a clean circle. */
  .ss-fab__wa {
    display: inline-flex;
    align-items: center;
    gap: 0;
    height: 56px;
    padding: 0;
    border-radius: 999px;
    background: #25d366; /* WhatsApp brand green — see COLOUR NOTE */
    color: #fff;
    text-decoration: none;
    box-shadow: 0 12px 30px -10px rgba(18, 140, 70, 0.7);
    transition:
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      padding var(--dur-base) var(--ease-out);
  }
  .ss-fab__wa-badge {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    flex: 0 0 56px;
  }
  .ss-fab__wa-label {
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    font-size: var(--text-small);
    font-weight: 600;
    opacity: 0;
    transition:
      max-width var(--dur-base) var(--ease-out),
      opacity var(--dur-base) var(--ease-out),
      padding var(--dur-base) var(--ease-out);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .ss-fab__wa:hover,
    .ss-fab__wa:focus-visible {
      padding-left: var(--space-3);
      transform: translateY(-2px);
    }
    .ss-fab__wa:hover .ss-fab__wa-label,
    .ss-fab__wa:focus-visible .ss-fab__wa-label {
      max-width: 160px;
      opacity: 1;
      padding-right: 0.35rem;
    }
  }
  .ss-fab__wa:focus-visible {
    outline: 2px solid #0f8a45;
    outline-offset: 3px;
  }

  /* --- Growth-plan CTA ------------------------------------------------------
     Floats above WhatsApp, reserving no layout space until revealed (so no gap
     when hidden). Hidden by default; motion.ts adds .is-visible on hero-exit. */
  .ss-fab__cta {
    position: absolute;
    right: 0;
    bottom: calc(100% + var(--space-2));
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem var(--space-3);
    border-radius: 999px;
    background: var(--accent-fill);
    color: var(--accent-on);
    font-size: var(--text-small);
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    box-shadow: 0 14px 34px -14px color-mix(in srgb, var(--accent-fill) 75%, transparent);
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px) scale(0.96);
    transform-origin: bottom right;
    transition:
      transform var(--dur-base) var(--ease-out),
      opacity var(--dur-base) var(--ease-out),
      visibility var(--dur-base);
  }
  .ss-fab__cta.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }
  .ss-fab__cta-icon { flex: 0 0 auto; }
</style>
