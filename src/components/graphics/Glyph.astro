---
/**
 * Glyph — a single on-brand line icon, drawn on a 24×24 grid in `currentColor`
 * so the caller controls colour (usually --accent-graphic). Stroke-only, 1.7px,
 * round joins — the "instrument" line style from the design brief (08).
 *
 * Add a name here and it is available everywhere. Never invents meaning: each
 * name maps to one glyph, reused across process steps, service cards and
 * interior-page headers so the whole site shares one drawing hand.
 */
export interface Props {
  name: string;
  size?: number;
  class?: string;
  strokeWidth?: number;
}
const { name, size = 24, class: className = '', strokeWidth = 1.7 } = Astro.props;

// Inner SVG for each glyph (paths use currentColor via the parent <svg>).
const GLYPHS: Record<string, string> = {
  // ---- process phases -------------------------------------------------------
  audit: '<circle cx="11" cy="11" r="6"/><path d="M20 20l-4.3-4.3"/><path d="M11 8v6M8 11h6"/>',
  plan: '<rect x="5" y="4" width="14" height="16" rx="2"/><path d="M9 3.5h6v3H9z"/><path d="M8.5 11h4M8.5 15h7"/>',
  build: '<path d="M14.5 6.5a3.5 3.5 0 00-4.9 4.2L4 16.3 6.7 19l5.6-5.6a3.5 3.5 0 004.2-4.9l-2.2 2.2-2-2 2.2-2.2z"/>',
  test: '<path d="M9 3v6.5L4.8 17a2 2 0 001.8 3h10.8a2 2 0 001.8-3L15 9.5V3"/><path d="M8 3h8M7.5 14h9"/>',
  scale: '<path d="M4 16l5-5 3 3 7-8"/><path d="M15 6h4v4"/>',
  // ---- services / sub-services ---------------------------------------------
  target: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="0.6" fill="currentColor" stroke="none"/>',
  search: '<circle cx="11" cy="11" r="6"/><path d="M20 20l-4.3-4.3"/>',
  chart: '<path d="M4 20V4M4 20h16"/><rect x="7" y="12" width="2.5" height="5"/><rect x="12" y="9" width="2.5" height="8"/><rect x="17" y="5" width="2.5" height="12"/>',
  cart: '<circle cx="9" cy="20" r="1.3"/><circle cx="17" cy="20" r="1.3"/><path d="M3 4h2l2.2 11h10.3l1.7-8H6"/>',
  code: '<path d="M9 8l-4 4 4 4M15 8l4 4-4 4"/>',
  social: '<path d="M20 12a8 8 0 01-11.5 7.2L4 20l0.9-4.4A8 8 0 1120 12z"/><path d="M9 12h.01M12 12h.01M15 12h.01"/>',
  funnel: '<path d="M4 5h16l-6 7v6l-4 2v-8L4 5z"/>',
  gauge: '<path d="M5 18a8 8 0 1114 0"/><path d="M12 14l4-4"/><circle cx="12" cy="18" r="1.1" fill="currentColor" stroke="none"/>',
  layers: '<path d="M12 4l8 4-8 4-8-4 8-4z"/><path d="M4 12l8 4 8-4M4 16l8 4 8-4"/>',
  migrate: '<path d="M4 8h11M11 4l4 4-4 4"/><path d="M20 16H9M13 20l-4-4 4-4"/>',
  speed: '<path d="M13 3l-8 10h6l-1 8 8-10h-6l1-8z"/>',
  doc: '<path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4"/><path d="M9.5 12h5M9.5 15.5h5"/>',
  shield: '<path d="M12 3l7 3v5c0 4.5-3 7.8-7 9-4-1.2-7-4.5-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/>',
  cookie: '<path d="M12 4a8 8 0 108 8 3 3 0 01-3-3 3 3 0 01-3-3 8 8 0 00-2-2z"/><path d="M9 11h.01M13 14h.01M15 10h.01"/>',
  spark: '<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5L18 18M18 6l-2.5 2.5M8.5 15.5L6 18"/>',
  handshake: '<path d="M8 12l3 3 2-2 3 3"/><path d="M3 8l4-2 5 3 5-3 4 2v6l-4 2-5-3-5 3-4-2V8z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M4 7l8 6 8-6"/>',
  chat: '<path d="M5 5h14v10H9l-4 4V5z"/><path d="M9 9h6M9 12h4"/>',
};

const inner = GLYPHS[name] ?? GLYPHS.spark;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
  set:html={inner}
/>
