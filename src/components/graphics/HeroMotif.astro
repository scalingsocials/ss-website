---
/**
 * HeroMotif — a decorative, framed illustration for interior-page hero right
 * columns, so a page isn't a wall of text (08 §6). An "instrument panel" with a
 * soft drifting aura behind a per-page motif, subtly animated (CSS only, no JS,
 * no external assets). Reads semantic vars only, works in either register, is
 * purely decorative (aria-hidden), and all motion is gated behind
 * prefers-reduced-motion so it settles to a clean static state.
 */
export interface Props {
  variant?: 'growth' | 'teardown' | 'guide' | 'glossary' | 'team';
  label?: string;
  class?: string;
}
const { variant = 'growth', label, class: className = '' } = Astro.props;
const labels: Record<string, string> = {
  growth: 'results.live',
  teardown: 'teardown.live',
  guide: 'library.live',
  glossary: 'glossary.live',
  team: 'team.live',
};
const cap = label ?? labels[variant];
const pill = variant === 'teardown' ? 'What we found' : variant === 'growth' ? 'Compounding' : 'Scaling Socials';
---
<div class:list={['ss-motif', `ss-motif--${variant}`, className]} aria-hidden="true">
  <span class="ss-motif__aura"></span>
  <div class="ss-motif__head">
    <span class="ss-motif__dot"></span><span class="ss-motif__dot"></span><span class="ss-motif__dot"></span>
    <span class="ss-motif__label">{cap}</span>
  </div>
  <div class="ss-motif__body">
    {variant === 'growth' && (
      <svg viewBox="0 0 320 190" fill="none" preserveAspectRatio="xMidYMid meet" class="ss-motif__svg">
        <g class="ss-motif__grid"><line x1="0" y1="150" x2="320" y2="150"/><line x1="0" y1="110" x2="320" y2="110"/><line x1="0" y1="70" x2="320" y2="70"/></g>
        <rect class="ss-motif__bar" x="26" y="120" width="30" height="30" rx="4"/>
        <rect class="ss-motif__bar" x="86" y="96" width="30" height="54" rx="4"/>
        <rect class="ss-motif__bar" x="146" y="70" width="30" height="80" rx="4"/>
        <rect class="ss-motif__bar" x="206" y="44" width="30" height="106" rx="4"/>
        <rect class="ss-motif__bar ss-motif__bar--hot" x="266" y="24" width="30" height="126" rx="4"/>
        <path class="ss-motif__line ss-motif__draw" d="M20 128 C 80 112, 120 96, 170 72 C 210 52, 250 40, 300 20"/>
        <path class="ss-motif__arrow" d="M286 20h16v16"/>
      </svg>
    )}
    {variant === 'teardown' && (
      <svg viewBox="0 0 320 190" fill="none" preserveAspectRatio="xMidYMid meet" class="ss-motif__svg">
        <g class="ss-motif__grid"><line x1="0" y1="140" x2="320" y2="140"/><line x1="0" y1="96" x2="320" y2="96"/><line x1="0" y1="52" x2="320" y2="52"/></g>
        <path class="ss-motif__line ss-motif__line--warn ss-motif__draw" d="M12 60 C 60 70, 90 120, 140 118 C 190 116, 210 60, 260 66"/>
        <path class="ss-motif__line ss-motif__draw ss-motif__draw--slow" d="M12 130 C 70 120, 110 96, 170 84 C 220 74, 260 56, 300 40"/>
        <g class="ss-motif__lens-g">
          <circle class="ss-motif__lens" cx="206" cy="108" r="34"/>
          <line class="ss-motif__lens-h" x1="230" y1="132" x2="256" y2="158"/>
        </g>
      </svg>
    )}
    {variant === 'guide' && (
      <svg viewBox="0 0 320 190" fill="none" preserveAspectRatio="xMidYMid meet" class="ss-motif__svg ss-guide">
        {/* fanned stack of long reads, the front one being marked up */}
        <rect class="ss-motif__doc ss-motif__doc--back ss-guide__rise" x="66" y="42" width="150" height="128" rx="7" transform="rotate(-7 141 106)"/>
        <rect class="ss-motif__doc ss-motif__doc--mid ss-guide__rise" x="86" y="34" width="150" height="128" rx="7" transform="rotate(-3 161 98)"/>
        <rect class="ss-motif__doc ss-guide__rise" x="104" y="24" width="150" height="130" rx="7"/>

        {/* the annotation — the brand signature: a thin accent rule with a tag */}
        <g class="ss-guide__note">
          <rect class="ss-guide__tag" x="112" y="40" width="42" height="16" rx="4"/>
          <line class="ss-guide__rule" x1="120" y1="60" x2="120" y2="140"/>
        </g>

        {/* the moving highlight sweeping the paragraph as it is "read" */}
        <rect class="ss-guide__hl" x="132" y="56" width="96" height="13" rx="3"/>

        <g class="ss-guide__rows">
          <line class="ss-motif__row" x1="134" y1="62" x2="240" y2="62"/>
          <line class="ss-motif__row" x1="134" y1="82" x2="240" y2="82"/>
          <line class="ss-motif__row ss-motif__row--short" x1="134" y1="102" x2="204" y2="102"/>
          <line class="ss-motif__row" x1="134" y1="128" x2="240" y2="128"/>
        </g>

        {/* keep-reading chevron in an accent chip, gently pulsing */}
        <g class="ss-guide__go">
          <circle class="ss-guide__chip" cx="228" cy="140" r="13"/>
          <path class="ss-guide__chev" d="M225 134l6 6-6 6"/>
        </g>
      </svg>
    )}
    {variant === 'glossary' && (
      <svg viewBox="0 0 320 190" fill="none" preserveAspectRatio="xMidYMid meet" class="ss-motif__svg">
        <rect class="ss-motif__doc" x="40" y="30" width="240" height="130" rx="8"/>
        <line class="ss-motif__spine" x1="160" y1="30" x2="160" y2="160"/>
        <text class="ss-motif__az ss-motif__fade" x="86" y="106" text-anchor="middle">A</text>
        <text class="ss-motif__az ss-motif__az--z ss-motif__fade ss-motif__fade--2" x="234" y="106" text-anchor="middle">Z</text>
        <line class="ss-motif__row" x1="70" y1="128" x2="130" y2="128"/>
        <line class="ss-motif__row" x1="192" y1="128" x2="252" y2="128"/>
      </svg>
    )}
    {variant === 'team' && (
      <svg viewBox="0 0 320 190" fill="none" preserveAspectRatio="xMidYMid meet" class="ss-motif__svg ss-net">
        <g class="ss-net__links">
          <line class="ss-net__link" x1="160" y1="95" x2="70" y2="52"/>
          <line class="ss-net__link" x1="160" y1="95" x2="250" y2="52"/>
          <line class="ss-net__link" x1="160" y1="95" x2="70" y2="138"/>
          <line class="ss-net__link" x1="160" y1="95" x2="250" y2="138"/>
        </g>
        <circle class="ss-net__halo" cx="160" cy="95" r="26"/>
        <g class="ss-net__node ss-net__node--hub"><circle class="ss-net__ring" cx="160" cy="95" r="26"/><circle class="ss-net__head" cx="160" cy="88" r="7"/><path class="ss-net__torso" d="M147 109a13 13 0 0 1 26 0"/></g>
        <g class="ss-net__node ss-net__pop ss-net__pop--1"><circle class="ss-net__ring" cx="70" cy="52" r="18"/><circle class="ss-net__head" cx="70" cy="47" r="5"/><path class="ss-net__torso" d="M61 63a9 9 0 0 1 18 0"/></g>
        <g class="ss-net__node ss-net__pop ss-net__pop--2"><circle class="ss-net__ring" cx="250" cy="52" r="18"/><circle class="ss-net__head" cx="250" cy="47" r="5"/><path class="ss-net__torso" d="M241 63a9 9 0 0 1 18 0"/></g>
        <g class="ss-net__node ss-net__pop ss-net__pop--3"><circle class="ss-net__ring" cx="70" cy="138" r="18"/><circle class="ss-net__head" cx="70" cy="133" r="5"/><path class="ss-net__torso" d="M61 149a9 9 0 0 1 18 0"/></g>
        <g class="ss-net__node ss-net__pop ss-net__pop--4"><circle class="ss-net__ring" cx="250" cy="138" r="18"/><circle class="ss-net__head" cx="250" cy="133" r="5"/><path class="ss-net__torso" d="M241 149a9 9 0 0 1 18 0"/></g>
      </svg>
    )}
    <span class="ss-motif__pill">{pill}</span>
  </div>
</div>
<style>
  .ss-motif {
    position: relative;
    border: 1px solid var(--rule-c);
    border-radius: var(--radius-card);
    background: linear-gradient(180deg, color-mix(in srgb, var(--surface-c) 92%, transparent), var(--surface-c));
    padding: var(--space-3);
    box-shadow: 0 34px 80px -48px color-mix(in srgb, var(--accent-fill) 50%, transparent);
    overflow: hidden;
    isolation: isolate;
  }
  /* Soft drifting aura — two blurred accent blobs behind the motif. Purely
     atmospheric; kept low-opacity so it lifts the panel without shouting. */
  .ss-motif__aura {
    position: absolute; inset: -20%; z-index: 0; pointer-events: none;
    background:
      radial-gradient(38% 42% at 22% 24%, color-mix(in srgb, var(--accent-graphic) 34%, transparent), transparent 70%),
      radial-gradient(42% 46% at 84% 82%, color-mix(in srgb, var(--accent-graphic-2, var(--accent-graphic)) 26%, transparent), transparent 70%);
    filter: blur(20px);
    opacity: 0.55;
  }
  .ss-motif__head, .ss-motif__body { position: relative; z-index: 1; }
  .ss-motif__head { display: flex; align-items: center; gap: 6px; padding-bottom: var(--space-2); }
  .ss-motif__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--rule-c); }
  .ss-motif__label { margin-left: auto; font-size: var(--text-label); color: var(--fg-muted); letter-spacing: 0.02em; }
  .ss-motif__svg { width: 100%; height: auto; display: block; aspect-ratio: 320 / 190; overflow: visible; }

  .ss-motif__grid line { stroke: var(--rule-c); stroke-width: 1; }
  .ss-motif__bar { fill: color-mix(in srgb, var(--accent-graphic) 22%, transparent); stroke: color-mix(in srgb, var(--accent-graphic) 45%, transparent); stroke-width: 1; transform-box: fill-box; transform-origin: bottom; }
  .ss-motif__bar--hot { fill: color-mix(in srgb, var(--accent-graphic) 45%, transparent); stroke: var(--accent-graphic); }
  .ss-motif__line { stroke: var(--accent-graphic); stroke-width: 2.5; stroke-linecap: round; fill: none; }
  .ss-motif__line--warn { stroke: var(--accent-graphic-2); stroke-width: 2; opacity: 0.85; }
  .ss-motif__arrow { stroke: var(--accent-graphic); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; fill: none; }

  .ss-motif__lens { stroke: var(--accent-graphic); stroke-width: 2.5; fill: color-mix(in srgb, var(--accent-fill) 8%, transparent); }
  .ss-motif__lens-h { stroke: var(--accent-graphic); stroke-width: 4; stroke-linecap: round; }
  .ss-motif__lens-g { transform-box: fill-box; transform-origin: 206px 108px; }

  .ss-motif__doc { fill: var(--ground); stroke: var(--rule-c); stroke-width: 1.5; }
  .ss-motif__doc--back { opacity: 0.5; }
  .ss-motif__doc--mid { opacity: 0.75; }
  .ss-motif__row { stroke: color-mix(in srgb, var(--fg-muted) 55%, transparent); stroke-width: 3; stroke-linecap: round; }
  .ss-motif__row--short { opacity: 0.7; }
  .ss-motif__spine { stroke: var(--rule-c); stroke-width: 1.5; }
  .ss-motif__az { fill: var(--accent-graphic); font-family: var(--font-display); font-weight: 700; font-size: 42px; }
  .ss-motif__az--z { fill: var(--accent-graphic-2); }

  /* ---- guide: a marked-up long read ------------------------------------- */
  .ss-guide__tag { fill: var(--accent-graphic); }
  .ss-guide__rule { stroke: var(--accent-graphic); stroke-width: 2.5; stroke-linecap: round; }
  .ss-guide__hl { fill: color-mix(in srgb, var(--accent-graphic) 20%, transparent); }
  .ss-guide__chip { fill: var(--accent-graphic); }
  .ss-guide__chev { stroke: var(--ground); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; fill: none; }

  /* ---- team network ------------------------------------------------------- */
  .ss-net__link { stroke: color-mix(in srgb, var(--accent-graphic) 42%, transparent); stroke-width: 1.5; stroke-linecap: round; stroke-dasharray: 3 7; }
  .ss-net__halo { fill: color-mix(in srgb, var(--accent-graphic) 30%, transparent); opacity: 0; transform-box: fill-box; transform-origin: center; }
  .ss-net__ring { fill: color-mix(in srgb, var(--accent-fill) 12%, var(--ground)); stroke: var(--accent-graphic); stroke-width: 2; }
  .ss-net__head { fill: var(--accent-graphic); }
  .ss-net__torso { fill: none; stroke: var(--accent-graphic); stroke-width: 2; }
  .ss-net__node--hub .ss-net__ring { stroke-width: 2.5; }

  .ss-motif__pill {
    position: absolute; top: 4%; right: 5%; z-index: 2;
    font-size: var(--text-label); color: var(--fg);
    background: var(--ground); border: 1px solid var(--rule-c);
    border-radius: 999px; padding: 2px 10px;
  }

  /* ---- motion (opt-in; everything above is the finished static state) ----- */
  @media (prefers-reduced-motion: no-preference) {
    .ss-motif__aura { animation: ssAura 16s ease-in-out infinite alternate; }

    /* growth / teardown: draw the lines in once, then let bars rise + arrow fade */
    .ss-motif__draw { stroke-dasharray: 620; stroke-dashoffset: 620; animation: ssDraw 1.5s var(--ease-out, ease) 0.15s forwards; }
    .ss-motif__draw--slow { animation-duration: 1.9s; animation-delay: 0.3s; }
    .ss-motif--growth .ss-motif__bar { opacity: 0; animation: ssRise 0.7s var(--ease-out, ease) forwards; }
    .ss-motif--growth .ss-motif__bar:nth-of-type(1) { animation-delay: 0.15s; }
    .ss-motif--growth .ss-motif__bar:nth-of-type(2) { animation-delay: 0.27s; }
    .ss-motif--growth .ss-motif__bar:nth-of-type(3) { animation-delay: 0.39s; }
    .ss-motif--growth .ss-motif__bar:nth-of-type(4) { animation-delay: 0.51s; }
    .ss-motif--growth .ss-motif__bar:nth-of-type(5) { animation-delay: 0.63s; }
    .ss-motif__arrow { opacity: 0; animation: ssFadeIn 0.5s ease 1.4s forwards; }
    .ss-motif__lens-g { animation: ssBob 5s ease-in-out infinite alternate; }

    /* docs + letters ease in on load */
    .ss-motif__rise { opacity: 0; animation: ssRiseDoc 0.7s var(--ease-out, ease) forwards; }
    .ss-motif__rise:nth-of-type(1) { animation-delay: 0.1s; }
    .ss-motif__rise:nth-of-type(2) { animation-delay: 0.22s; }
    .ss-motif__rise:nth-of-type(3) { animation-delay: 0.34s; }
    .ss-motif__fade { opacity: 0; animation: ssFadeIn 0.7s ease 0.3s forwards; }
    .ss-motif__fade--2 { animation-delay: 0.55s; }

    /* guide: pages fan in, the annotation lands, then a highlight reads down */
    .ss-guide__rise { opacity: 0; transform-box: fill-box; transform-origin: center; animation: ssRiseDoc 0.7s var(--ease-out, ease) forwards; }
    .ss-guide__rise:nth-of-type(1) { animation-delay: 0.1s; }
    .ss-guide__rise:nth-of-type(2) { animation-delay: 0.22s; }
    .ss-guide__rise:nth-of-type(3) { animation-delay: 0.34s; }
    .ss-guide__note { opacity: 0; transform-box: fill-box; transform-origin: left center; animation: ssNoteIn 0.5s var(--ease-out, ease) 0.5s forwards; }
    .ss-guide__hl { opacity: 0; transform-box: fill-box; transform-origin: center; animation: ssReadHL 5.5s var(--ease-out, ease) 0.9s infinite; }
    .ss-guide__go { transform-box: fill-box; transform-origin: 228px 140px; animation: ssNudge 2.8s ease-in-out 1s infinite; }

    /* team: signal flows along the links, hub breathes a soft halo, members pop in */
    .ss-net__link { animation: ssFlow 2.6s linear infinite; }
    .ss-net__halo { animation: ssHalo 4.5s ease-in-out infinite; }
    .ss-net__pop { opacity: 0; transform-box: fill-box; transform-origin: center; animation: ssPop 0.6s var(--ease-out, ease) forwards; }
    .ss-net__pop--1 { animation-delay: 0.25s; }
    .ss-net__pop--2 { animation-delay: 0.4s; }
    .ss-net__pop--3 { animation-delay: 0.55s; }
    .ss-net__pop--4 { animation-delay: 0.7s; }
  }

  @keyframes ssAura { from { transform: translate(-4%, -3%) scale(1); } to { transform: translate(5%, 4%) scale(1.12); } }
  @keyframes ssDraw { to { stroke-dashoffset: 0; } }
  @keyframes ssRise { from { opacity: 0; transform: scaleY(0.4); } to { opacity: 1; transform: scaleY(1); } }
  @keyframes ssRiseDoc { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes ssFadeIn { to { opacity: 1; } }
  @keyframes ssBob { from { transform: translate(0, 0); } to { transform: translate(-4px, -5px); } }
  @keyframes ssFlow { to { stroke-dashoffset: -20; } }
  @keyframes ssHalo { 0%, 100% { opacity: 0; transform: scale(0.8); } 50% { opacity: 0.5; transform: scale(1.5); } }
  @keyframes ssPop { from { opacity: 0; transform: scale(0.6); } to { opacity: 1; transform: scale(1); } }
  @keyframes ssNoteIn { from { opacity: 0; transform: translateX(-8px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes ssReadHL {
    0%   { opacity: 0; transform: translateY(0); }
    8%   { opacity: 1; }
    30%  { transform: translateY(20px); }
    55%  { transform: translateY(40px); }
    80%  { opacity: 1; transform: translateY(66px); }
    92%  { opacity: 0; transform: translateY(66px); }
    100% { opacity: 0; transform: translateY(0); }
  }
  @keyframes ssNudge { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(3px); } }
</style>
