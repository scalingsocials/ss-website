---
/**
 * BrandIcon — inline, official-ish brand marks used for social links and partner
 * badges. Inlined SVG (never hotlinked) so it is CSP-safe and themable.
 *
 * The marks render in FULL colour; the consumer decides the treatment. The
 * shared pattern on this site is greyscale by default, brand colour on hover —
 * see `.ss-brand` in Footer/PartnerBadges. Purely decorative next to a text
 * label, so aria-hidden; the link/label carries the accessible name.
 *
 * These are simplified, recognisable marks for identification (social profiles,
 * platform partnerships), not pixel-exact logo reproductions.
 */
export interface Props {
  name: 'linkedin' | 'instagram' | 'facebook' | 'google' | 'meta' | 'shopify';
  size?: number;
  class?: string;
}
const { name, size = 20, class: className = '' } = Astro.props;
---
{name === 'linkedin' && (
  <svg class:list={['ss-brandicon', className]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <rect width="24" height="24" rx="4" fill="#0A66C2" />
    <path fill="#fff" d="M7.2 9.6H4.8V19h2.4V9.6ZM6 5.2a1.4 1.4 0 1 0 0 2.8 1.4 1.4 0 0 0 0-2.8ZM19.2 19v-5.2c0-2.6-1.4-3.8-3.3-3.8-1.5 0-2.2.8-2.6 1.4V9.6H10.9c0 .7 0 9.4 0 9.4h2.4v-5.2c0-.3 0-.6.1-.8.3-.6.8-1.2 1.7-1.2 1.2 0 1.7.9 1.7 2.3V19h2.4Z" />
  </svg>
)}
{name === 'instagram' && (
  <svg class:list={['ss-brandicon', className]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <defs>
      <radialGradient id="ig-g" cx="0.3" cy="1" r="1.1">
        <stop offset="0" stop-color="#FED576" />
        <stop offset="0.35" stop-color="#F47133" />
        <stop offset="0.62" stop-color="#BC3081" />
        <stop offset="1" stop-color="#4C63D2" />
      </radialGradient>
    </defs>
    <rect width="24" height="24" rx="6" fill="url(#ig-g)" />
    <rect x="5" y="5" width="14" height="14" rx="4.4" fill="none" stroke="#fff" stroke-width="1.8" />
    <circle cx="12" cy="12" r="3.4" fill="none" stroke="#fff" stroke-width="1.8" />
    <circle cx="16.4" cy="7.6" r="1.1" fill="#fff" />
  </svg>
)}
{name === 'facebook' && (
  <svg class:list={['ss-brandicon', className]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <rect width="24" height="24" rx="4" fill="#1877F2" />
    <path fill="#fff" d="M15.3 12.5l.4-2.6h-2.5V8.2c0-.7.3-1.4 1.5-1.4h1.1V4.6s-1-.2-2-.2c-2 0-3.4 1.2-3.4 3.5v2H8.2v2.6h2.2V19h2.8v-6.5h2.1Z" />
  </svg>
)}
{name === 'google' && (
  <svg class:list={['ss-brandicon', className]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path fill="#4285F4" d="M21.6 12.2c0-.6-.05-1.2-.16-1.8H12v3.4h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.1Z" />
    <path fill="#34A853" d="M12 22c2.7 0 5-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.7-5.6-4.1H3.1v2.6A10 10 0 0 0 12 22Z" />
    <path fill="#FBBC05" d="M6.4 14c-.2-.6-.3-1.3-.3-2s.1-1.4.3-2V7.4H3.1a10 10 0 0 0 0 9.2L6.4 14Z" />
    <path fill="#EA4335" d="M12 5.9c1.5 0 2.8.5 3.8 1.5l2.8-2.8A10 10 0 0 0 3.1 7.4L6.4 10c.8-2.4 3-4.1 5.6-4.1Z" />
  </svg>
)}
{name === 'meta' && (
  <svg class:list={['ss-brandicon', className]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="meta-g" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#0064E0" />
        <stop offset="1" stop-color="#0082FB" />
      </linearGradient>
    </defs>
    <path fill="none" stroke="url(#meta-g)" stroke-width="2.6" stroke-linecap="round" d="M4 15.5c0-4 1.7-7 4-7 2.8 0 4 6.5 4 6.5s1.2-6.5 4-6.5c2.3 0 4 3 4 7" />
  </svg>
)}
{name === 'shopify' && (
  <svg class:list={['ss-brandicon', className]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path fill="#95BF47" d="M15.6 5.4c-.1 0-1.9.1-1.9.1s-1.3-1.3-1.5-1.4c-.1-.1-.3 0-.4 0l-.7 21.9 6.5-1.4-1.6-19c-.1-.2-.3-.2-.4-.2Z" transform="translate(0 -3)" />
    <path fill="#5E8E3E" d="M15.6 2.4c-.1 0-.2 0-.2.1.4.1.7.7.9 1.5 1.5.5 1.6.5 1.6.5l-.9-2c-.4-.1-1-.6-1.4-.6Z" />
    <path fill="#fff" d="M14.6 11c-.6-.3-1-.4-1.6-.5.9-.5 1.5-1.3 1.5-2.3 0-1.5-1-2.4-2.4-2.4-1.9 0-3 1.5-3.3 3.4l1.9-.6c.1-.7.5-1.4 1.1-1.4.4 0 .6.2.6.6 0 .6-.7 1-1.5 1.3-1.1.4-2.4 1-2.4 2.7 0 1.3 1 2.1 2.3 2.1.6 0 1.1-.1 1.5-.4l.3-1.8c-.4.3-.9.5-1.3.5-.4 0-.7-.2-.7-.6 0-.6.6-.8 1.4-1.1l.4-.1Z" transform="translate(-1 1)" />
  </svg>
)}
<style>
  .ss-brandicon { display: block; }
</style>
