---
/**
 * BrandIcon — inline, official-ish brand marks used for social links and partner
 * badges. Inlined SVG (never hotlinked) so it is CSP-safe and themable.
 *
 * The marks render in FULL colour; the consumer decides the treatment. The
 * shared pattern on this site is greyscale by default, brand colour on hover —
 * see `.ss-brand` in Footer/PartnerBadges. Purely decorative next to a text
 * label, so aria-hidden; the link/label carries the accessible name.
 *
 * These are simplified, recognisable marks for identification (social profiles,
 * platform partnerships), not pixel-exact logo reproductions.
 */
export interface Props {
  name: 'linkedin' | 'instagram' | 'facebook' | 'google' | 'meta' | 'shopify';
  size?: number;
  class?: string;
}
const { name, size = 20, class: className = '' } = Astro.props;
---
{name === 'linkedin' && (
  <svg class:list={['ss-brandicon', className]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <rect width="24" height="24" rx="4" fill="#0A66C2" />
    <path fill="#fff" d="M7.2 9.6H4.8V19h2.4V9.6ZM6 5.2a1.4 1.4 0 1 0 0 2.8 1.4 1.4 0 0 0 0-2.8ZM19.2 19v-5.2c0-2.6-1.4-3.8-3.3-3.8-1.5 0-2.2.8-2.6 1.4V9.6H10.9c0 .7 0 9.4 0 9.4h2.4v-5.2c0-.3 0-.6.1-.8.3-.6.8-1.2 1.7-1.2 1.2 0 1.7.9 1.7 2.3V19h2.4Z" />
  </svg>
)}
{name === 'instagram' && (
  <svg class:list={['ss-brandicon', className]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <defs>
      <radialGradient id="ig-g" cx="0.3" cy="1" r="1.1">
        <stop offset="0" stop-color="#FED576" />
        <stop offset="0.35" stop-color="#F47133" />
        <stop offset="0.62" stop-color="#BC3081" />
        <stop offset="1" stop-color="#4C63D2" />
      </radialGradient>
    </defs>
    <rect width="24" height="24" rx="6" fill="url(#ig-g)" />
    <rect x="5" y="5" width="14" height="14" rx="4.4" fill="none" stroke="#fff" stroke-width="1.8" />
    <circle cx="12" cy="12" r="3.4" fill="none" stroke="#fff" stroke-width="1.8" />
    <circle cx="16.4" cy="7.6" r="1.1" fill="#fff" />
  </svg>
)}
{name === 'facebook' && (
  <svg class:list={['ss-brandicon', className]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <rect width="24" height="24" rx="4" fill="#1877F2" />
    <path fill="#fff" d="M15.3 12.5l.4-2.6h-2.5V8.2c0-.7.3-1.4 1.5-1.4h1.1V4.6s-1-.2-2-.2c-2 0-3.4 1.2-3.4 3.5v2H8.2v2.6h2.2V19h2.8v-6.5h2.1Z" />
  </svg>
)}
{name === 'google' && (
  <svg class:list={['ss-brandicon', className]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
  </svg>
)}
{name === 'meta' && (
  <svg class:list={['ss-brandicon', className]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path fill="#0081FB" d="M6.915 4.03c-1.968 0-3.683 1.28-4.871 3.113C.704 9.208 0 11.883 0 14.449c0 .706.07 1.369.21 1.973a6.624 6.624 0 0 0 .265.86 5.297 5.297 0 0 0 .371.761c.696 1.159 1.818 1.927 3.593 1.927 1.497 0 2.633-.671 3.965-2.444.76-1.012 1.144-1.626 2.663-4.32l.756-1.339.186-.325c.061.1.121.196.183.3l2.152 3.595c.724 1.21 1.665 2.556 2.47 3.314 1.046.987 1.992 1.22 3.06 1.22 1.075 0 1.876-.355 2.455-.843a3.743 3.743 0 0 0 .81-.973c.542-.939.861-2.127.861-3.745 0-2.72-.681-5.357-2.084-7.45-1.282-1.912-2.957-2.93-4.716-2.93-1.047 0-2.088.467-3.053 1.308-.652.57-1.257 1.29-1.82 2.05-.69-.875-1.335-1.547-1.958-2.056-1.182-.966-2.315-1.303-3.454-1.303zm10.16 2.053c1.147 0 2.188.758 2.992 1.999 1.132 1.748 1.647 4.195 1.647 6.4 0 1.548-.368 2.9-1.839 2.9-.58 0-1.027-.23-1.664-1.004-.496-.601-1.343-1.878-2.832-4.358l-.617-1.028a44.908 44.908 0 0 0-1.255-1.98c.07-.109.141-.224.211-.327 1.12-1.667 2.118-2.602 3.358-2.602zm-10.201.553c1.265 0 2.058.791 2.675 1.446.307.327.737.871 1.234 1.579l-1.02 1.566c-.757 1.163-1.882 3.017-2.837 4.338-1.191 1.649-1.81 1.817-2.486 1.817-.524 0-1.038-.237-1.383-.794-.263-.426-.464-1.13-.464-2.046 0-2.221.63-4.535 1.66-6.088.454-.687.964-1.226 1.533-1.533a2.264 2.264 0 0 1 1.088-.285z" />
  </svg>
