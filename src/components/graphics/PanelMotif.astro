---
/**
 * PanelMotif — a static "instrument panel" illustration: a titled dashboard card
 * with a small upward chart, an annotation marker and two stat chips. The same
 * dashboard language as the homepage hero, but static (no draw animation, safe
 * to place many-per-page) and self-contained. Purely decorative — aria-hidden.
 *
 * Use in interior-page headers (tools, policy, about) and service heroes so no
 * page is a wall of text. Reads semantic vars only; works in either register.
 */
export interface Props {
  label?: string;
  tag?: string;
  class?: string;
}
const { label = 'performance.live', tag = 'Creative refresh', class: className = '' } = Astro.props;
---
<div class:list={['ss-panelmotif', className]} aria-hidden="true">
  <div class="ss-pm__head">
    <span class="ss-pm__dot"></span><span class="ss-pm__dot"></span><span class="ss-pm__dot"></span>
    <span class="ss-pm__label">{label}</span>
  </div>
  <div class="ss-pm__body">
    <svg class="ss-pm__chart" viewBox="0 0 320 150" fill="none" preserveAspectRatio="none" aria-hidden="true">
      <g class="ss-pm__grid">
        <line x1="0" y1="38" x2="320" y2="38" /><line x1="0" y1="76" x2="320" y2="76" /><line x1="0" y1="114" x2="320" y2="114" />
      </g>
      <path class="ss-pm__area" d="M0 128 C 50 120, 90 104, 130 92 C 180 76, 210 72, 250 46 C 280 28, 300 22, 320 16 L 320 150 L 0 150 Z" />
      <path class="ss-pm__line" d="M0 128 C 50 120, 90 104, 130 92 C 180 76, 210 72, 250 46 C 280 28, 300 22, 320 16" />
      <line class="ss-pm__annot" x1="250" y1="6" x2="250" y2="144" />
      <circle class="ss-pm__pt" cx="250" cy="46" r="4.5" />
    </svg>
    <span class="ss-pm__pill">{tag}</span>
    <div class="ss-pm__chips">
      <span class="ss-pm__chip"><b></b>ROAS</span>
      <span class="ss-pm__chip ss-pm__chip--teal"><b></b>CAC</span>
    </div>
  </div>
</div>
<style>
  .ss-panelmotif {
    position: relative;
    border: 1px solid var(--rule-c);
    border-radius: var(--radius-card);
    background: linear-gradient(180deg, color-mix(in srgb, var(--surface-c) 92%, transparent), var(--surface-c));
    padding: var(--space-3);
    box-shadow: 0 30px 70px -44px color-mix(in srgb, var(--accent-fill) 45%, transparent);
    overflow: hidden;
  }
  .ss-pm__head { display: flex; align-items: center; gap: 6px; padding-bottom: var(--space-2); }
  .ss-pm__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--rule-c); }
  .ss-pm__label { margin-left: auto; font-size: var(--text-label); color: var(--fg-muted); letter-spacing: 0.02em; }
  .ss-pm__body { position: relative; }
  .ss-pm__chart { width: 100%; height: auto; display: block; aspect-ratio: 320 / 150; }
  .ss-pm__grid line { stroke: var(--rule-c); stroke-width: 1; }
  .ss-pm__area { fill: color-mix(in srgb, var(--accent-fill) 15%, transparent); }
  .ss-pm__line { stroke: var(--accent-graphic); stroke-width: 2.5; stroke-linecap: round; fill: none; }
  .ss-pm__annot { stroke: var(--accent-graphic); stroke-width: 1; stroke-dasharray: 3 4; opacity: 0.7; }
  .ss-pm__pt { fill: var(--accent-graphic); }
  .ss-pm__pill {
    position: absolute; top: 4%; right: 6%;
    font-size: var(--text-label); color: var(--fg);
    background: var(--ground); border: 1px solid var(--rule-c);
    border-radius: 999px; padding: 2px 10px;
  }
  .ss-pm__chips { display: flex; gap: var(--space-2); margin-top: var(--space-2); }
  .ss-pm__chip {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: var(--text-label); font-weight: 600; color: var(--fg-muted);
    background: var(--ground); border: 1px solid var(--rule-c);
    border-radius: 999px; padding: 3px 10px;
  }
  .ss-pm__chip b { width: 8px; height: 8px; border-radius: 2px; background: var(--accent-graphic); }
  .ss-pm__chip--teal b { background: var(--accent-graphic-2); }
</style>
