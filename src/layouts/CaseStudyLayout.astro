---
/**
 * CaseStudyLayout — one anonymised account, told as a state change, with an
 * interactive hand-rolled SVG hero visual chosen to fit the data this account
 * actually has (see caseStudies.ts `tier` / `heroVisual`).
 *
 * No client is ever named — `client`/`niche` are descriptors, which is what
 * satisfies the anonymity requirement. Every figure rendered comes from the study
 * object; nothing is fabricated to fill a chart.
 *
 * Register rhythm keeps three ink bands (StatGrid, Before/After, CTA) — under the
 * five-band cap. Motion is CSS + one IntersectionObserver and respects
 * prefers-reduced-motion; every animated figure has its exact value as static text.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Meta from '@/components/seo/Meta.astro';
import SchemaGraph from '@/components/seo/SchemaGraph.astro';
import Section from '@/components/primitives/Section.astro';
import Prose from '@/components/primitives/Prose.astro';
import Button from '@/components/primitives/Button.astro';
import AnswerBlock from '@/components/blocks/AnswerBlock.astro';
import CtaBand from '@/components/blocks/CtaBand.astro';
import RangeStat from '@/components/casestudy/RangeStat.astro';
import StatGrid from '@/components/casestudy/StatGrid.astro';
import CaseVisual from '@/components/casestudy/CaseVisual.astro';
import NumberedSteps from '@/components/casestudy/NumberedSteps.astro';
import BeforeAfter from '@/components/casestudy/BeforeAfter.astro';
import PullQuote from '@/components/casestudy/PullQuote.astro';
import RelatedRow from '@/components/casestudy/RelatedRow.astro';
import { ARCHETYPES, CASE_STUDIES_ORDERED, type CaseStudy } from '@/lib/caseStudies';
import { base, caseStudy, webPage, breadcrumbs, articleId } from '@/lib/schema';

export interface Props {
  study: CaseStudy;
}
const { study: s } = Astro.props;

const url = `/case-studies/${s.slug}/`;
const published = '2026-09-05';
const publishedLabel = 'September 2026';
const arch = ARCHETYPES[s.archetype];
const related = CASE_STUDIES_ORDERED.filter((c) => c.slug !== s.slug).slice(0, 3);

const nodes = [
  ...base(),
  ...caseStudy({
    url,
    headline: s.headline,
    description: s.answer,
    datePublished: published,
    dateModified: published,
    clientName: s.niche,
    category: s.niche,
  }),
  webPage({ url, name: s.title, description: s.answer, aboutId: articleId(url), hasBreadcrumb: true, dateModified: published }),
  breadcrumbs(url, [
    { name: 'Home', url: '/' },
    { name: 'Case studies', url: '/case-studies/' },
    { name: s.niche, url },
  ]),
];
---

<BaseLayout>
  <Meta slot="meta" title={s.title} description={s.description} type="article" modifiedTime={published} />
  <SchemaGraph slot="schema" nodes={nodes} />

  <!-- 1 · paper — hero -->
  <Section size="lg" class="ss-cs-hero relative overflow-hidden">
    <!-- subtle per-archetype backdrop motif, draws in on load -->
    <svg class="ss-cs-hero__bg" viewBox="0 0 600 300" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
      {s.archetype === 'launch' && <path class="ss-cs-hero__draw" d="M20 270 C 140 265, 200 230, 300 170 C 400 110, 470 60, 580 30" />}
      {s.archetype === 'turnaround' && <><path class="ss-cs-hero__draw" d="M20 210 C 120 205, 200 200, 290 195" /><path class="ss-cs-hero__draw ss-cs-hero__draw--2" d="M310 200 C 400 150, 470 90, 580 40" /><line class="ss-cs-hero__rule" x1="300" y1="30" x2="300" y2="280" /></>}
      {s.archetype === 'scale' && <><rect class="ss-cs-hero__band" x="20" y="150" width="560" height="70" /><path class="ss-cs-hero__draw" d="M20 235 C 160 210, 280 150, 400 110 C 480 84, 530 66, 580 50" /></>}
      {s.archetype === 'sustain' && <><line class="ss-cs-hero__floor" x1="20" y1="180" x2="580" y2="180" /><circle class="ss-cs-hero__pt" cx="160" cy="130" r="5" /><circle class="ss-cs-hero__pt" cx="320" cy="150" r="5" /><circle class="ss-cs-hero__pt" cx="470" cy="120" r="5" /></>}
    </svg>

    <div class="relative">
      <nav aria-label="Breadcrumb" class="mb-[var(--space-3)] text-label text-[var(--fg-muted)]">
        <a href="/" class="text-[var(--accent-text)] no-underline">Home</a><span class="mx-[0.35rem]">/</span>
        <a href="/case-studies/" class="text-[var(--accent-text)] no-underline">Case studies</a><span class="mx-[0.35rem]">/</span>
        <span>{s.niche}</span>
      </nav>

      <div class="grid gap-[var(--space-8)] lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div>
          <span class="ss-eyebrow">{s.niche} · {arch.label}</span>
          <h1 class="max-w-[18ch]">{s.headline}</h1>
          <AnswerBlock class="mt-[var(--space-4)]">{s.answer}</AnswerBlock>
          <p class="mt-[var(--space-4)] text-label text-[var(--fg-muted)]" data-num>
            {s.channels} · {s.period} · Published <time datetime={published}>{publishedLabel}</time>
          </p>
          <div class="mt-[var(--space-6)] flex flex-wrap gap-[var(--space-2)]">
            <Button href="/audit/" variant="primary">Get a free growth plan</Button>
            <Button href="/case-studies/" variant="secondary">All case studies</Button>
          </div>
        </div>
        <div class="ss-cs-hero__stat rounded-[var(--radius-card)] border border-[var(--rule-c)] bg-[var(--ground)] p-[var(--space-6)]">
          {s.delta ? (
            <RangeStat label={s.delta.metric} from={s.delta.before} to={s.delta.after} />
          ) : s.held ? (
            <RangeStat label={s.held.metric} value={s.held.value} caption={s.held.note} />
          ) : null}
        </div>
      </div>
    </div>
  </Section>

  <!-- 2 · ink — the four figures -->
  <Section register="ink" size="md">
    <span class="ss-eyebrow">The numbers</span>
    <h2 class="max-w-[22ch] text-h2 font-semibold">What the account did</h2>
    <div class="mt-[var(--space-6)]"><StatGrid stats={s.stats} /></div>
  </Section>

  <!-- 3 · paper — the interactive hero visual -->
  <Section size="md">
    <span class="ss-eyebrow">The shape of it</span>
    <h2 class="max-w-[24ch] text-h2 font-semibold">How the account actually moved</h2>
    <div class="mt-[var(--space-6)]"><CaseVisual visual={s.heroVisual} /></div>
  </Section>

  <!-- 4 · surface — where it started -->
  <Section size="md" class="!bg-[var(--surface-c)]">
    <div class="grid gap-[var(--space-8)] lg:grid-cols-[1.4fr_1fr] lg:items-start">
      <div>
        <span class="ss-eyebrow">The starting point</span>
        <h2 class="max-w-[22ch] text-h2 font-semibold">Where the account was</h2>
        <Prose class="mt-[var(--space-4)]"><p>{s.situation}</p></Prose>
      </div>
      <aside class="lg:sticky lg:top-[96px] rounded-[var(--radius-card)] border border-[var(--rule-c)] bg-[var(--ground)] p-[var(--space-5)]">
        <span class="text-label font-semibold text-[var(--fg-muted)]">{arch.label}</span>
        <p class="mt-[var(--space-2)] text-small leading-relaxed text-[var(--fg-muted)]">{arch.blurb}</p>
        <p class="mt-[var(--space-4)] border-t border-[var(--rule-c)] pt-[var(--space-3)] text-label text-[var(--fg-muted)]">
          Client name withheld to protect a competitive account. Figures come from the client’s own
          ad account and can be verified under NDA on a call.
        </p>
      </aside>
    </div>
  </Section>

  <!-- 5 · paper — what we did -->
  <Section size="md">
    <span class="ss-eyebrow">The work</span>
    <h2 class="max-w-[24ch] text-h2 font-semibold">What we did</h2>
    <div class="mt-[var(--space-6)]"><NumberedSteps steps={s.moves} /></div>
  </Section>

  <!-- 6 · ink — before → after -->
  <Section register="ink" size="md">
    <span class="ss-eyebrow">The outcome</span>
    <h2 class="max-w-[24ch] text-h2 font-semibold">Before and after</h2>
    <div class="mt-[var(--space-6)]"><BeforeAfter rows={s.outcome} /></div>
  </Section>

  <!-- 7 · paper — the soft month + takeaway -->
  <Section size="md">
    <div class="grid gap-[var(--space-8)] lg:grid-cols-2 lg:items-center">
      <PullQuote text={s.honesty} context="The soft month" />
      <div class="lg:pl-[var(--space-4)]">
        <span class="ss-eyebrow">The takeaway</span>
        <p class="max-w-[50ch] text-h4 leading-[1.5] text-[var(--fg)]">{s.takeaway}</p>
      </div>
    </div>
  </Section>

  <!-- 8 · surface — read another -->
  <Section size="md" class="!bg-[var(--surface-c)]">
    <span class="ss-eyebrow">More proof</span>
    <h2 class="max-w-[24ch] text-h2 font-semibold">Other accounts</h2>
    <div class="mt-[var(--space-5)]">
      <RelatedRow items={related.map((r) => ({ href: `/case-studies/${r.slug}/`, niche: r.niche, headline: r.headline, period: r.period }))} />
    </div>
  </Section>

  <!-- 9 · ink — CTA -->
  <Section register="ink" size="md">
    <CtaBand
      heading="Want your account to read like this?"
      body="Send us your numbers and you get a written audit in three working days, whether or not you hire us."
      ctaLabel="Get a free growth plan"
      ctaHref="/audit/"
      secondaryLabel="Talk to us"
      secondaryHref="/contact/"
    />
  </Section>

  <script>
    import '@/scripts/caseviz.ts';
  </script>

  <style>
    .ss-eyebrow { display: inline-block; margin-bottom: var(--space-2); font-size: var(--text-label); font-weight: 600; color: var(--accent-text); }

    /* hero backdrop motif */
    .ss-cs-hero__bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0.5;
      pointer-events: none;
      -webkit-mask-image: radial-gradient(120% 100% at 80% 0%, #000 30%, transparent 78%);
              mask-image: radial-gradient(120% 100% at 80% 0%, #000 30%, transparent 78%);
    }
    .ss-cs-hero__draw, .ss-cs-hero__draw--2 { fill: none; stroke: color-mix(in srgb, var(--accent-graphic) 40%, transparent); stroke-width: 2.5; stroke-linecap: round; stroke-dasharray: 900; stroke-dashoffset: 900; }
    .ss-cs-hero__rule { stroke: color-mix(in srgb, var(--rule-c) 90%, transparent); stroke-width: 1.5; stroke-dasharray: 4 5; }
    .ss-cs-hero__band { fill: color-mix(in srgb, var(--accent-fill) 8%, transparent); }
    .ss-cs-hero__floor { stroke: color-mix(in srgb, var(--accent-graphic) 45%, transparent); stroke-width: 2.5; stroke-linecap: round; }
    .ss-cs-hero__pt { fill: color-mix(in srgb, var(--accent-graphic) 55%, transparent); }
    @media (prefers-reduced-motion: no-preference) {
      .ss-cs-hero__draw { animation: ssCsDraw 1.6s var(--ease-out) 0.2s forwards; }
      .ss-cs-hero__draw--2 { animation-delay: 0.5s; }
      @keyframes ssCsDraw { to { stroke-dashoffset: 0; } }
    }

    .ss-cs-hero__stat { box-shadow: 0 24px 60px -40px color-mix(in srgb, var(--accent-fill) 40%, transparent); }
  </style>
</BaseLayout>
