---
/**
 * ArticleLayout — blog posts and guides. See 02 §5.3.
 *
 * Everything the spec asks for is here and, importantly, all of it is real HTML:
 * the table of contents is built at build time from the rendered headings, not
 * generated by JS, because content behind JS never gets cited (CLAUDE.md §1).
 *
 * Order matters for extraction: H1, then the answer block, then the key
 * takeaways, then the body. An AI answer that lifts the top of this page gets a
 * self-contained claim rather than a preamble.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Meta from '@/components/seo/Meta.astro';
import SchemaGraph from '@/components/seo/SchemaGraph.astro';
import Section from '@/components/primitives/Section.astro';
import Prose from '@/components/primitives/Prose.astro';
import Button from '@/components/primitives/Button.astro';
import AnswerBlock from '@/components/blocks/AnswerBlock.astro';
import CtaBand from '@/components/blocks/CtaBand.astro';
import { Image } from 'astro:assets';
import { PARTNER_BY_SLUG } from '@/lib/team';
import { base, article, webPage, breadcrumbs, articleId } from '@/lib/schema';

export interface Props {
  kind: 'blog' | 'guides';
  slug: string;
  data: {
    title: string;
    seoTitle: string;
    description: string;
    answer: string;
    takeaways: string[];
    author: string;
    published: Date;
    updated?: Date;
    tags: string[];
    sources: { label: string; href: string }[];
  };
  /** Headings extracted from the rendered MDX, for the static TOC. */
  headings: { depth: number; slug: string; text: string }[];
  related: { title: string; href: string; description: string }[];
}

const { kind, slug, data, headings, related } = Astro.props;

const root = kind === 'blog' ? '/blog/' : '/guides/';
const rootLabel = kind === 'blog' ? 'Blog' : 'Guides';
const url = `${root}${slug}/`;
const author = PARTNER_BY_SLUG[data.author];
const updated = data.updated ?? data.published;
const iso = (d: Date) => d.toISOString().slice(0, 10);
const human = (d: Date) =>
  d.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });

// Only H2s carry the TOC — an H3-deep contents list is noise, not navigation.
const toc = headings.filter((h) => h.depth === 2);

const nodes = [
  ...base(),
  article({
    url,
    headline: data.title,
    description: data.description,
    datePublished: iso(data.published),
    dateModified: iso(updated),
    authorSlug: data.author,
    type: kind === 'guides' ? 'TechArticle' : 'Article',
  }),
  webPage({
    url,
    name: data.seoTitle,
    description: data.description,
    aboutId: articleId(url),
    hasBreadcrumb: true,
    dateModified: iso(updated),
  }),
  breadcrumbs(url, [
    { name: 'Home', url: '/' },
    { name: rootLabel, url: root },
    { name: data.title, url },
  ]),
];
---

<BaseLayout>
  <Meta
    slot="meta"
    title={data.seoTitle}
    description={data.description}
    type="article"
    publishedTime={iso(data.published)}
    modifiedTime={iso(updated)}
  />
  <SchemaGraph slot="schema" nodes={nodes} />

  <Section size="lg">
    <nav aria-label="Breadcrumb" class="mb-[var(--space-4)] text-small text-[var(--fg-muted)]">
      <a href="/" class="text-[var(--accent-text)] no-underline">Home</a><span> / </span>
      <a href={root} class="text-[var(--accent-text)] no-underline">{rootLabel}</a><span> / </span>
      <span>{data.title}</span>
    </nav>

    <span class="ss-eyebrow">{data.tags[0]}</span>
    <h1 class="max-w-[24ch]">{data.title}</h1>

    <AnswerBlock class="mt-[var(--space-4)]">{data.answer}</AnswerBlock>

    <!-- byline: a named human with a face and a verifiable profile -->
    {author && (
      <div class="mt-[var(--space-6)] flex flex-wrap items-center gap-[var(--space-3)]">
        <Image
          src={author.photo}
          alt={`${author.name}, ${author.role} at Scaling Socials`}
          width={44}
          height={44}
          widths={[44, 88]}
          sizes="44px"
          loading="eager"
          class="h-[44px] w-[44px] rounded-full bg-[var(--surface-c)] object-cover object-top"
        />
        <div class="flex flex-col">
          <span class="text-small font-semibold text-[var(--fg)]">
            {author.name}
            <span class="font-normal text-[var(--fg-muted)]"> · {author.role}</span>
          </span>
          <span class="text-label text-[var(--fg-muted)]" data-num>
            Published <time datetime={iso(data.published)}>{human(data.published)}</time>
            {updated.getTime() !== data.published.getTime() && (
              <> · Updated <time datetime={iso(updated)}>{human(updated)}</time></>
            )}
          </span>
        </div>
        <a
          href={author.linkedin}
          rel="author noopener"
          target="_blank"
          class="text-label font-medium text-[var(--accent-text)] no-underline"
        >LinkedIn</a>
      </div>
    )}
  </Section>

  <Section size="md">
    <div class="grid gap-[var(--space-8)] lg:grid-cols-[1fr_minmax(220px,280px)] lg:items-start">
      <div class="min-w-0">
        <!-- key takeaways: each one a standalone extractable claim (02 §5.3) -->
        <div class="rounded-[var(--radius-card)] border border-[var(--rule-c)] bg-[var(--surface-c)] p-[var(--space-5)]">
          <h2 class="text-h4 font-semibold text-[var(--fg)]">Key takeaways</h2>
          <ul class="mt-[var(--space-3)] flex flex-col gap-[var(--space-2)]">
            {data.takeaways.map((t) => (
              <li class="flex gap-[var(--space-2)] text-body leading-relaxed text-[var(--fg)]">
                <span aria-hidden="true" class="mt-[0.55em] h-[5px] w-[5px] shrink-0 rounded-full bg-[var(--accent-graphic)]"></span>
                <span>{t}</span>
              </li>
            ))}
          </ul>
        </div>

        <Prose class="mt-[var(--space-8)]">
          <slot />
        </Prose>

        {data.sources.length > 0 && (
          <div class="mt-[var(--space-8)] border-t border-[var(--rule-c)] pt-[var(--space-4)]">
            <h2 class="text-h4 font-semibold text-[var(--fg)]">Sources</h2>
            <ul class="mt-[var(--space-3)] flex flex-col gap-[var(--space-2)]">
              {data.sources.map((s) => (
                <li class="text-small">
                  <a href={s.href} rel="noopener" target="_blank" class="text-[var(--accent-text)]">{s.label}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <aside class="lg:sticky lg:top-[96px] flex flex-col gap-[var(--space-4)]">
        {toc.length > 1 && (
          <nav aria-labelledby="toc-heading" class="rounded-[var(--radius-card)] border border-[var(--rule-c)] p-[var(--space-4)]">
            <h2 id="toc-heading" class="text-label font-semibold text-[var(--fg-muted)]">On this page</h2>
            <ol class="mt-[var(--space-3)] flex flex-col gap-[var(--space-2)]">
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`} class="text-small leading-snug text-[var(--fg)] no-underline hover:text-[var(--accent-text)]">
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )}

        <div class="rounded-[var(--radius-card)] border border-[var(--rule-c)] bg-[var(--surface-c)] p-[var(--space-5)]">
          <h2 class="text-h4 font-semibold text-[var(--fg)]">Want this run for you?</h2>
          <p class="mt-[var(--space-2)] text-small leading-relaxed text-[var(--fg-muted)]">
            Send us your accounts and you get a written audit in three working days, whether or not
            you go on to hire us.
          </p>
          <div class="mt-[var(--space-4)] flex flex-col gap-[var(--space-2)]">
            <Button href="/audit/" variant="primary">Get a free growth plan</Button>
          </div>
        </div>
      </aside>
    </div>
  </Section>

  {related.length > 0 && (
    <Section size="md" class="!bg-[var(--surface-c)]">
      <span class="ss-eyebrow">Keep reading</span>
      <h2 class="max-w-[24ch] text-h2 font-semibold">Related reading</h2>
      <ul class="mt-[var(--space-5)] grid gap-[var(--space-3)] sm:grid-cols-2 lg:grid-cols-3">
        {related.map((r) => (
          <li>
            <a href={r.href} class="ss-rel group flex h-full flex-col gap-[var(--space-2)] rounded-[var(--radius-card)] border border-[var(--rule-c)] bg-[var(--ground)] p-[var(--space-4)] no-underline">
              <span class="text-h4 font-semibold leading-snug text-[var(--fg)] group-hover:text-[var(--accent-text)]">{r.title}</span>
              <span class="text-small leading-relaxed text-[var(--fg-muted)]">{r.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </Section>
  )}

  <Section register="ink" size="md">
    <CtaBand
      heading="Want this run on your account?"
      body="A written audit in three working days, whether or not you hire us."
      ctaLabel="Get a free growth plan"
      ctaHref="/audit/"
      secondaryLabel="Talk to us"
      secondaryHref="/contact/"
    />
  </Section>

  <style>
    .ss-eyebrow { display: inline-block; margin-bottom: var(--space-2); font-size: var(--text-label); font-weight: 600; color: var(--accent-text); }
    .ss-rel { transition: transform var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out); }
    @media (prefers-reduced-motion: no-preference) {
      .ss-rel:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--accent-fill) 55%, var(--rule-c)); }
    }
  </style>
</BaseLayout>
