    /* Buttons — one punchy action colour on LP buttons only */
    .lp-btn { display:inline-flex; align-items:center; justify-content:center; min-height:52px; padding: 0 var(--space-5); border-radius: var(--radius-button); background: var(--cta); color: var(--cta-on); font-weight:700; font-size:1.02rem; text-decoration:none; box-shadow: 0 10px 24px -12px color-mix(in srgb, var(--cta) 55%, transparent); transition: transform var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out); }
