---
/**
 * LandingLayout — the /lp/ ad landing-page template (02 §5.4). NOINDEX, no site
 * nav: one conversion goal, the lead form. Built for paid traffic — message-
 * matched, proof-heavy, objection-handling, with a sticky mobile CTA so the form
 * is always one tap away. Renders from a LandingContent object.
 *
 * Rebuilt 2026-09-15 against the conversion teardown. Reading order:
 *   hero → trust → problem → results (expand in place, real Ads Manager shots)
 *   → creative wall → what you get → categories we run (real proof per card)
 *   → how it works → why us (comparison table + founder note) → the real team
 *   → fit → founder videos + reviews → fee + FAQ → final CTA.
 * Zero links leave the page above the footer.
 *
 * Reuses BaseLayout in `bare` mode (no global header/footer) so the page still
 * gets the shared shell: fonts, theme, strict CSP, analytics, view transitions.
 * The minimal LP header/footer are provided here instead.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Meta from '@/components/seo/Meta.astro';
import SchemaGraph from '@/components/seo/SchemaGraph.astro';
import Section from '@/components/primitives/Section.astro';
import LeadForm from '@/components/blocks/LeadForm.astro';
import LogoWall from '@/components/blocks/LogoWall.astro';
import SiteShowcase from '@/components/blocks/SiteShowcase.astro';
import Testimonials from '@/components/blocks/Testimonials.astro';
import FaqAccordion from '@/components/blocks/FaqAccordion.astro';
import ProcessSteps from '@/components/blocks/ProcessSteps.astro';
import PartnerBadges from '@/components/blocks/PartnerBadges.astro';
import ComparisonTable from '@/components/blocks/ComparisonTable.astro';
import VideoTestimonials from '@/components/blocks/VideoTestimonials.astro';
import TeamLife from '@/components/blocks/TeamLife.astro';
import Glyph from '@/components/graphics/Glyph.astro';
import DotField from '@/components/graphics/DotField.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import lockup from '@/assets/brand/lockup-black.png';
import jamalPhoto from '@/assets/founders/jamal-khan.jpg';
import CreativeWall from '@/components/blocks/CreativeWall.astro';
import CaseStudyPoster from '@/components/blocks/CaseStudyPoster.astro';
import { ARCHETYPES, CASE_STUDY_BY_SLUG, CASE_STUDY_KICKERS, INDEX_ORDER } from '@/lib/caseStudies';
import { googleReviews } from '@/data/proofStats';
import { ORG } from '@/lib/schema/entity';
import { base, service, webPage, breadcrumbs, faqPage, serviceId } from '@/lib/schema';
import type { LandingContent } from '@/lib/landings';

export interface Props {
  content: LandingContent;
}
const { content: c } = Astro.props;
const url = c.url;
const tel = ORG.telephone.replace(/[^+\d]/g, '');
const wa = c.whatsapp ? `https://wa.me/${c.whatsapp.number}?text=${encodeURIComponent(c.whatsapp.text)}` : null;
const reply = c.replyPromise ?? 'No spam. We reply within one working day.';

// Real Ads Manager screenshots (owner-supplied 2026-09-15, brand names hidden),
// optimised by astro:assets. Nothing renders if the folder is empty — no
// placeholder row on a paid page, ever.
const shotFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/lp/proof/*.{webp,png,jpg,jpeg,avif}', { eager: true });
const proofShots: ImageMetadata[] = c.proof
  ? Object.keys(shotFiles).sort().map((k) => shotFiles[k]!.default)
  : [];

// Proof row = the existing case-study poster cards (full detail), by slug. The
// same study object feeds the expand-in-place panel, so nothing can drift.
const proofPosters = (c.proofStudies ?? [])
  .map((sl) => {
    const study = CASE_STUDY_BY_SLUG[sl];
    return study ? { study, colorIndex: (INDEX_ORDER as readonly string[]).indexOf(sl) % 7, kicker: CASE_STUDY_KICKERS[sl] ?? '' } : null;
  })
  .filter((x): x is NonNullable<typeof x> => x !== null);
const published = '2026-09-11';
const modified = '2026-09-15';

// Schema service name: the eyebrow's subject ("Performance marketing for …" →
// "Performance marketing").
const serviceName = c.hero.eyebrow.split(' for ')[0] ?? c.hero.eyebrow;

const nodes = [
  ...base(),
  service({
    url,
    name: serviceName,
    description: c.description,
    serviceType: serviceName,
    areaServed: ['IN', 'AE'],
  }),
  webPage({ url, name: c.title, description: c.description, aboutId: serviceId(url), hasBreadcrumb: true, datePublished: published, dateModified: modified }),
  breadcrumbs(url, [{ name: 'Home', url: '/' }, { name: serviceName, url }]),
  faqPage(url, c.faqs),
];

const WA_PATH = 'M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.97L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm5.8 14.03c-.24.68-1.42 1.32-1.95 1.36-.5.05-1.14.24-3.84-.8-3.22-1.27-5.28-4.55-5.44-4.76-.16-.21-1.31-1.74-1.31-3.32s.83-2.36 1.12-2.68c.29-.32.63-.4.84-.4l.6.01c.19.01.45-.07.7.54.24.6.83 2.07.9 2.22.07.15.12.32.02.53-.1.21-.15.32-.29.5-.15.18-.31.4-.44.53-.15.15-.3.31-.13.6.17.29.75 1.24 1.62 2.01 1.11.99 2.05 1.3 2.34 1.45.29.15.46.12.63-.07.17-.19.73-.85.93-1.14.19-.29.39-.24.65-.15.27.1 1.7.8 1.99.95.29.15.48.22.55.34.07.13.07.72-.17 1.4z';
---

<BaseLayout bare noindex>
  <Meta slot="meta" title={c.title} description={c.description} type="website" modifiedTime={modified} />
  <SchemaGraph slot="schema" nodes={nodes} />

  <!-- ── LP HEADER (minimal, no nav — one goal) ─────────────────────────────── -->
  <header class="lp-head">
    <div class="lp-head__in">
      <span class="lp-brand" aria-label="Scaling Socials">
        <Image src={lockup} alt="Scaling Socials" height={30} width={Math.round(30 * (lockup.width / lockup.height))} densities={[1, 2]} loading="eager" />
      </span>
      <div class="lp-head__cta">
        <a href={`tel:${tel}`} class="lp-tel lp-tel--icon" aria-label={`${c.phoneCtaLabel} ${ORG.telephone}`}>
          <Glyph name="phone" size={20} />
        </a>
        <a href="#lead" class="lp-btn lp-btn--sm">{c.ctaLabelShort}</a>
      </div>
    </div>
  </header>

  <span id="top" class="sr-only"></span>

  <!-- ── HERO ───────────────────────────────────────────────────────────────── -->
  <Section size="lg" class="lp-hero relative overflow-hidden" id="hero">
    <DotField origin="top-right" />
    <div class="[&>*]:min-w-0 lp-hero__grid relative grid gap-[var(--space-6)] lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:items-start">
      <div class="lp-hero__copy">
        <span class="lp-eyebrow">{c.hero.eyebrow}</span>
        <h1 class="lp-h1">{c.hero.h1}</h1>
        <p class="lp-sub">{c.hero.sub}</p>
        {c.hero.bullets && (
          <ul class="lp-bullets">
            {c.hero.bullets.map((b) => (
              <li>
                <span class="lp-bullets__tick"><Glyph name="scale" size={15} /></span>
                <span>{b}</span>
              </li>
            ))}
          </ul>
        )}
        {/* The CTA sits in the first phone screen. From lg up the form itself is
            the hero CTA, so this row hides to keep one accent action per view. */}
        <div class="lp-hero__cta">
          <a href="#lead" class="lp-btn">{c.ctaLabel}</a>
          {wa && (
            <a href={wa} target="_blank" rel="noopener" class="lp-walink">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={WA_PATH} /></svg>
              Chat on WhatsApp
            </a>
          )}
        </div>
        {c.hero.micro && <p class="lp-micro">{c.hero.micro}</p>}
        {c.hero.qualifier && <p class="lp-qual">{c.hero.qualifier}</p>}
        {c.hero.stats && (
          <ul class="lp-stats">
            {c.hero.stats.map((s) => (
              <li>
                <span class="lp-stats__val display-type" data-num>{s.value}</span>
                <span class="lp-stats__lbl">{s.label}</span>
              </li>
            ))}
          </ul>
        )}
        <p class="lp-trust">{c.trustLine}</p>
      </div>
      <div class="lp-hero__form" id="lead">
        <LeadForm
          source={c.source}
          heading={c.hero.formHeading}
          subheading={c.hero.formSub}
          submitLabel={c.hero.submitLabel}
          nextLabel={c.hero.nextLabel}
          footnote={reply}
          questions={c.form?.step2 ? [] : c.hero.questions}
          step1Fields={c.form?.step1}
          step2Lead={c.form?.step2}
          showMessage={c.form?.showMessage ?? true}
          redirect={c.form?.redirect}
          elevated
        />
        {wa && (
          <a href={wa} target="_blank" rel="noopener" class="lp-wa">
            <span class="lp-wa__icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d={WA_PATH} /></svg></span>
            Prefer WhatsApp? Message us
          </a>
        )}
      </div>
    </div>
  </Section>

  <!-- ── TRUST STRIP ────────────────────────────────────────────────────────── -->
  <Section size="sm" class="!bg-[var(--surface-c)]">
    <div class="lp-truststrip">
      <PartnerBadges label="Official partners" />
      <p class="lp-rating"><span class="lp-rating__stars" aria-hidden="true">★★★★★</span> 5.0 on Google, {googleReviews.value} reviews</p>
    </div>
    <div class="mt-[var(--space-6)]"><LogoWall heading="Brands we work with" /></div>
    {c.nicheLine && <p class="lp-niche">{c.nicheLine}</p>}
  </Section>

  <!-- ── PROBLEM — founder-voice pain, early, so cold traffic recognises itself ─ -->
  {c.problem && (
    <Section size="md">
      <span class="lp-eyebrow">Sound familiar?</span>
      <h2 class="lp-h2">{c.problem.heading}</h2>
      <ul class="lp-quotes">
        {c.problem.quotes.map((q) => (
          <li class="lp-quote"><blockquote>“{q}”</blockquote></li>
        ))}
      </ul>
      <div class="lp-quotes__foot">
        <p>{c.problem.pivot}</p>
        <a href="#results" class="lp-textlink">See the accounts</a>
      </div>
    </Section>
  )}

  <!-- ── RESULTS (perf) — number first, expand in place, no exits ───────────── -->
  {c.proof && (
    <Section size="md" class="!bg-[var(--surface-c)]" id="results">
      <span class="lp-eyebrow">Real accounts, real numbers</span>
      <h2 class="lp-h2">Results, not reports</h2>
      {c.proofLede && <p class="lp-lede">{c.proofLede}</p>}

      <ul class="lp-proofposters">
        {proofPosters.map((pp) => (
          <li>
            <a href={`#case-${pp.study.slug}`} class="lp-case__open" data-case-open={pp.study.slug}>
              <CaseStudyPoster study={pp.study} colorIndex={pp.colorIndex} kicker={pp.kicker} link={false} readLabel="See how" />
            </a>
          </li>
        ))}
      </ul>

      {/* The full story of each account, on this page. <details> keeps it in the
          DOM for crawlers and works with JavaScript off; the poster above just
          opens it and scrolls. */}
      <div class="lp-case__panels">
        {proofPosters.map((pp) => (
          <details class="lp-case" id={`case-${pp.study.slug}`} data-case={pp.study.slug}>
            <summary class="lp-case__sum">
              <span class="lp-case__sum-chip">{pp.study.niche} · {ARCHETYPES[pp.study.archetype].label}</span>
              <span class="lp-case__sum-h">{pp.study.headline}</span>
              <span class="lp-case__sum-stat" data-num>{pp.study.delta ? `${pp.study.delta.before} → ${pp.study.delta.after}` : pp.study.held?.value}</span>
              <span class="lp-case__sum-toggle" aria-hidden="true"></span>
            </summary>
            <div class="lp-case__body">
              <p class="lp-case__meta" data-num>{pp.study.channels} · {pp.study.period} · {pp.study.delta?.metric ?? pp.study.held?.metric}</p>
              <p class="lp-case__sit">{pp.study.situation}</p>
              <h3 class="lp-case__h">What changed</h3>
              <ol class="lp-case__moves">
                {pp.study.moves.map((m) => (
                  <li><strong>{m.title}</strong><span>{m.body}</span></li>
                ))}
              </ol>
              <h3 class="lp-case__h">Before and after</h3>
              <div class="lp-case__tblwrap">
                <table class="lp-case__tbl">
                  <thead><tr><th scope="col">Before</th><th scope="col">After</th></tr></thead>
                  <tbody>
                    {pp.study.outcome.map((o) => (
                      <tr><td>{o.before}</td><td data-num>{o.after}</td></tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="lp-case__honest"><strong>The soft month.</strong> {pp.study.honesty}</p>
              <div class="lp-case__foot">
                <a href="#lead" class="lp-btn">{c.ctaLabel}</a>
                <button type="button" class="lp-case__close" data-case-close>Close</button>
              </div>
            </div>
          </details>
        ))}
      </div>

      {proofShots.length > 0 && (
        <>
          <div class="lp-slider lp-slider--proof mt-[var(--space-7)]" data-slider>
            <div class="lp-slider__track">
              {[...proofShots, ...proofShots].map((img, i) => (
                <button type="button" class="lp-slider__item lp-shot" data-shot aria-hidden={i >= proofShots.length ? 'true' : undefined} tabindex={i >= proofShots.length ? -1 : undefined} aria-label="Enlarge Ads Manager screenshot">
                  <Image src={img} alt="Meta Ads Manager view from a client account showing spend, purchases and purchase ROAS, account name hidden" widths={[640, 1000, 1600]} sizes="(min-width: 768px) 900px, 90vw" loading="lazy" decoding="async" />
                </button>
              ))}
            </div>
          </div>
          {c.proofCaption && <p class="lp-slider__cap">{c.proofCaption}</p>}
        </>
      )}

      <div class="lp-cta-row"><a href="#lead" class="lp-btn">{c.ctaLabel}</a></div>
    </Section>
  )}

  {/* ── CREATIVES ─ the homepage creative wall (real creatives). No CTA of its own. */}
  {c.creatives && (
    <Section size="md">
      <span class="lp-eyebrow">Creative we ship</span>
      <h2 class="lp-h2">Ads we shot, cut and scaled</h2>
      <p class="lp-lede">Creative is the biggest lever in paid. You send raw footage; this is what comes back, tested weekly.</p>
      <div class="mt-[var(--space-6)]"><CreativeWall variant="marquee" limit={12} /></div>
    </Section>
  )}

  {c.showcase && (
    <Section size="md">
      <span class="lp-eyebrow">Recent work</span>
      <h2 class="lp-h2">Stores and sites we've built</h2>
      <div class="mt-[var(--space-5)]"><SiteShowcase heading="" /></div>
      <div class="lp-cta-row"><a href="#lead" class="lp-btn">{c.ctaLabel}</a></div>
    </Section>
  )}

  <!-- ── WHAT YOU GET ───────────────────────────────────────────────────────── -->
  <Section size="md" class="!bg-[var(--surface-c)]">
    <span class="lp-eyebrow">{c.benefits.eyebrow}</span>
    <h2 class="lp-h2">{c.benefits.heading}</h2>
    <p class="lp-lede">{c.benefits.sub}</p>
    <ul class:list={['lp-cards', c.benefits.items.some((i) => i.list) && 'lp-cards--2x2']}>
      {c.benefits.items.map((it) => (
        <li class="lp-card">
          <span class="lp-card__glyph"><Glyph name={it.glyph} size={20} /></span>
          <h3 class="lp-card__title">{it.title}</h3>
          <p class="lp-card__body">{it.body}</p>
          {it.list && (
            <ul class="lp-card__list">
              {it.list.map((li) => (
                <li><span class="lp-card__tick" aria-hidden="true"><Glyph name="scale" size={13} /></span>{li}</li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </Section>

  <!-- ── WHO WE WORK BEST WITH — categories, each with its own documented proof ─
       A card with no documented account states the category and nothing else,
       never a borrowed number (§15). -->
  {c.segments && (
    <Section size="md">
      <span class="lp-eyebrow">{c.segments.eyebrow}</span>
      <h2 class="lp-h2">{c.segments.heading}</h2>
      <p class="lp-lede">{c.segments.sub}</p>
      <ul class="lp-segs">
        {c.segments.items.map((sg) => (
          <li class="lp-seg">
            <span class="lp-seg__glyph"><Glyph name={sg.glyph} size={22} /></span>
            <h3 class="lp-seg__t">{sg.title}</h3>
            <p class="lp-seg__b">{sg.body}</p>
            {sg.proof ? (
              <div class="lp-seg__proof">
                <span class="lp-seg__metric">{sg.proof.metric}</span>
                <span class="lp-seg__move" data-num>
                  {sg.proof.kind === 'delta' ? (
                    <>
                      <span class="lp-seg__before">{sg.proof.before}</span>
                      <svg class="lp-seg__arrow" width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M1 5h14M11 1l5 4-5 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      <span class="lp-seg__after">{sg.proof.after}</span>
                    </>
                  ) : (
                    <span class="lp-seg__after">{sg.proof.value}</span>
                  )}
                </span>
                <span class="lp-seg__period">{sg.proof.period}</span>
              </div>
            ) : (
              <p class="lp-seg__noproof">{sg.note}</p>
            )}
          </li>
        ))}
      </ul>
    </Section>
  )}

  <!-- ── HOW IT WORKS — one dated timeline ──────────────────────────────────── -->
  <Section size="md">
    <div class="text-center">
      <span class="lp-eyebrow">How it works</span>
      <h2 class="lp-h2 mx-auto">{c.processHeading ?? 'A clear path from first call to results'}</h2>
    </div>
    <div class="mt-[var(--space-5)]"><ProcessSteps steps={c.process} /></div>
  </Section>

  <!-- ── WHY US — a fair decision table, then the founder ───────────────────── -->
  <Section size="md" class="!bg-[var(--surface-c)]">
    <span class="lp-eyebrow">{c.why.eyebrow}</span>
    <h2 class="lp-h2">{c.why.heading}</h2>
    {c.why.table ? (
      <div class="mt-[var(--space-5)]">
        <ComparisonTable columns={c.why.table.columns} rows={c.why.table.rows} highlightCol={c.why.table.highlightCol} caption={c.why.table.caption} />
      </div>
    ) : c.why.pointers ? (
      <ul class="lp-pointers">
        {c.why.pointers.map((p) => (
          <li class="lp-pointer">
            <span class="lp-pointer__tick" aria-hidden="true"><Glyph name="scale" size={15} /></span>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    ) : (
      <ul class="lp-why">
        {(c.why.points ?? []).map((p) => (
          <li class="lp-why__item">
            <span class="lp-card__glyph"><Glyph name={p.glyph} size={20} /></span>
            <div>
              <h3 class="lp-card__title">{p.title}</h3>
              <p class="lp-card__body">{p.body}</p>
            </div>
          </li>
        ))}
      </ul>
    )}

    {c.founderNote && (
      <div class="lp-note">
        <Image src={jamalPhoto} alt="Jamal Khan, Co-founder at Scaling Socials" width={112} height={112} class="lp-note__photo2" />
        <blockquote class="lp-note__q">
          <p>{c.founderNote.quote}</p>
          <cite class="lp-note__cite">— {c.founderNote.attribution}</cite>
          {c.founderNote.line && <span class="lp-note__line">{c.founderNote.line}</span>}
        </blockquote>
      </div>
    )}
  </Section>

  <!-- ── THE TEAM — real photographs, answering "who will actually be on my account" ─ -->
  {c.teamStrip && (
    <Section size="md">
      <TeamLife
        eyebrow="Who runs your account"
        heading="A senior team you can name, not a ticket queue"
        body="You talk to the people making the decisions on your account: the media buyer, the creative lead and the person fixing the store. The team is kept small on purpose so nobody is handed your brand because they happened to be free."
      />
    </Section>
  )}

  <!-- ── WHO IT'S FOR / NOT FOR ─────────────────────────────────────────────── -->
  {c.fit && (
    <Section size="md" class="!bg-[var(--surface-c)]">
      <span class="lp-eyebrow">Honest about fit</span>
      <h2 class="lp-h2">Who we do our best work with</h2>
      <div class="lp-fit">
        <div class="lp-fit__col lp-fit__col--good">
          <h3 class="lp-fit__h"><span class="lp-fit__badge lp-fit__badge--yes" aria-hidden="true">✓</span> A strong fit if you</h3>
          <ul>{c.fit.good.map((g) => <li>{g}</li>)}</ul>
        </div>
        <div class="lp-fit__col lp-fit__col--bad">
          <h3 class="lp-fit__h"><span class="lp-fit__badge lp-fit__badge--no" aria-hidden="true">✕</span> Not the right fit yet if you</h3>
          <ul>{c.fit.bad.map((g) => <li>{g}</li>)}</ul>
          {c.fit.note && <p class="lp-fit__note">{c.fit.note}</p>}
        </div>
      </div>
    </Section>
  )}

  <!-- ── TESTIMONIALS — founder videos, then the performance reviews ────────── -->
  <Section size="md">
    <span class="lp-eyebrow">What clients say</span>
    {c.videos ? (
      <>
        <h2 class="lp-h2">{c.videos.heading}</h2>
        {c.videos.lede && <p class="lp-lede">{c.videos.lede}</p>}
        <div class="mt-[var(--space-6)]"><VideoTestimonials items={c.videos.items} /></div>
        <div class="mt-[var(--space-7)]"><Testimonials variant="rail" filter={['Performance marketing']} /></div>
      </>
    ) : (
      <>
        <h2 class="lp-h2">What founders say</h2>
        <div class="mt-[var(--space-5)]"><Testimonials variant="rail" /></div>
      </>
    )}
  </Section>

  <!-- ── FEE (no figure, §18) + FAQ (objections, not information) ───────────── -->
  <Section size="md" class="!bg-[var(--surface-c)]">
    {c.fee && (
      <div class="lp-fee">
        <h2 class="lp-fee__h">{c.fee.heading}</h2>
        <ul class="lp-fee__list">
          {c.fee.lines.map((l) => (
            <li><span class="lp-fee__tick" aria-hidden="true"><Glyph name="scale" size={14} /></span><span>{l}</span></li>
          ))}
        </ul>
      </div>
    )}
    <span class="lp-eyebrow">Questions</span>
    <h2 class="lp-h2">Straight answers before you book</h2>
    <div class="mt-[var(--space-5)] max-w-[62ch]"><FaqAccordion items={c.faqs} openFirst /></div>
  </Section>

  <!-- ── FINAL CTA + repeat form (no scroll-up needed on mobile) ────────────── -->
  <Section register="ink" size="md" id="lead-bottom">
    <div class="[&>*]:min-w-0 lp-final grid gap-[var(--space-7)] lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] lg:items-center">
      <div>
        <h2 class="lp-final__h">{c.finalCta.heading}</h2>
        <p class="lp-final__b">{c.finalCta.body}</p>
        <ul class="lp-final__list">
          {(c.finalBullets ?? c.hero.bullets ?? []).map((b) => (
            <li><span class="lp-final__tick"><Glyph name="scale" size={15} /></span><span>{b}</span></li>
          ))}
        </ul>
      </div>
      <div class="lp-final__form">
        <LeadForm
          source={c.source}
          heading={c.finalCta.ctaLabel}
          subheading={c.hero.formSub}
          submitLabel={c.hero.submitLabel}
          nextLabel={c.hero.nextLabel}
          footnote={reply}
          questions={c.form?.step2 ? [] : c.hero.questions}
          step1Fields={c.form?.step1}
          step2Lead={c.form?.step2}
          showMessage={c.form?.showMessage ?? true}
          redirect={c.form?.redirect}
