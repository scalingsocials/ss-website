---
/**
 * LandingLayout — the /lp/ ad landing-page template (02 §5.4). NOINDEX, no site
 * nav: one conversion goal, the lead form. Built for paid traffic — message-
 * matched, proof-heavy, objection-handling, with a sticky mobile CTA so the form
 * is always one tap away. Renders from a LandingContent object.
 *
 * Reuses BaseLayout in `bare` mode (no global header/footer) so the page still
 * gets the shared shell: fonts, theme, strict CSP, analytics, view transitions.
 * The minimal LP header/footer are provided here instead.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Meta from '@/components/seo/Meta.astro';
import SchemaGraph from '@/components/seo/SchemaGraph.astro';
import Section from '@/components/primitives/Section.astro';
import LeadForm from '@/components/blocks/LeadForm.astro';
import LogoWall from '@/components/blocks/LogoWall.astro';
import SiteShowcase from '@/components/blocks/SiteShowcase.astro';
import Testimonials from '@/components/blocks/Testimonials.astro';
import FaqAccordion from '@/components/blocks/FaqAccordion.astro';
import ProcessSteps from '@/components/blocks/ProcessSteps.astro';
import PartnerBadges from '@/components/blocks/PartnerBadges.astro';
import Glyph from '@/components/graphics/Glyph.astro';
import DotField from '@/components/graphics/DotField.astro';
import { Image } from 'astro:assets';
import lockup from '@/assets/brand/lockup-black.png';
import jamalPhoto from '@/assets/founders/jamal-khan.jpg';
import CreativeWall from '@/components/blocks/CreativeWall.astro';
import CaseStudyPoster from '@/components/blocks/CaseStudyPoster.astro';
import { CASE_STUDY_BY_SLUG, CASE_STUDY_KICKERS, INDEX_ORDER } from '@/lib/caseStudies';
import { readdirSync } from 'node:fs';
import { ORG } from '@/lib/schema/entity';
import { base, service, webPage, breadcrumbs, faqPage, serviceId } from '@/lib/schema';
import type { LandingContent } from '@/lib/landings';

export interface Props {
  content: LandingContent;
}
const { content: c } = Astro.props;
const url = c.url;
const tel = ORG.telephone.replace(/[^+\d]/g, '');
const wa = c.whatsapp ? `https://wa.me/${c.whatsapp.number}?text=${encodeURIComponent(c.whatsapp.text)}` : null;

// Scan a /public sub-folder for slider assets (owner drops files in later). Empty
// or missing folder → empty list → the slider renders a placeholder row.
const listPublic = (dir: string): string[] => {
  try {
    return readdirSync(`public/${dir}`)
      .filter((f) => /\.(png|jpe?g|webp|mp4)$/i.test(f))
      .sort()
      .map((f) => `/${dir}/${f}`);
  } catch {
    return [];
  }
};
const proofShots = c.proof ? listPublic('lp/proof') : [];

// Proof row = the existing case-study poster cards (full detail), by slug.
const proofPosters = (c.proofStudies ?? [])
  .map((sl) => {
    const study = CASE_STUDY_BY_SLUG[sl];
    return study ? { study, colorIndex: (INDEX_ORDER as readonly string[]).indexOf(sl) % 7, kicker: CASE_STUDY_KICKERS[sl] ?? '' } : null;
  })
  .filter((x): x is NonNullable<typeof x> => x !== null);
const published = '2026-09-11';
const modified = '2026-09-11';

const nodes = [
  ...base(),
  service({
    url,
    name: c.hero.eyebrow,
    description: c.description,
    serviceType: c.hero.eyebrow,
    areaServed: ['IN', 'AE'],
  }),
  webPage({ url, name: c.title, description: c.description, aboutId: serviceId(url), hasBreadcrumb: true, datePublished: published, dateModified: modified }),
  breadcrumbs(url, [{ name: 'Home', url: '/' }, { name: c.hero.eyebrow, url }]),
  faqPage(url, c.faqs),
];
---

<BaseLayout bare noindex>
  <Meta slot="meta" title={c.title} description={c.description} type="website" modifiedTime={modified} />
  <SchemaGraph slot="schema" nodes={nodes} />

  <!-- ── LP HEADER (minimal, no nav — one goal) ─────────────────────────────── -->
  <header class="lp-head">
    <div class="lp-head__in">
      <span class="lp-brand" aria-label="Scaling Socials">
        <Image src={lockup} alt="Scaling Socials" height={30} width={Math.round(30 * (lockup.width / lockup.height))} densities={[1, 2]} loading="eager" />
      </span>
      <div class="lp-head__cta">
        <a href={`tel:${tel}`} class="lp-tel lp-tel--icon" aria-label={`${c.phoneCtaLabel} ${ORG.telephone}`}>
          <Glyph name="phone" size={20} />
        </a>
        <a href="#lead" class="lp-btn lp-btn--sm">{c.ctaLabelShort}</a>
      </div>
    </div>
  </header>

  <span id="top" class="sr-only"></span>

  <!-- ── HERO ───────────────────────────────────────────────────────────────── -->
  <Section size="lg" class="lp-hero relative overflow-hidden" id="hero">
    <DotField origin="top-right" />
    <div class="lp-hero__grid relative grid gap-[var(--space-7)] lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div class="lp-hero__copy">
        <!-- Visual opener: a plan → execute graphic, so the page leads with a
             picture of the approach, not a wall of text. Decorative. -->
        <div class="lp-plan" aria-hidden="true">
          <div class="lp-plan__step">
            <span class="lp-plan__num">1</span>
            <div class="lp-plan__txt"><span class="lp-plan__t">Plan</span><span class="lp-plan__s">Your margins & break-even ROAS</span></div>
            <span class="lp-plan__ico"><Glyph name="doc" size={20} /></span>
          </div>
          <svg class="lp-plan__arrow" width="34" height="16" viewBox="0 0 34 16" fill="none"><path d="M1 8h29M24 2l7 6-7 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <div class="lp-plan__step lp-plan__step--go">
            <span class="lp-plan__num">2</span>
            <div class="lp-plan__txt"><span class="lp-plan__t">Execute</span><span class="lp-plan__s">Create, test & scale weekly</span></div>
            <span class="lp-plan__ico"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l5-5 3 3 7-8"/><path d="M17 4h4v4"/></svg></span>
          </div>
        </div>
        <span class="lp-eyebrow">{c.hero.eyebrow}</span>
        <h1 class="lp-h1">{c.hero.h1}</h1>
        <p class="lp-sub">{c.hero.sub}</p>
        <ul class="lp-bullets">
          {c.hero.bullets.map((b) => (
            <li>
              <span class="lp-bullets__tick"><Glyph name="scale" size={15} /></span>
              <span>{b}</span>
            </li>
          ))}
        </ul>
        {c.hero.qualifier && <p class="lp-qual">{c.hero.qualifier}</p>}
        <ul class="lp-stats">
          {c.hero.stats.map((s) => (
            <li>
              <span class="lp-stats__val display-type" data-num>{s.value}</span>
              <span class="lp-stats__lbl">{s.label}</span>
            </li>
          ))}
        </ul>
        <p class="lp-trust">{c.trustLine}</p>
      </div>
      <div class="lp-hero__form" id="lead">
        <LeadForm
          source={c.source}
          heading={c.hero.formHeading}
          subheading={c.hero.formSub}
          submitLabel={c.hero.submitLabel}
          questions={c.form?.step2 ? [] : c.hero.questions}
          step1Fields={c.form?.step1}
          step2Lead={c.form?.step2}
          showMessage={c.form?.showMessage ?? true}
          redirect={c.form?.redirect}
          elevated
        />
        {wa && (
          <a href={wa} target="_blank" rel="noopener" class="lp-wa">
            <span class="lp-wa__icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.97L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm5.8 14.03c-.24.68-1.42 1.32-1.95 1.36-.5.05-1.14.24-3.84-.8-3.22-1.27-5.28-4.55-5.44-4.76-.16-.21-1.31-1.74-1.31-3.32s.83-2.36 1.12-2.68c.29-.32.63-.4.84-.4l.6.01c.19.01.45-.07.7.54.24.6.83 2.07.9 2.22.07.15.12.32.02.53-.1.21-.15.32-.29.5-.15.18-.31.4-.44.53-.15.15-.3.31-.13.6.17.29.75 1.24 1.62 2.01 1.11.99 2.05 1.3 2.34 1.45.29.15.46.12.63-.07.17-.19.73-.85.93-1.14.19-.29.39-.24.65-.15.27.1 1.7.8 1.99.95.29.15.48.22.55.34.07.13.07.72-.17 1.4z"/></svg></span>
            Prefer WhatsApp? Message us
          </a>
        )}
      </div>
    </div>
  </Section>

  <!-- ── WHAT HAPPENS NEXT ──────────────────────────────────────────────────── -->
  {c.nextSteps && (
    <Section size="sm" class="!bg-[var(--surface-c)]">
      <span class="lp-eyebrow">What happens next</span>
      <h2 class="lp-h2">A real reply, same day or the next working day.</h2>
      <ol class="lp-steps">
        {c.nextSteps.map((s) => (
          <li class="lp-step">
            <span class="lp-step__n display-type">{s.n}</span>
            <span class="lp-step__t">{s.text}</span>
          </li>
        ))}
      </ol>
    </Section>
  )}

  <!-- ── TRUST STRIP ────────────────────────────────────────────────────────── -->
  <Section size="sm" class="!bg-[var(--surface-c)]">
    <div class="lp-truststrip">
      <PartnerBadges label="Official partners" />
      <p class="lp-rating"><span class="lp-rating__stars" aria-hidden="true">★★★★★</span> Rated 5.0 on Google by D2C founders</p>
    </div>
    <div class="mt-[var(--space-6)]"><LogoWall heading="Brands we work with" /></div>
  </Section>

  <!-- ── PROOF (perf) or SHOWCASE (web) ─────────────────────────────────────── -->
  {c.proof && (
    <Section size="md">
      <span class="lp-eyebrow">Real accounts, real numbers</span>
      <h2 class="lp-h2">Growth we can show you in the ad account</h2>
      <p class="lp-lede">Every figure below is taken from a client's own Meta Ads Manager — anonymised by niche, never invented.</p>
      <ul class="lp-proofposters">
        {proofPosters.map((pp) => (
          <li><CaseStudyPoster study={pp.study} colorIndex={pp.colorIndex} kicker={pp.kicker} /></li>
        ))}
      </ul>

      {/* Row 2 — auto-scrolling Ads Manager screenshots from /public/lp/proof/ */}
      <div class="lp-slider lp-slider--proof mt-[var(--space-6)]" data-slider>
        {proofShots.length > 0 ? (
          <div class="lp-slider__track">
            {[...proofShots, ...proofShots].map((src, i) => (
              <button type="button" class="lp-slider__item lp-shot" data-shot={src} data-alt="Ads Manager screenshot from a client account, brand name hidden" aria-hidden={i >= proofShots.length ? 'true' : undefined}>
                <img src={src} alt={i < proofShots.length ? 'Ads Manager screenshot from a client account, brand name hidden' : ''} loading="lazy" decoding="async" />
              </button>
            ))}
          </div>
        ) : (
          <div class="lp-slider__empty">
            {[0, 1, 2].map(() => <span class="lp-shot lp-shot--ph">Ads Manager screenshot</span>)}
          </div>
        )}
      </div>
      <p class="lp-slider__cap">Screenshots from client Meta Ads Manager accounts. Brand names hidden.</p>

      <div class="lp-cta-row"><a href="#lead" class="lp-btn">{c.ctaLabel}</a></div>
    </Section>
  )}

  {/* ── CREATIVES ─ reuse the homepage creative wall (real creatives) ────────── */}
  {c.creatives && (
    <Section size="md" class="!bg-[var(--surface-c)]">
      <span class="lp-eyebrow">Creative we ship</span>
      <h2 class="lp-h2">Ads we've made and scaled</h2>
      <p class="lp-lede">Shot, cut and tested in-house. Creative is the lever — this is what ours looks like.</p>
      <div class="mt-[var(--space-6)]"><CreativeWall variant="marquee" limit={12} /></div>
      <div class="lp-cta-row"><a href="#lead" class="lp-btn">{c.ctaLabel}</a></div>
    </Section>
  )}

  {c.showcase && (
    <Section size="md">
      <span class="lp-eyebrow">Recent work</span>
      <h2 class="lp-h2">Stores and sites we've built</h2>
      <div class="mt-[var(--space-5)]"><SiteShowcase heading="" /></div>
      <div class="lp-cta-row"><a href="#lead" class="lp-btn">{c.ctaLabel}</a></div>
    </Section>
  )}

  <!-- ── BENEFITS ───────────────────────────────────────────────────────────── -->
  <Section size="md" class="!bg-[var(--surface-c)]">
    <span class="lp-eyebrow">{c.benefits.eyebrow}</span>
    <h2 class="lp-h2">{c.benefits.heading}</h2>
    <p class="lp-lede">{c.benefits.sub}</p>
    <ul class:list={['lp-cards', c.benefits.items.some((i) => i.list) && 'lp-cards--2x2']}>
      {c.benefits.items.map((it) => (
        <li class="lp-card">
          <span class="lp-card__glyph"><Glyph name={it.glyph} size={20} /></span>
          <h3 class="lp-card__title">{it.title}</h3>
          <p class="lp-card__body">{it.body}</p>
          {it.list && (
            <ul class="lp-card__list">
              {it.list.map((li) => (
                <li><span class="lp-card__tick" aria-hidden="true"><Glyph name="scale" size={13} /></span>{li}</li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </Section>

  <!-- ── PROCESS ────────────────────────────────────────────────────────────── -->
  <Section size="md">
    <span class="lp-eyebrow">How it works</span>
    <h2 class="lp-h2">A clear path from first call to results</h2>
    <div class="mt-[var(--space-5)]"><ProcessSteps steps={c.process} /></div>
  </Section>

  <!-- ── WHY US / RISK REVERSAL ─────────────────────────────────────────────── -->
  <Section size="md" class="!bg-[var(--surface-c)]">
    <span class="lp-eyebrow">{c.why.eyebrow}</span>
    <h2 class="lp-h2">{c.why.heading}</h2>
    {c.why.pointers ? (
      <ul class="lp-pointers">
        {c.why.pointers.map((p) => (
          <li class="lp-pointer">
            <span class="lp-pointer__tick" aria-hidden="true"><Glyph name="scale" size={15} /></span>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    ) : (
      <ul class="lp-why">
        {(c.why.points ?? []).map((p) => (
          <li class="lp-why__item">
            <span class="lp-card__glyph"><Glyph name={p.glyph} size={20} /></span>
            <div>
              <h3 class="lp-card__title">{p.title}</h3>
              <p class="lp-card__body">{p.body}</p>
            </div>
          </li>
        ))}
      </ul>
    )}
  </Section>

  <!-- ── FOUNDER NOTE ───────────────────────────────────────────────────────── -->
  {c.founderNote && (
    <Section size="md">
      <span class="lp-eyebrow">A note from the founder</span>
      <div class="lp-note">
        <Image src={jamalPhoto} alt="Jamal Khan, Co-founder at Scaling Socials" width={112} height={112} class="lp-note__photo2" />
        <blockquote class="lp-note__q">
          <p>{c.founderNote.quote}</p>
          <cite class="lp-note__cite">— {c.founderNote.attribution}</cite>
        </blockquote>
      </div>
    </Section>
  )}

  <!-- ── WHO IT'S FOR / NOT FOR ─────────────────────────────────────────────── -->
  {c.fit && (
    <Section size="md">
      <span class="lp-eyebrow">Honest about fit</span>
      <h2 class="lp-h2">Who we do our best work with</h2>
      <div class="lp-fit">
        <div class="lp-fit__col lp-fit__col--good">
          <h3 class="lp-fit__h"><span class="lp-fit__badge lp-fit__badge--yes" aria-hidden="true">✓</span> You're a strong fit if you</h3>
          <ul>{c.fit.good.map((g) => <li>{g}</li>)}</ul>
        </div>
        <div class="lp-fit__col lp-fit__col--bad">
          <h3 class="lp-fit__h"><span class="lp-fit__badge lp-fit__badge--no" aria-hidden="true">✕</span> We're probably not the best fit yet if you</h3>
          <ul>{c.fit.bad.map((g) => <li>{g}</li>)}</ul>
          {c.fit.note && <p class="lp-fit__note">{c.fit.note}</p>}
        </div>
      </div>
    </Section>
  )}

  <!-- ── WHERE YOU'RE STARTING FROM ─────────────────────────────────────────── -->
  {c.startingFrom && (
    <Section size="md" class="!bg-[var(--surface-c)]">
      <span class="lp-eyebrow">Sound familiar?</span>
      <h2 class="lp-h2">Most brands come to us from one of these</h2>
      <ul class="lp-from">
        {c.startingFrom.map((s) => (
          <li class="lp-from__card">
            <h3 class="lp-from__t">{s.title}</h3>
            <p class="lp-from__b">{s.body}</p>
          </li>
        ))}
      </ul>
      <div class="lp-from__foot">
        <span>Whichever one it is, the call is the same 30 minutes.</span>
        <a href="#lead" class="lp-btn">{c.ctaLabel}</a>
      </div>
    </Section>
  )}

  <!-- ── TESTIMONIALS ───────────────────────────────────────────────────────── -->
  <Section size="md">
    <span class="lp-eyebrow">What clients say</span>
    <h2 class="lp-h2">Founders who let us run it</h2>
    <div class="mt-[var(--space-5)]"><Testimonials variant={c.proof ? 'slider' : 'rail'} /></div>
  </Section>

  <!-- ── FAQ ────────────────────────────────────────────────────────────────── -->
  <Section size="md" class="!bg-[var(--surface-c)]">
    <span class="lp-eyebrow">Questions</span>
    <h2 class="lp-h2">Straight answers before you enquire</h2>
    <div class="mt-[var(--space-5)] max-w-[62ch]"><FaqAccordion items={c.faqs} openFirst /></div>
  </Section>

  <!-- ── GETTING STARTED ────────────────────────────────────────────────────── -->
  {c.gettingStarted && (
    <Section size="md">
      <span class="lp-eyebrow">Getting started</span>
      <h2 class="lp-h2">From first call to live campaigns in 10 days</h2>
      <div class="mt-[var(--space-5)]"><ProcessSteps steps={c.gettingStarted} /></div>
    </Section>
  )}

  <!-- ── FINAL CTA + repeat form (no scroll-up needed on mobile) ────────────── -->
  <Section register="ink" size="md" id="lead-bottom">
    <div class="lp-final grid gap-[var(--space-7)] lg:grid-cols-[1fr_0.9fr] lg:items-center">
      <div>
        <h2 class="lp-final__h">{c.finalCta.heading}</h2>
        <p class="lp-final__b">{c.finalCta.body}</p>
        <ul class="lp-final__list">
          {(c.finalBullets ?? c.hero.bullets).map((b) => (
            <li><span class="lp-final__tick"><Glyph name="scale" size={15} /></span><span>{b}</span></li>
          ))}
        </ul>
      </div>
      <div class="lp-final__form">
        <LeadForm
          source={c.source}
          heading={c.finalCta.ctaLabel}
          subheading={c.hero.formSub}
          submitLabel={c.hero.submitLabel}
          questions={c.form?.step2 ? [] : c.hero.questions}
          step1Fields={c.form?.step1}
          step2Lead={c.form?.step2}
          showMessage={c.form?.showMessage ?? true}
          redirect={c.form?.redirect}
          elevated
        />
        {wa && (
          <a href={wa} target="_blank" rel="noopener" class="lp-wa lp-wa--on-ink">
            <span class="lp-wa__icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.97L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm5.8 14.03c-.24.68-1.42 1.32-1.95 1.36-.5.05-1.14.24-3.84-.8-3.22-1.27-5.28-4.55-5.44-4.76-.16-.21-1.31-1.74-1.31-3.32s.83-2.36 1.12-2.68c.29-.32.63-.4.84-.4l.6.01c.19.01.45-.07.7.54.24.6.83 2.07.9 2.22.07.15.12.32.02.53-.1.21-.15.32-.29.5-.15.18-.31.4-.44.53-.15.15-.3.31-.13.6.17.29.75 1.24 1.62 2.01 1.11.99 2.05 1.3 2.34 1.45.29.15.46.12.63-.07.17-.19.73-.85.93-1.14.19-.29.39-.24.65-.15.27.1 1.7.8 1.99.95.29.15.48.22.55.34.07.13.07.72-.17 1.4z"/></svg></span>
            Prefer WhatsApp? Message us
          </a>
        )}
      </div>
    </div>
  </Section>

  <!-- ── LP FOOTER (slim) ───────────────────────────────────────────────────── -->
  <footer class="lp-foot">
    <div class="lp-foot__in">
      <span class="lp-foot__brand">
        <Image src={lockup} alt="Scaling Socials" height={24} width={Math.round(24 * (lockup.width / lockup.height))} densities={[1, 2]} loading="lazy" />
        <span>© {new Date().getFullYear()} {ORG.legalName}</span>
      </span>
      <nav class="lp-foot__nav" aria-label="Legal">
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
        <a href={`tel:${tel}`}>{ORG.telephone}</a>
      </nav>
    </div>
  </footer>

  <!-- ── STICKY MOBILE CTA (always one tap from the form) ───────────────────── -->
  <div class="lp-sticky" aria-hidden="false">
    <a href="#lead" class="lp-sticky__cta">{c.ctaLabel}</a>
    {wa ? (
      <a href={wa} target="_blank" rel="noopener" class="lp-sticky__wa" aria-label="Message us on WhatsApp">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.97L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm5.8 14.03c-.24.68-1.42 1.32-1.95 1.36-.5.05-1.14.24-3.84-.8-3.22-1.27-5.28-4.55-5.44-4.76-.16-.21-1.31-1.74-1.31-3.32s.83-2.36 1.12-2.68c.29-.32.63-.4.84-.4l.6.01c.19.01.45-.07.7.54.24.6.83 2.07.9 2.22.07.15.12.32.02.53-.1.21-.15.32-.29.5-.15.18-.31.4-.44.53-.15.15-.3.31-.13.6.17.29.75 1.24 1.62 2.01 1.11.99 2.05 1.3 2.34 1.45.29.15.46.12.63-.07.17-.19.73-.85.93-1.14.19-.29.39-.24.65-.15.27.1 1.7.8 1.99.95.29.15.48.22.55.34.07.13.07.72-.17 1.4z"/></svg>
      </a>
    ) : (
      <a href={`tel:${tel}`} class="lp-sticky__call" aria-label="Call us"><Glyph name="phone" size={20} /></a>
    )}
  </div>

  <!-- ── PROOF LIGHTBOX (no library; a native <dialog>) ─────────────────────── -->
  <dialog class="lp-lightbox" data-lightbox>
    <button type="button" class="lp-lightbox__close" data-lightbox-close aria-label="Close">✕</button>
    <img class="lp-lightbox__img" data-lightbox-img src="" alt="" />
  </dialog>

  <script>
    // Images that may not exist yet (placeholders shown until the owner adds them)
    // hide themselves on error so the placeholder behind shows. Screenshots open
    // full-size in a native <dialog>. No library, CSP-safe.
    const dlg = document.querySelector('dialog[data-lightbox]') as HTMLDialogElement | null;
    const big = dlg?.querySelector('[data-lightbox-img]') as HTMLImageElement | null;
    const hideOnError = (sel: string, missingTarget: (img: HTMLImageElement) => Element | null | undefined) => {
      document.querySelectorAll<HTMLImageElement>(sel).forEach((img) => {
        const mark = () => missingTarget(img)?.classList.add('is-missing');
        if (img.complete && img.naturalWidth === 0) mark();
        img.addEventListener('error', mark);
      });
    };
    hideOnError('.lp-proof__img', (img) => img.closest('.lp-proof__shot'));
    hideOnError('.lp-shot img', (img) => img.closest('.lp-shot'));
    hideOnError('.lp-note__img', (img) => img);
    document.querySelectorAll<HTMLButtonElement>('.lp-proof__shot, .lp-shot').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.classList.contains('is-missing') || !btn.dataset.shot || !dlg || !big) return;
        big.src = btn.dataset.shot;
        big.alt = btn.dataset.alt || '';
        dlg.showModal();
      });
    });
    dlg?.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dlg.close());
    dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  </script>

  <style>
