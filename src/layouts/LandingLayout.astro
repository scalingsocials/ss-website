    /* ── Buttons: brand accent, soft gradient, calm shadow ───────────────── */
    .lp-btn { position:relative; display:inline-flex; align-items:center; justify-content:center; gap:0.55rem; min-height:52px; padding: 0 var(--space-4); border-radius: var(--radius-button); background: linear-gradient(180deg, color-mix(in srgb, var(--accent-fill) 88%, var(--accent-on)) 0%, var(--accent-fill) 100%); color: var(--accent-on); font-weight:600; font-size: var(--text-small); letter-spacing:.005em; text-decoration:none; border:1px solid color-mix(in srgb, var(--accent-fill) 70%, var(--accent-on)); box-shadow: 0 10px 26px -14px color-mix(in srgb, var(--accent-fill) 55%, transparent); transition: transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out); }
