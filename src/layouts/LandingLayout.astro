    .lp-fit__note { margin-top: var(--space-3); font-size: var(--text-small); color: var(--fg-muted); }

    /* Who we work best with */
    .lp-segs { margin-top: var(--space-6); display:grid; gap: var(--space-3); grid-template-columns:1fr; }
    @media (min-width:640px){ .lp-segs { grid-template-columns: repeat(2, minmax(0,1fr)); } }
    @media (min-width:1024px){ .lp-segs { grid-template-columns: repeat(3, minmax(0,1fr)); } }
    .lp-seg { display:flex; flex-direction:column; gap: var(--space-2); padding: var(--space-5); border:1px solid var(--rule-c); border-radius: var(--radius-card); background: var(--ground); }
    .lp-seg__glyph { display:grid; place-items:center; width:44px; height:44px; border-radius: var(--radius-input); color: var(--accent-graphic); background: var(--accent-wash); border:1px solid color-mix(in srgb, var(--accent-graphic) 22%, transparent); }
    .lp-seg__t { margin-top: var(--space-2); font-size: var(--text-h4); font-weight:700; color: var(--fg); }
    .lp-seg__b { font-size: var(--text-small); line-height:1.55; color: var(--fg-muted); }
    .lp-seg__proof { margin-top:auto; padding-top: var(--space-4); border-top:1px solid var(--rule-c); }
    .lp-seg__metric { display:block; font-size: var(--text-label); font-weight:600; color: var(--fg-muted); }
    .lp-seg__move { display:flex; align-items:baseline; gap:0.5rem; margin-top:0.35rem; font-weight:800; font-size: var(--text-h4); line-height:1.1; }
    .lp-seg__before { color: var(--fg-muted); }
    .lp-seg__arrow { flex:none; align-self:center; color: var(--fg-muted); }
    .lp-seg__after { color: var(--pos); }
    .lp-seg__period { display:block; margin-top:0.35rem; font-size: var(--text-label); color: var(--fg-muted); }
    .lp-seg__noproof { margin-top:auto; padding-top: var(--space-4); border-top:1px solid var(--rule-c); font-size: var(--text-label); color: var(--fg-muted); }

    /* Fee — scope, never a figure */
    .lp-fee { margin-bottom: var(--space-7); max-width: 62ch; border:1px solid var(--rule-c); border-radius: var(--radius-card); background: var(--ground); padding: var(--space-5); }
    .lp-fee__h { font-size: var(--text-h3); font-weight:700; color: var(--fg); }
    .lp-fee__list { margin-top: var(--space-3); display:flex; flex-direction:column; gap: var(--space-2); }
    .lp-fee__list li { display:flex; gap:0.6rem; align-items:flex-start; font-size: var(--text-body); color: var(--fg); }
    .lp-fee__tick { display:inline-flex; flex:none; margin-top:4px; color: var(--accent-graphic); }

    /* Final CTA (ink register) */
    .lp-final__h { max-width: 20ch; font-size: var(--text-h2); font-weight:800; letter-spacing:-0.015em; color: var(--fg); text-wrap: balance; }
    .lp-final__b { margin-top: var(--space-3); max-width: 52ch; font-size: var(--text-h4); line-height:1.5; color: var(--fg-muted); }
    .lp-final__list { margin-top: var(--space-5); display:flex; flex-direction:column; gap: var(--space-2); }
    .lp-final__list li { display:flex; gap:0.6rem; align-items:flex-start; font-size: var(--text-body); color: var(--fg); }
    .lp-final__tick { display:grid; place-items:center; width:22px; height:22px; flex:none; margin-top:1px; border-radius:6px; background: color-mix(in srgb, var(--accent-graphic) 22%, transparent); color: var(--accent-graphic); }

    /* WhatsApp secondary button (brand green) */
    .lp-wa { display:flex; align-items:center; justify-content:center; gap:0.5rem; margin-top: var(--space-3); min-height:48px; padding:0 var(--space-4); border-radius: var(--radius-button); border:1px solid #25D366; background: color-mix(in srgb, #25D366 8%, transparent); color: #0B6B39; font-weight:600; font-size: var(--text-small); text-decoration:none; }
    .lp-wa:hover { background: color-mix(in srgb, #25D366 16%, transparent); }
    .lp-wa__icon { display:inline-flex; color:#25D366; }
    .lp-wa--on-ink { color:#EDEDED; border-color: color-mix(in srgb, #25D366 70%, transparent); }

    /* Footer */
    .lp-foot { border-top:1px solid var(--rule-c); background: var(--ground); padding: var(--space-5) var(--space-3) calc(var(--space-6) + 72px); }
    .lp-foot__in { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap: var(--space-3); max-width: var(--lp-max); margin:0 auto; font-size: var(--text-small); color: var(--fg-muted); }
    .lp-foot__brand { display:inline-flex; align-items:center; gap: var(--space-3); }
    .lp-foot__brand img { display:block; height:24px; width:auto; }
    .lp-foot__nav { display:flex; flex-wrap:wrap; gap: var(--space-4); }
    .lp-foot__nav a { color: var(--fg-muted); text-decoration:none; min-height:44px; display:inline-flex; align-items:center; }
    .lp-foot__nav a:hover { color: var(--fg); }

    /* Sticky mobile CTA */
    .lp-sticky { position: fixed; left:0; right:0; bottom:0; z-index: 50; display:flex; gap: var(--space-2); align-items:center; padding: 0.6rem var(--space-3) calc(0.6rem + env(safe-area-inset-bottom)); background: color-mix(in srgb, var(--ground) 92%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-top:1px solid var(--rule-c); transition: transform var(--dur-base) var(--ease-out); }
    .lp-sticky.is-hidden { transform: translateY(110%); }
    .lp-sticky__call { display:grid; place-items:center; width:52px; height:52px; flex:none; border-radius: var(--radius-button); border:1px solid var(--fg-muted); color: var(--fg); text-decoration:none; }
    .lp-sticky__cta { flex:1; display:inline-flex; align-items:center; justify-content:center; min-height:52px; border-radius: var(--radius-button); background: var(--cta); color: var(--cta-on); font-weight:700; text-decoration:none; text-align:center; padding: 0 var(--space-3); font-size: var(--text-small); }
    .lp-sticky__cta:hover { background: var(--cta-hover); }
    .lp-sticky__wa { display:grid; place-items:center; width:52px; height:52px; flex:none; border-radius: var(--radius-button); background:#25D366; color:#fff; text-decoration:none; }
    @media (min-width: 768px) { .lp-sticky { display:none; } .lp-foot { padding-bottom: var(--space-6); } }

    /* Lightbox */
    .lp-lightbox { border:none; padding:0; background:transparent; max-width:min(1100px,94vw); max-height:90vh; }
    .lp-lightbox::backdrop { background: color-mix(in srgb, #000 78%, transparent); }
    .lp-lightbox__img { display:block; width:100%; height:auto; border-radius: var(--radius-card); }
    .lp-lightbox__close { position:fixed; top:3vh; right:4vw; width:44px; height:44px; border-radius:50%; border:none; background:#fff; color:#000; font-size:18px; line-height:1; cursor:pointer; }

    /* ── Sliders (CSS keyframes on a duplicated track; pause on hover/focus; a
          static wrapped grid under reduced motion) ─────────────────────────── */
    .lp-slider { overflow:hidden; }
    .lp-slider__track { display:flex; gap: var(--space-3); width:max-content; animation: lpScroll 48s linear infinite; will-change: transform; }
    @media (hover: hover) { .lp-slider:hover .lp-slider__track { animation-play-state: paused; } }
    .lp-slider:focus-within .lp-slider__track { animation-play-state: paused; }
    @keyframes lpScroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    .lp-slider__cap { margin-top: var(--space-2); font-size: var(--text-label); color: var(--fg-muted); }
    .lp-shot { flex:none; height:200px; border:1px solid var(--rule-c); border-radius: var(--radius-card); overflow:hidden; background: var(--ground); padding:0; cursor: zoom-in; }
    .lp-shot img { height:100%; width:auto; max-width:none; display:block; }
    @media (min-width:768px){ .lp-shot { height:300px; } }
    .lp-shot:focus-visible { outline: 3px solid var(--accent-text); outline-offset: 2px; }

    @media (prefers-reduced-motion: reduce) {
      .lp-btn, .lp-sticky__cta, .lp-sticky, .lp-case__sum-toggle::before, .lp-case__sum-toggle::after { transition:none; }
      .lp-slider__track { animation:none; flex-wrap:wrap; width:auto; justify-content:center; }
      .lp-slider__track > [aria-hidden="true"] { display:none; }
    }
  </style>
</BaseLayout>
