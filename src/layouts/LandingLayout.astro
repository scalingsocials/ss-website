    .lp-chip--high { background: color-mix(in srgb, var(--neg) 16%, transparent); color: var(--neg); }
    .lp-chip--medium { background: color-mix(in srgb, #E8A13A 22%, transparent); color:#8A5A0F; }
    .lp-chip--low { background: color-mix(in srgb, var(--pos) 16%, transparent); color: var(--pos); }
    .lp-sample__next { border-top:1px solid var(--rule-c); padding-top: var(--space-4); }
    .lp-sample__nexth { font-size: var(--text-h4); font-weight:700; margin-bottom: var(--space-2); }
    .lp-sample__next ol { padding-left:1.2rem; display:flex; flex-direction:column; gap: var(--space-1); }
    .lp-sample__next li { font-size: var(--text-small); color: var(--fg-muted); }

    /* Sticky WhatsApp square */
    .lp-sticky__wa { display:grid; place-items:center; width:52px; height:52px; flex:none; border-radius: var(--radius-button); background:#25D366; color:#fff; text-decoration:none; }

    /* Lightbox */
    .lp-lightbox { border:none; padding:0; background:transparent; max-width:min(1100px,94vw); max-height:90vh; }
    .lp-lightbox::backdrop { background: color-mix(in srgb, #000 78%, transparent); }
    .lp-lightbox__img { display:block; width:100%; height:auto; border-radius: var(--radius-card); }
    .lp-lightbox__close { position:fixed; top:3vh; right:4vw; width:44px; height:44px; border-radius:50%; border:none; background:#fff; color:#000; font-size:18px; line-height:1; cursor:pointer; }

    /* Logo */
    .lp-brand img { display:block; height:30px; width:auto; }
    .lp-foot__brand { display:inline-flex; align-items:center; gap: var(--space-3); }
    .lp-foot__brand img { display:block; height:24px; width:auto; }

    /* ── Sliders (CSS keyframes on a duplicated track; pause on hover/focus; a
          static wrapped grid under reduced motion) ─────────────────────────── */
    .lp-slider { overflow:hidden; }
    .lp-slider__track { display:flex; gap: var(--space-3); width:max-content; animation: lpScroll 40s linear infinite; will-change: transform; }
    /* Pause on hover only where a real pointer exists — on touch, :hover sticks
       after a tap and would freeze the marquee. Focus (keyboard) always pauses. */
    @media (hover: hover) { .lp-slider:hover .lp-slider__track { animation-play-state: paused; } }
    .lp-slider:focus-within .lp-slider__track { animation-play-state: paused; }
    @keyframes lpScroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    .lp-slider__empty { display:flex; flex-wrap:wrap; gap: var(--space-3); }
    .lp-slider__cap { margin-top: var(--space-2); font-size: var(--text-label); color: var(--fg-muted); }
    /* proof screenshots */
    .lp-shot { flex:none; height:220px; border:1px solid var(--rule-c); border-radius: var(--radius-card); overflow:hidden; background: var(--surface-c); padding:0; cursor: zoom-in; }
    .lp-shot img { height:100%; width:auto; display:block; }
    @media (min-width:768px){ .lp-shot { height:320px; } }
    .lp-shot--ph { display:grid; place-items:center; width:min(440px,82vw); color: var(--fg-muted); font-size: var(--text-label); cursor:default;
      background: repeating-linear-gradient(45deg, var(--surface-c), var(--surface-c) 10px, color-mix(in srgb, var(--fg-muted) 8%, var(--surface-c)) 10px, color-mix(in srgb, var(--fg-muted) 8%, var(--surface-c)) 20px); }
    /* creatives (portrait 9:16) */
    .lp-creative { flex:none; height:260px; aspect-ratio:9/16; border:1px solid var(--rule-c); border-radius: var(--radius-card); overflow:hidden; background: var(--ground); }
    .lp-creative img, .lp-creative video { width:100%; height:100%; object-fit:cover; display:block; }
    @media (min-width:768px){ .lp-creative { height:360px; } }
    .lp-creative--ph { display:grid; place-items:center; color: var(--fg-muted); font-size: var(--text-label); }

    /* Founder note */
    .lp-note { margin-top: var(--space-5); display:flex; flex-direction:column; align-items:flex-start; gap: var(--space-4); max-width: 780px; }
    @media (min-width:640px){ .lp-note { flex-direction:row; align-items:center; gap: var(--space-5); } }
    .lp-note__photo2 { width:112px; height:112px; flex:none; border-radius:50%; object-fit:cover; border:1px solid var(--rule-c); }
    .lp-note__q p { font-size: var(--text-h4); line-height:1.55; color: var(--fg); }
    .lp-note__cite { display:block; margin-top: var(--space-3); font-weight:600; color: var(--fg-muted); font-style:normal; }

    /* Proof: existing case-study poster cards in a 3-up row */
    .lp-proofposters { margin-top: var(--space-5); display:grid; gap: var(--space-4); grid-template-columns:1fr; }
    @media (min-width:640px){ .lp-proofposters { grid-template-columns: repeat(2, minmax(0,1fr)); } }
    @media (min-width:1024px){ .lp-proofposters { grid-template-columns: repeat(3, minmax(0,1fr)); } }

    /* Form heading a touch larger on the LP (task: form CTA looked small) */
    .lp-hero__form :global(.ss-leadform h3), .lp-final__form :global(.ss-leadform h3) { font-size: var(--text-h3); line-height: 1.15; }
    /* CTAs point at #lead (the form). Offset so it clears the sticky LP header. */
    .lp-hero__form { scroll-margin-top: 84px; }
    /* Extra breathing room between the hero copy and the form on mobile */
    @media (max-width: 959px) { .lp-hero__form { margin-top: var(--space-4); } }

    /* Why pointers */
    .lp-pointers { margin-top: var(--space-6); display:grid; gap: var(--space-3); grid-template-columns:1fr; }
    @media (min-width:768px){ .lp-pointers { grid-template-columns:1fr 1fr; gap: var(--space-3) var(--space-6); } }
    .lp-pointer { display:flex; gap: var(--space-3); align-items:flex-start; font-size: var(--text-body); color: var(--fg); }
    .lp-pointer__tick { display:grid; place-items:center; width:24px; height:24px; flex:none; margin-top:1px; border-radius:6px; background: var(--accent-wash); color: var(--accent-graphic); }

    /* What-you-get checklist cards */
    .lp-cards--2x2 { grid-template-columns:1fr; }
    @media (min-width:768px){ .lp-cards--2x2 { grid-template-columns:1fr 1fr; } }
    .lp-cards--2x2 .lp-card { background: color-mix(in srgb, var(--accent-wash) 55%, var(--ground)); border-color: color-mix(in srgb, var(--accent-graphic) 14%, var(--rule-c)); }
    .lp-card__list { margin-top: var(--space-3); display:flex; flex-direction:column; gap: var(--space-2); }
    .lp-card__list li { display:flex; gap:0.5rem; align-items:flex-start; font-size: var(--text-small); color: var(--fg); }
    .lp-card__tick { display:inline-flex; flex:none; margin-top:2px; color: var(--accent-graphic); }

    /* Where you're starting from */
    .lp-from { margin-top: var(--space-6); display:grid; gap: var(--space-3); grid-template-columns:1fr; }
    @media (min-width:640px){ .lp-from { grid-template-columns: repeat(2, minmax(0,1fr)); } }
    .lp-from__card { border:1px solid var(--rule-c); border-radius: var(--radius-card); background: var(--ground); padding: var(--space-5); }
    .lp-from__t { font-size: var(--text-h4); font-weight:700; margin-bottom: var(--space-2); }
    .lp-from__b { font-size: var(--text-small); line-height:1.55; color: var(--fg-muted); }
    .lp-from__foot { margin-top: var(--space-6); display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap: var(--space-3); }
    .lp-from__foot span { font-size: var(--text-body); color: var(--fg); }

    .lp-fit__note { margin-top: var(--space-3); font-size: var(--text-small); color: var(--fg-muted); }

    @media (prefers-reduced-motion: reduce) {
      .lp-btn, .lp-sticky__cta { transition:none; }
      .lp-slider__track { animation:none; flex-wrap:wrap; width:auto; justify-content:center; }
      .lp-slider__track > [aria-hidden="true"] { display:none; }
    }
  </style>
</BaseLayout>
