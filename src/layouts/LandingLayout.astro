    .lp-case__sum { display:grid; grid-template-columns: minmax(0,1fr) auto; grid-template-areas: "chip toggle" "h toggle" "stat toggle"; align-items:center; gap: 0.2rem var(--space-3); padding: var(--space-4) var(--space-5); cursor:pointer; list-style:none; }
