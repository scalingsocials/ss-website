    .lp-case__sum-chip { grid-area: chip; font-size: var(--text-label); font-weight:600; color: var(--fg-muted); }
    .lp-case__sum-h { grid-area: h; font-size: var(--text-h4); font-weight:700; color: var(--fg); line-height:1.25; }
