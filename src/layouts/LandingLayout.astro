  <!-- ── PROOF LIGHTBOX (no library; a native <dialog>) ─────────────────────── -->
  <dialog class="lp-lightbox" data-lightbox>
    <button type="button" class="lp-lightbox__close" data-lightbox-close aria-label="Close">✕</button>
    <img class="lp-lightbox__img" data-lightbox-img alt="" width="1600" height="600" />
  </dialog>

  </div>

  <script>
    // All progressive enhancement, no library, CSP-safe. Re-runs on view
    // transitions; every binding is guarded so nothing doubles up.
    const init = () => {
      // 0. Header: transparent over the ink hero, solid once scrolled.
      const head = document.querySelector<HTMLElement>('[data-lp-head]');
      const hero = document.getElementById('hero');
      if (head && hero && !head.dataset.bound && 'IntersectionObserver' in window) {
        head.dataset.bound = '1';
        const sentinel = document.createElement('span');
        sentinel.setAttribute('aria-hidden', 'true');
        sentinel.className = 'lp-head__sentinel';
        hero.prepend(sentinel);
        new IntersectionObserver(([e]) => head.classList.toggle('is-solid', !e?.isIntersecting), { rootMargin: '-72px 0px 0px 0px' }).observe(sentinel);
      }

      // 0b. In-page anchors (#lead, #results, #case-…). The view-transition router
      //     intercepts same-document hash clicks and, on this page, updates the
      //     hash without scrolling. Scroll explicitly so every CTA lands on the form.
      document.querySelectorAll<HTMLAnchorElement>('.lp a[href^="#"]').forEach((a) => {
        if (a.dataset.anchorBound || a.dataset.caseOpen !== undefined) return;
        a.dataset.anchorBound = '1';
        a.addEventListener('click', (e) => {
          const id = decodeURIComponent(a.getAttribute('href')!.slice(1));
          const target = id && document.getElementById(id);
          if (!target) return;
          e.preventDefault();
          history.replaceState(null, '', `#${id}`);
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      // 1. Screenshots open full-size in a native <dialog>.
      const dlg = document.querySelector('dialog[data-lightbox]') as HTMLDialogElement | null;
      const big = dlg?.querySelector('[data-lightbox-img]') as HTMLImageElement | null;
      document.querySelectorAll<HTMLButtonElement>('.lp-shot').forEach((btn) => {
        if (btn.dataset.bound) return;
        btn.dataset.bound = '1';
        btn.addEventListener('click', () => {
          const img = btn.querySelector('img');
          if (!img || !dlg || !big) return;
          const cands = (img.srcset || '').split(',').map((s) => s.trim().split(' ')[0]).filter(Boolean);
          big.src = cands[cands.length - 1] || img.currentSrc || img.src;
          big.alt = img.alt || 'Ads Manager screenshot';
          dlg.showModal();
        });
      });
      if (dlg && !dlg.dataset.bound) {
        dlg.dataset.bound = '1';
        dlg.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dlg.close());
        dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
      }

      // 2. Case posters open their <details> panel in place (and close the others).
      const panels = Array.from(document.querySelectorAll<HTMLDetailsElement>('details[data-case]'));
      const openCase = (slug: string) => {
        for (const d of panels) d.open = d.dataset.case === slug;
        const d = panels.find((p) => p.dataset.case === slug);
        if (!d) return;
        d.scrollIntoView({ behavior: 'smooth', block: 'start' });
        d.querySelector<HTMLElement>('summary')?.focus({ preventScroll: true });
      };
      document.querySelectorAll<HTMLAnchorElement>('[data-case-open]').forEach((a) => {
        if (a.dataset.bound) return;
        a.dataset.bound = '1';
        a.addEventListener('click', (e) => { e.preventDefault(); openCase(a.dataset.caseOpen || ''); });
      });
      document.querySelectorAll<HTMLButtonElement>('[data-case-close]').forEach((b) => {
        if (b.dataset.bound) return;
        b.dataset.bound = '1';
        b.addEventListener('click', () => {
          const d = b.closest<HTMLDetailsElement>('details[data-case]');
          if (!d) return;
          d.open = false;
          document.querySelector<HTMLElement>(`[data-case-open="${d.dataset.case}"]`)?.focus();
        });
      });

      // 3. The sticky bar steps aside while either lead form is on screen.
      const sticky = document.querySelector<HTMLElement>('[data-sticky]');
      if (sticky && !sticky.dataset.bound && 'IntersectionObserver' in window) {
        sticky.dataset.bound = '1';
        const visible = new Set<Element>();
        const io = new IntersectionObserver((entries) => {
          for (const en of entries) en.isIntersecting ? visible.add(en.target) : visible.delete(en.target);
          sticky.classList.toggle('is-hidden', visible.size > 0);
        }, { threshold: 0.15 });
        document.querySelectorAll('form[data-lead-form]').forEach((f) => io.observe(f));
      }
    };
    init();
    document.addEventListener('astro:page-load', init);
  </script>

