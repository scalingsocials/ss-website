    .lp-why { margin-top: var(--space-6); display:grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
    .lp-why__item { display:flex; gap: var(--space-3); align-items:flex-start; }

    /* Final CTA (ink register) */
    .lp-final__h { max-width: 20ch; font-size: var(--text-h2); font-weight:800; letter-spacing:-0.015em; color: var(--fg); }
    .lp-final__b { margin-top: var(--space-3); max-width: 52ch; font-size: var(--text-h4); line-height:1.5; color: var(--fg-muted); }
