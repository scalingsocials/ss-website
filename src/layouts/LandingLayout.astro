    .lp-step__t { font-size: var(--text-small); line-height:1.5; color: var(--fg); }

    /* Proof: force 3-up on desktop, screenshot slot + still-running */
    .lp-proof { grid-template-columns:1fr; }
    @media (min-width:768px){ .lp-proof { grid-template-columns: repeat(3, minmax(0,1fr)); } }
    .lp-proof__card { display:flex; flex-direction:column; }
    .lp-proof__shot { position:relative; display:block; width:100%; aspect-ratio:5/3; margin-bottom: var(--space-3); border:1px solid var(--rule-c); border-radius: var(--radius-input); overflow:hidden; background: var(--surface-c); padding:0; cursor: zoom-in; }
    .lp-proof__ph { position:absolute; inset:0; display:grid; place-items:center; font-size: var(--text-label); color: var(--fg-muted); background: repeating-linear-gradient(45deg, var(--surface-c), var(--surface-c) 10px, color-mix(in srgb, var(--fg-muted) 8%, var(--surface-c)) 10px, color-mix(in srgb, var(--fg-muted) 8%, var(--surface-c)) 20px); }
    .lp-proof__img { position:relative; z-index:1; width:100%; height:100%; object-fit:cover; display:block; }
    .lp-proof__shot.is-missing { cursor:default; }
    .lp-proof__shot.is-missing .lp-proof__img { display:none; }
    .lp-proof__running { margin-top: var(--space-2); font-size: var(--text-label); font-weight:600; color: var(--fg-muted); }
    .lp-proof__running::before { content:'●'; margin-right:0.4rem; color: var(--pos); font-size:0.7em; vertical-align:middle; }

    /* Who it's for / not for */
    .lp-fit { margin-top: var(--space-6); display:grid; gap: var(--space-4); grid-template-columns:1fr; }
    @media (min-width:768px){ .lp-fit { grid-template-columns:1fr 1fr; } }
    .lp-fit__col { border:1px solid var(--rule-c); border-radius: var(--radius-card); background: var(--ground); padding: var(--space-5); }
    .lp-fit__col--good { border-color: color-mix(in srgb, var(--pos) 35%, var(--rule-c)); }
    .lp-fit__col--bad { border-color: color-mix(in srgb, var(--neg) 30%, var(--rule-c)); }
    .lp-fit__h { display:flex; align-items:center; gap:0.5rem; font-size: var(--text-h4); font-weight:700; margin-bottom: var(--space-3); }
    .lp-fit__badge { display:grid; place-items:center; width:24px; height:24px; flex:none; border-radius:50%; font-size:13px; font-weight:700; }
    .lp-fit__badge--yes { background: color-mix(in srgb, var(--pos) 18%, transparent); color: var(--pos); }
    .lp-fit__badge--no { background: color-mix(in srgb, var(--neg) 16%, transparent); color: var(--neg); }
    .lp-fit__col ul { display:flex; flex-direction:column; gap: var(--space-2); }
    .lp-fit__col li { position:relative; padding-left: var(--space-4); font-size: var(--text-body); color: var(--fg); }
    .lp-fit__col li::before { content:''; position:absolute; left:0; top:0.62em; width:6px; height:6px; border-radius:50%; background: var(--fg-muted); }

    /* Sample audit */
    .lp-sample { margin-top: var(--space-6); max-width:760px; border:1px solid var(--rule-c); border-radius: var(--radius-card); background: var(--ground); padding: var(--space-5); }
    .lp-sample__head { display:flex; align-items:center; justify-content:space-between; gap: var(--space-3); flex-wrap:wrap; padding-bottom: var(--space-4); border-bottom:1px solid var(--rule-c); }
    .lp-sample__tag { font-size: var(--text-label); font-weight:700; letter-spacing:0.04em; text-transform:uppercase; color: var(--accent-on); background: var(--accent-fill); border-radius:999px; padding:0.25rem 0.7rem; }
    .lp-sample__score { text-align:right; }
    .lp-sample__score-n { display:block; font-weight:800; font-size: var(--text-h2); line-height:1; color: var(--fg); }
    .lp-sample__score-l { font-size: var(--text-label); color: var(--fg-muted); }
    .lp-sample__findings { display:flex; flex-direction:column; gap: var(--space-3); padding: var(--space-4) 0; }
    .lp-sample__finding { display:flex; gap: var(--space-3); align-items:flex-start; font-size: var(--text-small); color: var(--fg); }
    .lp-chip { flex:none; font-size: var(--text-label); font-weight:700; border-radius:999px; padding:0.15rem 0.6rem; }
    .lp-chip--high { background: color-mix(in srgb, var(--neg) 16%, transparent); color: var(--neg); }
    .lp-chip--medium { background: color-mix(in srgb, #E8A13A 22%, transparent); color:#8A5A0F; }
    .lp-chip--low { background: color-mix(in srgb, var(--pos) 16%, transparent); color: var(--pos); }
    .lp-sample__next { border-top:1px solid var(--rule-c); padding-top: var(--space-4); }
    .lp-sample__nexth { font-size: var(--text-h4); font-weight:700; margin-bottom: var(--space-2); }
    .lp-sample__next ol { padding-left:1.2rem; display:flex; flex-direction:column; gap: var(--space-1); }
    .lp-sample__next li { font-size: var(--text-small); color: var(--fg-muted); }

    /* Sticky WhatsApp square */
    .lp-sticky__wa { display:grid; place-items:center; width:52px; height:52px; flex:none; border-radius: var(--radius-button); background:#25D366; color:#fff; text-decoration:none; }

    /* Lightbox */
    .lp-lightbox { border:none; padding:0; background:transparent; max-width:min(1100px,94vw); max-height:90vh; }
    .lp-lightbox::backdrop { background: color-mix(in srgb, #000 78%, transparent); }
    .lp-lightbox__img { display:block; width:100%; height:auto; border-radius: var(--radius-card); }
    .lp-lightbox__close { position:fixed; top:3vh; right:4vw; width:44px; height:44px; border-radius:50%; border:none; background:#fff; color:#000; font-size:18px; line-height:1; cursor:pointer; }

    @media (prefers-reduced-motion: reduce) { .lp-btn, .lp-sticky__cta { transition:none; } }
  </style>
</BaseLayout>
