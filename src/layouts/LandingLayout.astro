    .lp-foot__nav a:hover { color: var(--fg); }

    /* Sticky mobile CTA */
    .lp-sticky { position: fixed; left:0; right:0; bottom:0; z-index: 50; display:flex; gap: var(--space-2); align-items:center; padding: 0.6rem var(--space-3) calc(0.6rem + env(safe-area-inset-bottom)); background: color-mix(in srgb, var(--ground) 92%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-top:1px solid var(--rule-c); }
    .lp-sticky__call { display:grid; place-items:center; width:52px; height:52px; flex:none; border-radius: var(--radius-button); border:1px solid var(--fg-muted); color: var(--fg); text-decoration:none; }
    .lp-sticky__cta { flex:1; display:inline-flex; align-items:center; justify-content:center; min-height:52px; border-radius: var(--radius-button); background: var(--accent-fill); color: var(--accent-on); font-weight:700; text-decoration:none; }
    @media (min-width: 768px) { .lp-sticky { display:none; } .lp-foot { padding-bottom: var(--space-6); } }

    /* ── CTA colour: one punchy action colour on LP buttons only (task 1a) ──── */
    .lp-btn { background: var(--cta); color: var(--cta-on); box-shadow: 0 10px 24px -12px color-mix(in srgb, var(--cta) 55%, transparent); }
    .lp-btn:hover { background: var(--cta-hover); }
    .lp-sticky__cta { background: var(--cta); color: var(--cta-on); }
    .lp-sticky__cta:hover { background: var(--cta-hover); }
    .lp-hero__form :global(.ss-btn-primary), .lp-final__form :global(.ss-btn-primary) { background: var(--cta); color: var(--cta-on); }
    .lp-hero__form :global(.ss-btn-primary):hover, .lp-final__form :global(.ss-btn-primary):hover { background: var(--cta-hover); }
    .lp-tel--icon { padding: 0; min-width: 44px; justify-content: center; color: var(--fg); }

    /* Hero qualifier */
    .lp-qual { margin-top: var(--space-3); font-size: var(--text-small); color: var(--fg-muted); }

    /* WhatsApp secondary button (brand green) */
    .lp-wa { display:flex; align-items:center; justify-content:center; gap:0.5rem; margin-top: var(--space-3); min-height:48px; padding:0 var(--space-4); border-radius: var(--radius-button); border:1px solid #25D366; background: color-mix(in srgb, #25D366 8%, transparent); color: #0B6B39; font-weight:600; font-size: var(--text-small); text-decoration:none; }
