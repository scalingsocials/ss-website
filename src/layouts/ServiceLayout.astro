---
/**
 * ServiceLayout — the pillar-page template. See 02 §5.1 and 03 §1.3.
 *
 * Renders a full service page from a ServiceContent object: answer-first hero
 * with an inline service-specific lead form, real proof, education, sub-services,
 * comparison, process, a value block, a genuine disqualifier list, FAQ, and
 * a CTA band. Emits one @graph (Service + WebPage + BreadcrumbList + FAQPage).
 * No pricing is shown anywhere (owner directive).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Meta from '@/components/seo/Meta.astro';
import SchemaGraph from '@/components/seo/SchemaGraph.astro';
import Section from '@/components/primitives/Section.astro';
import Prose from '@/components/primitives/Prose.astro';
import Button from '@/components/primitives/Button.astro';
import LeadForm from '@/components/blocks/LeadForm.astro';
import LogoWall from '@/components/blocks/LogoWall.astro';
import SiteShowcase from '@/components/blocks/SiteShowcase.astro';
import CreativeWall from '@/components/blocks/CreativeWall.astro';
import ProcessSteps from '@/components/blocks/ProcessSteps.astro';
import PricingBlock from '@/components/blocks/PricingBlock.astro';
import ComparisonTable from '@/components/blocks/ComparisonTable.astro';
import NotForYouBlock from '@/components/blocks/NotForYouBlock.astro';
import FaqAccordion from '@/components/blocks/FaqAccordion.astro';
import CtaBand from '@/components/blocks/CtaBand.astro';
import Glyph from '@/components/graphics/Glyph.astro';
import SubServiceCard from '@/components/blocks/SubServiceCard.astro';
import DotField from '@/components/graphics/DotField.astro';
import { HERO_STATS } from '@/lib/caseStudies';
import { INDUSTRIES } from '@/lib/industries';
import { COMPARISONS } from '@/lib/comparisons';
import { SERVICE_NAMES } from '@/lib/serviceCategory';
import { glyphFor } from '@/lib/glyphFor';
import { base, service, webPage, breadcrumbs, faqPage, serviceId } from '@/lib/schema';
import type { ServiceContent } from '@/lib/services';

export interface Props {
  svc: ServiceContent;
}
const { svc } = Astro.props;
const url = svc.url;
const published = '2026-09-01';
const modified = '2026-09-04';

// Hero highlights. Performance marketing shows its real Meta results (HERO_STATS);
// every other pillar has no verified per-service numbers, so it defines its own
// honest, non-metric `heroStats` (scope facts, not invented figures) — see §15.
const heroStats =
  svc.heroStats ??
  HERO_STATS.map((cs) => ({ value: cs.value, label: `${cs.label}, ${cs.niche.toLowerCase()}` }));

// Pre-selected service for the lead form: match the page to a canonical name.
const svcDefault =
  SERVICE_NAMES.find((n) => n.toLowerCase() === svc.name.toLowerCase()) ??
  SERVICE_NAMES.find((n) => n.toLowerCase().includes(svc.name.toLowerCase().split(' ')[0]!)) ??
  SERVICE_NAMES[0];

// Cards left over on the last row at three-up and at two-up. Computed here, not
// in CSS, because centring a short row needs to know where that row begins —
// :nth-last-child can express it, but only as one rule per remainder per
// breakpoint, and this is the same fact stated once.
const rest3 = svc.subservices.length % 3;
const rest2 = svc.subservices.length % 2;

const nodes = [
  ...base(),
  service({
    url,
    name: svc.name,
    description: svc.description,
    serviceType: svc.name,
    areaServed: ['IN', 'AE'],
    offerCatalog: svc.subservices.map((s) => ({ name: s.title, url: s.href ?? url })),
  }),
  webPage({ url, name: svc.title, description: svc.description, aboutId: serviceId(url), hasBreadcrumb: true, datePublished: published, dateModified: modified }),
  breadcrumbs(url, [{ name: 'Home', url: '/' }, { name: svc.name, url }]),
  faqPage(url, svc.faqs),
];
---

<BaseLayout heroOver>
  <Meta slot="meta" title={svc.title} description={svc.description} type="website" modifiedTime={modified} />
  <SchemaGraph slot="schema" nodes={nodes} />

  <!-- HERO — ink, matching the homepage opener (owner-directed, 2026-09-13):
       same dark ground, same ambient wash, same full-bleed-under-a-transparent-
       header treatment via `heroOver` + .ss-hero-over. Still form-forward, so the
       lead form becomes a glass card — on ink, --ground is near-black and the
       form's default card would be black-on-black. -->
  <Section register="ink" size="lg" class="ss-inkhero ss-inkhero--pillar ss-hero-over">
    <DotField origin="top-right" />
    <nav aria-label="Breadcrumb" class="ss-inkhero__crumb relative flex flex-wrap items-center text-label text-[var(--fg-muted)]">
      <a href="/" class="inline-flex items-center text-[var(--accent-text)] no-underline">Home</a><span class="mx-[0.35rem]">/</span><span>{svc.name}</span>
    </nav>
    <div class="ss-inkhero__grid relative grid gap-[var(--space-8)] lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div class="ss-inkhero__copy">
        <span class="ss-eyebrow">{svc.eyebrow}</span>
        <h1>{svc.h1}</h1>
        <p class="mt-[var(--space-4)] max-w-[54ch] text-h4 leading-[1.45] text-[var(--fg)]">{svc.answer}</p>
        <ul class="ss-inkhero__stats mt-[var(--space-5)] grid grid-cols-3 gap-x-[var(--space-3)] gap-y-[var(--space-2)]">
          {heroStats.map((s) => (
            <li class="flex flex-col gap-[3px]">
              <span class="ss-inkhero__stat-val display-type font-bold leading-none text-[var(--fg)]" data-num>{s.value}</span>
              <span class="text-label leading-snug text-[var(--fg-muted)]">{s.label}</span>
            </li>
          ))}
        </ul>
        {/* Two columns, not flex-wrap: on a phone the two labels are too long to
            share a flex row, so they wrapped into a stack that ate ~90px of the
            first screen and pushed the form further down. A grid puts them side
            by side at every width and lets each button shrink its own text. */}
        <div class="ss-inkhero__cta mt-[var(--space-5)] grid grid-cols-2 gap-[var(--space-2)]">
          <Button href="/audit/" variant="primary">{svc.formHeading}</Button>
          <Button href="/case-studies/" variant="secondary">See case studies</Button>
        </div>
      </div>
      <div>
        <LeadForm source={svc.slug} heading={svc.formHeading} questions={svc.formQuestions} service={{ options: [...SERVICE_NAMES], value: svcDefault }} submitLabel="Get my free plan" elevated />
      </div>
    </div>
  </Section>

  <!-- LOGOS -->
  <Section size="sm" class="!bg-[var(--surface-c)]">
    <LogoWall heading="Brands we work with" />
  </Section>

  {(svc.slug === 'shopify-development' || svc.slug === 'web-development') && (
    <Section size="md">
      <span class="ss-eyebrow">Recent work</span>
      <SiteShowcase heading="Stores and sites we've built" />
    </Section>
  )}

  {svc.slug === 'social-media-marketing' && (
    <Section size="md">
      <span class="ss-eyebrow">Content we make</span>
      <h2 class="mb-[var(--space-5)] max-w-[24ch] text-h2 font-semibold">Social content, edited and posted in-house</h2>
      <CreativeWall variant="grid" limit={9} />
    </Section>
  )}

  <!-- EDUCATION (2-col: heading left, prose right — fills the width) -->
  <Section size="md">
    <div class="grid gap-[var(--space-6)] lg:grid-cols-[0.72fr_1.28fr] lg:items-start">
      <div class="lg:sticky lg:top-[96px]">
        <span class="ss-eyebrow">{svc.intro.eyebrow}</span>
        <h2 class="text-h2 font-semibold">{svc.intro.heading}</h2>
      </div>
      <Prose>
        {svc.intro.paras.map((p) => <p>{p}</p>)}
      </Prose>
    </div>
  </Section>

  <!-- SUB-SERVICES -->
  <Section size="md" class="!bg-[var(--surface-c)]">
    <span class="ss-eyebrow">What’s included</span>
    <h2 class="max-w-[24ch] text-h2 font-semibold">{svc.subheading}</h2>
    {/* Three across, like the homepage grid, and a short final row is CENTRED
        rather than stretched (owner-directed, 2026-09-14) — cards keep one size
        everywhere. `rest3`/`rest2` are how many cards are left over on the last
        row at three-up and two-up; the card that STARTS that row carries the
        offset, and the rest flow in beside it. */}
    <ul class="ss-subgrid mt-[var(--space-6)]" data-n={svc.subservices.length}>
      {svc.subservices.map((s, i) => (
        <li
          data-row3={rest3 !== 0 && i === svc.subservices.length - rest3 ? String(rest3) : undefined}
          data-row2={rest2 !== 0 && i === svc.subservices.length - rest2 ? '1' : undefined}
        >
          <SubServiceCard title={s.title} body={s.body} href={s.href} glyph={glyphFor(s.title)} index={i} />
        </li>
      ))}
    </ul>
  </Section>

  {svc.comparison && (
    <Section size="md">
      <span class="ss-eyebrow">Honest comparison</span>
      <h2 class="max-w-[28ch] text-h2 font-semibold">{svc.comparison.heading}</h2>
      <div class="mt-[var(--space-5)]">
        <ComparisonTable columns={svc.comparison.cols} rows={svc.comparison.rows} highlightCol={svc.comparison.highlightCol} caption={svc.comparison.caption} />
      </div>
    </Section>
  )}

  <!-- PROCESS -->
  <Section size="md" class="!bg-[var(--surface-c)]">
    <span class="ss-eyebrow">How it works</span>
    <h2 class="max-w-[22ch] text-h2 font-semibold">How an engagement runs</h2>
    <div class="mt-[var(--space-5)]"><ProcessSteps steps={svc.process} /></div>
  </Section>

  <!-- VALUE — what you get, full width. No fee shown. -->
  <Section size="md">
    <span class="ss-eyebrow">The value</span>
    <h2 class="max-w-[24ch] text-h2 font-semibold">{svc.value.heading}</h2>
    <div class="mt-[var(--space-5)]"><PricingBlock lede={svc.value.lede} included={svc.value.included} note={svc.value.note} /></div>
  </Section>

  <!-- NOT FOR YOU (2-col: honest disqualifiers + the flip side, so the row fills) -->
  <Section size="md" class="!bg-[var(--surface-c)]">
    <div class="grid gap-[var(--space-8)] lg:grid-cols-[1fr_1fr] lg:items-start">
      <NotForYouBlock items={svc.notForYou} />
      <aside class="rounded-[var(--radius-card)] border border-[var(--rule-c)] bg-[var(--ground)] p-[var(--space-5)]">
        <span class="ss-svc-glyph mb-[var(--space-3)]"><Glyph name="handshake" size={20} /></span>
        <h3 class="text-h4 font-semibold text-[var(--fg)]">A good fit if this sounds like you</h3>
        <ul class="mt-[var(--space-3)] flex flex-col gap-[var(--space-2)]">
          {svc.goodFit.map((f) => (
            <li class="flex gap-[var(--space-2)] text-small leading-relaxed text-[var(--fg-muted)]">
              <span class="mt-[3px] shrink-0 text-[var(--accent-graphic)]"><Glyph name="scale" size={16} /></span>
              <span>{f}</span>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </Section>

  <!-- FAQ (2-col: accordion + a sticky CTA aside so the right column isn't blank) -->
  <Section size="md">
    <div class="grid gap-[var(--space-8)] lg:grid-cols-[1.5fr_1fr] lg:items-start">
      <div>
        <span class="ss-eyebrow">Questions</span>
        <h2 class="max-w-[22ch] text-h2 font-semibold">Questions founders ask</h2>
        <div class="mt-[var(--space-5)]"><FaqAccordion items={svc.faqs} openFirst /></div>
      </div>
      <aside class="lg:sticky lg:top-[96px] rounded-[var(--radius-card)] border border-[var(--rule-c)] bg-[var(--surface-c)] p-[var(--space-5)]">
        <span class="ss-svc-glyph mb-[var(--space-3)]"><Glyph name="chat" size={20} /></span>
        <h3 class="text-h4 font-semibold text-[var(--fg)]">Still weighing it up?</h3>
        <p class="mt-[var(--space-2)] text-small leading-relaxed text-[var(--fg-muted)]">
          Send us your accounts and you get a written audit in three working days, whether or not you
          go on to hire us. No sales deck.
        </p>
        <div class="mt-[var(--space-4)] flex flex-col gap-[var(--space-2)]">
          <Button href="/audit/" variant="primary">{svc.formHeading}</Button>
          <Button href="/contact/" variant="secondary">Talk to us</Button>
        </div>
      </aside>
    </div>
  </Section>

  {/* Contextual links into /industries/ and /vs/. Both sections were footer-only
      before, so their ten child pages had roughly two editorial inbound links
      each and almost no internal authority. These are topically relevant links
      from commercial pages, which are worth more than a sitewide nav slot. */}
  <Section size="md" class="!bg-[var(--surface-c)]">
    <div class="grid gap-[var(--space-6)] md:grid-cols-2">
      <div>
        <h2 class="text-h4 font-semibold">Working in a specific category?</h2>
        <p class="mt-[var(--space-2)] text-small leading-relaxed text-[var(--fg-muted)]">
          The levers differ by vertical. Each of these is anchored to a real result or a real client
          quote in that category.
        </p>
        <ul class="mt-[var(--space-3)] flex flex-wrap gap-x-[var(--space-3)] gap-y-[var(--space-2)]">
          {INDUSTRIES.map((i) => (
            <li>
              <a href={`/industries/${i.slug}/`} class="text-small font-medium text-[var(--accent-text)] no-underline hover:underline">{i.name}</a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="text-h4 font-semibold">Still deciding how to resource it?</h2>
        <p class="mt-[var(--space-2)] text-small leading-relaxed text-[var(--fg-muted)]">
          Honest comparisons that say plainly when the other option wins.
        </p>
        <ul class="mt-[var(--space-3)] flex flex-wrap gap-x-[var(--space-3)] gap-y-[var(--space-2)]">
          {COMPARISONS.map((c) => (
            <li>
              <a href={c.url} class="text-small font-medium text-[var(--accent-text)] no-underline hover:underline">{c.name}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <!-- CTA -->
  <Section register="ink" size="md">
    <CtaBand
      heading="Find out what is leaking money"
      body="Send us access and, within three working days, you get a written audit of what is working, what is not, and what we would change first, whether or not you hire us."
      ctaLabel={svc.formHeading}
      ctaHref="/audit/"
      secondaryLabel="Talk to us"
      secondaryHref="/contact/"
    />
  </Section>

  <style>
    .ss-eyebrow { display: inline-block; margin-bottom: var(--space-2); font-size: var(--text-label); font-weight: 600; color: var(--accent-text); }
    /* Hero fills the screen below the sticky header, so the copy + form land in
       one view. Padding is trimmed from the Section default to help it fit. */
    .ss-inkhero__stat-val { font-size: clamp(1.05rem, 1.5vw, 1.5rem); }
    @media (max-width: 480px) { .ss-inkhero__stat-val { font-size: 1rem; } }
    .ss-svc-glyph {
      display: grid;
      place-items: center;
      width: 40px;
      height: 40px;
      border-radius: var(--radius-input);
      color: var(--accent-graphic);
      background: var(--accent-wash);
      border: 1px solid color-mix(in srgb, var(--accent-graphic) 22%, transparent);
    }
  </style>
</BaseLayout>
