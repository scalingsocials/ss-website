---
/**
 * ServiceLayout — the pillar-page template. See 02 §5.1 and 03 §1.3.
 *
 * Renders a full service page from a ServiceContent object: answer-first hero
 * with an inline service-specific lead form, real proof, education, sub-services,
 * comparison, process, transparent pricing, a genuine disqualifier list, FAQ, and
 * a CTA band. Emits one @graph (Service + WebPage + BreadcrumbList + FAQPage,
 * with an Offer where a price floor is published).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Meta from '@/components/seo/Meta.astro';
import SchemaGraph from '@/components/seo/SchemaGraph.astro';
import Section from '@/components/primitives/Section.astro';
import Prose from '@/components/primitives/Prose.astro';
import Button from '@/components/primitives/Button.astro';
import LeadForm from '@/components/blocks/LeadForm.astro';
import LogoWall from '@/components/blocks/LogoWall.astro';
import ProcessSteps from '@/components/blocks/ProcessSteps.astro';
import PricingBlock from '@/components/blocks/PricingBlock.astro';
import ComparisonTable from '@/components/blocks/ComparisonTable.astro';
import NotForYouBlock from '@/components/blocks/NotForYouBlock.astro';
import FaqAccordion from '@/components/blocks/FaqAccordion.astro';
import CtaBand from '@/components/blocks/CtaBand.astro';
import Glyph from '@/components/graphics/Glyph.astro';
import DotField from '@/components/graphics/DotField.astro';
import { HERO_STATS } from '@/lib/caseStudies';
import { base, service, webPage, breadcrumbs, faqPage, serviceId } from '@/lib/schema';
import type { ServiceContent } from '@/lib/services';

export interface Props {
  svc: ServiceContent;
}
const { svc } = Astro.props;
const url = svc.url;
const published = '2026-09-01';
const modified = '2026-09-04';

// Map a sub-service title to one shared glyph, so every card carries a line
// icon in the site's single drawing hand. Keyword match, falls back to spark.
function glyphFor(title: string): string {
  const t = title.toLowerCase();
  const rules: [RegExp, string][] = [
    [/meta|facebook|instagram\b|paid social/, 'target'],
    [/google|search ads|ppc|shopping/, 'search'],
    [/seo|ranking|organic|answer engine|aeo/, 'chart'],
    [/shopify|store|ecommerce|checkout|cart/, 'cart'],
    [/web|site|develop|headless|code|build/, 'code'],
    [/social|community|content|ugc/, 'social'],
    [/cro|conversion|landing|funnel/, 'funnel'],
    [/speed|performance|core web|pagespeed/, 'speed'],
    [/migrat|replatform/, 'migrate'],
    [/redesign|theme|design/, 'layers'],
    [/audit|analys|research/, 'audit'],
    [/email|crm|retention|lifecycle/, 'mail'],
    [/report|analytic|dashboard|measure/, 'gauge'],
    [/local|map|gmb|profile/, 'target'],
  ];
  for (const [re, g] of rules) if (re.test(t)) return g;
  return 'spark';
}

const process = [
  { title: 'Audit', body: 'We read your accounts and your store and find where spend leaks and where it can scale.' },
  { title: 'Plan', body: 'A 30-60-90 plan: the first things we would change, in order, with the reasoning.' },
  { title: 'Build', body: 'The work itself, whether campaigns, pages, content or code, built so it can be tested.' },
  { title: 'Test', body: 'We test against your real margins, not a vanity benchmark.' },
  { title: 'Scale', body: 'What works gets more; what doesn’t gets cut. Then we run the loop again.' },
];

const nodes = [
  ...base(),
  service({
    url,
    name: svc.name,
    description: svc.description,
    serviceType: svc.name,
    areaServed: ['IN', 'AE'],
    ...(svc.offer ? { offer: svc.offer } : {}),
    offerCatalog: svc.subservices.map((s) => ({ name: s.title, url: s.href ?? url })),
  }),
  webPage({ url, name: svc.title, description: svc.description, aboutId: serviceId(url), hasBreadcrumb: true, datePublished: published, dateModified: modified }),
  breadcrumbs(url, [{ name: 'Home', url: '/' }, { name: svc.name, url }]),
  faqPage(url, svc.faqs),
];
---

<BaseLayout>
  <Meta slot="meta" title={svc.title} description={svc.description} type="website" modifiedTime={modified} />
  <SchemaGraph slot="schema" nodes={nodes} />

  <!-- HERO -->
  <Section size="lg" class="relative overflow-hidden">
    <DotField origin="top-right" />
    <nav aria-label="Breadcrumb" class="relative mb-[var(--space-4)] text-small text-[var(--fg-muted)]">
      <a href="/" class="text-[var(--accent-text)] no-underline">Home</a><span> / </span><span>{svc.name}</span>
    </nav>
    <div class="relative grid gap-[var(--space-8)] lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
      <div>
        <span class="ss-eyebrow">{svc.eyebrow}</span>
        <h1>{svc.h1}</h1>
        <p class="mt-[var(--space-4)] max-w-[56ch] text-h4 leading-[1.5] text-[var(--fg)]">{svc.answer}</p>
        <ul class="mt-[var(--space-6)] flex flex-wrap gap-[var(--space-6)]">
          {HERO_STATS.map((cs) => (
            <li class="flex flex-col gap-[2px]">
              <span class="display-type text-data-sm font-bold leading-none text-[var(--fg)]" data-num>{cs.value}</span>
              <span class="text-label text-[var(--fg-muted)]">{cs.label}, {cs.niche.toLowerCase()}</span>
            </li>
          ))}
        </ul>
        <div class="mt-[var(--space-6)] flex flex-wrap gap-[var(--space-2)]">
          <Button href="/audit/" variant="primary">Get a free growth plan</Button>
          <Button href="/case-studies/" variant="secondary">See case studies</Button>
        </div>
      </div>
      <div class="lg:sticky lg:top-[88px]">
        <LeadForm source={svc.slug} heading={svc.formHeading} questions={svc.formQuestions} submitLabel="Get my free plan" />
      </div>
    </div>
  </Section>

  <!-- LOGOS -->
  <Section size="sm" class="!bg-[var(--surface-c)]">
    <LogoWall heading="Brands we work with" />
  </Section>

  <!-- EDUCATION (2-col: heading left, prose right — fills the width) -->
  <Section size="md">
    <div class="grid gap-[var(--space-6)] lg:grid-cols-[0.72fr_1.28fr] lg:items-start">
      <div class="lg:sticky lg:top-[96px]">
        <span class="ss-eyebrow">{svc.intro.eyebrow}</span>
        <h2 class="text-h2 font-semibold">{svc.intro.heading}</h2>
      </div>
      <Prose>
        {svc.intro.paras.map((p) => <p>{p}</p>)}
      </Prose>
    </div>
  </Section>

  <!-- SUB-SERVICES -->
  <Section size="md" class="!bg-[var(--surface-c)]">
    <span class="ss-eyebrow">What’s included</span>
    <h2 class="max-w-[24ch] text-h2 font-semibold">{svc.subheading}</h2>
    <ul class="mt-[var(--space-6)] grid gap-[var(--space-3)] sm:grid-cols-2">
      {svc.subservices.map((s) => (
        <li class="flex flex-col gap-[var(--space-2)] rounded-[var(--radius-card)] border border-[var(--rule-c)] bg-[var(--ground)] p-[var(--space-4)]">
          <span class="ss-svc-glyph"><Glyph name={glyphFor(s.title)} size={20} /></span>
          <h3 class="text-h4 font-semibold text-[var(--fg)]">{s.title}</h3>
          <p class="text-small leading-relaxed text-[var(--fg-muted)]">{s.body}</p>
          {s.href && <a href={s.href} class="mt-auto pt-[var(--space-1)] text-small font-medium text-[var(--accent-text)] no-underline">Learn more</a>}
        </li>
      ))}
    </ul>
  </Section>

  {svc.comparison && (
    <Section size="md">
      <span class="ss-eyebrow">Honest comparison</span>
      <h2 class="max-w-[28ch] text-h2 font-semibold">{svc.comparison.heading}</h2>
      <div class="mt-[var(--space-5)]">
        <ComparisonTable columns={svc.comparison.cols} rows={svc.comparison.rows} highlightCol={svc.comparison.highlightCol} caption={svc.comparison.caption} />
      </div>
    </Section>
  )}

  <!-- PROCESS -->
  <Section size="md" class="!bg-[var(--surface-c)]">
    <span class="ss-eyebrow">How it works</span>
    <h2 class="max-w-[22ch] text-h2 font-semibold">How an engagement runs</h2>
    <div class="mt-[var(--space-5)]"><ProcessSteps steps={process} /></div>
  </Section>

  <!-- VALUE (was "pricing" — value-framed, full width) -->
  <Section size="md">
    <span class="ss-eyebrow">The value</span>
    <h2 class="max-w-[24ch] text-h2 font-semibold">{svc.value.heading}</h2>
    <div class="mt-[var(--space-5)]"><PricingBlock lede={svc.value.lede} included={svc.value.included} price={svc.value.price} note={svc.value.note} /></div>
  </Section>

  <!-- NOT FOR YOU (2-col: honest disqualifiers + the flip side, so the row fills) -->
  <Section size="md" class="!bg-[var(--surface-c)]">
    <div class="grid gap-[var(--space-8)] lg:grid-cols-[1fr_1fr] lg:items-start">
      <NotForYouBlock items={svc.notForYou} />
      <aside class="rounded-[var(--radius-card)] border border-[var(--rule-c)] bg-[var(--ground)] p-[var(--space-5)]">
        <span class="ss-svc-glyph mb-[var(--space-3)]"><Glyph name="handshake" size={20} /></span>
        <h3 class="text-h4 font-semibold text-[var(--fg)]">A good fit if this sounds like you</h3>
        <ul class="mt-[var(--space-3)] flex flex-col gap-[var(--space-2)]">
          {['You’re a D2C or ecommerce brand with some trading data to work from', 'You can keep a steady supply of creative and offers coming', 'You want growth measured against your margins, not a dashboard', 'You’d rather see the maths than be handed a promise'].map((f) => (
            <li class="flex gap-[var(--space-2)] text-small leading-relaxed text-[var(--fg-muted)]">
              <span class="mt-[3px] shrink-0 text-[var(--accent-graphic)]"><Glyph name="scale" size={16} /></span>
              <span>{f}</span>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </Section>

  <!-- FAQ (2-col: accordion + a sticky CTA aside so the right column isn't blank) -->
  <Section size="md">
    <div class="grid gap-[var(--space-8)] lg:grid-cols-[1.5fr_1fr] lg:items-start">
      <div>
        <span class="ss-eyebrow">Questions</span>
        <h2 class="max-w-[22ch] text-h2 font-semibold">Questions founders ask</h2>
        <div class="mt-[var(--space-5)]"><FaqAccordion items={svc.faqs} openFirst /></div>
      </div>
      <aside class="lg:sticky lg:top-[96px] rounded-[var(--radius-card)] border border-[var(--rule-c)] bg-[var(--surface-c)] p-[var(--space-5)]">
        <span class="ss-svc-glyph mb-[var(--space-3)]"><Glyph name="chat" size={20} /></span>
        <h3 class="text-h4 font-semibold text-[var(--fg)]">Still weighing it up?</h3>
        <p class="mt-[var(--space-2)] text-small leading-relaxed text-[var(--fg-muted)]">
          Send us your accounts and you get a written audit in three working days, whether or not you
          go on to hire us. No sales deck.
        </p>
        <div class="mt-[var(--space-4)] flex flex-col gap-[var(--space-2)]">
          <Button href="/audit/" variant="primary">Get a free growth plan</Button>
          <Button href="/contact/" variant="secondary">Talk to us</Button>
        </div>
      </aside>
    </div>
  </Section>

  <!-- CTA -->
  <Section register="ink" size="md">
    <CtaBand
      heading="Find out what is leaking money"
      body="Send us access and, within three working days, you get a written audit of what is working, what is not, and what we would change first, whether or not you hire us."
      ctaLabel="Get a free growth plan"
      ctaHref="/audit/"
      secondaryLabel="Talk to us"
      secondaryHref="/contact/"
    />
  </Section>

  <style>
    .ss-eyebrow { display: inline-block; margin-bottom: var(--space-2); font-size: var(--text-label); font-weight: 600; color: var(--accent-text); }
    .ss-svc-glyph {
      display: grid;
      place-items: center;
      width: 40px;
      height: 40px;
      border-radius: var(--radius-input);
      color: var(--accent-graphic);
      background: var(--accent-wash);
      border: 1px solid color-mix(in srgb, var(--accent-graphic) 22%, transparent);
    }
  </style>
</BaseLayout>
