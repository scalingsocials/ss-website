{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/",
        "http://localhost/tools/break-even-roas-calculator/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.98 }],
        "categories:accessibility": ["warn", { "minScore": 0.98 }],
        "categories:best-practices": ["warn", { "minScore": 0.98 }],
        "categories:seo": ["warn", { "minScore": 1 }]
      }
    }
  }
}
